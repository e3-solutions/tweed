+def observe_workspace(cwd: Path, evidence_directory: Path) -> dict[str, str] | None:
+    """Fingerprint the workspace, treating an unavailable Git as unknown."""
+    try:
+        return git_workspace_fingerprint(cwd, evidence_directory)
+    except OSError:
+        return None
+
+
+def workspace_binding(
+    before: dict[str, str] | None, after: dict[str, str] | None
+) -> str:
+    if before is None or after is None:
+        return "unknown"
+    if before["root"] == after["root"] and before["sha256"] == after["sha256"]:
+        return "unchanged"
+    return "changed"
+
