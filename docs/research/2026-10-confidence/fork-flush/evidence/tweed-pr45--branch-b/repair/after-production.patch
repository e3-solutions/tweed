+def workspace_binding(
+    start: dict[str, str] | None, end: dict[str, str] | None
+) -> str:
+    """Classify source identity across a capture; never claim unchanged without proof."""
+    if start is None or end is None:
+        return "unknown"
+    if start["root"] == end["root"] and start["sha256"] == end["sha256"]:
+        return "unchanged"
+    return "changed"
+
