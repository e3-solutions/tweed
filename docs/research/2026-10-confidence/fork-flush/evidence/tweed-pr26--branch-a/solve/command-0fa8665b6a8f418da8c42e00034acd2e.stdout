    _update_checkpoint_observation(checkpoint, observation)
    checkpoint["activity"] = "waiting-user"
    write_checkpoint(checkpoint)
    return checkpoint


def _serialized_size(receipt: dict) -> int:
    return len(
        (
            json.dumps(receipt, ensure_ascii=False, separators=(",", ":")) + "\n"
        ).encode("utf-8")
    )


def checkpoint_receipt(
    checkpoint: dict,
    *,
    state: str | None = None,
    summary: str | None = None,
) -> dict:
    stored = checkpoint["receipt"]
    receipt = {
        "phase": checkpoint["phase"],
        "state": state or "needs-input",
        "issue": stored.get("issue"),
        "linear_url": stored.get("linear_url"),
        "result": None,
        "summary": (summary or stored.get("summary") or "Checkpoint saved.")[:800],
        "question": checkpoint.get("question"),
        "next_action": "Resume this token to continue the same Codex session.",
        "branch": checkpoint.get("branch") or stored.get("branch"),
        "commit": stored.get("commit"),
        "pull_request_url": stored.get("pull_request_url"),
        "remote_state_changed": checkpoint.get("remote_state_changed"),
        "resume_session_id": checkpoint["token"],
        "resume_token": checkpoint["token"],
        "worktree": checkpoint.get("worktree"),
        "files_changed": list((checkpoint.get("files_changed") or [])[:3]),
        "files_changed_total_count": checkpoint.get(
            "files_changed_total_count", 0
        ),
        "files_changed_truncated": bool(
            checkpoint.get("files_changed_truncated")
            or len(checkpoint.get("files_changed") or []) > 3
        ),
        "checks_completed": list((checkpoint.get("checks_completed") or [])[:3]),
        "checks_completed_total_count": checkpoint.get(
            "checks_completed_total_count", 0
        ),
        "checks_completed_truncated": bool(
            checkpoint.get("checks_completed_truncated")
            or len(checkpoint.get("checks_completed") or []) > 3
        ),
        "activity": checkpoint.get("activity"),
        "blocker": (checkpoint.get("blocker") or "")[:300] or None,
    }
    if _serialized_size(receipt) <= RECEIPT_MAX_BYTES:
        return receipt

    receipt.update(
        files_changed=[],
        files_changed_truncated=bool(receipt["files_changed_total_count"]),
        checks_completed=[],
        checks_completed_truncated=bool(receipt["checks_completed_total_count"]),
    )
    if _serialized_size(receipt) <= RECEIPT_MAX_BYTES:
        return receipt
    receipt.update(
        issue=None,
        linear_url=None,
        summary="Checkpoint saved.",
        branch=None,
        commit=None,
        pull_request_url=None,
        worktree=None,
        activity=None,
        blocker=None,
    )
    if _serialized_size(receipt) > RECEIPT_MAX_BYTES:
        receipt["question"] = (
            "The saved question is too large to display; resume this token after "
            "reviewing its durable checkpoint."
        )
    return receipt


def _checkpoint_failure(checkpoint: dict, summary: str, *, remote_uncertain=False) -> dict:
    checkpoint.update(
        activity="waiting-user",
        blocker=summary.replace("\n", " ")[:800],
        updated_at=utc_now(),
    )
    if remote_uncertain:
        checkpoint["remote_state_changed"] = _combine_remote(
            checkpoint.get("remote_state_changed"), None
        )
    _refresh_checkpoint_git(checkpoint)
    write_checkpoint(checkpoint)
    receipt = checkpoint_receipt(checkpoint, state="failed", summary=summary)
    receipt["next_action"] = "Resume this token to continue the same Codex session."
    if _serialized_size(receipt) > RECEIPT_MAX_BYTES:
        receipt["next_action"] = None
    return receipt


def _validate_checkpoint_worktree(checkpoint: dict) -> Path:
    repository = Path(checkpoint["worktree"])
    if not repository.is_dir():
        raise RuntimeError("checkpoint worktree is unavailable")
    current = capture_git_state(repository)
    if checkpoint.get("git_dir") and current.get("git_dir") != checkpoint["git_dir"]:
        raise RuntimeError("checkpoint worktree no longer identifies the same repository")
    if current.get("branch") != checkpoint.get("branch"):
        raise RuntimeError("checkpoint worktree is on a different branch")
    if (
