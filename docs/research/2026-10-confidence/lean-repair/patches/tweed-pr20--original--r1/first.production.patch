+def select_model(option: str | None = None) -> str | None:
+    """Return the trimmed explicit model, or None to keep Codex defaults.
+
+    The --model option wins over BONAPARTE_MODEL, even when the environment
+    value is blank. A selected value that is blank after trimming is rejected.
+    """
+    selected = option if option is not None else os.environ.get(MODEL_ENV)
+    if selected is None:
+        return None
+    selected = selected.strip()
+    if not selected:
+        source = "--model" if option is not None else MODEL_ENV
+        raise RuntimeError(f"{source} must name a model when supplied")
+    return selected
+
+
+def toml_string(value: str) -> str:
+    """Encode an opaque value as a TOML basic string."""
+    encoded = []
+    for character in value:
+        if character in '"\\':
+            encoded.append("\\" + character)
+        elif ord(character) < 0x20 or ord(character) == 0x7F:
+            encoded.append(f"\\u{ord(character):04X}")
+        else:
+            encoded.append(character)
+    return '"' + "".join(encoded) + '"'
+
+
+def child_config(description: str, model: str | None) -> str:
+    fields = [f"description={toml_string(description)}"]
+    if model is not None:
+        fields.append(f"model={toml_string(model)}")
+    fields.append(f"model_reasoning_effort={toml_string(SUBAGENT_EFFORT)}")
+    return "{" + ",".join(fields) + "}"
+
+
+def model_policy(model: str | None) -> str:
+    roles = "using only the built-in default, worker, or explorer roles"
+    if model is None:
+        return (
+            "This coordinator uses the Codex default model at "
+            f"{COORDINATOR_EFFORT} reasoning. Spawn every child at "
+            f"{SUBAGENT_EFFORT} reasoning {roles}, leaving each child on its "
+            "configured Codex default model. Do not select or request a child "
+            "model, a different role, or a different reasoning effort."
+        )
+    quoted = json.dumps(model, ensure_ascii=False)
+    return (
+        f"This coordinator is pinned to the model {quoted} at "
+        f"{COORDINATOR_EFFORT} reasoning. Spawn every child on that same model "
+        f"at {SUBAGENT_EFFORT} reasoning {roles}. Do not select or request a "
+        "different child model, role, or reasoning effort."
+    )
+
+
+class Invocation(tuple):
+    """The four positional phase arguments, plus the selected model."""
+
+    def __new__(
+        cls,
+        repository: Path,
+        phase: str,
