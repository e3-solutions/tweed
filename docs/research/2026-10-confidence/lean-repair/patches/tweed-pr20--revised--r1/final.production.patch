+def select_model(option: str | None = None) -> str | None:
+    """Return the trimmed --model or BONAPARTE_MODEL value, or None for defaults."""
+    source, selected = "--model", option
+    if selected is None:
+        source, selected = MODEL_ENV, os.environ.get(MODEL_ENV)
+    if selected is None:
+        return None
+    selected = selected.strip()
+    if not selected:
+        raise RuntimeError(f"{source} must not be blank")
+    if any(0xD800 <= ord(character) <= 0xDFFF for character in selected):
+        raise RuntimeError(f"{source} must be valid Unicode text")
+    return selected
+
+
+def toml_string(value: str) -> str:
+    """Encode text as a TOML basic string for a Codex -c override."""
+    encoded = []
+    for character in value:
+        code = ord(character)
+        if character in {'"', "\\"}:
+            encoded.append("\\" + character)
+        elif code < 0x20 or code == 0x7F:
+            encoded.append(f"\\u{code:04X}")
+        else:
+            encoded.append(character)
+    return '"' + "".join(encoded) + '"'
+
+
+class ParsedArguments(tuple):
+    """The four positional parse results, plus the selected model attribute."""
+
+    model: str | None
+
+    def __new__(cls, values: tuple, model: str | None):
+        parsed = super().__new__(cls, values)
+        parsed.model = model
+        return parsed
+
