+def _is_coordinator_completion(
+    message: dict, completed_turn: dict | None, session_id: str, turn_id: str
+) -> bool:
+    """Whether a turn/completed notification belongs to the active coordinator turn.
+
+    Child threads and stale coordinator turns are observed but ignored. A legacy
+    notification that omits threadId entirely is accepted only for the active turn.
+    """
+    if completed_turn is None or completed_turn.get("id") != turn_id:
+        return False
+    params = message.get("params")
+    if not isinstance(params, dict):
+        return False
+    return "threadId" not in params or params["threadId"] == session_id
+
