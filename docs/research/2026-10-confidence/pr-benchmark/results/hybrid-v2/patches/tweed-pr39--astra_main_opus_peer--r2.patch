@@ -346,4 +358,43 @@ class AppServerPhaseDriver:
         return self._last_agent_message
 
     def close(self, *, failed: bool) -> None:
-        terminate_and_reap(self.process)
+        if getattr(self, "_closed", False):
+            return
+        self._closed = True
+        errors = []
+        try:
+            root = getattr(self, "_receipt_thread_id", None)
+            started = getattr(self, "_started_threads", {})
+            if getattr(self, "_terminal_root", False) and root in started:
+                # Only actual starts establish ownership, including every link
+                # in a descendant's ancestry. Spawn tool results are not starts.
+                owned = {root}
+                while True:
+                    descendants = {
+                        identifier for identifier, parent in started.items()
+                        if parent in owned
+                    } - owned
+                    if not descendants:
+                        break
+                    owned.update(descendants)
+                for identifier in sorted(owned - {root}):
+                    try:
+                        if not self.issue_branch:
+                            raise RuntimeError("canonical issue branch is unavailable")
+                        self.request("thread/metadata/update", {
+                            "threadId": identifier,
+                            "gitInfo": {"branch": self.issue_branch},
+                        })
+                    except Exception as error:
+                        errors.append(f"descendant {identifier} metadata cleanup failed: {error}")
+                try:
+                    self.request("thread/archive", {"threadId": root})
+                except Exception as error:
+                    errors.append(f"root {root} archive failed: {error}")
+        finally:
+            try:
+                terminate_and_reap(self.process)
+            except Exception as error:
+                errors.append(f"process reaping failed: {error}")
+        if errors:
+            raise RuntimeError("; ".join(errors))
