+    base_git: dict,
+    soft_phase_budget_seconds: float,
+) -> tuple[dict, int]:
+    summary = _soft_budget_failure_summary(error)
+    saved = {name: None for name in RECEIPT_SCHEMA["required"]}
+    saved.update(
+        phase=phase,
+        state="needs-input",
+        summary=summary,
+        question=SOFT_BUDGET_CONTINUE_QUESTION,
+    )
