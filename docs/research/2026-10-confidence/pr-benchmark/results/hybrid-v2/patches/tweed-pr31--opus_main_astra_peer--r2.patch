+            model,
+            reasoning,
+            observation,
+            base_git,
+            soft_phase_budget_seconds,
+        )
+    except RuntimeError:
+        # Without a verified repository identity no usable token can exist.
+        raise error from None
+    receipt = _checkpoint_failure(checkpoint, summary, remote_uncertain=True)
+    return receipt, 130 if error.interrupted else 1
