+def _soft_budget_failure_summary(error: SoftBudgetContinuation) -> str:
+    detail = str(error).replace("\n", " ")
+    return (
+        f"Soft phase budget wrap-up failed: {detail} Unfinished proof obligations "
+        "are unverified. Resume this token with Continue."
