+def select_soft_phase_budget(
+    seconds: str | None, disabled: bool, resume: bool
+) -> object:
+    """Resolve CLI and environment budget selection.
+
+    Fresh runs return positive seconds or None (disabled). Resume returns None
+    for "keep the checkpoint budget", SOFT_PHASE_BUDGET_DISABLED, or seconds.
+    """
+    if seconds is not None:
+        if disabled:
+            raise RuntimeError(
+                "--soft-phase-budget-seconds and --no-soft-phase-budget "
+                "are mutually exclusive"
+            )
+        budget = resolve_soft_phase_budget(seconds)
+        if budget is None:
+            raise RuntimeError(
+                "soft phase budget requires one positive finite seconds value"
+            )
+        return budget
+    if disabled:
+        return SOFT_PHASE_BUDGET_DISABLED if resume else None
+    if resume:
+        return None
+    environment = os.environ.get(SOFT_PHASE_BUDGET_ENV, "").strip()
+    if not environment:
+        return DEFAULT_SOFT_PHASE_BUDGET_SECONDS
+    if environment.casefold() == "off":
+        return None
+    try:
+        return resolve_soft_phase_budget(environment)
+    except RuntimeError as error:
