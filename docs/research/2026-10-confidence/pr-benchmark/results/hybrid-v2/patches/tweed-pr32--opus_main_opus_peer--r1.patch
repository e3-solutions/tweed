+def coordinator_turn_completion(
+    message: dict, completed_turn: dict | None, session_id: str, turn_id: str
+) -> dict | None:
+    """Return the completion only when it belongs to the active coordinator turn.
+
+    Native child threads report their own ``turn/completed`` notifications on
+    the same connection; those must never finish or replace the coordinator
+    turn. Legacy notifications without ``threadId`` are attributed to the
+    coordinator and still require the active turn ID.
+    """
+    if completed_turn is None:
+        return None
+    params = message.get("params")
+    thread_id = params.get("threadId") if isinstance(params, dict) else None
+    if thread_id is not None and thread_id != session_id:
+        return None
+    if completed_turn.get("id") != turn_id:
+        raise RuntimeError("Codex app-server completed the wrong turn")
+    return completed_turn
+
+
