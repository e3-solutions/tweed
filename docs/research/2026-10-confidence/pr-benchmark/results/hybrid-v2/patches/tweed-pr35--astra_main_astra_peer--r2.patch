+def snapshot_contents(release: Path) -> dict:
+    """Compare cached snapshots to the fetched tree, excluding Python caches."""
+    contents = {}
+    for path in release.rglob("*"):
+        relative = path.relative_to(release)
+        if "__pycache__" in relative.parts:
+            continue
+        if path.is_symlink():
+            contents[str(relative)] = ("link", str(path.readlink()))
+        elif path.is_file():
+            contents[str(relative)] = ("file", path.stat().st_mode & 0o111, path.read_bytes())
+        elif path.is_dir():
+            contents[str(relative)] = ("directory",)
+        else:
+            raise RuntimeError(f"invalid snapshot path: {relative}")
+    return contents
+
