+def snapshot(release: Path) -> dict[str, tuple[int, str]]:
+    """Compare cached releases by content, never merely by their tag name."""
+    result = {}
+    for directory, directories, files in os.walk(release, followlinks=False):
+        for name in directories + files:
+            path = Path(directory) / name
+            relative = path.relative_to(release)
+            if "__pycache__" in relative.parts:
+                continue
+            if relative.as_posix() == IDENTITY:
+                continue
+            mode = path.lstat().st_mode
+            if stat.S_ISLNK(mode) or not (stat.S_ISDIR(mode) or stat.S_ISREG(mode)):
+                raise RuntimeError(f"release has unsupported path: {relative}")
+            result[relative.as_posix()] = (
+                stat.S_IFMT(mode) | (mode & 0o111),
+                hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else "",
+            )
+    return result
+
+
+def release_oid(release: Path) -> str | None:
+    identity = release / IDENTITY
+    if identity.is_symlink() or not identity.is_file():
+        return None
+    return identity.read_text().strip()
+
