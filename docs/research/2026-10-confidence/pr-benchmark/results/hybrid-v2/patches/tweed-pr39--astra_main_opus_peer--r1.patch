@@ -346,4 +367,42 @@ class AppServerPhaseDriver:
         return self._last_agent_message
 
     def close(self, *, failed: bool) -> None:
-        terminate_and_reap(self.process)
+        """Attempt every owned cleanup, then reap before surfacing failures."""
+        if getattr(self, "_closed", False):
+            return
+        self._closed = True
+        errors: list[str] = []
+        try:
+            root = getattr(self, "_receipt_thread_id", None)
+            started = getattr(self, "_started_parents", {})
+            if getattr(self, "_terminal", False) and root in started:
+                owned = {root}
+                while True:
+                    descendants = {
+                        child for child, parent in started.items() if parent in owned
+                    }
+                    if descendants <= owned:
+                        break
+                    owned.update(descendants)
+                for child in sorted(owned - {root}):
+                    if not self.canonical_branch:
+                        errors.append(f"metadata for {child}: canonical issue branch unavailable")
+                        continue
+                    try:
+                        self.request(
+                            "thread/metadata/update",
+                            {"threadId": child, "gitInfo": {"branch": self.canonical_branch}},
+                        )
+                    except Exception as error:
+                        errors.append(f"metadata for {child}: {error}")
+                try:
+                    self.request("thread/archive", {"threadId": root})
+                except Exception as error:
+                    errors.append(f"archive for {root}: {error}")
+        finally:
+            try:
+                terminate_and_reap(self.process)
+            except Exception as error:
+                errors.append(f"process reaping: {error}")
+        if errors:
+            raise RuntimeError("Native session cleanup failed: " + "; ".join(errors))
