@@ -345,5 +349,70 @@ class AppServerPhaseDriver:
     def last_agent_message(self) -> str | None:
         return self._last_agent_message
 
+    def owned_descendants(self, root_thread_id: str) -> list[str]:
+        """Started threads whose observed parent chain reaches the root."""
+        started: dict = getattr(self, "_started_threads", {})
+        owned: list[str] = []
+        frontier = [root_thread_id]
+        seen = {root_thread_id}
+        while frontier:
+            parent = frontier.pop(0)
+            for thread_id, parent_id in started.items():
+                if parent_id == parent and thread_id not in seen:
+                    seen.add(thread_id)
+                    owned.append(thread_id)
+                    frontier.append(thread_id)
+        return owned
+
+    def _teardown_session(self, errors: list[str]) -> None:
+        finished = getattr(self, "_finished_root", None)
+        if finished is None:
+            return
+        root_thread_id, branch, archive_root = finished
+        if branch:
+            for thread_id in self.owned_descendants(root_thread_id):
+                try:
+                    self.request(
+                        "thread/metadata/update",
+                        {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                    )
+                except Exception as error:
+                    errors.append(f"metadata update for {thread_id}: {error}")
+        if archive_root and root_thread_id in getattr(self, "_started_threads", {}):
+            try:
+                self.request("thread/archive", {"threadId": root_thread_id})
+            except Exception as error:
+                errors.append(f"archive of {root_thread_id}: {error}")
+
     def close(self, *, failed: bool) -> None:
-        terminate_and_reap(self.process)
+        errors: list[str] = []
+        try:
+            if not failed:
+                self._teardown_session(errors)
+        finally:
+            terminate_and_reap(self.process)
+        if errors:
+            raise RuntimeError("Codex session cleanup failed: " + "; ".join(errors))
+
+
+def _parent_thread_id(thread: dict) -> str | None:
+    """Return the spawning parent recorded on a native thread, if any."""
+    for key in ("parentThreadId", "parent_thread_id"):
+        if isinstance(thread.get(key), str) and thread[key]:
+            return thread[key]
+    source = thread.get("source")
+    if not isinstance(source, dict):
+        return None
+    for key in ("subAgent", "subagent", "sub_agent"):
+        sub_agent = source.get(key)
+        if not isinstance(sub_agent, dict):
+            continue
+        for spawn_key in ("thread_spawn", "threadSpawn"):
+            spawn = sub_agent.get(spawn_key)
+            if not isinstance(spawn, dict):
+                continue
+            for parent_key in ("parent_thread_id", "parentThreadId"):
+                parent = spawn.get(parent_key)
+                if isinstance(parent, str) and parent:
+                    return parent
+    return None
