+def coordinator_terminal(
+    message: dict, completed_turn: dict | None, thread_id: str, turn_id: str
+) -> dict | None:
+    """Return a turn completion only when it belongs to the active coordinator turn.
+
+    Completions from other threads (native child agents) are ignored. Legacy
+    completions without a threadId are accepted only for the active turn ID.
+    A completion on the coordinator thread for a different turn is rejected.
+    """
+    if completed_turn is None:
+        return None
+    params = message.get("params")
+    event_thread = params.get("threadId") if isinstance(params, dict) else None
+    if event_thread is None:
+        return completed_turn if completed_turn.get("id") == turn_id else None
+    if event_thread != thread_id:
+        return None
+    if completed_turn.get("id") != turn_id:
+        raise RuntimeError("Codex app-server completed the wrong turn")
+    return completed_turn
+
+
