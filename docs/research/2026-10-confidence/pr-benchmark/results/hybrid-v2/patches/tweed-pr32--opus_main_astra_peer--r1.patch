+def coordinator_turn_outcome(
+    message: dict, completed_turn: dict | None, thread_id: str, turn_id: str
+) -> dict | None:
+    """Return a turn completion only when it belongs to the active coordinator turn.
+
+    Native child threads and stale turns also emit turn/completed; they must not
+    establish the coordinator outcome. Legacy notifications without a threadId
+    are accepted only when their turn ID matches the active turn.
+    """
+    if completed_turn is None or completed_turn.get("id") != turn_id:
+        return None
+    params = message.get("params")
+    notified_thread = params.get("threadId") if isinstance(params, dict) else None
+    if notified_thread is None or notified_thread == thread_id:
+        return completed_turn
+    return None
+
