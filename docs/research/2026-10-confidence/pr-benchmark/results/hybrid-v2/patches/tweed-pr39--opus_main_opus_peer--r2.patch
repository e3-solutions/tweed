+    def owned_descendants(self) -> list[str]:
+        """Started threads transitively spawned by the started receipt root."""
+        started = getattr(self, "_started_threads", {})
+        root = getattr(self, "_receipt_thread_id", None)
+        if root is None or root not in started:
+            return []
+        owned = {root}
+        descendants: list[str] = []
+        changed = True
+        while changed:
+            changed = False
+            for thread_id, parent in started.items():
+                if thread_id not in owned and parent in owned:
+                    owned.add(thread_id)
+                    descendants.append(thread_id)
+                    changed = True
+        return [thread_id for thread_id in started if thread_id in descendants]
