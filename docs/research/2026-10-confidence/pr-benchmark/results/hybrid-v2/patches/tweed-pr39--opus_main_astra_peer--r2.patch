                 self.observer.feed(
                     json.dumps({"type": "thread.started", "thread_id": thread["id"]})
                 )
@@ -345,5 +347,102 @@ class AppServerPhaseDriver:
     def last_agent_message(self) -> str | None:
         return self._last_agent_message
 
+    def owned_descendants(self, root_id: str) -> list[str]:
+        """Started threads whose started-parent chain reaches a started root."""
+        started = self.__dict__.get("_started_threads", {})
+        if root_id not in started:
+            return []
+        owned = []
+        for thread_id in started:
+            if thread_id == root_id:
+                continue
+            seen = {thread_id}
+            parent = started[thread_id]
+            while parent is not None and parent != root_id:
+                if parent in seen or parent not in started:
+                    parent = None
+                    break
+                seen.add(parent)
+                parent = started[parent]
+            if parent == root_id:
+                owned.append(thread_id)
+        return owned
+
+    def retire_session(self, root_id: str, canonical_branch) -> None:
+        """Stamp started owned descendants, then archive the started root.
+
+        Every step is attempted; failures are raised together afterwards.
+        A root with no observed thread/started event is left untouched.
+        """
+        if root_id not in self.__dict__.get("_started_threads", {}):
+            return
+        errors = []
+        interrupt = None
+        branch = None
+        updated: set[str] = set()
+        try:
+            # Descendants whose thread/started arrives while cleanup requests
+            # are in flight are picked up until the root archive is sent.
+            while True:
+                pending = [
+                    thread_id
+                    for thread_id in self.owned_descendants(root_id)
+                    if thread_id not in updated
+                ]
+                if not pending:
+                    break
+                if branch is None:
+                    try:
+                        branch = canonical_branch()
+                        if not isinstance(branch, str) or not branch:
+                            raise RuntimeError("canonical issue branch is unavailable")
+                    except Exception as error:
+                        errors.append(f"descendant metadata skipped: {error}")
+                        break
+                for thread_id in pending:
+                    updated.add(thread_id)
+                    try:
+                        self.request(
+                            "thread/metadata/update",
+                            {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                        )
+                    except Exception as error:
+                        errors.append(f"descendant {thread_id} metadata: {error}")
+        except BaseException as error:
+            interrupt = error
+        try:
+            self.request("thread/archive", {"threadId": root_id})
+        except Exception as error:
+            errors.append(f"root {root_id} archive: {error}")
+        except BaseException as error:
+            if interrupt is None:
+                interrupt = error
+        if interrupt is not None:
+            raise interrupt
+        if errors:
+            raise RuntimeError("native session cleanup failed: " + "; ".join(errors))
+
     def close(self, *, failed: bool) -> None:
         terminate_and_reap(self.process)
+
+
+def _spawn_parent(thread: dict) -> str | None:
+    """Return the spawning parent recorded on a native thread, if any."""
+    source = thread.get("source")
+    if isinstance(source, dict):
+        for key in ("subAgent", "subagent", "sub_agent"):
+            sub_agent = source.get(key)
+            if not isinstance(sub_agent, dict):
+                continue
+            for spawn_key in ("thread_spawn", "threadSpawn"):
+                spawn = sub_agent.get(spawn_key)
+                if isinstance(spawn, dict):
+                    for parent_key in ("parent_thread_id", "parentThreadId"):
+                        parent = spawn.get(parent_key)
+                        if isinstance(parent, str) and parent:
+                            return parent
+    for parent_key in ("parentThreadId", "parent_thread_id"):
+        parent = thread.get(parent_key)
+        if isinstance(parent, str) and parent:
+            return parent
+    return None
