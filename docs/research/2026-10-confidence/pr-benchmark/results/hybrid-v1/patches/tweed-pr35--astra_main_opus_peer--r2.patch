+def is_current(release: Path, tag: str, oid: str) -> bool:
+    if release.name != tag:
+        return False
+    identity = release / ".bonaparte-release-oid"
+    # Older releases did not record an object ID. Their tag is the only
+    # installed identity available without changing the installation format.
+    return not identity.exists() or identity.read_text().strip() == oid
