+        try:
+            if (
+                getattr(self, "terminal_session", False)
+                and self.root_thread_id in self._started_threads
+                and self._started_threads[self.root_thread_id] is None
+            ):
+                # Each operation is best effort; an earlier failure must not skip
+                # another descendant or the terminal root's archive attempt.
+                updated = set()
+                archive_attempted = False
+                while True:
+                    pending = set(self._owned_descendants()) - updated
+                    if not pending:
+                        if archive_attempted:
+                            break
+                        archive_attempted = True
+                        try:
+                            self.request("thread/archive", {"threadId": self.root_thread_id})
+                        except Exception as error:
+                            errors.append(error)
+                        # The archive wait can deliver additional started events.
+                        continue
+                    for identifier in sorted(pending):
+                        updated.add(identifier)
+                        try:
+                            if not self.canonical_branch:
+                                self.canonical_branch = self.resolve_child_branch()
+                            self.request("thread/metadata/update", {
+                                "threadId": identifier,
+                                "gitInfo": {"branch": self.canonical_branch},
+                            })
+                        except Exception as error:
