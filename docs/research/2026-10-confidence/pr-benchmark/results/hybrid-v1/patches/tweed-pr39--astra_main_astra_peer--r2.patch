+    def _owned_descendants(self) -> list[str]:
+        owned = {self.root_thread_id}
+        while True:
+            children = {
+                identifier for identifier, parent in self._started_threads.items()
+                if parent in owned and parent is not None
+            }
+            expanded = owned | children
+            if expanded == owned:
+                return sorted(owned - {self.root_thread_id})
+            owned = expanded
