+    def owned_descendants(self) -> set[str]:
+        root = self._root_thread_id
+        if root not in self._started_threads:
+            return set()
+        # Resolve at teardown so starts can arrive before their parents.
+        owned = {root}
+        while True:
+            descendants = {
+                identifier for identifier, parent in self._started_threads.items()
+                if parent in owned
+            } - owned
+            if not descendants:
+                return owned - {root}
+            owned.update(descendants)
