+def snapshot(release: Path) -> dict[str, tuple[int, str]]:
+    """Inventory the self-contained snapshot, excluding local runtime bytecode."""
+    result = {}
+    for directory, directories, files in os.walk(release, followlinks=False):
+        directories[:] = [name for name in directories if name != "__pycache__"]
+        for name in directories + files:
+            path = Path(directory) / name
+            relative = path.relative_to(release).as_posix()
+            mode = path.lstat().st_mode
+            if stat.S_ISLNK(mode):
+                target = path.resolve(strict=True)
+                if not target.is_relative_to(release.resolve()):
+                    raise RuntimeError(f"release symlink escapes snapshot: {relative}")
+                value = os.readlink(path)
+            elif stat.S_ISREG(mode):
+                value = hashlib.sha256(path.read_bytes()).hexdigest()
+            elif stat.S_ISDIR(mode):
+                continue
+            else:
+                raise RuntimeError(f"invalid release file: {relative}")
+            result[relative] = (stat.S_IFMT(mode) | (mode & 0o111), value)
+    return result
+
