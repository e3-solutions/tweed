+    def owned_descendants(self) -> list[str]:
+        """Resolve ancestry after observation, including child-before-parent events."""
+        root = self.root_thread_id
+        if root not in self._started_threads or self._started_threads[root] is not None:
+            return []
+        owned = {root}
+        while True:
+            children = {
+                identifier for identifier, parent in self._started_threads.items()
+                if parent in owned and identifier not in owned
+            }
+            if not children:
+                return sorted(owned - {root})
+            owned.update(children)
