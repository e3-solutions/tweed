+def may_complete_active_turn(
+    params: dict, turn: dict, active_thread: str | None, active_turn: str | None
+) -> bool:
+    """Reject turn completions owned by other threads, such as native children.
+
+    Before the coordinator turn is bound, completions are returned unchanged.
+    A completion naming the coordinator thread is returned so the caller can
+    reject a mismatched turn. A legacy completion without ``threadId`` counts
+    only when it names the active turn.
+    """
+    if active_thread is None or active_turn is None:
+        return True
+    thread_id = params.get("threadId")
+    if thread_id is None:
+        return turn.get("id") == active_turn
+    return thread_id == active_thread
+
+
 class AppServerPhaseDriver:
