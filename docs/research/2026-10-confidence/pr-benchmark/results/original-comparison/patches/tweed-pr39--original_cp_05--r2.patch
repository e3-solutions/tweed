+def thread_parent(thread: dict, params: dict) -> str | None:
+    """Return the parent thread named by a native thread/started event."""
+    for candidate in (
+        thread.get("parentThreadId"),
+        thread.get("parent_thread_id"),
+        params.get("parentThreadId"),
+    ):
+        if isinstance(candidate, str) and candidate:
+            return candidate
+    source = thread.get("source")
+    if not isinstance(source, dict):
+        return None
+    for agent_key in ("subAgent", "sub_agent", "subagent"):
+        sub_agent = source.get(agent_key)
+        if not isinstance(sub_agent, dict):
+            continue
+        for spawn_key in ("thread_spawn", "threadSpawn"):
+            spawn = sub_agent.get(spawn_key)
+            if not isinstance(spawn, dict):
+                continue
+            for name in ("parent_thread_id", "parentThreadId"):
+                parent = spawn.get(name)
+                if isinstance(parent, str) and parent:
+                    return parent
+    return None
+
