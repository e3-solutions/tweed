     def last_agent_message(self) -> str | None:
         return self._last_agent_message
 
+    def owned_descendants(self, root: str) -> list[str]:
+        """Return started threads whose started ancestry reaches the started root."""
+        started = self._started_threads
+        if root not in started:
+            return []
+        owned: list[str] = []
+        for thread_id in started:
+            seen = {thread_id}
+            parent = started[thread_id]
+            while parent in started and parent not in seen and parent != root:
+                seen.add(parent)
+                parent = started[parent]
+            if thread_id != root and parent == root:
+                owned.append(thread_id)
+        return owned
+
+    def _finish_root(self) -> list[tuple[str, BaseException]]:
+        root = self.root_thread_id
+        failures: list[tuple[str, BaseException]] = []
+        if not root or root not in self._started_threads:
+            return failures
+        branch = self.canonical_branch
+        if isinstance(branch, str) and branch:
+            for child in self.owned_descendants(root):
+                try:
+                    self.request(
+                        "thread/metadata/update",
+                        {"threadId": child, "gitInfo": {"branch": branch}},
+                    )
+                except Exception as error:
+                    failures.append((f"metadata update for {child}", error))
+        try:
+            self.request("thread/archive", {"threadId": root})
+        except Exception as error:
+            failures.append((f"archive of {root}", error))
+        return failures
+
     def close(self, *, failed: bool) -> None:
-        terminate_and_reap(self.process)
+        failures: list[tuple[str, BaseException]] = []
+        try:
+            if not failed and getattr(self, "archive_root", False):
+                failures = self._finish_root()
+        finally:
+            terminate_and_reap(self.process)
+        if failures:
+            detail = "; ".join(f"{name}: {error}" for name, error in failures)
+            raise RuntimeError(
+                f"Codex app-server session cleanup failed: {detail}"
+            ) from failures[0][1]
