+def belongs_to_turn(
+    params: dict, thread_id: str | None, turn_id: str | None, event_turn_id: object
+) -> bool:
+    """Return whether a notification belongs to the active coordinator turn.
+
+    Native child threads emit their own notifications on the same stream; only
+    events for the active coordinator thread and turn may establish its outcome.
+    Legacy notifications without ``threadId`` are matched by turn identity alone.
+    """
+    if not isinstance(thread_id, str) or not isinstance(turn_id, str):
+        return False
+    event_thread_id = params.get("threadId")
+    if event_thread_id is not None and event_thread_id != thread_id:
+        return False
+    return event_turn_id == turn_id
+
+
