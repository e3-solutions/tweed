@@ -345,5 +352,72 @@ class AppServerPhaseDriver:
     def last_agent_message(self) -> str | None:
         return self._last_agent_message
 
+    def owned_descendants(self) -> list[str]:
+        """Started threads whose observed parent chain reaches the started root."""
+        root = self._receipt_thread_id
+        if root is None or root not in self._started_threads:
+            return []
+        owned: list[str] = []
+        for identifier in self._started_threads:
+            seen = {identifier}
+            parent = self._started_threads[identifier]
+            while parent is not None and parent not in seen:
+                if parent == root:
+                    owned.append(identifier)
+                    break
+                seen.add(parent)
+                parent = self._started_threads.get(parent)
+        return owned
+
     def close(self, *, failed: bool) -> None:
-        terminate_and_reap(self.process)
+        """Finish a terminal root's native lifecycle, then always reap the server.
+
+        Every cleanup step is attempted; failures surface only after reaping.
+        """
+        errors: list[str] = []
+        root = getattr(self, "_receipt_thread_id", None)
+        started = getattr(self, "_started_threads", {})
+        try:
+            if getattr(self, "_root_terminal", False) and root in started:
+                if getattr(self, "child_branch", None):
+                    for child in self.owned_descendants():
+                        try:
+                            self.request(
+                                "thread/metadata/update",
+                                {
+                                    "threadId": child,
+                                    "gitInfo": {"branch": self.child_branch},
+                                },
+                            )
+                        except Exception as error:
+                            errors.append(f"metadata update for {child}: {error}")
+                if not getattr(self, "retain_root", False):
+                    try:
+                        self.request("thread/archive", {"threadId": root})
+                    except Exception as error:
+                        errors.append(f"archive of {root}: {error}")
+        finally:
+            terminate_and_reap(self.process)
+        if errors:
+            raise RuntimeError(
+                "Codex app-server session cleanup failed: " + "; ".join(errors)
+            )
+
+
+def thread_parent(thread: dict) -> str | None:
+    """Return the spawning parent thread identity carried by a started thread."""
+    for key in ("parentThreadId", "parent_thread_id"):
+        value = thread.get(key)
+        if isinstance(value, str) and value:
+            return value
+    source = thread.get("source")
+    if isinstance(source, dict):
+        sub_agent = source.get("subAgent", source.get("sub_agent"))
+        if isinstance(sub_agent, dict):
+            spawn = sub_agent.get("thread_spawn", sub_agent.get("threadSpawn"))
+            if isinstance(spawn, dict):
+                for key in ("parent_thread_id", "parentThreadId"):
+                    value = spawn.get(key)
+                    if isinstance(value, str) and value:
+                        return value
+    return None
