+def _require_soft_budget_wrap_up(receipt: object, phase: str, session_id: str) -> None:
+    """Reject an invalid post-steer wrap-up while retaining its native session."""
+    try:
+        validate_schema(receipt, RECEIPT_SCHEMA)
+    except (RuntimeError, ValueError) as error:
+        raise SoftBudgetContinuation(
+            f"soft-budget wrap-up violated the receipt schema: {error}", session_id
+        ) from error
+    if receipt["phase"] != phase:
+        raise SoftBudgetContinuation(
+            "soft-budget wrap-up returned the wrong phase", session_id
+        )
+    if receipt["state"] != "needs-input":
+        raise SoftBudgetContinuation(
+            "soft-budget wrap-up did not request continuation", session_id
+        )
+    question = receipt["question"]
+    if not isinstance(question, str) or (
+        question != SOFT_BUDGET_CONTINUE_QUESTION
+        and not question.startswith("Clarification required:")
+    ):
+        raise SoftBudgetContinuation(
+            "soft-budget wrap-up returned an invalid question", session_id
+        )
+    if "unverified" not in receipt["summary"].casefold():
+        raise SoftBudgetContinuation(
+            "soft-budget wrap-up omitted unverified proof obligations", session_id
+        )
+
