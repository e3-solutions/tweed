+def _ownership(driver) -> tuple[dict[str, str | None], dict[str, str]]:
+    """Started threads with their recorded parent, and spawn announcements."""
+    if not hasattr(driver, "_started_threads"):
+        driver._started_threads = {}
+        driver._spawned_by = {}
+    return driver._started_threads, driver._spawned_by
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
