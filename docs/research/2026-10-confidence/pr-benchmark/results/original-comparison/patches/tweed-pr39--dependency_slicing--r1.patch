@@ -341,6 +356,75 @@ class AppServerPhaseDriver:
                 raise RuntimeError(f"Codex app-server returned no result for {method}")
             return result
 
+    @staticmethod
+    def _thread_parent(thread: dict) -> str | None:
+        """Return the spawning thread recorded by a native thread-started event."""
+        for key in ("parentThreadId", "parent_thread_id"):
+            if isinstance(thread.get(key), str) and thread[key]:
+                return thread[key]
+        source = thread.get("source")
+        if not isinstance(source, dict):
+            return None
+        for sub_key in ("subAgent", "subagent", "sub_agent"):
+            sub = source.get(sub_key)
+            if not isinstance(sub, dict):
+                continue
+            for spawn_key in ("thread_spawn", "threadSpawn"):
+                spawn = sub.get(spawn_key)
+                if not isinstance(spawn, dict):
+                    continue
+                for key in ("parent_thread_id", "parentThreadId"):
+                    if isinstance(spawn.get(key), str) and spawn[key]:
+                        return spawn[key]
+        return None
+
+    def root_started(self, root_id: str) -> bool:
+        return root_id in _ownership(self)[0]
+
+    def owned_started_descendants(self, root_id: str) -> list[str]:
+        """Started threads whose spawning chain reaches the root, in start order."""
+        started, spawned_by = _ownership(self)
+        owned = {root_id}
+        changed = True
+        while changed:
+            changed = False
+            for thread_id, parent in started.items():
+                if thread_id in owned:
+                    continue
+                parent = parent or spawned_by.get(thread_id)
+                if parent in owned:
+                    owned.add(thread_id)
+                    changed = True
+        return [
+            thread_id
+            for thread_id in started
+            if thread_id in owned and thread_id != root_id
+        ]
+
+    def finish_terminal_session(self, root_id: str, branch: str | None) -> None:
+        """Update owned child metadata, then archive the root; raise afterwards."""
+        if not self.root_started(root_id):
+            return
+        errors: list[BaseException] = []
+        if branch:
+            for child in self.owned_started_descendants(root_id):
+                try:
+                    self.request(
+                        "thread/metadata/update",
+                        {"threadId": child, "gitInfo": {"branch": branch}},
+                    )
+                except Exception as error:
+                    errors.append(error)
+        try:
+            self.request("thread/archive", {"threadId": root_id})
+        except Exception as error:
+            errors.append(error)
+        if errors:
+            raise RuntimeError(
+                "Codex native session cleanup failed: "
+                + "; ".join(str(error) for error in errors)
+            ) from errors[0]
+
     @property
     def last_agent_message(self) -> str | None:
         return self._last_agent_message
