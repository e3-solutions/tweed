@@ -345,5 +373,49 @@ class AppServerPhaseDriver:
     def last_agent_message(self) -> str | None:
         return self._last_agent_message
 
+    def owned_descendants(self, root_id: str) -> list[str]:
+        """Started threads whose observed ancestry reaches the started root."""
+        if root_id not in self._started_threads:
+            return []
+        owned: list[str] = []
+        for thread_id in self._started_threads:
+            seen = {thread_id}
+            parent = self._started_threads[thread_id]
+            while parent is not None and parent not in seen:
+                if parent == root_id:
+                    owned.append(thread_id)
+                    break
+                seen.add(parent)
+                parent = self._started_threads.get(parent)
+        return owned
+
+    def finish_root(self, root_id: str, branch: str | None) -> None:
+        """Tear down a terminal root: tag owned children, then archive the root.
+
+        Only threads announced by thread/started are touched. A descendant
+        failure never prevents the root archive attempt; failures are raised
+        after every cleanup step was attempted.
+        """
+        if root_id not in self._started_threads:
+            return
+        failures: list[str] = []
+        if branch:
+            for child_id in self.owned_descendants(root_id):
+                try:
+                    self.request(
+                        "thread/metadata/update",
+                        {"threadId": child_id, "gitInfo": {"branch": branch}},
+                    )
+                except Exception as error:
+                    failures.append(f"descendant {child_id} metadata: {error}")
+        try:
+            self.request("thread/archive", {"threadId": root_id})
+        except Exception as error:
+            failures.append(f"root {root_id} archive: {error}")
+        if failures:
+            raise RuntimeError(
+                "Codex native session cleanup failed: " + "; ".join(failures)
+            )
+
     def close(self, *, failed: bool) -> None:
         terminate_and_reap(self.process)
