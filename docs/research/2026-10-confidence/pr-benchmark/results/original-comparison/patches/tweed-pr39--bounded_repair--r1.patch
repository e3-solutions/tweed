diff --git a/bonaparte_native.py b/bonaparte_native.py
index e9a607c..fbba697 100644
--- a/bonaparte_native.py
+++ b/bonaparte_native.py
@@ -97,6 +97,113 @@ def terminate_and_reap(process: subprocess.Popen) -> None:
                     pass
 
 
+def _native_threads(driver) -> dict:
+    """Started-thread registry kept on the driver; tolerant of test doubles."""
+    return driver.__dict__.setdefault(
+        "_native_threads", {"started": [], "parents": {}}
+    )
+
+
+def _thread_parent(thread: dict) -> str | None:
+    for key in ("parentThreadId", "parent_thread_id"):
+        if isinstance(thread.get(key), str) and thread[key]:
+            return thread[key]
+    source = thread.get("source")
+    if isinstance(source, dict):
+        sub_agent = next(
+            (
+                source[key]
+                for key in ("subAgent", "subagent", "sub_agent")
+                if isinstance(source.get(key), dict)
+            ),
+            None,
+        )
+        if sub_agent is not None:
+            spawn = sub_agent.get("thread_spawn") or sub_agent.get("threadSpawn")
+            if isinstance(spawn, dict):
+                for key in ("parent_thread_id", "parentThreadId"):
+                    if isinstance(spawn.get(key), str) and spawn[key]:
+                        return spawn[key]
+    return None
+
+
+def record_thread_started(driver, thread: dict) -> None:
+    registry = _native_threads(driver)
+    thread_id = thread["id"]
+    if thread_id not in registry["started"]:
+        registry["started"].append(thread_id)
+    parent = _thread_parent(thread)
+    if parent and parent != thread_id:
+        registry["parents"][thread_id] = parent
+
+
+def record_spawn_edges(driver, params: dict, item: dict) -> None:
+    """Remember parent links announced by a thread's own spawn items."""
+    sender = item.get("senderThreadId") or params.get("threadId")
+    if not isinstance(sender, str) or not sender:
+        return
+    children: list = []
+    item_type = item.get("type")
+    if item_type in {"collabAgentToolCall", "collabToolCall"} and item.get(
+        "tool"
+    ) in {"spawnAgent", "spawn_agent"}:
+        receivers = item.get("receiverThreadIds")
+        children = list(receivers) if isinstance(receivers, list) else [
+            item.get("receiverThreadId"),
+            item.get("newThreadId"),
+        ]
+    elif item_type == "subAgentActivity" and item.get("kind") == "started":
+        children = [item.get("agentThreadId")]
+    parents = _native_threads(driver)["parents"]
+    for child in children:
+        if isinstance(child, str) and child and child != sender:
+            parents.setdefault(child, sender)
+
+
+def owned_started_descendants(driver, root: str) -> list[str]:
+    registry = _native_threads(driver)
+    started, parents = registry["started"], registry["parents"]
+    if root not in started:
+        return []
+    owned = {root}
+    ordered: list[str] = []
+    changed = True
+    while changed:
+        changed = False
+        for thread_id in started:
+            if thread_id not in owned and parents.get(thread_id) in owned:
+                owned.add(thread_id)
+                ordered.append(thread_id)
+                changed = True
+    return ordered
+
+
+def finish_native_session(driver, root: str, branch: str | None) -> None:
+    """Tear down a finished root: child metadata first, then always archive root.
+
+    Only threads observed via thread/started and owned by the root are touched.
+    Failures are collected and raised after every cleanup attempt was made.
+    """
+    if root not in _native_threads(driver)["started"]:
+        return
+    failures = []
+    if branch:
+        for child in owned_started_descendants(driver, root):
+            try:
+                driver.request(
+                    "thread/metadata/update",
+                    {"threadId": child, "gitInfo": {"branch": branch}},
+                )
+            except Exception as error:
+                failures.append(f"child {child} metadata update failed: {error}")
+    try:
+        driver.request("thread/archive", {"threadId": root})
+    except Exception as error:
+        failures.append(f"root {root} archive failed: {error}")
+    if failures:
+        raise RuntimeError("native session cleanup failed: " + "; ".join(failures))
+
+
