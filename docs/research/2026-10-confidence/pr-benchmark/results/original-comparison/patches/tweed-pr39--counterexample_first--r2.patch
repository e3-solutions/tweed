+    def started_descendants(self, root_id: str) -> list[str]:
+        """Return started threads transitively spawned by a started root."""
+        if root_id not in self._started_threads:
+            return []
+        owned = {root_id}
+        descendants: list[str] = []
+        changed = True
+        while changed:
+            changed = False
+            for thread_id, parent in self._started_threads.items():
+                if thread_id not in owned and parent in owned:
+                    owned.add(thread_id)
+                    descendants.append(thread_id)
+                    changed = True
+        return descendants
+
+    def _finish_root(self) -> list[BaseException]:
+        root_id = self.archive_root_id
+        if not root_id or root_id not in self.__dict__.get("_started_threads", {}):
+            return []
+        self._closing = True
+        errors: list[BaseException] = []
+        branch = self.issue_branch
+        # Without a canonical issue branch (create, resumed sessions) there is no
+        # branch metadata to publish; never substitute a child-reported branch.
+        for thread_id in self.started_descendants(root_id) if branch else ():
+            try:
+                self.request(
+                    "thread/metadata/update",
+                    {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                )
+            except Exception as error:
+                errors.append(error)
+        try:
+            self.request("thread/archive", {"threadId": root_id})
+        except Exception as error:
+            errors.append(error)
+        return errors
+
     def close(self, *, failed: bool) -> None:
-        terminate_and_reap(self.process)
+        errors: list[BaseException] = []
+        try:
+            if not failed:
+                errors = self._finish_root()
+        finally:
+            terminate_and_reap(self.process)
+        if errors:
+            detail = "; ".join(str(error) for error in errors)
+            raise RuntimeError(
+                f"Codex app-server session cleanup failed: {detail}"
+            ) from errors[0]
