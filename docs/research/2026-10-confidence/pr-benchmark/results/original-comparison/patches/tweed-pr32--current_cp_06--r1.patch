                     pass
 
 
+def coordinator_turn_completion(
+    message: dict, thread_id: str, turn_id: str
+) -> dict | None:
+    """Return the turn only when this completion ends the active coordinator turn.
+
+    Native child threads emit their own ``turn/completed`` notifications on the
+    same connection; those must not finish or replace the coordinator turn.
+    Legacy notifications without ``threadId`` are accepted by turn identity.
+    """
+    if message.get("method") != "turn/completed":
+        return None
+    params = message.get("params")
+    if not isinstance(params, dict):
+        return None
+    turn = params.get("turn")
+    if not isinstance(turn, dict):
+        return None
+    notified_thread = params.get("threadId")
+    if notified_thread is None:
+        notified_thread = turn.get("threadId")
+    if notified_thread is not None and notified_thread != thread_id:
+        return None
+    if turn.get("id") != turn_id:
+        return None
+    return turn
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
