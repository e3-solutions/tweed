+def _parent_thread_id(thread: dict, params: dict) -> str | None:
+    """Return the spawning parent named by a native thread-started event."""
+    pending: list[object] = [thread, params, thread.get("source")]
+    for _ in range(5):
+        nested: list[object] = []
+        for value in pending:
+            if not isinstance(value, dict):
+                continue
+            for key in ("parentThreadId", "parent_thread_id"):
+                parent = value.get(key)
+                if isinstance(parent, str) and parent:
+                    return parent
+            if value is not thread and value is not params:
+                nested.extend(value.values())
+        pending = nested
+    return None
+
+
+class ThreadOwnership:
+    """Native threads observed as started, with their observed spawning parents."""
+
+    def __init__(self) -> None:
+        self._started: list[str] = []
+        self._parents: dict[str, str] = {}
+
+    def started(self, thread_id: object) -> bool:
+        return isinstance(thread_id, str) and thread_id in self._started
+
+    def record_started(self, thread: dict, params: dict) -> None:
+        thread_id = thread.get("id")
+        if not isinstance(thread_id, str) or not thread_id:
+            return
+        if thread_id not in self._started:
+            self._started.append(thread_id)
+        parent = _parent_thread_id(thread, params)
+        if parent and parent != thread_id:
+            self._parents.setdefault(thread_id, parent)
+
+    def record_spawn(self, parent: object, item: dict) -> None:
+        if not isinstance(parent, str) or not parent:
+            return
+        children: list[object] = []
+        item_type = item.get("type")
+        if item_type in {"collabAgentToolCall", "collabToolCall"} and item.get(
+            "tool"
+        ) in {"spawnAgent", "spawn_agent"}:
+            receivers = item.get("receiverThreadIds")
+            if isinstance(receivers, list):
+                children.extend(receivers)
+            children.extend((item.get("receiverThreadId"), item.get("newThreadId")))
+        elif item_type == "subAgentActivity" and item.get("kind") == "started":
+            children.append(item.get("agentThreadId"))
+        for child in children:
+            if isinstance(child, str) and child and child != parent:
+                self._parents.setdefault(child, parent)
+
+    def started_descendants(self, root: str) -> list[str]:
+        """Started threads whose observed spawn chain reaches the started root."""
+        if not self.started(root):
+            return []
+        owned = []
+        for thread_id in self._started:
+            if thread_id == root:
+                continue
+            seen = {thread_id}
+            parent = self._parents.get(thread_id)
+            while parent is not None and parent != root and parent not in seen:
+                seen.add(parent)
+                parent = self._parents.get(parent)
+            if parent == root:
+                owned.append(thread_id)
+        return owned
+
