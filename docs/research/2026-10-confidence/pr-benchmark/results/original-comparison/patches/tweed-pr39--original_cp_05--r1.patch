+    def _finish_native_session(self) -> list[BaseException]:
+        """Attempt every terminal-session update; return failures for the caller."""
+        root = getattr(self, "_receipt_thread_id", None)
+        ownership = getattr(self, "ownership", None)
+        if (
+            not getattr(self, "root_terminal", False)
+            or ownership is None
+            or not ownership.started(root)
+        ):
+            return []
+        failures: list[BaseException] = []
+        if getattr(self, "canonical_branch", None):
+            for thread_id in ownership.started_descendants(root):
+                try:
+                    self.request(
+                        "thread/metadata/update",
+                        {
+                            "threadId": thread_id,
+                            "gitInfo": {"branch": self.canonical_branch},
+                        },
+                    )
+                except Exception as error:
+                    failures.append(error)
+        try:
+            self.request("thread/archive", {"threadId": root})
+        except Exception as error:
+            failures.append(error)
+        return failures
