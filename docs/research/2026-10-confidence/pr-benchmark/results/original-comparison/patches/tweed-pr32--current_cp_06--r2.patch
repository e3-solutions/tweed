+        def coordinator_completion(message: dict, completed_turn: dict | None) -> bool:
+            """Accept only the active coordinator turn's completion.
+
+            Native child threads complete their own turns on the same stream;
+            those must never finish or replace the coordinator turn. Legacy
+            notifications without a threadId are accepted by turn ID alone.
+            """
+            if completed_turn is None:
+                return False
+            params = message.get("params")
+            thread_id = params.get("threadId") if isinstance(params, dict) else None
+            if thread_id is None:
+                thread_id = completed_turn.get("threadId")
+            if thread_id is not None and thread_id != session_id:
+                return False
+            if completed_turn.get("id") == turn_id:
+                return terminal is None
+            if thread_id == session_id:
+                raise RuntimeError("Codex app-server completed the wrong turn")
+            return False
+
