+def active_turn_completion(
+    message: dict, thread_id: str | None, turn_id: str | None
+) -> dict | None:
+    """Return the completed turn only when it belongs to the active coordinator turn.
+
+    Native child threads emit their own ``turn/completed`` notifications on the
+    same connection; those must never finish or replace the coordinator turn.
+    Legacy notifications without a ``threadId`` are accepted only by turn ID.
+    """
+    if message.get("method") != "turn/completed" or not turn_id:
+        return None
+    params = message.get("params")
+    if not isinstance(params, dict):
+        return None
+    turn = params.get("turn")
+    if not isinstance(turn, dict) or turn.get("id") != turn_id:
+        return None
+    for owner in (params.get("threadId"), turn.get("threadId")):
+        if owner is not None and owner != thread_id:
+            return None
+    return turn
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
