+class SoftBudgetInterruption(RuntimeError):
+    """A steered coordinator turn stopped or broke a wrap-up guard.
+
+    The native session exists and remains resumable, so callers persist a
+    continuation checkpoint instead of discarding the session.
+    """
+
+    def __init__(self, reason: str, session_id: str, receipt: dict | None = None):
+        super().__init__(
+            f"Soft phase budget interrupted the coordinator: {reason}. "
+            "Unfinished proof obligations are unverified."
+        )
+        self.session_id = session_id
+        self.receipt = receipt if isinstance(receipt, dict) else None
+
