index e9a607c..28e5a3e 100644
--- a/bonaparte_native.py
+++ b/bonaparte_native.py
@@ -97,6 +97,89 @@ def terminate_and_reap(process: subprocess.Popen) -> None:
                     pass
 
 
+def _parent_thread_id(value: object) -> str | None:
+    """Find the spawning parent recorded in a native thread payload."""
+    if isinstance(value, dict):
+        for key in ("parentThreadId", "parent_thread_id"):
+            parent = value.get(key)
+            if isinstance(parent, str) and parent:
+                return parent
+        for nested in value.values():
+            parent = _parent_thread_id(nested)
+            if parent:
+                return parent
+    return None
+
+
+class ThreadOwnership:
+    """Started native threads and the parent links that make them descendants."""
+
+    def __init__(self) -> None:
+        self.started: dict[str, None] = {}
+        self.parents: dict[str, str] = {}
+
+    def thread_started(self, params: dict) -> None:
+        thread = params.get("thread")
+        if not isinstance(thread, dict):
+            return
+        thread_id = thread.get("id")
+        if not isinstance(thread_id, str) or not thread_id:
+            return
+        self.started.setdefault(thread_id, None)
+        parent = _parent_thread_id(thread)
+        if parent and parent != thread_id:
+            self.parents.setdefault(thread_id, parent)
+
+    def spawned(self, parent: object, child: str) -> None:
+        if isinstance(parent, str) and parent and parent != child:
+            self.parents.setdefault(child, parent)
+
+    def owned_descendants(self, root: str) -> list[str]:
+        """Started threads whose parent chain reaches a started root."""
+        if root not in self.started:
+            return []
+        owned = {root}
+        changed = True
+        while changed:
+            changed = False
+            for thread_id in self.started:
+                if thread_id not in owned and self.parents.get(thread_id) in owned:
+                    owned.add(thread_id)
+                    changed = True
+        return [thread_id for thread_id in self.started if thread_id in owned - {root}]
+
+
+def thread_ownership(driver: object) -> ThreadOwnership:
+    ownership = getattr(driver, "_thread_ownership", None)
+    if ownership is None:
+        ownership = ThreadOwnership()
+        driver._thread_ownership = ownership
+    return ownership
+
+
+def finish_terminal_session(driver, root: str, branch: str | None) -> None:
+    """Label owned started children, archive the started root, then surface failures."""
+    ownership = thread_ownership(driver)
+    if root not in ownership.started:
+        return
+    failures = []
+    if branch:
+        for child in ownership.owned_descendants(root):
+            try:
+                driver.request(
+                    "thread/metadata/update",
+                    {"threadId": child, "gitInfo": {"branch": branch}},
+                )
+            except Exception as error:
+                failures.append(f"metadata update for {child} failed: {error}")
+    try:
+        driver.request("thread/archive", {"threadId": root})
+    except Exception as error:
+        failures.append(f"archive of {root} failed: {error}")
+    if failures:
+        raise RuntimeError("native session teardown failed: " + "; ".join(failures))
+
+
