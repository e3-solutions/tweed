+def status(home: Path) -> int:
+    """Report installed and latest stable releases without changing state."""
+
+    installed = current_release(home).name
+    print(f"installed: {installed}", flush=True)
+    try:
+        tag, _ = latest_tag()
+    except Exception as error:
+        print("latest: unavailable\ncurrent: unknown", flush=True)
+        print(f"bonaparte: cannot resolve latest release: {error}", file=sys.stderr)
+        return 1
+    installed_version = tag_version(installed)
+    current = installed_version is not None and installed_version >= tag_version(tag)
+    print(f"latest: {tag}\ncurrent: {'yes' if current else 'no'}")
+    return 0
+
