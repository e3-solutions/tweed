@@ -347,3 +349,104 @@ class AppServerPhaseDriver:
 
     def close(self, *, failed: bool) -> None:
         terminate_and_reap(self.process)
+
+
+def _lineage(driver) -> dict:
+    """Per-driver thread ownership state, created lazily for borrowed observers."""
+    state = getattr(driver, "_native_lineage", None)
+    if state is None:
+        # Thread ids from actual thread/started notifications, plus child -> parent.
+        state = {"started": [], "parents": {}}
+        driver._native_lineage = state
+    return state
+
+
+def _parent_thread_id(thread: dict) -> str | None:
+    """Find the spawning parent recorded in a native thread or its source."""
+    pending: list[object] = [thread]
+    while pending:
+        value = pending.pop()
+        if isinstance(value, dict):
+            for key in ("parentThreadId", "parent_thread_id"):
+                if isinstance(value.get(key), str) and value[key]:
+                    return value[key]
+            pending.extend(
+                child for key, child in value.items() if value is not thread or key == "source"
+            )
+        elif isinstance(value, list):
+            pending.extend(value)
+    return None
+
+
+def record_started_thread(driver, thread: dict) -> None:
+    state = _lineage(driver)
+    thread_id = thread["id"]
+    if thread_id not in state["started"]:
+        state["started"].append(thread_id)
+    parent = _parent_thread_id(thread)
+    if parent and parent != thread_id:
+        state["parents"].setdefault(thread_id, parent)
+
+
+def record_spawned_threads(driver, sender: object, item: dict) -> None:
+    if not isinstance(sender, str) or not sender:
+        return
+    item_type = item.get("type")
+    spawned: list[object] = []
+    if item_type in {"collabAgentToolCall", "collabToolCall"} and item.get("tool") in {
+        "spawnAgent",
+        "spawn_agent",
+    }:
+        receivers = item.get("receiverThreadIds")
+        spawned.extend(receivers if isinstance(receivers, list) else [])
+        spawned.extend((item.get("receiverThreadId"), item.get("newThreadId")))
+    elif item_type == "subAgentActivity" and item.get("kind") == "started":
+        spawned.append(item.get("agentThreadId"))
+    parents = _lineage(driver)["parents"]
+    for child in spawned:
+        if isinstance(child, str) and child and child != sender:
+            parents.setdefault(child, sender)
+
+
+def started_descendants(driver, root_id: str) -> list[str]:
+    """Started threads whose parent chain reaches the started root."""
+    state = _lineage(driver)
+    if root_id not in state["started"]:
+        return []
+    owned: list[str] = []
+    for thread_id in state["started"]:
+        seen = {thread_id}
+        parent = state["parents"].get(thread_id)
+        while parent is not None and parent not in seen:
+            if parent == root_id:
+                owned.append(thread_id)
+                break
+            seen.add(parent)
+            parent = state["parents"].get(parent)
+    return owned
+
+
+def finish_root(driver, root_id: str, *, archive: bool, branch: str | None) -> list[str]:
+    """Attempt every terminal step for a started root and return its failures.
+
+    Owned started descendants receive the canonical issue branch metadata; the
+    root archive is still attempted when any descendant update fails.
+    """
+    failures: list[str] = []
+    if root_id not in _lineage(driver)["started"]:
+        return failures
+    if branch:
+        for child_id in started_descendants(driver, root_id):
+            try:
+                driver.request(
+                    "thread/metadata/update",
+                    {"threadId": child_id, "gitInfo": {"branch": branch}},
+                )
+            except Exception as error:
+                failures.append(f"metadata update for {child_id} failed: {error}")
+    if archive:
+        try:
+            driver.request("thread/archive", {"threadId": root_id})
+        except Exception as error:
+            failures.append(f"archive of {root_id} failed: {error}")
+    return failures
