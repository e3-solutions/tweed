+def is_active_turn_completion(
+    message: dict, thread_id: str | None, turn_id: str | None
+) -> bool:
+    """Whether a turn/completed notification belongs to the coordinator turn.
+
+    Native child threads complete their own turns on the same stream; only the
+    active coordinator thread/turn may establish the phase outcome. Legacy
+    notifications without threadId are matched by turn ID alone.
+    """
+    params = message.get("params")
+    if message.get("method") != "turn/completed" or not isinstance(params, dict):
+        return False
+    turn = params.get("turn")
+    if not isinstance(turn, dict) or turn_id is None:
+        return False
+    if params.get("threadId") is not None and params["threadId"] != thread_id:
+        return False
+    return turn.get("id") == turn_id
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
