+def status(home: Path) -> int:
+    """Report installed and latest stable releases without changing any state."""
+
+    installed = current_release(home).name
+    try:
+        tag, _ = latest_tag()
+    except Exception as error:
+        print(f"installed: {installed}")
+        print("latest: unavailable")
+        print("current: unknown")
+        print(f"bonaparte: cannot resolve latest release: {error}", file=sys.stderr)
+        return 1
+    installed_version = tag_version(installed)
+    up_to_date = installed_version is not None and installed_version >= tag_version(tag)
+    print(f"installed: {installed}")
+    print(f"latest: {tag}")
+    print(f"current: {'yes' if up_to_date else 'no'}")
+    return 0
+
+
 def main() -> int:
     home = bonaparte_home()
     try:
+        if sys.argv[1:] == ["status"]:
+            return status(home)
