+def status(home: Path) -> int:
+    """Report installed and latest stable release without changing any state."""
+
+    installed = current_release(home).name
+    print(f"installed: {installed}")
+    try:
+        latest, _ = latest_tag()
+    except Exception as error:
+        print("latest: unavailable")
+        print("current: unknown")
+        print(f"bonaparte: cannot resolve latest release: {error}", file=sys.stderr)
+        return 1
+    installed_version = tag_version(installed)
+    is_current = bool(installed_version and installed_version >= tag_version(latest))
+    print(f"latest: {latest}")
+    print(f"current: {'yes' if is_current else 'no'}")
+    return 0
+
