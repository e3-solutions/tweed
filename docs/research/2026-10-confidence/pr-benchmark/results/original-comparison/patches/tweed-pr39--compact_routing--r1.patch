diff --git a/bonaparte_native.py b/bonaparte_native.py
index e9a607c..e9b21b4 100644
--- a/bonaparte_native.py
+++ b/bonaparte_native.py
@@ -97,6 +97,40 @@ def terminate_and_reap(process: subprocess.Popen) -> None:
                     pass
 
 
+def _parent_thread_id(thread: dict) -> str | None:
+    """Return the spawning parent recorded on a native thread, if any."""
+    for key in ("parentThreadId", "parent_thread_id"):
+        if isinstance(thread.get(key), str) and thread[key]:
+            return thread[key]
+    source = thread.get("source")
+    if not isinstance(source, dict):
+        return None
+    sub_agent = next(
+        (
+            source[key]
+            for key in ("subAgent", "sub_agent", "subagent")
+            if isinstance(source.get(key), dict)
+        ),
+        None,
+    )
+    if sub_agent is None:
+        return None
+    spawn = next(
+        (
+            sub_agent[key]
+            for key in ("thread_spawn", "threadSpawn")
+            if isinstance(sub_agent.get(key), dict)
+        ),
+        None,
+    )
+    if spawn is None:
+        return None
+    for key in ("parent_thread_id", "parentThreadId"):
+        if isinstance(spawn.get(key), str) and spawn[key]:
+            return spawn[key]
+    return None
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
@@ -274,6 +308,8 @@ class AppServerPhaseDriver:
         if method == "thread/started":
             thread = params.get("thread")
             if isinstance(thread, dict) and isinstance(thread.get("id"), str):
+                started = self.__dict__.setdefault("_started_threads", {})
+                started.setdefault(thread["id"], _parent_thread_id(thread))
                 self.observer.feed(
                     json.dumps({"type": "thread.started", "thread_id": thread["id"]})
                 )
@@ -345,5 +381,51 @@ class AppServerPhaseDriver:
     def last_agent_message(self) -> str | None:
         return self._last_agent_message
 
+    def owned_descendants(self, root_thread_id: str) -> list[str]:
+        """Started threads whose observed parent chain reaches the root."""
+        started = self.__dict__.get("_started_threads", {})
+        owned = {root_thread_id}
+        descendants: list[str] = []
+        changed = True
+        while changed:
+            changed = False
+            for thread_id, parent in started.items():
+                if thread_id not in owned and parent in owned:
+                    owned.add(thread_id)
+                    descendants.append(thread_id)
+                    changed = True
+        return descendants
+
+    def finish_root(
+        self,
+        root_thread_id: str,
+        *,
+        branch: str | None,
+        archive_root: bool,
+    ) -> None:
+        """Attempt every owned-thread teardown step, then surface the first failure."""
+        errors: list[BaseException] = []
+        if branch:
+            for thread_id in self.owned_descendants(root_thread_id):
+                try:
+                    self.request(
+                        "thread/metadata/update",
+                        {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                    )
+                except BaseException as error:
+                    errors.append(error)
+        if archive_root and root_thread_id in self.__dict__.get("_started_threads", {}):
+            try:
+                self.request("thread/archive", {"threadId": root_thread_id})
+            except BaseException as error:
+                errors.append(error)
+        for error in errors:
+            if not isinstance(error, Exception):
+                raise error
+        if errors:
+            raise RuntimeError(
+                f"Codex thread cleanup failed: {errors[0]}"
+            ) from errors[0]
+
     def close(self, *, failed: bool) -> None:
         terminate_and_reap(self.process)
