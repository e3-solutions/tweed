+    @staticmethod
+    def _parent_thread_id(params: dict, thread: dict) -> str | None:
+        for candidate in (
+            thread.get("parentThreadId"),
+            thread.get("parent_thread_id"),
+            params.get("parentThreadId"),
+        ):
+            if isinstance(candidate, str) and candidate:
+                return candidate
+        source = thread.get("source")
+        if isinstance(source, dict):
+            sub_agent = source.get("subAgent", source.get("sub_agent"))
+            if isinstance(sub_agent, dict):
+                spawn = sub_agent.get("thread_spawn", sub_agent.get("threadSpawn"))
+                if isinstance(spawn, dict):
+                    for key in ("parent_thread_id", "parentThreadId"):
+                        candidate = spawn.get(key)
+                        if isinstance(candidate, str) and candidate:
+                            return candidate
+        return None
+
+    def _track_started(self, params: dict) -> bool:
+        thread = params.get("thread")
+        if not isinstance(thread, dict):
+            return False
+        thread_id = thread.get("id")
+        if not isinstance(thread_id, str) or not thread_id:
+            return False
+        parent = self._parent_thread_id(params, thread)
+        # The first start event fixes ownership; a later event cannot re-parent.
+        self._started_threads.setdefault(thread_id, parent)
+        return True
+
+    def owned_descendants(self) -> list[str]:
+        """Started threads transitively spawned by the started root, in start order."""
+        root = self._receipt_thread_id
+        if root is None or root not in self._started_threads:
+            return []
+        owned = {root}
+        changed = True
+        while changed:
+            changed = False
+            for thread_id, parent in self._started_threads.items():
+                if thread_id not in owned and parent in owned:
+                    owned.add(thread_id)
+                    changed = True
+        return [
+            thread_id
+            for thread_id in self._started_threads
+            if thread_id in owned and thread_id != root
+        ]
+
+    def _teardown_request(self, method: str, params: dict) -> None:
+        request_id = self.send(method, params)
+        deadline = time.monotonic() + TEARDOWN_REQUEST_TIMEOUT_SECONDS
+        while True:
+            try:
+                message = self.next_message(max(0.0, deadline - time.monotonic()))
+            except TimeoutError as error:
+                raise RuntimeError(
+                    f"Codex app-server timed out during {method}"
+                ) from error
+            if "method" in message:
+                notification = message.get("params")
+                if message.get("method") == "thread/started" and isinstance(
+                    notification, dict
+                ):
+                    self._track_started(notification)
+                continue
+            response_id = message.get("id")
+            if isinstance(response_id, int) and response_id < request_id:
+                continue  # late reply to an earlier teardown request that timed out
+            if response_id != request_id:
+                raise RuntimeError("Codex app-server response correlation failed")
+            if "error" in message:
+                raise RuntimeError(
+                    f"Codex app-server rejected {method}: {message['error']}"
+                )
+            return
+
+    def _finish_session(self) -> list[str]:
+        """Attempt every teardown step for a finished, started root; return failures."""
+        root = getattr(self, "_receipt_thread_id", None)
+        started = getattr(self, "_started_threads", {})
+        if not getattr(self, "_root_finished", False) or root not in started:
+            return []
+        failures: list[str] = []
+        if getattr(self, "canonical_branch", None):
+            for child in self.owned_descendants():
