+def regular_release_file(release: Path, name: str) -> bool:
+    """A required path must be a regular file reached without symlinks."""
+
+    path = release
+    for part in Path(name).parts:
+        path = path / part
+        if path.is_symlink():
+            return False
+    return path.is_file()
