+    def owned_descendants(self, root: str) -> list[str]:
+        """Started threads whose observed spawn chain reaches ``root``."""
+        started = getattr(self, "_started_threads", {})
+        owned: list[str] = []
+        changed = True
+        while changed:
+            changed = False
+            for thread_id, parent in started.items():
+                if thread_id == root or thread_id in owned:
+                    continue
+                if parent == root or parent in owned:
+                    owned.append(thread_id)
+                    changed = True
+        return owned
