+    def close(
+        self,
+        *,
+        failed: bool,
+        terminal_root: str | None = None,
+        branch: str | None = None,
+    ) -> None:
+        """Tear down a finished root session, then always reap the process.
+
+        Only threads observed through ``thread/started`` are touched: started
+        descendants owned by ``terminal_root`` receive the canonical issue
+        branch, and the root is archived when its own start was observed.
+        Every cleanup step is attempted before the first failure is raised.
+        """
+        errors: list[Exception] = []
+        try:
+            if terminal_root is not None and not failed:
+                if branch:
+                    for thread_id in self.owned_descendants(terminal_root):
+                        try:
+                            self.request(
+                                "thread/metadata/update",
+                                {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                            )
+                        except Exception as error:
+                            errors.append(error)
+                if terminal_root in getattr(self, "_started_threads", {}):
+                    try:
+                        self.request("thread/archive", {"threadId": terminal_root})
+                    except Exception as error:
+                        errors.append(error)
+        finally:
+            terminate_and_reap(self.process)
+        if errors:
+            raise RuntimeError(
+                f"Codex app-server session cleanup failed: {errors[0]}"
+            ) from errors[0]
