+    @staticmethod
+    def _parent_thread_id(thread: dict) -> str | None:
+        """Return the spawning thread recorded in a native thread payload."""
+        candidates = [thread.get("parentThreadId"), thread.get("parent_thread_id")]
+        source = thread.get("source")
+        if isinstance(source, dict):
+            subagent = source.get("subAgent") or source.get("sub_agent")
+            if isinstance(subagent, dict):
+                spawn = subagent.get("thread_spawn") or subagent.get("threadSpawn")
+                if isinstance(spawn, dict):
+                    candidates += [
+                        spawn.get("parent_thread_id"),
+                        spawn.get("parentThreadId"),
+                    ]
+        for candidate in candidates:
+            if isinstance(candidate, str) and candidate:
+                return candidate
+        return None
