+class SoftBudgetContinuation(RuntimeError):
+    """A soft-budget wrap-up failed after a native session already exists."""
+
+    def __init__(self, message: str, session_id: str, receipt: dict | None = None):
+        super().__init__(message)
+        self.session_id = session_id
+        self.receipt = receipt
+
+
+def _soft_budget_question(receipt: dict | None) -> str:
+    question = (receipt or {}).get("question")
+    if isinstance(question, str) and question.startswith("Clarification required:"):
+        return question
+    return SOFT_BUDGET_CONTINUE_QUESTION
+
+
+def _soft_budget_summary(error: SoftBudgetContinuation) -> str:
+    detail = str(error).replace("\n", " ")[:300]
+    return (
+        f"Soft phase budget wrap-up failed: {detail}. Every unfinished proof "
+        "obligation is unverified; resume this token to continue the same session."
+    )
+
+
