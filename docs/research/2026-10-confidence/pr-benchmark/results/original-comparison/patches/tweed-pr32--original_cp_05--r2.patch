+def active_turn_completion(
+    params: dict, turn: dict, active_thread: str | None, active_turn: str | None
+) -> dict | None:
+    """Return ``turn`` only when it is the active coordinator turn's outcome.
+
+    Native child threads complete their own turns on the same connection;
+    those completions must never finish or replace the coordinator turn.
+    Legacy notifications without a threadId are accepted only for the active
+    turn ID. A different turn on the coordinator thread itself fails closed.
+    """
+    if active_turn is None:
+        return None
+    thread_id = params.get("threadId")
+    if thread_id is None:
+        return turn if turn.get("id") == active_turn else None
+    if thread_id != active_thread:
+        return None
+    if turn.get("id") != active_turn:
+        raise RuntimeError("Codex app-server completed the wrong turn")
+    return turn
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
