diff --git a/bonaparte_native.py b/bonaparte_native.py
index e9a607c..ebdf635 100644
--- a/bonaparte_native.py
+++ b/bonaparte_native.py
@@ -97,6 +97,63 @@ def terminate_and_reap(process: subprocess.Popen) -> None:
                     pass
 
 
+def _parent_thread_id(value: object) -> str | None:
+    """Return the spawning parent thread id carried by a thread/started payload."""
+    stack = [value]
+    while stack:
+        current = stack.pop()
+        if isinstance(current, dict):
+            for key in ("parentThreadId", "parent_thread_id"):
+                if isinstance(current.get(key), str) and current[key]:
+                    return current[key]
+            stack.extend(
+                child for key, child in current.items() if key not in {"turns", "id"}
+            )
+    return None
+
+
+def finish_terminal_session(
+    driver: object, root_thread_id: str, branch: str | None
+) -> None:
+    """Tear down a finished root: tag started owned descendants, then archive the root.
+
+    Only threads announced by thread/started are touched. Every step is attempted;
+    the first failure is raised after the root archive attempt.
+    """
+    started = getattr(driver, "_started_threads", None) or {}
+    if root_thread_id not in started:
+        return
+    owned = {root_thread_id}
+    descendants: list[str] = []
+    changed = True
+    while changed:
+        changed = False
+        for thread_id, parent in started.items():
+            if thread_id not in owned and parent in owned:
+                owned.add(thread_id)
+                descendants.append(thread_id)
+                changed = True
+    failures: list[BaseException] = []
+    if branch:
+        for thread_id in descendants:
+            try:
+                driver.request(
+                    "thread/metadata/update",
+                    {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                )
+            except Exception as error:
+                failures.append(error)
+    try:
+        driver.request("thread/archive", {"threadId": root_thread_id})
+    except Exception as error:
+        failures.append(error)
+    if failures:
+        raise RuntimeError(
+            "native session teardown failed: "
+            + "; ".join(str(error) for error in failures)
+        ) from failures[0]
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
