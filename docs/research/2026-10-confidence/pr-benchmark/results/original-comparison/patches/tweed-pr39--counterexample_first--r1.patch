index e9a607c..44c0f66 100644
--- a/bonaparte_native.py
+++ b/bonaparte_native.py
@@ -97,6 +97,73 @@ def terminate_and_reap(process: subprocess.Popen) -> None:
                     pass
 
 
+def _lifecycle(driver) -> dict:
+    """Return thread lifecycle facts observed from this driver's notifications."""
+    return driver.__dict__.setdefault(
+        "_thread_lifecycle", {"started": [], "parents": {}, "spawned": {}}
+    )
+
+
+def _declared_parent(value, depth: int = 0) -> str | None:
+    if depth > 4 or not isinstance(value, dict):
+        return None
+    for key in ("parent_thread_id", "parentThreadId"):
+        if isinstance(value.get(key), str) and value[key]:
+            return value[key]
+    for nested in value.values():
+        parent = _declared_parent(nested, depth + 1)
+        if parent:
+            return parent
+    return None
+
+
+def owned_started_descendants(driver, root_id: str) -> list[str]:
+    """Started threads whose spawn chain leads back to the root, in start order."""
+    state = _lifecycle(driver)
+    owned = {root_id}
+    descendants: list[str] = []
+    changed = True
+    while changed:
+        changed = False
+        for thread_id in state["started"]:
+            if thread_id in owned:
+                continue
+            parent = state["parents"].get(thread_id)
+            parents = {parent} if parent else state["spawned"].get(thread_id, set())
+            if parents & owned:
+                owned.add(thread_id)
+                descendants.append(thread_id)
+                changed = True
+    order = {thread_id: index for index, thread_id in enumerate(state["started"])}
+    return sorted(descendants, key=order.__getitem__)
+
+
+def finish_root(driver, root_id: str, *, branch: str | None, archive: bool) -> None:
+    """Update started owned descendants, then archive the started root.
+
+    Every cleanup step is attempted; failures are raised together afterward.
+    """
+    errors: list[BaseException] = []
+    if branch:
+        for thread_id in owned_started_descendants(driver, root_id):
+            try:
+                driver.request(
+                    "thread/metadata/update",
+                    {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                )
+            except Exception as error:
+                errors.append(error)
+    if archive and root_id in _lifecycle(driver)["started"]:
+        try:
+            driver.request("thread/archive", {"threadId": root_id})
+        except Exception as error:
+            errors.append(error)
+    if errors:
+        raise RuntimeError(
+            "native thread cleanup failed: " + "; ".join(map(str, errors))
+        ) from errors[0]
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
