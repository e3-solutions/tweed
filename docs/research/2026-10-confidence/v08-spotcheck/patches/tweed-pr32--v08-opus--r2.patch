+def coordinator_completion(
+    message: dict, completed_turn: dict | None, thread_id: str, turn_id: str
+) -> bool:
+    """Return whether a turn completion belongs to the active coordinator turn.
+
+    Native child threads emit their own turn completions on the same stream;
+    those must never finish or replace the coordinator outcome. Legacy
+    notifications lacking a threadId are accepted only for the active turn ID.
+    """
+    if completed_turn is None or completed_turn.get("id") != turn_id:
+        return False
+    params = message.get("params")
+    for container in (params, completed_turn):
+        owner = container.get("threadId") if isinstance(container, dict) else None
+        if owner is not None and owner != thread_id:
+            return False
+    return True
+
