+def _is_coordinator_completion(
+    message: dict, completed_turn: dict | None, session_id: str, turn_id: str
+) -> bool:
+    """Return whether a turn completion establishes the active coordinator outcome.
+
+    Native child threads share the app-server stream; their completions must
+    never finish or replace the coordinator turn. Legacy notifications without
+    a thread identity are accepted only when they name the active turn.
+    """
+    if completed_turn is None:
+        return False
+    params = message.get("params")
+    thread_id = params.get("threadId") if isinstance(params, dict) else None
+    if thread_id is None:
+        thread_id = completed_turn.get("threadId")
+    if thread_id is None:
+        return completed_turn.get("id") == turn_id
+    if thread_id != session_id:
+        return False
+    if completed_turn.get("id") != turn_id:
+        raise RuntimeError("Codex app-server completed the wrong turn")
+    return True
+
+
