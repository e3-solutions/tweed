+def coordinator_terminal(
+    message: dict, completed_turn: dict | None, session_id: str, turn_id: str
+) -> dict | None:
+    """Return the completion only when it belongs to the active coordinator turn.
+
+    Native child threads emit their own turn/completed notifications; those must
+    not finish or replace the coordinator turn. A legacy notification without a
+    threadId is attributed to the coordinator only when it names the active turn.
+    """
+    if completed_turn is None:
+        return None
+    params = message.get("params")
+    thread_id = params.get("threadId") if isinstance(params, dict) else None
+    if thread_id is None:
+        return completed_turn if completed_turn.get("id") == turn_id else None
+    if thread_id != session_id:
+        return None
+    if completed_turn.get("id") != turn_id:
+        raise RuntimeError("Codex app-server completed the wrong turn")
+    return completed_turn
+
+
