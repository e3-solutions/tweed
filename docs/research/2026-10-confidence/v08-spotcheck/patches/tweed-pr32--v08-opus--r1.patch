+def owns_coordinator_event(driver: object, thread_id: object, turn_id: object) -> bool:
+    """Return whether an event may establish the active coordinator outcome.
+
+    Events from another thread (such as a native child agent) never qualify.
+    Legacy events lacking threadId qualify only with the active turn ID.
+    Events on the coordinator thread qualify so the caller can reject a
+    mismatched coordinator turn explicitly.
+    """
+    active_thread = getattr(driver, "_receipt_thread_id", None)
+    active_turn = getattr(driver, "_receipt_turn_id", None)
+    if active_thread is None or active_turn is None:
+        return False
+    if thread_id is None:
+        return turn_id == active_turn
+    return thread_id == active_thread
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
