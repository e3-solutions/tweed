@@ -346,4 +365,46 @@ class AppServerPhaseDriver:
         return self._last_agent_message
 
     def close(self, *, failed: bool) -> None:
-        terminate_and_reap(self.process)
+        errors = []
+        try:
+            root = getattr(self, "_root_thread_id", None)
+            started = getattr(self, "_started_threads", {})
+            if (
+                not failed
+                and getattr(self, "archive_on_close", True)
+                and root in started
+            ):
+                # Only a chain of actual start events establishes ownership.
+                owned = {root}
+                while True:
+                    children = {
+                        identifier for identifier, parent in started.items()
+                        if parent in owned and identifier not in owned
+                    }
+                    if not children:
+                        break
+                    owned.update(children)
+                branch = getattr(self, "canonical_branch", None)
+                for identifier in sorted(owned - {root}):
+                    if not branch:
+                        continue
+                    try:
+                        self.request(
+                            "thread/metadata/update",
+                            {"threadId": identifier, "gitInfo": {"branch": branch}},
+                        )
+                    except Exception as error:
+                        errors.append(error)
+                try:
+                    self.request("thread/archive", {"threadId": root})
+                except Exception as error:
+                    errors.append(error)
+        finally:
+            try:
+                terminate_and_reap(self.process)
+            except Exception as error:
+                errors.append(error)
+        if errors:
+            if len(errors) == 1:
+                raise errors[0]
+            raise ExceptionGroup("native session cleanup failed", errors)
