+def is_active_turn_completion(
+    message: dict, turn: dict, thread_id: str, turn_id: str
+) -> bool:
+    """Return whether a turn completion belongs to the active coordinator turn.
+
+    Native child threads emit their own turn completions on the same stream;
+    those must never finish or replace the coordinator turn. Legacy
+    notifications without a thread identity are accepted only by turn ID.
+    """
+    params = message.get("params")
+    notified_thread = params.get("threadId") if isinstance(params, dict) else None
+    if notified_thread is None:
+        notified_thread = turn.get("threadId")
+    if notified_thread is not None and notified_thread != thread_id:
+        return False
+    return turn.get("id") == turn_id
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
