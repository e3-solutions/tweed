@@ -97,6 +97,23 @@ def terminate_and_reap(process: subprocess.Popen) -> None:
                     pass
 
 
+def coordinator_turn_completion(
+    message: dict, turn: dict, thread_id: str, turn_id: str
+) -> dict | None:
+    """Return a completed turn only when it belongs to the active coordinator turn.
+
+    A completion attributed to another thread never establishes the outcome.
+    A completion without threadId (legacy) is accepted only for the active turn ID.
+    """
+    params = message.get("params")
+    event_thread = params.get("threadId") if isinstance(params, dict) else None
+    if event_thread is not None and event_thread != thread_id:
+        return None
+    if turn.get("id") != turn_id:
+        raise RuntimeError("Codex app-server completed the wrong turn")
+    return turn
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
