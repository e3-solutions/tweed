+def owns_coordinator_event(driver: object, params: dict, turn_id: object) -> bool:
+    """Whether an event belongs to the driver's active coordinator thread/turn.
+
+    Native child threads share the app-server stream; their events carry a
+    different threadId and must never establish the coordinator outcome.
+    Legacy notifications without threadId are accepted by turn ID alone.
+    """
+    active_thread = getattr(driver, "_receipt_thread_id", None)
+    active_turn = getattr(driver, "_receipt_turn_id", None)
+    if not isinstance(active_turn, str) or turn_id != active_turn:
+        return False
+    thread_id = params.get("threadId")
+    if thread_id is None:
+        return True
+    return isinstance(active_thread, str) and thread_id == active_thread
+
+
 class AppServerPhaseDriver:
     """Drive one native app-server turn without retaining its raw event stream."""
 
