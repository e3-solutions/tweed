+def coordinator_turn_completion(
+    message: dict, completed_turn: dict | None, thread_id: str, turn_id: str
+) -> dict | None:
+    """Return the completion only when it belongs to the active coordinator turn.
+
+    Native child threads complete their own turns on the shared app-server
+    stream; those events must never finish or replace the coordinator turn.
+    Legacy notifications without a thread identity are accepted only for the
+    active turn identity.
+    """
+    if completed_turn is None:
+        return None
+    params = message.get("params")
+    event_thread = params.get("threadId") if isinstance(params, dict) else None
+    if event_thread is None:
+        event_thread = completed_turn.get("threadId")
+    if event_thread is not None and event_thread != thread_id:
+        return None
+    if completed_turn.get("id") != turn_id:
+        if event_thread is None:
+            return None
+        raise RuntimeError("Codex app-server completed the wrong turn")
+    return completed_turn
+
+
