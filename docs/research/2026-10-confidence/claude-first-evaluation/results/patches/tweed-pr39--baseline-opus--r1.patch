+def _parent_thread_id(thread: dict) -> str | None:
+    """Extract the spawning parent from a native thread-started payload."""
+    candidates: list[object] = [thread.get("parentThreadId")]
+    source = thread.get("source")
+    if isinstance(source, dict):
+        for key in ("subAgent", "subagent", "sub_agent"):
+            spawned = source.get(key)
+            if isinstance(spawned, dict):
+                for spawn_key in ("thread_spawn", "threadSpawn"):
+                    spawn = spawned.get(spawn_key)
+                    if isinstance(spawn, dict):
+                        candidates.extend(
+                            [spawn.get("parent_thread_id"), spawn.get("parentThreadId")]
+                        )
+                candidates.extend(
+                    [spawned.get("parent_thread_id"), spawned.get("parentThreadId")]
+                )
+    for candidate in candidates:
+        if isinstance(candidate, str) and candidate:
+            return candidate
+    return None
