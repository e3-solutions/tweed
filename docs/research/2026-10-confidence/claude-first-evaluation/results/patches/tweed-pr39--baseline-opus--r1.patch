+    def owned_descendants(self, root_thread_id: str) -> list[str]:
+        """Return started threads whose observed parent chain reaches the root."""
+        if root_thread_id not in self._started_threads:
+            return []
+        owned: list[str] = []
+        for thread_id in self._started_threads:
+            if thread_id == root_thread_id:
+                continue
+            seen = {thread_id}
+            parent = self._started_threads.get(thread_id)
+            while parent is not None and parent not in seen:
+                if parent == root_thread_id:
+                    owned.append(thread_id)
+                    break
+                if parent not in self._started_threads:
+                    break
+                seen.add(parent)
+                parent = self._started_threads[parent]
+        return owned
+
+    def _cleanup_request(self, method: str, params: dict) -> dict:
+        """Issue one teardown request without feeding late events to progress."""
+        request_id = self.send(method, params)
+        deadline = time.monotonic() + CLEANUP_REQUEST_TIMEOUT_SECONDS
+        while True:
+            try:
+                message = self.next_message(max(0.0, deadline - time.monotonic()))
+            except TimeoutError as error:
+                raise RuntimeError(
+                    f"Codex app-server timed out during {method}"
+                ) from error
+            if "method" in message:
+                continue
+            if message.get("id") != request_id:
+                # A late reply to an earlier timed-out teardown request.
+                continue
+            if "error" in message:
+                raise RuntimeError(
+                    f"Codex app-server rejected {method}: {message['error']}"
+                )
+            result = message.get("result")
+            if not isinstance(result, dict):
+                raise RuntimeError(f"Codex app-server returned no result for {method}")
+            return result
+
+    def finish_root(self, root_thread_id: str, branch: str | None) -> list[str]:
+        """Update owned started descendants, then archive the started root.
+
+        Every step is attempted; failures are returned rather than raised so a
+        descendant failure never prevents the root archive attempt.
+        """
+        if root_thread_id not in self._started_threads:
+            return []
+        failures: list[str] = []
+        if isinstance(branch, str) and branch:
+            for thread_id in self.owned_descendants(root_thread_id):
+                try:
+                    self._cleanup_request(
+                        "thread/metadata/update",
+                        {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                    )
+                except Exception as error:
+                    failures.append(f"descendant {thread_id} metadata: {error}")
+        try:
+            self._cleanup_request("thread/archive", {"threadId": root_thread_id})
+        except Exception as error:
+            failures.append(f"root {root_thread_id} archive: {error}")
+        return failures
