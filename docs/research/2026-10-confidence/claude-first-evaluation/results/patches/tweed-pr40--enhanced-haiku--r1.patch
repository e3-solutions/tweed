+def _cli_soft_phase_budget(args: argparse.Namespace, command: str) -> object:
+    """Return a positive seconds value, None for unspecified, or the OFF sentinel.
+
+    Unspecified resumes keep the checkpoint's stored budget, so they return None.
+    Explicit disablement returns SOFT_PHASE_BUDGET_OFF on every path.
+    """
+    if args.no_soft_phase_budget and args.soft_phase_budget_seconds is not None:
+        raise RuntimeError(
+            "--no-soft-phase-budget and --soft-phase-budget-seconds are mutually exclusive"
+        )
+    if args.no_soft_phase_budget:
+        return SOFT_PHASE_BUDGET_OFF
+    if args.soft_phase_budget_seconds is not None:
+        return resolve_soft_phase_budget(args.soft_phase_budget_seconds)
+    if command == "resume":
+        return None
+    environment = os.environ.get(SOFT_PHASE_BUDGET_ENV)
+    if environment is None:
+        return DEFAULT_SOFT_PHASE_BUDGET_SECONDS
+    if environment.strip().casefold() == "off":
+        return SOFT_PHASE_BUDGET_OFF
+    return resolve_soft_phase_budget(environment)
+
+
+def _run_soft_phase_budget(value: object) -> float | None:
+    """Map a parsed new-run budget to run_phase semantics (None means disabled)."""
+    if value is None:
+        return DEFAULT_SOFT_PHASE_BUDGET_SECONDS
+    if value is SOFT_PHASE_BUDGET_OFF:
+        return None
+    return value
+
