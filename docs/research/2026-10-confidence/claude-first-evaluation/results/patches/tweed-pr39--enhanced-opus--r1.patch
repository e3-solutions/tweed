diff --git a/bonaparte_native.py b/bonaparte_native.py
index e9a607c..715baaf 100644
--- a/bonaparte_native.py
+++ b/bonaparte_native.py
@@ -51,6 +51,27 @@ def child_environment() -> dict[str, str]:
     return environment
 
 
+def parent_thread_id(thread: dict) -> str | None:
+    """Return the spawning parent recorded on a started native thread."""
+    pending: list[tuple[object, int]] = [(thread, 0)]
+    while pending:
+        value, depth = pending.pop()
+        if not isinstance(value, dict):
+            continue
+        for key in ("parentThreadId", "parent_thread_id"):
+            parent = value.get(key)
+            if isinstance(parent, str) and parent:
+                return parent
+        if depth < 4:
+            source = value.get("source") if depth == 0 else None
+            if depth == 0:
+                if source is not None:
+                    pending.append((source, 1))
+            else:
+                pending.extend((nested, depth + 1) for nested in value.values())
+    return None
+
+
 def terminate_and_reap(process: subprocess.Popen) -> None:
     """Boundedly stop the coordinator's private process group and reap it."""
     pid = getattr(process, "pid", None)
@@ -121,6 +142,7 @@ class AppServerPhaseDriver:
         self._last_agent_message: str | None = None
         self._receipt_thread_id: str | None = None
         self._receipt_turn_id: str | None = None
+        self._started_threads: dict[str, str | None] = {}
         self._reader = threading.Thread(target=self._read, daemon=True)
         self._reader.start()
 
@@ -274,6 +296,9 @@ class AppServerPhaseDriver:
         if method == "thread/started":
             thread = params.get("thread")
             if isinstance(thread, dict) and isinstance(thread.get("id"), str):
+                started = self.__dict__.setdefault("_started_threads", {})
+                if thread["id"] not in started:
+                    started[thread["id"]] = parent_thread_id(thread)
                 self.observer.feed(
                     json.dumps({"type": "thread.started", "thread_id": thread["id"]})
                 )
@@ -345,5 +370,48 @@ class AppServerPhaseDriver:
     def last_agent_message(self) -> str | None:
         return self._last_agent_message
 
+    def owned_descendants(self, root_id: str) -> list[str]:
+        """Return started threads whose parent chain reaches the root."""
+        started = self.__dict__.get("_started_threads", {})
+        owned = {root_id}
+        descendants: list[str] = []
+        changed = True
+        while changed:
+            changed = False
+            for thread_id, parent in started.items():
+                if thread_id not in owned and parent in owned:
+                    owned.add(thread_id)
+                    descendants.append(thread_id)
+                    changed = True
+        return descendants
+
+    def finish_root(
+        self, root_id: str, *, branch: str | None, archive: bool
+    ) -> None:
+        """Tag started owned descendants, then archive a terminal root.
+
+        Every step is attempted; failures are raised together afterwards.
+        """
+        failures: list[BaseException] = []
+        if branch:
+            for child in self.owned_descendants(root_id):
+                try:
+                    self.request(
+                        "thread/metadata/update",
+                        {"threadId": child, "gitInfo": {"branch": branch}},
+                    )
+                except Exception as error:
+                    failures.append(error)
+        if archive:
+            try:
+                self.request("thread/archive", {"threadId": root_id})
+            except Exception as error:
+                failures.append(error)
+        if failures:
+            raise RuntimeError(
+                "native session cleanup failed: "
+                + "; ".join(str(error) for error in failures)
+            ) from failures[0]
+
     def close(self, *, failed: bool) -> None:
         terminate_and_reap(self.process)
