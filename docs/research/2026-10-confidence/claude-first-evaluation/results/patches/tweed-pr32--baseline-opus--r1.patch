+def is_active_turn_completion(
+    params: dict, turn: dict, active_thread: str | None, active_turn: str | None
+) -> bool:
+    """Only the active coordinator thread/turn may establish its outcome.
+
+    Native child threads complete their own turns on the same stream; those
+    must never finish or replace the coordinator turn. Legacy notifications
+    without a threadId are accepted only when they carry the active turn ID.
+    """
+    if active_turn is None or turn.get("id") != active_turn:
+        return False
+    thread_id = params.get("threadId")
+    if thread_id is None:
+        thread_id = turn.get("threadId")
+    return thread_id is None or thread_id == active_thread
+
