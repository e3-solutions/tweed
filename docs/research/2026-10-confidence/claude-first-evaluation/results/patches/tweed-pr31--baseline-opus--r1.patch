+class SoftBudgetContinuation(RuntimeError):
+    """A soft-budget interruption or post-steer guard failure in a live session."""
+
+    def __init__(self, message: str, session_id: str, receipt: dict | None = None):
+        super().__init__(message)
+        self.session_id = session_id
+        self.receipt = receipt
+
+
+def _continuation_receipt(phase: str, error: SoftBudgetContinuation) -> dict:
+    stored = error.receipt if isinstance(error.receipt, dict) else {}
+    return {
+        **{name: stored.get(name) for name in RECEIPT_SCHEMA["required"]},
+        "phase": phase,
+        "state": "failed",
+        "result": None,
+        "summary": str(error),
+        "question": SOFT_BUDGET_CONTINUE_QUESTION,
+        "remote_state_changed": None,
+        "resume_session_id": error.session_id,
+    }
+
