+    def owned_started_descendants(self) -> list[str]:
+        """Started threads whose observed parent chain reaches the started root."""
+        root = getattr(self, "_receipt_thread_id", None)
+        started = getattr(self, "_started_threads", {})
+        if root is None or root not in started:
+            return []
+        owned: list[str] = []
+        for thread_id in started:
+            if thread_id == root:
+                continue
+            seen = {thread_id}
+            parent = started[thread_id]
+            while parent is not None and parent != root and parent in started:
+                if parent in seen:
+                    break
+                seen.add(parent)
+                parent = started[parent]
+            if parent == root:
+                owned.append(thread_id)
+        return owned
+
+    def _teardown_session(self) -> None:
+        root = getattr(self, "_receipt_thread_id", None)
+        if not getattr(self, "_root_finished", False) or root is None:
+            return
+        if root not in getattr(self, "_started_threads", {}):
+            return
+        errors: list[str] = []
+        branch = getattr(self, "issue_branch", None)
+        if branch:
+            for thread_id in self.owned_started_descendants():
+                try:
+                    self.request(
+                        "thread/metadata/update",
+                        {"threadId": thread_id, "gitInfo": {"branch": branch}},
+                        timeout=TEARDOWN_REQUEST_TIMEOUT_SECONDS,
+                        observe=False,
+                    )
+                except Exception as error:
+                    errors.append(f"descendant {thread_id} metadata update: {error}")
+        if getattr(self, "archive_root", True):
+            try:
+                self.request(
+                    "thread/archive",
+                    {"threadId": root},
+                    timeout=TEARDOWN_REQUEST_TIMEOUT_SECONDS,
+                    observe=False,
+                )
+            except Exception as error:  # surfaced after reaping
+                errors.append(f"root {root} archive: {error}")
+        if errors:
+            raise RuntimeError(
+                "Codex session teardown failed: " + "; ".join(errors)
+            )
+
