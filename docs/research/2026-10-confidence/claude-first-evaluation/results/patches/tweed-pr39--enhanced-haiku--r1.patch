diff --git a/bonaparte_teardown.py b/bonaparte_teardown.py
new file mode 100644
index 0000000..a2c78f5
--- /dev/null
+++ b/bonaparte_teardown.py
@@ -0,0 +1,67 @@
+"""Owner-scoped native teardown for one Bonaparte terminal root session."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+METADATA_UPDATE_METHOD = "thread/metadata/update"
+ARCHIVE_METHOD = "thread/archive"
+
+
+class TeardownError(RuntimeError):
+    """Raised after every teardown step was attempted and at least one failed."""
+
+    def __init__(self, failures: list[BaseException]):
+        self.failures = failures
+        detail = "; ".join(str(failure) for failure in failures)
+        super().__init__(f"terminal session teardown failed: {detail}")
+
+
+class ThreadOwnership:
+    """Record threads named by actual thread/started notifications, in order."""
+
+    def __init__(self) -> None:
+        self._started: list[str] = []
+
+    def observe_started(self, thread_id: str) -> None:
+        if thread_id not in self._started:
+            self._started.append(thread_id)
+
+    def started_descendants(self, root_id: str | None) -> list[str]:
+        return [thread_id for thread_id in self._started if thread_id != root_id]
+
+
+def teardown_terminal_session(
+    request: Callable[[str, dict], dict],
+    root_id: str,
+    descendants: list[str],
+    canonical_branch: str | None,
+) -> None:
+    """Update started descendants, then archive the root.
+
+    A descendant failure never prevents the root archive attempt. All failures
+    are raised together after every step has been attempted.
+    """
+    failures: list[BaseException] = []
+    for thread_id in descendants:
+        if not canonical_branch:
+            failures.append(
+                RuntimeError(
+                    f"descendant {thread_id} metadata skipped: "
+                    "canonical issue branch is unavailable"
+                )
+            )
+            continue
+        try:
+            request(
+                METADATA_UPDATE_METHOD,
+                {"threadId": thread_id, "gitInfo": {"branch": canonical_branch}},
+            )
+        except Exception as error:
+            failures.append(error)
+    try:
+        request(ARCHIVE_METHOD, {"threadId": root_id})
+    except Exception as error:
+        failures.append(error)
+    if failures:
+        raise TeardownError(failures)
