+def _soft_budget_failure(checkpoint: dict, detail: str) -> dict:
+    """Persist a continuation question after a post-steer failure of the session."""
+    checkpoint.update(
+        status="waiting-input",
+        question=SOFT_BUDGET_CONTINUE_QUESTION,
+        pending_answer=None,
+    )
+    try:
+        _refresh_checkpoint_git(
+            checkpoint, update_identity=True, require_identity=True
+        )
+    except RuntimeError:
+        pass  # keep the last verified identity; resume validation still applies
+    summary = (
+        f"{detail.replace(chr(10), ' ')[:500]} Unfinished proof obligations are "
+        f"unverified. {SOFT_BUDGET_CONTINUE_QUESTION}"
+    )
+    return _checkpoint_failure(checkpoint, summary, remote_uncertain=True)
+
