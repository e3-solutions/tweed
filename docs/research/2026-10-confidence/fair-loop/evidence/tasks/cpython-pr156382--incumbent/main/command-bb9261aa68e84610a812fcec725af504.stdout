960 
961     def write(self, fp, space_around_delimiters=True):
962         """Write an .ini-format representation of the configuration state.
963 
964         If `space_around_delimiters` is True (the default), delimiters
965         between keys and values are surrounded by spaces.
966 
967         Please note that comments in the original configuration file are not
968         preserved when writing the configuration back.
969         """
970         if space_around_delimiters:
971             d = " {} ".format(self._delimiters[0])
972         else:
973             d = self._delimiters[0]
974         if self._defaults:
975             self._write_section(fp, self.default_section,
976                                     self._defaults.items(), d)
977         if UNNAMED_SECTION in self._sections and self._sections[UNNAMED_SECTION]:
978             self._write_section(fp, UNNAMED_SECTION, self._sections[UNNAMED_SECTION].items(), d, unnamed=True)
979 
980         for section in self._sections:
981             if section is UNNAMED_SECTION:
982                 continue
983             self._write_section(fp, section,
984                                 self._sections[section].items(), d)
985 
986     def _write_section(self, fp, section_name, section_items, delimiter, unnamed=False):
987         """Write a single section to the specified 'fp'."""
988         if not unnamed:
989             fp.write("[{}]\n".format(section_name))
990         for key, value in section_items:
991             self._validate_key_contents(key)
992             value = self._interpolation.before_write(self, section_name, key,
993                                                      value)
994             if value is not None or not self._allow_no_value:
995                 # Convert all possible line-endings into '\n\t'
996                 value = (delimiter + str(value).replace('\r\n', '\n')
997                          .replace('\r', '\n').replace('\n', '\n\t'))
998             else:
999                 value = ""
1000             fp.write("{}{}\n".format(key, value))
1001         fp.write("\n")
