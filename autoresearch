    return result


def _target_met(spec: Mapping[str, Any], metric: float) -> bool:
    target = spec["search"]["target"]
    return target is not None and (metric >= target if spec["evaluator"]["direction"] == "max" else metric <= target)


def _promote_batch(spec: Mapping[str, Any], state: Path, log: EventLog, replay: dict[str, Any], records: Sequence[Mapping[str, Any]], budget: RunBudget) -> dict[str, Any]:
    attempt_ids = sorted(int(record["attempt_id"]) for record in records)
    eligible = [r for r in records if all(r["constraints"].values()) and is_better(r["metric"], replay["best_metric"], spec["evaluator"]["direction"], spec["search"]["min_improvement"])]
    if not eligible:
        log.append("batch-outcome", {"attempt_ids": attempt_ids, "outcome": "none", "winner": None, "failure_delta": len(records)})
        return replay
    winner = stable_rank(eligible, spec["evaluator"]["direction"])[0]
    critic = replay["critics"].get(winner["attempt_id"])
    if critic is None:
        critic = run_critic(spec, state, budget, winner["binding"], winner)
        log.append("critic-completed", critic, winner["attempt_id"])
    if critic["supported"]:
        log.append("batch-outcome", {"attempt_ids": attempt_ids, "outcome": "correction", "winner": dict(winner), "failure_delta": 1}, winner["attempt_id"])
        return replay
    log.append("batch-outcome", {"attempt_ids": attempt_ids, "outcome": "promotion", "winner": dict(winner), "failure_delta": 0}, winner["attempt_id"])
    return replay


def _finalize(spec: Mapping[str, Any], state: Path, log: EventLog, replay: dict[str, Any], baseline_export: Path, budget: RunBudget) -> dict[str, Any]:
    control = state / "temporary" / f"final-{uuid.uuid4().hex}"
    try:
        materialize(Path(spec["repository"]["path"]), control, spec["repository"]["baseline_oid"], budget)
        patch = replay["best_patch"]
        if patch is not None and patch.stat().st_size:
            verify_artifact({"patch": str(patch), "patch_digest": replay["best_patch_digest"], "attempt_id": replay["best_attempt_id"]}, state, budget)
            applied = git(control, "apply", "--index", "--binary", str(patch), check=False, timeout=budget.remaining())
            if applied.returncode:
                raise ValidationError("final cumulative patch no longer applies")
        tree = git(control, "write-tree", timeout=budget.remaining()).stdout.strip()
        if tree != replay["best_tree"]:
            raise ValidationError("final reconstructed tree differs from promoted tree")
        score = evaluate_tree(spec, control, baseline_export, state, budget)
        if score["metric"] != replay["best_metric"] or not all(score["constraints"].values()):
            raise ValidationError("final fresh objective replay differs from promotion")
        binding = replay["leased"].get(replay["best_attempt_id"])
        if binding is None:
            # Baseline-only run still receives a bound final critic.
            binding = _attempt_binding(replay["run_id"], max(replay["leased"], default=0) + 1, "baseline-final", spec["repository"]["baseline_oid"], replay["best_tree"], time.time() + budget.remaining())
        evidence = {**score, "tree": tree, "patch_digest": file_digest(patch, budget) if patch else hashlib.sha256(b"").hexdigest(), "final_replay": True}
        critic = replay["final_critics"].get(binding["attempt_id"])
        if critic is None:
            critic = run_critic(spec, state, budget, binding, evidence, final=True)
            log.append("final-critic", critic, binding["attempt_id"])
        if critic["supported"]:
            raise FinalObjection("final critic raised a supported objection")
        budget.check_artifacts()
        final_patch = state / "evidence" / "final.patch"
        patch_data = read_bytes_bounded(patch, budget.artifact_bytes, budget) if patch else b""
        if not final_patch.exists():
            with budget.reserve_artifact(len(patch_data)):
                patch_digest = exclusive_bytes(final_patch, patch_data)
        else:
            patch_digest = file_digest(final_patch, budget)
            if patch_digest != hashlib.sha256(patch_data).hexdigest():
                raise ValidationError("torn/tampered final patch")
        result = {"schema_version": VERSION, "run_id": replay["run_id"], "status": "completed", "baseline_metric": replay["baseline"]["metric"], "best_metric": score["metric"], "best_attempt_id": replay["best_attempt_id"], "baseline_oid": spec["repository"]["baseline_oid"], "best_tree": tree, "patch": str(final_patch), "patch_digest": patch_digest, "evidence": str(state / "events"), "knowledge": str(state / "knowledge.json")}
        _object(result, RESULT_KEYS, "result"); atomic_json(state / "knowledge.json", {"best_attempt_id": replay["best_attempt_id"], "metric": score["metric"]}, budget); atomic_json(state / "result.json", result, budget); budget.check_artifacts(); log.append("run-completed", result); return result
    finally:
        shutil.rmtree(control, ignore_errors=True)


def run_controller(spec_path: Path, state: Path, *, resume: bool = False) -> dict[str, Any]:
    invocation_started = time.time()
    spec_path = spec_path.resolve(); spec = validate_spec(read_json_bounded(spec_path, 256 * 1024), spec_path=spec_path)
    source = Path(spec["repository"]["path"]).resolve()
    state = state.resolve()
    if state == source or source in state.parents:
        raise ValidationError("state must not be inside source")
    state.mkdir(parents=True, exist_ok=True)
    with RunLock(state):
        event_directory = state / "events"; first_path = event_directory / "00000001.json"
        has_event_state = first_path.exists() or (event_directory.exists() and any(event_directory.iterdir()))
        if has_event_state:
            if not first_path.is_file(): raise ValidationError("event log lacks canonical first event")
            first = read_json_bounded(first_path, 16 * 1024)
            if not isinstance(first, dict) or first.get("kind") != "run-started" or first.get("sequence") != 1 or not isinstance(first.get("payload"), dict): raise ValidationError("invalid canonical first event")
            run_id = _string(first.get("run_id"), "first event run_id"); started = _number(first["payload"].get("started_epoch"), "first event started_epoch", 0)
            budget = RunBudget(started, spec["budgets"]["wall_seconds"], spec["budgets"]["artifact_bytes"], state)
            budget.remaining()
            log = EventLog(state, run_id); log.budget = budget; events = log.replay(budget); replay = reconstruct_state(events, state, spec, budget)
            if not resume:
                raise RuntimeError("state already contains a run; use resume")
        else:
            if resume:
                raise ValidationError("run directory has no immutable event log")
            run_id = uuid.uuid4().hex; log = EventLog(state, run_id); started = invocation_started
            initial_budget = RunBudget(started, spec["budgets"]["wall_seconds"], spec["budgets"]["artifact_bytes"], state); log.budget = initial_budget
            spec_size = len(json.dumps(spec, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()) + 1
            initial_budget.check_artifacts(spec_size + 1024)
            log.append("run-started", {"spec_digest": digest_json(spec), "started_epoch": started}); atomic_json(state / "spec.json", spec, initial_budget)
            budget = initial_budget; replay = reconstruct_state(log.replay(budget), state, spec, budget)
        log.budget = budget
        budget.check_artifacts()
        source_oid, _ = repository_facts(source, budget)
        if source_oid != spec["repository"]["source_oid"]:
            raise ValidationError("source repository no longer matches pinned OID")
        # Mutable files are caches only; never trust them on resume.
        (state / "checkpoint.json").unlink(missing_ok=True)
        if replay["completed"] is not None:
            result = replay["completed"]
            verify_artifact(result, state, budget); atomic_json(state / "result.json", result, budget); return result
        incomplete = sorted(set(replay["leased"]) - replay["terminal"])
        for attempt_id in incomplete:
            log.append("lease-abandoned", {"reason": "resume never restores model sessions"}, attempt_id)
        if incomplete:
            replay = reconstruct_state(log.replay(budget), state, spec, budget)
        capability_probe(spec, state, budget)
        baseline_control = state / "temporary" / f"baseline-control-{uuid.uuid4().hex}"; baseline_export = state / "temporary" / f"baseline-export-{uuid.uuid4().hex}"; baseline_control.parent.mkdir(exist_ok=True)
        materialize(source, baseline_control, spec["repository"]["baseline_oid"], budget); export_index(baseline_control, baseline_export, budget)
        try:
            if replay["baseline"] is None:
                baseline = evaluate_tree(spec, baseline_control, baseline_export, state, budget, baseline=True)
                baseline["tree"] = git(baseline_control, "write-tree", timeout=budget.remaining()).stdout.strip()
                if not all(baseline["constraints"].values()):
                    raise ValidationError("baseline violates declared constraints")
                log.append("baseline-evaluated", baseline); replay = reconstruct_state(log.replay(budget), state, spec, budget)
            else:
                # Resume verifies the immutable baseline decision freshly.
                fresh = evaluate_tree(spec, baseline_control, baseline_export, state, budget, baseline=True)
                fresh["tree"] = git(baseline_control, "write-tree", timeout=budget.remaining()).stdout.strip()
                if fresh != replay["baseline"]:
                    raise ValidationError("baseline replay differs from immutable event")
            pending = [record for attempt_id, record in sorted(replay["verified"].items()) if attempt_id not in replay["decided"]]
            if pending:
                replay = _promote_batch(spec, state, log, replay, pending, budget)
                replay = reconstruct_state(log.replay(budget), state, spec, budget)
            used = max(replay["leased"], default=0)
            # Reserve one correction slot; the adversarial direction remains the last search slot.
            search_limit = max(0, spec["budgets"]["attempts"] - 1)
            while used < search_limit and replay["failures"] <= spec["search"]["patience"] and not _target_met(spec, replay["best_metric"]):
                batch_size = min(spec["budgets"]["concurrency"], search_limit - used)
                directions = schedule_directions(spec, winner_direction=replay["winner_direction"], used=used, count=batch_size, limit=search_limit)
                parent_patch, parent_tree = replay["best_patch"], replay["best_tree"]
                bindings = []
                for offset, direction in enumerate(directions, 1):
                    attempt_id = used + offset; binding = _attempt_binding(run_id, attempt_id, direction, spec["repository"]["baseline_oid"], parent_tree, time.time() + budget.remaining()); bindings.append(binding); log.append("lease-started", binding, attempt_id)
                records = []
                with concurrent.futures.ThreadPoolExecutor(max_workers=batch_size) as executor:
                    futures = {executor.submit(execute_attempt, spec, state, baseline_export, budget, binding, parent_patch): binding for binding in bindings}
                    for future in concurrent.futures.as_completed(futures):
                        binding = futures[future]
                        try:
                            record = future.result(); log.append("attempt-verified", record, binding["attempt_id"]); records.append(record)
                        except Exception as exc:
                            log.append("attempt-rejected", {"reason": str(exc)}, binding["attempt_id"])
                # Completion order is discarded before the serialized decision.
                records.sort(key=lambda item: item["attempt_id"]); replay = reconstruct_state(log.replay(budget), state, spec, budget); replay = _promote_batch(spec, state, log, replay, records, budget); replay = reconstruct_state(log.replay(budget), state, spec, budget)
                used += batch_size; atomic_json(state / "checkpoint.json", {"event_digest": log.replay(budget)[-1]["digest"]}, budget)
            # A supported promotion objection gets exactly the reserved correction attempt.
            correction = replay.get("correction")
            if correction and used < spec["budgets"]["attempts"]:
                attempt_id = used + 1; binding = _attempt_binding(run_id, attempt_id, f"correction:{correction['attempt_id']}", spec["repository"]["baseline_oid"], correction["tree"], time.time() + budget.remaining()); log.append("lease-started", binding, attempt_id)
                try:
                    record = execute_attempt(spec, state, baseline_export, budget, binding, Path(correction["patch"])); log.append("attempt-verified", record, attempt_id); replay = reconstruct_state(log.replay(budget), state, spec, budget); replay = _promote_batch(spec, state, log, replay, [record], budget)
                except Exception as exc:
                    log.append("attempt-rejected", {"reason": str(exc)}, attempt_id)
                replay = reconstruct_state(log.replay(budget), state, spec, budget)
            budget.check_artifacts()
            try:
                return _finalize(spec, state, log, replay, baseline_export, budget)
            except FinalObjection:
                used = max(replay["leased"], default=0)
                if replay["best_patch"] is None or used >= spec["budgets"]["attempts"]:
                    raise
                attempt_id = used + 1
                binding = _attempt_binding(run_id, attempt_id, f"correction-final:{replay['best_attempt_id']}", spec["repository"]["baseline_oid"], replay["best_tree"], time.time() + budget.remaining())
                log.append("lease-started", binding, attempt_id)
                try:
                    record = execute_attempt(spec, state, baseline_export, budget, binding, replay["best_patch"])
                    if not all(record["constraints"].values()) or not is_better(record["metric"], replay["baseline"]["metric"], spec["evaluator"]["direction"], spec["search"]["min_improvement"]):
                        raise ValidationError("final correction no longer satisfies promotion gate")
                    log.append("attempt-verified", record, attempt_id)
                    critic = run_critic(spec, state, budget, binding, record, final=True); log.append("critic-completed", critic, attempt_id)
                    if critic["supported"]:
                        raise ValidationError("final correction retained a supported objection")
                    log.append("batch-outcome", {"attempt_ids": [attempt_id], "outcome": "promotion", "winner": dict(record), "failure_delta": 0}, attempt_id); replay = reconstruct_state(log.replay(budget), state, spec, budget)
                except Exception as exc:
                    log.append("attempt-rejected", {"reason": str(exc)}, attempt_id)
                    raise
                return _finalize(spec, state, log, replay, baseline_export, budget)
        finally:
            shutil.rmtree(baseline_control, ignore_errors=True); shutil.rmtree(baseline_export, ignore_errors=True); shutil.rmtree(state / "temporary", ignore_errors=True)


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="autoresearch"); commands = parser.add_subparsers(dest="command", required=True)
    setup = commands.add_parser("setup"); setup.add_argument("--repo", required=True, type=Path); setup.add_argument("--output", required=True, type=Path); setup.add_argument("goal"); setup.add_argument("--codex", default="codex", help=argparse.SUPPRESS); setup.add_argument("--timeout", type=float, default=300, help=argparse.SUPPRESS)
    run = commands.add_parser("run"); run.add_argument("spec", type=Path); run.add_argument("--state", required=True, type=Path)
    resume = commands.add_parser("resume"); resume.add_argument("run_dir", type=Path)
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    try:
        args = parse_args(argv)
        if args.command == "setup":
            return command_setup(args)
        result = run_controller(args.spec, args.state) if args.command == "run" else run_controller(args.run_dir / "spec.json", args.run_dir, resume=True)
        print(json.dumps(result, sort_keys=True)); return 0
    except (ValidationError, BudgetExceeded, RuntimeError, TimeoutError, OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"schema_version": VERSION, "status": "failed", "error": str(exc)}, sort_keys=True), file=sys.stderr); return 1


if __name__ == "__main__":
    raise SystemExit(main())
