            failure_delta = payload.get("failure_delta")
            if not isinstance(attempt_ids, list) or any(type(value) is not int for value in attempt_ids) or type(failure_delta) is not int or failure_delta < 0:
                raise ValidationError("invalid immutable batch decision")
