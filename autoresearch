                records.sort(key=lambda item: item["attempt_id"]); replay = reconstruct_state(log.replay(), state, spec); replay = _promote_batch(spec, state, log, replay, records, budget); replay = reconstruct_state(log.replay(), state, spec)
                used += batch_size; atomic_json(state / "checkpoint.json", {"event_digest": log.replay()[-1]["digest"]})
            # A supported promotion objection gets exactly the reserved correction attempt.
            correction = replay.get("correction")
            if correction and used < spec["budgets"]["attempts"]:
                attempt_id = used + 1; binding = _attempt_binding(run_id, attempt_id, f"correction:{correction['attempt_id']}", spec["repository"]["baseline_oid"], correction["tree"], time.time() + budget.remaining()); log.append("lease-started", binding, attempt_id)
                try:
                    record = execute_attempt(spec, state, baseline_export, budget, binding, Path(correction["patch"])); log.append("attempt-verified", record, attempt_id); replay = reconstruct_state(log.replay(), state, spec); replay = _promote_batch(spec, state, log, replay, [record], budget)
                except Exception as exc:
                    log.append("attempt-rejected", {"reason": str(exc)}, attempt_id)
                replay = reconstruct_state(log.replay(), state, spec)
            budget.check_artifacts()
            try:
                return _finalize(spec, state, log, replay, baseline_export, budget)
            except FinalObjection:
                used = max(replay["leased"], default=0)
                if replay["best_patch"] is None or used >= spec["budgets"]["attempts"]:
                    raise
                attempt_id = used + 1
                binding = _attempt_binding(run_id, attempt_id, f"correction-final:{replay['best_attempt_id']}", spec["repository"]["baseline_oid"], replay["best_tree"], time.time() + budget.remaining())
                log.append("lease-started", binding, attempt_id)
                try:
                    record = execute_attempt(spec, state, baseline_export, budget, binding, replay["best_patch"])
                    if not all(record["constraints"].values()) or not is_better(record["metric"], replay["baseline"]["metric"], spec["evaluator"]["direction"], spec["search"]["min_improvement"]):
                        raise ValidationError("final correction no longer satisfies promotion gate")
                    log.append("attempt-verified", record, attempt_id)
                    critic = run_critic(spec, state, budget, binding, record, final=True); log.append("critic-completed", critic, attempt_id)
                    if critic["supported"]:
                        raise ValidationError("final correction retained a supported objection")
                    log.append("promotion", record, attempt_id); replay = reconstruct_state(log.replay(), state, spec)
                except Exception as exc:
                    log.append("attempt-rejected", {"reason": str(exc)}, attempt_id)
                    raise
                return _finalize(spec, state, log, replay, baseline_export, budget)
        finally:
            shutil.rmtree(baseline_control, ignore_errors=True); shutil.rmtree(baseline_export, ignore_errors=True); shutil.rmtree(state / "temporary", ignore_errors=True)


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="autoresearch"); commands = parser.add_subparsers(dest="command", required=True)
    setup = commands.add_parser("setup"); setup.add_argument("--repo", required=True, type=Path); setup.add_argument("--output", required=True, type=Path); setup.add_argument("goal"); setup.add_argument("--codex", default="codex", help=argparse.SUPPRESS); setup.add_argument("--timeout", type=float, default=300, help=argparse.SUPPRESS)
    run = commands.add_parser("run"); run.add_argument("spec", type=Path); run.add_argument("--state", required=True, type=Path)
    resume = commands.add_parser("resume"); resume.add_argument("run_dir", type=Path)
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    try:
        args = parse_args(argv)
        if args.command == "setup":
            return command_setup(args)
        result = run_controller(args.spec, args.state) if args.command == "run" else run_controller(args.run_dir / "spec.json", args.run_dir, resume=True)
        print(json.dumps(result, sort_keys=True)); return 0
    except (ValidationError, BudgetExceeded, RuntimeError, TimeoutError, OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"schema_version": VERSION, "status": "failed", "error": str(exc)}, sort_keys=True), file=sys.stderr); return 1


if __name__ == "__main__":
    raise SystemExit(main())
