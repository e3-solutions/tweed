VERSION = 1
SPEC_KEYS = frozenset({"schema_version", "goal", "repository", "paths", "evaluator", "sandbox", "budgets", "search", "provenance"})
REPOSITORY_KEYS = frozenset({"path", "source_oid", "baseline_oid"})
PATH_KEYS = frozenset({"allowed", "protected"})
EVALUATOR_KEYS = frozenset({"argv", "baseline_argv", "check_argv", "constraint_names", "immutable_inputs", "direction", "timeout_seconds", "max_output_bytes"})
SANDBOX_KEYS = frozenset({"wrapper_argv", "capabilities"})
BUDGET_KEYS = frozenset({"attempts", "concurrency", "wall_seconds", "process_seconds", "artifact_bytes"})
SEARCH_KEYS = frozenset({"directions", "adversarial_direction", "target", "patience", "min_improvement"})
PROVENANCE_KEYS = frozenset({"created_by", "created_at"})
WORKER_KEYS = frozenset({"schema_version", "run_id", "attempt_id", "direction", "generation", "baseline_oid", "parent_tree", "lease", "deadline", "status", "summary"})
CRITIC_KEYS = frozenset({"schema_version", "run_id", "attempt_id", "lease", "supported", "objection", "summary"})
EVENT_KEYS = frozenset({"schema_version", "sequence", "kind", "run_id", "attempt_id", "time", "payload", "previous_digest", "digest"})
RESULT_KEYS = frozenset({"schema_version", "run_id", "status", "baseline_metric", "best_metric", "best_attempt_id", "baseline_oid", "best_tree", "patch", "patch_digest", "evidence", "knowledge"})
REQUIRED_CAPABILITIES = frozenset({"filesystem-contained", "process-contained", "network-denied"})
MAX_EVENT_BYTES = 512 * 1024
TERMINAL_ATTEMPT_EVENTS = frozenset({"attempt-verified", "attempt-rejected", "lease-abandoned"})
GIT_ENV = {"GIT_CONFIG_NOSYSTEM": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0", "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "core.hooksPath", "GIT_CONFIG_VALUE_0": os.devnull}
ORIGINAL_CODEX_HOME = os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))


class ValidationError(ValueError):
    pass


class BudgetExceeded(RuntimeError):
    pass


class FinalObjection(ValidationError):
    pass


def _object(value: Any, keys: frozenset[str], where: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ValidationError(f"{where} must be an object")
    missing, unknown = keys - set(value), set(value) - keys
    if missing or unknown:
        raise ValidationError(f"{where} keys invalid; missing={sorted(missing)}, unknown={sorted(unknown)}")
    return value


def _string(value: Any, where: str, *, empty: bool = False) -> str:
    if not isinstance(value, str) or (not empty and not value.strip()) or "\x00" in value:
        raise ValidationError(f"{where} must be {'a string' if empty else 'a non-empty string'} without NUL")
    return value


def _integer(value: Any, where: str, low: int, high: int) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or not low <= value <= high:
        raise ValidationError(f"{where} must be an integer in [{low}, {high}]")
    return value


def _number(value: Any, where: str, low: float = -math.inf) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < low:
        raise ValidationError(f"{where} must be a finite number >= {low}")
    return float(value)


def _oid(value: Any, where: str) -> str:
    value = _string(value, where)
    if len(value) != 40 or any(c not in "0123456789abcdef" for c in value):
        raise ValidationError(f"{where} must be a lowercase 40-character Git OID")
    return value


def validate_argv(value: Any, where: str = "argv") -> list[str]:
    if not isinstance(value, list) or not value:
        raise ValidationError(f"{where} must be a non-empty argv array")
    for index, part in enumerate(value):
        _string(part, f"{where}[{index}]")
    return list(value)


def normalize_prefix(value: Any, where: str = "path") -> str:
    text = _string(value, where)
    if text.startswith("/") or "\\" in text or text.endswith("/"):
        raise ValidationError(f"{where} must be a canonical relative POSIX prefix")
    path = PurePosixPath(text)
    if text in {"", "."} or any(part in {"", ".", ".."} for part in path.parts):
        raise ValidationError(f"{where} contains traversal or a non-canonical component")
    return path.as_posix()


def _prefix_contains(prefix: str, path: str) -> bool:
    return prefix == path or path.startswith(prefix + "/")


def validate_prefixes(allowed: Any, protected: Any) -> tuple[list[str], list[str]]:
    if not isinstance(allowed, list) or not allowed or not isinstance(protected, list) or not protected:
        raise ValidationError("paths.allowed and paths.protected must be non-empty arrays")
    groups = ([normalize_prefix(v, f"paths.allowed[{i}]") for i, v in enumerate(allowed)], [normalize_prefix(v, f"paths.protected[{i}]") for i, v in enumerate(protected)])
    for group in groups:
        if len(group) != len(set(group)):
            raise ValidationError("path prefixes must be unique")
        for index, left in enumerate(group):
            for right in group[index + 1:]:
                if _prefix_contains(left, right) or _prefix_contains(right, left):
                    raise ValidationError(f"path prefixes overlap: {left!r}, {right!r}")
    for left in groups[0]:
        for right in groups[1]:
            if _prefix_contains(left, right) or _prefix_contains(right, left):
                raise ValidationError(f"allowed/protected prefixes overlap: {left!r}, {right!r}")
    return groups


def validate_spec(value: Any, *, spec_path: Path | None = None) -> dict[str, Any]:
    try:
        if len(json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode()) > 256 * 1024:
            raise ValidationError("spec exceeds the closed 256 KiB bound")
    except (TypeError, ValueError) as exc:
        raise ValidationError("spec is not JSON-serializable") from exc
    spec = _object(value, SPEC_KEYS, "spec")
    if spec["schema_version"] != VERSION:
        raise ValidationError("spec.schema_version must be 1")
    _string(spec["goal"], "spec.goal")
    repository = _object(spec["repository"], REPOSITORY_KEYS, "spec.repository")
    source_value = Path(_string(repository["path"], "spec.repository.path")).expanduser()
    if not source_value.is_absolute():
        raise ValidationError("spec.repository.path must be absolute")
    source = source_value.resolve()
    _oid(repository["source_oid"], "spec.repository.source_oid")
    _oid(repository["baseline_oid"], "spec.repository.baseline_oid")
    paths = _object(spec["paths"], PATH_KEYS, "spec.paths")
    allowed, protected = validate_prefixes(paths["allowed"], paths["protected"])
    evaluator = _object(spec["evaluator"], EVALUATOR_KEYS, "spec.evaluator")
    for name in ("argv", "baseline_argv", "check_argv"):
        validate_argv(evaluator[name], f"spec.evaluator.{name}")
    names = evaluator["constraint_names"]
    if not isinstance(names, list) or not names or len(names) != len(set(names)):
        raise ValidationError("spec.evaluator.constraint_names must be a non-empty unique string array")
    for index, name in enumerate(names):
        _string(name, f"spec.evaluator.constraint_names[{index}]")
    inputs = evaluator["immutable_inputs"]
    if not isinstance(inputs, list) or not inputs or len(inputs) != len(set(inputs)):
        raise ValidationError("spec.evaluator.immutable_inputs must be a non-empty unique path array")
    normalized_inputs = [normalize_prefix(path, f"spec.evaluator.immutable_inputs[{i}]") for i, path in enumerate(inputs)]
    for path in normalized_inputs:
        if not any(_prefix_contains(prefix, path) for prefix in protected):
            raise ValidationError(f"immutable evaluator input is not protected: {path}")
    if evaluator["direction"] not in {"min", "max"}:
        raise ValidationError("spec.evaluator.direction must be 'min' or 'max'")
    _number(evaluator["timeout_seconds"], "spec.evaluator.timeout_seconds", 0.001)
    _integer(evaluator["max_output_bytes"], "spec.evaluator.max_output_bytes", 64, 64 * 1024 * 1024)
    sandbox = _object(spec["sandbox"], SANDBOX_KEYS, "spec.sandbox")
    validate_argv(sandbox["wrapper_argv"], "spec.sandbox.wrapper_argv")
    caps = sandbox["capabilities"]
    if not isinstance(caps, list) or len(caps) != len(REQUIRED_CAPABILITIES) or any(not isinstance(value, str) for value in caps) or set(caps) != REQUIRED_CAPABILITIES:
        raise ValidationError(f"spec.sandbox.capabilities must be exactly {sorted(REQUIRED_CAPABILITIES)}")
    budgets = _object(spec["budgets"], BUDGET_KEYS, "spec.budgets")
    attempts = _integer(budgets["attempts"], "spec.budgets.attempts", 1, 10000)
    _integer(budgets["concurrency"], "spec.budgets.concurrency", 1, min(256, attempts))
    _number(budgets["wall_seconds"], "spec.budgets.wall_seconds", 0.001)
    _number(budgets["process_seconds"], "spec.budgets.process_seconds", 0.001)
    _integer(budgets["artifact_bytes"], "spec.budgets.artifact_bytes", 1024, 1024 ** 4)
    search = _object(spec["search"], SEARCH_KEYS, "spec.search")
    directions = search["directions"]
    if not isinstance(directions, list) or not directions or len(directions) != len(set(directions)):
        raise ValidationError("spec.search.directions must be a non-empty unique string array")
    for index, direction in enumerate(directions):
        _string(direction, f"spec.search.directions[{index}]")
    adversarial = _string(search["adversarial_direction"], "spec.search.adversarial_direction")
    if adversarial in directions:
        raise ValidationError("adversarial_direction must be reserved and independent")
    if search["target"] is not None:
        _number(search["target"], "spec.search.target")
    _integer(search["patience"], "spec.search.patience", 0, attempts)
    _number(search["min_improvement"], "spec.search.min_improvement", 0)
    provenance = _object(spec["provenance"], PROVENANCE_KEYS, "spec.provenance")
    _string(provenance["created_by"], "spec.provenance.created_by")
    _string(provenance["created_at"], "spec.provenance.created_at")
    if spec_path is not None:
        try:
            spec_path.resolve().parent.relative_to(source)
        except ValueError:
            pass
        else:
            raise ValidationError("state/spec must not be inside the source repository")
    return spec


def parse_evaluator_output(data: str | bytes, constraint_names: Sequence[str] | None = None) -> dict[str, Any]:
    if isinstance(data, bytes):
        try:
            data = data.decode("utf-8", "strict")
        except UnicodeError as exc:
            raise ValidationError("evaluator output is not UTF-8") from exc
    try:
        value = json.loads(data, parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
    except (json.JSONDecodeError, ValueError) as exc:
        raise ValidationError(f"evaluator output is not exact JSON: {exc}") from exc
    if not isinstance(value, dict) or set(value) != {"metric", "constraints"}:
        raise ValidationError("evaluator output must contain exactly metric and constraints")
    metric = _number(value["metric"], "evaluator.metric")
    constraints = value["constraints"]
    if not isinstance(constraints, dict) or not constraints or any(not isinstance(k, str) or type(v) is not bool for k, v in constraints.items()):
        raise ValidationError("evaluator.constraints must be a non-empty boolean object")
    if constraint_names is not None and set(constraints) != set(constraint_names):
        raise ValidationError("evaluator constraint keys/order do not exactly match declaration")
    return {"metric": metric, "constraints": constraints}


def is_better(candidate: float, incumbent: float, direction: str, minimum: float) -> bool:
    improvement = candidate - incumbent if direction == "max" else incumbent - candidate
    return improvement > 0 and improvement >= minimum


def stable_rank(attempts: Iterable[Mapping[str, Any]], direction: str) -> list[Mapping[str, Any]]:
    sign = -1 if direction == "max" else 1
    return sorted(attempts, key=lambda item: (sign * float(item["metric"]), int(item["attempt_id"])))


def schedule_directions(spec: Mapping[str, Any], *, winner_direction: str | None = None, used: int = 0, count: int | None = None, limit: int | None = None) -> list[str]:
    """Return deterministic allocation: independent first, reallocate, reserve last."""
    total = spec["budgets"]["attempts"] if limit is None else limit
    if count is None:
        count = total - used
    normal_end = max(0, total - 1)
    independent = list(spec["search"]["directions"])
    result = []
    for attempt_index in range(used, min(total, used + count)):
        if attempt_index == total - 1:
            result.append(spec["search"]["adversarial_direction"])
        elif attempt_index < min(len(independent), normal_end):
            result.append(independent[attempt_index])
        else:
            result.append(winner_direction or independent[attempt_index % len(independent)])
    return result


def minimal_environment(extra: Mapping[str, str] | None = None) -> dict[str, str]:
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": tempfile.gettempdir(), **GIT_ENV}
    if extra:
        env.update(extra)
    return env


def codex_environment() -> dict[str, str]:
    """Minimal environment plus explicitly supported Codex credentials only."""
    allowed = {"CODEX_HOME": ORIGINAL_CODEX_HOME}
    if "OPENAI_API_KEY" in os.environ:
        allowed["OPENAI_API_KEY"] = os.environ["OPENAI_API_KEY"]
    return minimal_environment(allowed)


def _kill_group(process: subprocess.Popen[bytes]) -> None:
    with contextlib.suppress(OSError):
        os.killpg(process.pid, signal.SIGKILL)


def run_bounded(argv: Sequence[str], *, cwd: Path, timeout: float, max_output: int, env: Mapping[str, str] | None = None, input_text: str | None = None) -> subprocess.CompletedProcess[bytes]:
    """Run without a shell, streaming-capping each output and killing immediately."""
    command = validate_argv(list(argv))
    if timeout <= 0:
        raise TimeoutError("process has no wall budget remaining")
    process = subprocess.Popen(command, cwd=cwd, env=dict(env or minimal_environment()), stdin=subprocess.PIPE if input_text is not None else subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    input_data = memoryview(input_text.encode() if input_text is not None else b"")
    input_offset = 0
    selector = selectors.DefaultSelector()
    buffers: dict[Any, bytearray] = {process.stdout: bytearray(), process.stderr: bytearray()}
    for stream in buffers:
        os.set_blocking(stream.fileno(), False)
        selector.register(stream, selectors.EVENT_READ)
    if input_text is not None:
        os.set_blocking(process.stdin.fileno(), False)
        selector.register(process.stdin, selectors.EVENT_WRITE)
    deadline = time.monotonic() + timeout
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                _kill_group(process)
                raise TimeoutError(f"process exceeded {timeout} seconds")
            for key, _ in selector.select(min(0.05, remaining)):
                if key.fileobj is process.stdin:
                    try:
                        written = os.write(process.stdin.fileno(), input_data[input_offset:input_offset + 8192])
                        input_offset += written
                    except BlockingIOError:
                        continue
                    except (BrokenPipeError, OSError):
                        input_offset = len(input_data)
                    if input_offset >= len(input_data):
                        selector.unregister(process.stdin); process.stdin.close()
                    continue
                chunk = os.read(key.fileobj.fileno(), 8192)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                target = buffers[key.fileobj]
                target.extend(chunk)
                if len(target) > max_output:
                    _kill_group(process)
                    raise BudgetExceeded("process output budget exceeded")
            if process.poll() is not None and not selector.get_map():
                break
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            _kill_group(process)
            raise TimeoutError(f"process exceeded {timeout} seconds")
        process.wait(timeout=remaining)
        return subprocess.CompletedProcess(command, process.returncode, bytes(buffers[process.stdout]), bytes(buffers[process.stderr]))
    finally:
        selector.close()
        if process.poll() is None:
            _kill_group(process)
            with contextlib.suppress(Exception):
                process.wait(timeout=1)
        for stream in (process.stdin, process.stdout, process.stderr):
            if stream is not None and not stream.closed:
                stream.close()


def git(repo: Path, *args: str, check: bool = True, text: bool = True, timeout: float | None = None, max_output: int = 64 * 1024 * 1024) -> subprocess.CompletedProcess[Any]:
    command = ["git", "-c", f"core.hooksPath={os.devnull}", *args]
    if timeout is None:
        result = subprocess.run(command, cwd=repo, env=minimal_environment(), capture_output=True, text=text, check=False)
    else:
        bounded = run_bounded(command, cwd=repo, env=minimal_environment(), timeout=timeout, max_output=max_output)
        result = subprocess.CompletedProcess(command, bounded.returncode, bounded.stdout.decode("utf-8", "strict") if text else bounded.stdout, bounded.stderr.decode("utf-8", "replace") if text else bounded.stderr)
    if check and result.returncode:
        stderr = result.stderr if text else result.stderr.decode("utf-8", "replace")
        raise RuntimeError(f"git {' '.join(args)} failed: {stderr.strip()}")
    return result


def repository_facts(repo: Path, budget: Any = None) -> tuple[str, str]:
    repo = repo.resolve()
    timeout = lambda: budget.remaining() if budget is not None else None
    if git(repo, "status", "--porcelain=v1", "--untracked-files=normal", timeout=timeout()).stdout:
        raise ValidationError("source repository must be clean")
    source_oid = git(repo, "rev-parse", "HEAD", timeout=timeout()).stdout.strip()
    baseline_oid = git(repo, "rev-parse", "HEAD^{commit}", timeout=timeout()).stdout.strip()
    return _oid(source_oid, "source OID"), _oid(baseline_oid, "baseline OID")


def encode_json(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode() + b"\n"


def atomic_json(path: Path, value: Any, budget: Any = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    data = encode_json(value); old_size = path.stat().st_size if path.is_file() else 0
    reservation = budget.reserve_artifact(max(0, len(data) - old_size)) if budget is not None else contextlib.nullcontext()
    with reservation:
        temporary_dir = path.parent
        if budget is not None:
            temporary_dir = budget.state / "temporary"; temporary_dir.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=temporary_dir)
        try:
            with os.fdopen(fd, "wb") as stream:
                stream.write(data); stream.flush(); os.fsync(stream.fileno())
            os.replace(temporary, path)
        finally:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(temporary)


def digest_json(value: Any) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()


def read_bytes_bounded(path: Path, max_bytes: int, budget: Any = None) -> bytes:
    if budget is not None: budget.remaining()
    data = bytearray()
    with path.open("rb") as stream:
        while True:
            if budget is not None: budget.remaining()
            chunk = stream.read(min(64 * 1024, max_bytes + 1 - len(data)))
            if not chunk: break
            data.extend(chunk)
            if len(data) > max_bytes: raise BudgetExceeded(f"bounded read exceeded {max_bytes} bytes: {path}")
    return bytes(data)


def read_json_bounded(path: Path, max_bytes: int, budget: Any = None) -> Any:
    try:
        return json.loads(read_bytes_bounded(path, max_bytes, budget).decode("utf-8", "strict"))
    except UnicodeError as exc:
        raise ValidationError(f"JSON is not UTF-8: {path}") from exc


def file_digest(path: Path, budget: Any = None) -> str:
    if budget is not None: budget.remaining()
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while True:
            if budget is not None: budget.remaining()
            chunk = stream.read(1024 * 1024)
            if not chunk: break
            digest.update(chunk)
    return digest.hexdigest()


def exclusive_bytes(path: Path, data: bytes) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as stream:
        stream.write(data); stream.flush(); os.fsync(stream.fileno())
    return hashlib.sha256(data).hexdigest()


class RunLock:
    def __init__(self, directory: Path):
        self.path = directory / "run.lock"; self.stream: Any = None
    def __enter__(self) -> "RunLock":
        self.path.parent.mkdir(parents=True, exist_ok=True); self.stream = self.path.open("a+")
        try:
            fcntl.flock(self.stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            self.stream.close()
            if exc.errno in {errno.EACCES, errno.EAGAIN}:
                raise RuntimeError("run is already locked") from exc
            raise
        return self
    def __exit__(self, *_: Any) -> None:
        fcntl.flock(self.stream, fcntl.LOCK_UN); self.stream.close()


class EventLog:
    def __init__(self, directory: Path, run_id: str):
        self.directory = directory / "events"; self.directory.mkdir(parents=True, exist_ok=True); self.run_id = run_id; self.budget: Any = None
    def append(self, kind: str, payload: Any, attempt_id: int | None = None) -> dict[str, Any]:
        if self.budget is not None: self.budget.remaining()
        existing: dict[int, Path] = {}
        with os.scandir(self.directory) as entries:
            for entry in entries:
                if self.budget is not None: self.budget.remaining()
                if not entry.name.endswith(".json") or len(entry.name) != 13 or not entry.name[:8].isdigit(): raise ValidationError("event filename is not canonical")
                existing[int(entry.name[:8])] = Path(entry.path)
        sequence = len(existing) + 1
        if set(existing) != set(range(1, sequence)): raise ValidationError("event sequence is not canonical")
        previous = "0" * 64 if not existing else read_json_bounded(existing[sequence - 1], MAX_EVENT_BYTES, self.budget)["digest"]
        event = {"schema_version": VERSION, "sequence": sequence, "kind": kind, "run_id": self.run_id, "attempt_id": attempt_id, "time": dt.datetime.now(dt.timezone.utc).isoformat(), "payload": payload, "previous_digest": previous}
        event["digest"] = digest_json(event)
        _object(event, EVENT_KEYS, "event")
        path = self.directory / f"{sequence:08d}.json"
        encoded = json.dumps(event, sort_keys=True, separators=(",", ":")).encode() + b"\n"
        if len(encoded) > MAX_EVENT_BYTES: raise BudgetExceeded("event exceeds canonical size bound")
        reservation = self.budget.reserve_artifact(len(encoded)) if self.budget is not None else contextlib.nullcontext()
        with reservation:
            exclusive_bytes(path, encoded)
        return event
    def replay(self, budget: Any = None) -> list[dict[str, Any]]:
        result, previous = [], "0" * 64
        if budget is not None: budget.remaining()
        files: dict[int, Path] = {}
        with os.scandir(self.directory) as entries:
            for entry in entries:
                if budget is not None: budget.remaining()
                if not entry.name.endswith(".json") or len(entry.name) != 13 or not entry.name[:8].isdigit(): raise ValidationError("event filename is not canonical")
                files[int(entry.name[:8])] = Path(entry.path)
        if set(files) != set(range(1, len(files) + 1)): raise ValidationError("event sequence is not canonical")
        for sequence in range(1, len(files) + 1):
            path = files[sequence]
            if budget is not None: budget.remaining()
            if path.name != f"{sequence:08d}.json":
                raise ValidationError("event sequence is not canonical")
            event = read_json_bounded(path, MAX_EVENT_BYTES, budget); _object(event, EVENT_KEYS, "event")
            digest = event.pop("digest", None); expected = digest_json(event); event["digest"] = digest
            if event["sequence"] != sequence or event["run_id"] != self.run_id or event["previous_digest"] != previous or digest != expected:
                raise ValidationError(f"event log tamper at sequence {sequence}")
            previous = digest; result.append(event)
        return result


def validate_binding(record: Mapping[str, Any], expected: Mapping[str, Any], *, critic: bool = False) -> dict[str, Any]:
    obj = _object(dict(record), CRITIC_KEYS if critic else WORKER_KEYS, "critic receipt" if critic else "worker receipt")
    if obj["schema_version"] != VERSION:
        raise ValidationError("receipt schema_version must be 1")
    _string(obj["run_id"], "receipt.run_id"); _integer(obj["attempt_id"], "receipt.attempt_id", 1, 10 ** 9); _string(obj["lease"], "receipt.lease")
    for key in ("run_id", "attempt_id", "lease"):
        if obj[key] != expected[key]:
            raise ValidationError(f"stale or wrong receipt binding: {key}")
    if critic:
        if type(obj["supported"]) is not bool:
            raise ValidationError("critic supported must be boolean")
        _string(obj["objection"], "critic.objection", empty=True); _string(obj["summary"], "critic.summary", empty=True)
        if obj["supported"] != bool(obj["objection"].strip()):
            raise ValidationError("critic objection must be non-empty exactly when supported")
    else:
        _string(obj["direction"], "worker.direction"); _integer(obj["generation"], "worker.generation", 1, 10 ** 9); _oid(obj["baseline_oid"], "worker.baseline_oid"); _oid(obj["parent_tree"], "worker.parent_tree"); _number(obj["deadline"], "worker.deadline", 0); _string(obj["summary"], "worker.summary", empty=True)
        for key in ("direction", "generation", "baseline_oid", "parent_tree", "deadline"):
            if obj[key] != expected[key]:
                raise ValidationError(f"stale or wrong receipt binding: {key}")
        if obj["status"] not in {"completed", "failed"}:
            raise ValidationError("worker status invalid")
    return obj


def materialize(source: Path, destination: Path, oid: str, budget: Any = None) -> None:
    remaining = (lambda: budget.remaining()) if budget is not None else (lambda: None)
    git(source, "clone", "--no-hardlinks", "--quiet", str(source), str(destination), timeout=remaining()); git(destination, "checkout", "--quiet", "--detach", oid, timeout=remaining()); git(destination, "clean", "-ffdx", timeout=remaining())


def export_index(repository: Path, destination: Path, budget: Any = None) -> None:
    destination.mkdir(parents=True, exist_ok=False)
    git(repository, "checkout-index", "--all", "--force", f"--prefix={destination.resolve()}{os.sep}", timeout=budget.remaining() if budget is not None else None)


def capture_workspace(workspace: Path, repository: Path, budget: Any = None) -> None:
    for entry in workspace.rglob("*"):
        if budget is not None: budget.remaining()
        mode = entry.lstat().st_mode
        if entry.name == ".git" or stat.S_ISLNK(mode) or not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
            raise ValidationError(f"symlink/special/metadata candidate rejected: {entry.relative_to(workspace)}")
    for entry in (p for p in repository.iterdir() if p.name != ".git"):
        if budget is not None: budget.remaining()
        shutil.rmtree(entry) if entry.is_dir() else entry.unlink()
    repository.mkdir(parents=True, exist_ok=True)
    for source in sorted(workspace.rglob("*")):
        if budget is not None: budget.remaining()
        relative, destination = source.relative_to(workspace), repository / source.relative_to(workspace)
        if source.is_dir(): destination.mkdir(parents=True, exist_ok=True)
        elif budget is not None: _copy_regular_tree(source, destination, budget)
        else: destination.parent.mkdir(parents=True, exist_ok=True); shutil.copy2(source, destination)
    git(repository, "add", "-A", timeout=budget.remaining() if budget is not None else None)


def inspect_candidate(repo: Path, baseline: str, allowed: Sequence[str], protected: Sequence[str], *, cached: bool = False, budget: Any = None) -> list[str]:
    raw = git(repo, "diff", *(["--cached"] if cached else []), "--name-status", "-z", baseline, "--", text=False, timeout=budget.remaining() if budget is not None else None).stdout
    fields, changed, index = raw.split(b"\0"), [], 0
    while index < len(fields) and fields[index]:
        status_code = fields[index].decode(); index += 1
        if status_code.startswith(("R", "C")):
            index += 1
        path = normalize_prefix(fields[index].decode("utf-8", "strict"), "candidate path"); index += 1
        if any(_prefix_contains(prefix, path) for prefix in protected):
            raise ValidationError(f"protected path changed: {path}")
        if not any(_prefix_contains(prefix, path) for prefix in allowed):
            raise ValidationError(f"out-of-scope path changed: {path}")
        target = repo / path
        if target.exists() or target.is_symlink():
            mode = target.lstat().st_mode
            if stat.S_ISLNK(mode) or not stat.S_ISREG(mode):
                raise ValidationError(f"symlink/special candidate rejected: {path}")
        changed.append(path)
    return changed


def tree_digest(path: Path, budget: Any = None) -> str:
    digest = hashlib.sha256()
    if not path.exists():
        return digest.hexdigest()
    entries = [path] if path.is_file() else sorted(path.rglob("*"))
    for entry in entries:
        if budget is not None: budget.remaining()
        relative = entry.relative_to(path.parent if path.is_file() else path).as_posix().encode(); digest.update(relative)
        if entry.is_symlink(): digest.update(b"L" + os.readlink(entry).encode())
        elif entry.is_file():
            digest.update(b"F")
            with entry.open("rb") as stream:
                while True:
                    if budget is not None: budget.remaining()
                    chunk = stream.read(1024 * 1024)
                    if not chunk: break
                    digest.update(chunk)
    return digest.hexdigest()


def artifact_usage(path: Path, budget: Any = None) -> int:
    total = 0
    for name in ("events", "evidence", "schemas"):
        if budget is not None: budget.remaining()
        directory = path / name
        if directory.exists():
            for entry in directory.rglob("*"):
                if budget is not None: budget.remaining()
                if entry.is_file() and not entry.is_symlink(): total += entry.stat().st_size
    for name in ("spec.json", "knowledge.json", "result.json", "checkpoint.json", "final.patch"):
        if budget is not None: budget.remaining()
        target = path / name
        if target.is_file():
            total += target.stat().st_size
    return total


class RunBudget:
    def __init__(self, started_epoch: float, wall_seconds: float, artifact_bytes: int, state: Path):
        self.deadline_epoch = started_epoch + wall_seconds; self.artifact_bytes = artifact_bytes; self.state = state; self._lock = threading.Lock(); self._reserved = 0
    def remaining(self) -> float:
        value = self.deadline_epoch - time.time()
        if value <= 0:
            raise BudgetExceeded("whole-run wall budget exhausted")
        return value
    def timeout(self, requested: float) -> float:
        return max(0.001, min(requested, self.remaining()))
    def check_artifacts(self, additional: int = 0) -> None:
        with self._lock:
            if artifact_usage(self.state, self) + self._reserved + additional > self.artifact_bytes:
                raise BudgetExceeded("artifact budget exceeded")
    @contextlib.contextmanager
    def reserve_artifact(self, amount: int):
        with self._lock:
            if artifact_usage(self.state, self) + self._reserved + amount > self.artifact_bytes:
                raise BudgetExceeded("artifact budget exceeded")
            self._reserved += amount
        try:
            yield
        finally:
            with self._lock:
                self._reserved -= amount


def _validate_regular_tree(path: Path, budget: RunBudget, relative: str) -> None:
    budget.remaining()
    mode = path.lstat().st_mode
    if stat.S_ISLNK(mode) or not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
        raise ValidationError(f"immutable evaluator input contains symlink/special file: {relative}")
    if stat.S_ISDIR(mode):
        with os.scandir(path) as entries:
            for entry in entries:
                _validate_regular_tree(Path(entry.path), budget, f"{relative}/{entry.name}")


def _copy_regular_tree(source: Path, destination: Path, budget: RunBudget) -> None:
    budget.remaining()
    if stat.S_ISDIR(source.lstat().st_mode):
        destination.mkdir(parents=True, exist_ok=True)
        with os.scandir(source) as entries:
            for entry in entries:
                _copy_regular_tree(Path(entry.path), destination / entry.name, budget)
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        with source.open("rb") as source_stream, destination.open("wb") as destination_stream:
            while True:
                budget.remaining(); chunk = source_stream.read(1024 * 1024)
                if not chunk: break
                destination_stream.write(chunk)
        shutil.copystat(source, destination)


def _copy_immutable(baseline: Path, work: Path, inputs: Sequence[str], budget: RunBudget) -> dict[str, str]:
    hashes = {}
    for relative in inputs:
        source, destination = baseline / relative, work / relative
        if not source.exists() and not source.is_symlink():
            raise ValidationError(f"immutable evaluator input missing: {relative}")
        _validate_regular_tree(source, budget, relative)
        if destination.exists() or destination.is_symlink():
            shutil.rmtree(destination) if destination.is_dir() else destination.unlink()
        _copy_regular_tree(source, destination, budget)
        hashes[relative] = tree_digest(destination, budget)
    return hashes


def _run_score(spec: Mapping[str, Any], work: Path, argv: Sequence[str], budget: RunBudget) -> dict[str, Any]:
    evaluator = spec["evaluator"]
    result = run_bounded([*spec["sandbox"]["wrapper_argv"], *argv], cwd=work, timeout=budget.timeout(min(evaluator["timeout_seconds"], spec["budgets"]["process_seconds"])), max_output=evaluator["max_output_bytes"])
    if result.returncode:
        raise RuntimeError(f"evaluator failed ({result.returncode}): {result.stderr.decode('utf-8', 'replace')}")
    return parse_evaluator_output(result.stdout, evaluator["constraint_names"])


def evaluate_tree(spec: Mapping[str, Any], controller_repo: Path, baseline_export: Path, state: Path, budget: RunBudget, *, baseline: bool = False) -> dict[str, Any]:
    work = state / "temporary" / f"eval-{uuid.uuid4().hex}"; work.parent.mkdir(exist_ok=True)
    budget.check_artifacts(); export_index(controller_repo, work, budget)
    try:
        immutable = _copy_immutable(baseline_export, work, spec["evaluator"]["immutable_inputs"], budget)
        primary = _run_score(spec, work, spec["evaluator"]["baseline_argv"] if baseline else spec["evaluator"]["argv"], budget)
        check = _run_score(spec, work, spec["evaluator"]["check_argv"], budget)
        if primary != check:
            raise ValidationError("primary evaluator and independent check disagree")
        if immutable != {path: tree_digest(work / path, budget) for path in spec["evaluator"]["immutable_inputs"]}:
            raise ValidationError("evaluator modified immutable baseline-owned inputs")
        return {**primary, "immutable_digest": digest_json(immutable)}
    finally:
        shutil.rmtree(work, ignore_errors=True)


def workflow_prompt(name: str) -> str:
    path = Path(__file__).resolve().parent / "workflows" / f"autoresearch-{name}.md"
    if not path.is_file():
        raise RuntimeError(f"canonical workflow prompt missing: {path}")
    return path.read_text()


def bounded_prompt(value: str) -> str:
    if len(value.encode()) > 256 * 1024:
        raise BudgetExceeded("model prompt exceeds 256 KiB bound")
    return value


def receipt_json_schema(kind: str) -> dict[str, Any]:
    if kind == "worker":
        properties = {"schema_version": {"const": 1}, "run_id": {"type": "string"}, "attempt_id": {"type": "integer"}, "direction": {"type": "string"}, "generation": {"type": "integer"}, "baseline_oid": {"type": "string"}, "parent_tree": {"type": "string"}, "lease": {"type": "string"}, "deadline": {"type": "number"}, "status": {"enum": ["completed", "failed"]}, "summary": {"type": "string"}}
    elif kind == "critic":
        properties = {"schema_version": {"const": 1}, "run_id": {"type": "string"}, "attempt_id": {"type": "integer"}, "lease": {"type": "string"}, "supported": {"type": "boolean"}, "objection": {"type": "string"}, "summary": {"type": "string"}}
    else:
        raise ValidationError("unknown receipt schema")
    return {"type": "object", "additionalProperties": False, "required": list(properties), "properties": properties}


def spec_json_schema() -> dict[str, Any]:
    def closed(properties: dict[str, Any], description: str | None = None) -> dict[str, Any]:
        result = {"type": "object", "additionalProperties": False, "required": list(properties), "properties": properties}
        if description: result["description"] = description
        return result
    string = {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}
    argv = {"type": "array", "items": string, "minItems": 1}
    unique_strings = {"type": "array", "items": string, "minItems": 1, "uniqueItems": True}
    path = {"type": "string", "minLength": 1, "pattern": r"^(?!.*\x00)(?!/)(?!.*\\)(?!.*(?:^|/)\.\.?(?:/|$))(?!.*//)(?!.*\/$).+$"}
    paths = {"type": "array", "items": path, "minItems": 1, "uniqueItems": True}
    oid = {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    positive = {"type": "number", "exclusiveMinimum": 0}
    capabilities = {"type": "array", "items": {"enum": sorted(REQUIRED_CAPABILITIES)}, "minItems": 3, "maxItems": 3, "uniqueItems": True}
    description = "Cross-field constraints enforced after JSON Schema: concurrency <= attempts; patience <= attempts; allowed/protected prefixes must not overlap; immutable_inputs must be protected; adversarial_direction must differ from directions."
    return closed({
        "schema_version": {"const": 1}, "goal": string,
        "repository": closed({"path": {"type": "string", "pattern": "^/"}, "source_oid": oid, "baseline_oid": oid}),
        "paths": closed({"allowed": paths, "protected": paths}),
        "evaluator": closed({"argv": argv, "baseline_argv": argv, "check_argv": argv, "constraint_names": unique_strings, "immutable_inputs": paths, "direction": {"enum": ["min", "max"]}, "timeout_seconds": positive, "max_output_bytes": {"type": "integer", "minimum": 64, "maximum": 64 * 1024 * 1024}}),
        "sandbox": closed({"wrapper_argv": argv, "capabilities": capabilities}),
        "budgets": closed({"attempts": {"type": "integer", "minimum": 1, "maximum": 10000}, "concurrency": {"type": "integer", "minimum": 1, "maximum": 256}, "wall_seconds": positive, "process_seconds": positive, "artifact_bytes": {"type": "integer", "minimum": 1024, "maximum": 1024 ** 4}}),
        "search": closed({"directions": unique_strings, "adversarial_direction": string, "target": {"type": ["number", "null"]}, "patience": {"type": "integer", "minimum": 0, "maximum": 10000}, "min_improvement": {"type": "number", "minimum": 0}}),
        "provenance": closed({"created_by": string, "created_at": string}),
    }, description)


def setup_command(repo: Path, output: Path, goal: str, codex: str = "codex") -> list[str]:
    return [codex, "exec", "--ephemeral", "--ignore-user-config", "--ignore-rules", "--sandbox", "read-only", "--cwd", str(repo), "--output-schema", str(output / "spec-schema.json"), "--output-last-message", str(output / "spec.json"), "-"]


def command_setup(args: argparse.Namespace) -> int:
    repo, output = args.repo.expanduser().resolve(), args.output.expanduser().resolve()
    if output == repo or repo in output.parents:
        raise ValidationError("state/output must not be inside source repository")
    source_oid, baseline_oid = repository_facts(repo); output.mkdir(parents=True, exist_ok=False)
    atomic_json(output / "spec-schema.json", spec_json_schema())
    prompt = bounded_prompt(workflow_prompt("setup") + "\n\n# Controller addendum (authoritative)\nThe evaluator object additionally and exactly requires baseline_argv, check_argv, constraint_names, and immutable_inputs. Both score commands must return identical exact JSON and immutable inputs must be protected baseline-owned paths.\n\n" + json.dumps({"goal": args.goal, "repository": str(repo), "source_oid": source_oid, "baseline_oid": baseline_oid}, sort_keys=True))
    result = run_bounded(setup_command(repo, output, args.goal, args.codex), cwd=repo, timeout=args.timeout, max_output=256 * 1024, input_text=prompt, env=codex_environment())
    if result.returncode:
        raise RuntimeError(result.stderr.decode("utf-8", "replace"))
    spec_path = output / "spec.json"; spec = validate_spec(json.loads(spec_path.read_text()), spec_path=spec_path)
    if Path(spec["repository"]["path"]).resolve() != repo or spec["repository"]["source_oid"] != source_oid or spec["repository"]["baseline_oid"] != baseline_oid:
        raise ValidationError("generated spec changed pinned repository provenance")
    atomic_json(spec_path, spec); print(spec_path); return 0


def capability_probe(spec: Mapping[str, Any], state: Path, budget: RunBudget) -> None:
    """Actively prove local escape/network denial and controller process containment."""
    root = state / "temporary" / f"probe-{uuid.uuid4().hex}"; inside = root / "inside"; outside = root / "outside"; inside.mkdir(parents=True); outside.mkdir()
    sentinel = outside / "sentinel"; sentinel.write_text("secret")
    listener = socket.socket(); listener.bind(("127.0.0.1", 0)); listener.listen(); listener.settimeout(0.1)
    script = "import pathlib,socket,sys\np=pathlib.Path(sys.argv[1]); port=int(sys.argv[2])\nok=[]\ntry:p.read_text();ok.append('read')\nexcept Exception:pass\ntry:p.write_text('changed');ok.append('write')\nexcept Exception:pass\ntry:s=socket.create_connection(('127.0.0.1',port),.2);ok.append('network');s.close()\nexcept Exception:pass\nprint(','.join(ok))\nsys.exit(1 if ok else 0)"
    try:
        result = run_bounded([*spec["sandbox"]["wrapper_argv"], sys.executable, "-c", script, str(sentinel), str(listener.getsockname()[1])], cwd=inside, timeout=budget.timeout(min(5, spec["budgets"]["process_seconds"])), max_output=1024)
        accepted = False
        try:
            connection, _ = listener.accept(); accepted = True; connection.close()
        except TimeoutError:
            pass
        if result.returncode or result.stdout != b"\n" or accepted or sentinel.read_text() != "secret":
            raise ValidationError("sandbox capability probe did not deny filesystem escape and local network")
        # A timed child proves process-group kill containment without external effects.
        child_script = "import subprocess,sys,time\np=subprocess.Popen([sys.executable,'-c','import time;time.sleep(30)']);print(p.pid,flush=True);time.sleep(30)"
        try:
            process_result = run_bounded([*spec["sandbox"]["wrapper_argv"], sys.executable, "-c", child_script], cwd=inside, timeout=budget.timeout(0.2), max_output=1024)
            if process_result.returncode == 0:
                raise ValidationError("sandbox process probe unexpectedly completed")
        except TimeoutError:
            pass
    finally:
        listener.close(); shutil.rmtree(root, ignore_errors=True)


def run_critic(spec: Mapping[str, Any], state: Path, budget: RunBudget, binding: Mapping[str, Any], evidence: Mapping[str, Any], *, final: bool = False) -> dict[str, Any]:
    schema = state / "schemas/critic-v1.json"; atomic_json(schema, receipt_json_schema("critic"), budget)
    suffix = "final" if final else "promotion"; receipt = state / "temporary" / f"critic-{binding['attempt_id']:08d}-{suffix}-{uuid.uuid4().hex}.json"
    closed_spec = {"goal": spec["goal"], "paths": spec["paths"], "evaluator": spec["evaluator"], "search": spec["search"]}
    prompt = bounded_prompt(workflow_prompt("critic") + "\n\n# Closed controller evidence\n" + json.dumps({"spec": closed_spec, "binding": {k: binding[k] for k in ("run_id", "attempt_id", "lease")}, "evidence": evidence, "final": final}, sort_keys=True))
    critic_cwd = state / "temporary" / f"critic-cwd-{uuid.uuid4().hex}"; critic_cwd.mkdir(parents=True)
    try:
        command = ["codex", "exec", "--ephemeral", "--ignore-user-config", "--ignore-rules", "--sandbox", "read-only", "--cwd", str(critic_cwd), "--output-schema", str(schema), "--output-last-message", str(receipt), "-"]
        result = run_bounded(command, cwd=critic_cwd, timeout=budget.timeout(min(120, spec["budgets"]["process_seconds"])), max_output=256 * 1024, input_text=prompt, env=codex_environment())
        if result.returncode or not receipt.exists():
            raise RuntimeError("critic failed or omitted receipt")
        return validate_binding(json.loads(receipt.read_text()), binding, critic=True)
    finally:
        receipt.unlink(missing_ok=True); shutil.rmtree(critic_cwd, ignore_errors=True)


def _attempt_binding(run_id: str, attempt_id: int, direction: str, baseline_oid: str, parent_tree: str, deadline: float) -> dict[str, Any]:
    return {"run_id": run_id, "attempt_id": attempt_id, "direction": direction, "generation": attempt_id, "baseline_oid": baseline_oid, "parent_tree": parent_tree, "lease": uuid.uuid4().hex, "deadline": deadline}


def execute_attempt(spec: Mapping[str, Any], state: Path, baseline_export: Path, budget: RunBudget, binding: Mapping[str, Any], parent_patch: Path | None) -> dict[str, Any]:
    attempt_id = binding["attempt_id"]; control = state / "temporary" / f"repo-{attempt_id:08d}-{binding['lease']}"; candidate = state / "temporary" / f"candidate-{attempt_id:08d}-{binding['lease']}"
    receipt = state / "temporary" / f"worker-{attempt_id:08d}-{binding['lease']}.json"
    try:
        budget.check_artifacts(); materialize(Path(spec["repository"]["path"]), control, spec["repository"]["baseline_oid"], budget)
        if parent_patch is not None and parent_patch.stat().st_size:
            if git(control, "apply", "--index", "--binary", str(parent_patch), check=False, timeout=budget.remaining()).returncode:
                raise ValidationError("parent patch no longer applies to pinned baseline")
        export_index(control, candidate, budget)
        schema = state / "schemas/worker-v1.json"; atomic_json(schema, receipt_json_schema("worker"), budget)
        supplied_spec = {"goal": spec["goal"], "paths": spec["paths"], "direction": binding["direction"], "budgets": {"process_seconds": spec["budgets"]["process_seconds"]}}
        prompt = bounded_prompt(workflow_prompt("worker") + "\n\n# Controller assignment\n" + json.dumps({"spec": supplied_spec, "binding": binding}, sort_keys=True))
        command = ["codex", "exec", "--ephemeral", "--ignore-user-config", "--ignore-rules", "--sandbox", "workspace-write", "--cwd", str(candidate), "--output-schema", str(schema), "--output-last-message", str(receipt), "-"]
        result = run_bounded(command, cwd=candidate, timeout=budget.timeout(min(spec["budgets"]["process_seconds"], binding["deadline"] - time.time())), max_output=256 * 1024, input_text=prompt, env=codex_environment())
        if result.returncode or not receipt.exists():
            raise RuntimeError("worker failed or omitted receipt")
        worker = validate_binding(json.loads(receipt.read_text()), binding)
        if worker["status"] != "completed":
            raise ValidationError("worker reported failed status")
        capture_workspace(candidate, control, budget)
        changed = inspect_candidate(control, spec["repository"]["baseline_oid"], spec["paths"]["allowed"], spec["paths"]["protected"], cached=True, budget=budget)
        if not changed:
            raise ValidationError("worker produced no scoped change")
        tree = git(control, "write-tree", timeout=budget.remaining()).stdout.strip(); patch = git(control, "diff", "--cached", "--binary", spec["repository"]["baseline_oid"], "--", text=False, timeout=budget.remaining(), max_output=min(64 * 1024 * 1024, budget.artifact_bytes)).stdout
        patch_path = state / "evidence" / f"{attempt_id:08d}.patch"
        with budget.reserve_artifact(len(patch)):
            patch_digest = exclusive_bytes(patch_path, patch)
        score = evaluate_tree(spec, control, baseline_export, state, budget)
        return {**score, "attempt_id": attempt_id, "direction": binding["direction"], "tree": tree, "changed": changed, "patch": str(patch_path), "patch_digest": patch_digest, "binding": dict(binding)}
    finally:
        receipt.unlink(missing_ok=True); shutil.rmtree(control, ignore_errors=True); shutil.rmtree(candidate, ignore_errors=True)


def verify_artifact(record: Mapping[str, Any], state: Path, budget: Any = None) -> Path:
    if budget is not None: budget.remaining()
    path = Path(record["patch"])
    try:
        path.resolve().relative_to((state / "evidence").resolve())
    except ValueError as exc:
        raise ValidationError("patch path escaped evidence directory") from exc
    if budget is not None: budget.remaining()
    if not path.is_file() or file_digest(path, budget) != record["patch_digest"]:
        raise ValidationError(f"patch artifact tamper for attempt {record.get('attempt_id', 'final')}")
    return path


def reconstruct_state(events: Sequence[Mapping[str, Any]], state: Path, spec: Mapping[str, Any], budget: Any = None) -> dict[str, Any]:
    if budget is not None: budget.remaining()
    if not events or events[0]["kind"] != "run-started":
        raise ValidationError("event log lacks canonical run-started event")
    start = events[0]["payload"]
    if start.get("spec_digest") != digest_json(spec):
        raise ValidationError("spec differs from immutable run binding")
    result = {"run_id": events[0]["run_id"], "started_epoch": start["started_epoch"], "baseline": None, "best_metric": None, "best_attempt_id": None, "best_tree": spec["repository"]["baseline_oid"], "best_patch": None, "best_patch_digest": hashlib.sha256(b"").hexdigest(), "winner_direction": None, "failures": 0, "leased": {}, "terminal": set(), "verified": {}, "critics": {}, "final_critics": {}, "decided": set(), "correction": None, "completed": None}
    for event in events[1:]:
        if budget is not None: budget.remaining()
        kind, payload, attempt_id = event["kind"], event["payload"], event["attempt_id"]
        if kind == "baseline-evaluated":
            result["baseline"] = payload; result["best_metric"] = payload["metric"]; result["best_tree"] = payload["tree"]
        elif kind == "lease-started":
            result["leased"][attempt_id] = payload
        elif kind == "attempt-verified":
            verify_artifact(payload, state, budget); result["terminal"].add(attempt_id); result["verified"][attempt_id] = payload
        elif kind in {"attempt-rejected", "lease-abandoned"}:
            result["terminal"].add(attempt_id); result["failures"] += 1
        elif kind == "critic-completed":
