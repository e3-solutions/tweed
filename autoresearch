            verify_artifact(payload, state, budget); result["decided"].add(attempt_id); result.update(best_metric=payload["metric"], best_attempt_id=attempt_id, best_tree=payload["tree"], best_patch=Path(payload["patch"]), best_patch_digest=payload["patch_digest"], winner_direction=payload["direction"], failures=0, correction=None)
