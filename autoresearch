        elif kind == "batch-outcome":
            if set(payload) != {"attempt_ids", "outcome", "winner", "failure_delta"}:
                raise ValidationError("invalid immutable batch outcome keys")
            attempt_ids, outcome, winner, failure_delta = payload["attempt_ids"], payload["outcome"], payload["winner"], payload["failure_delta"]
            if not isinstance(attempt_ids, list) or any(type(value) is not int for value in attempt_ids) or outcome not in {"none", "promotion", "correction"} or type(failure_delta) is not int or failure_delta < 0:
                raise ValidationError("invalid immutable batch outcome")
            result["decided"].update(attempt_ids)
            if outcome == "promotion":
                if not isinstance(winner, dict): raise ValidationError("promotion batch outcome lacks winner")
                verify_artifact(winner, state, budget)
                result.update(best_metric=winner["metric"], best_attempt_id=winner["attempt_id"], best_tree=winner["tree"], best_patch=Path(winner["patch"]), best_patch_digest=winner["patch_digest"], winner_direction=winner["direction"], failures=0, correction=None)
            elif outcome == "correction":
                if not isinstance(winner, dict): raise ValidationError("correction batch outcome lacks winner")
