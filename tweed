def find_codex() -> str:
    explicit = os.environ.get("CODEX_BIN")
    if explicit:
        resolved = shutil.which(explicit)
        if resolved:
            return resolved
        raise RuntimeError(f"Codex CLI not found: {explicit}")
    try:
        bundled = str(bundled_codex_path())
    except (FileNotFoundError, OSError):
        bundled = None
    candidates = [
        bundled,
        shutil.which("codex"),
        str(Path.home() / ".vite-plus/bin/codex"),
        "/Applications/ChatGPT.app/Contents/Resources/codex",
    ]
    for candidate in filter(None, candidates):
        try:
            subprocess.run(
                [candidate, "--version"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
                timeout=5,
            )
            return candidate
        except (OSError, subprocess.SubprocessError):
            continue
    raise RuntimeError("no working Codex CLI found")


def _contains_linear_endpoint(value: Any) -> bool:
    if isinstance(value, dict):
        return any(_contains_linear_endpoint(item) for item in value.values())
    if isinstance(value, list):
        return any(_contains_linear_endpoint(item) for item in value)
    if not isinstance(value, str):
        return False
    for match in re.finditer(r"https?://[^\s\"']+", value, re.IGNORECASE):
        if (urlsplit(match.group(0)).hostname or "").casefold() == "mcp.linear.app":
            return True
    return False


def _resolved_codex_mcp_servers(codex_bin: str, cwd: Path) -> list[dict[str, Any]]:
    """Resolve every effective MCP layer without starting a model thread."""
    command = [codex_bin]
    for override in ("features.hooks=false", *LINEAR_PLUGIN_DISABLE_OVERRIDES):
        command.extend(("-c", override))
    command.extend(("mcp", "list", "--json"))
    env = {**os.environ, **dict.fromkeys(LINEAR_CHILD_ENV_NAMES, "")}
    try:
        completed = run_bounded_process(
            command,
            cwd=cwd,
            timeout=15,
            stdout_limit=2_097_152,
            stderr_limit=65_536,
            env=env,
        )
    except (OSError, subprocess.SubprocessError, OutputLimitExceeded) as error:
        raise RuntimeError("cannot safely resolve Codex MCP configuration") from error
    if completed.returncode != 0:
        raise RuntimeError("cannot safely resolve Codex MCP configuration")
    try:
        value = json.loads(completed.stdout)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("Codex returned invalid MCP configuration") from error
    if not isinstance(value, list) or len(value) > 1024:
        raise RuntimeError("Codex returned invalid MCP configuration")
    if not all(isinstance(server, dict) for server in value):
        raise RuntimeError("Codex returned invalid MCP configuration")
    return value


def linear_mcp_disable_overrides(codex_bin: str, cwd: Path) -> tuple[str, ...]:
    """Replace every effective Linear MCP with a complete disabled transport."""
    disabled: list[str] = []
    for server in _resolved_codex_mcp_servers(codex_bin, cwd):
        name = server.get("name")
        if not isinstance(name, str):
            raise RuntimeError("Codex returned an invalid MCP server name")
        is_linear = LINEAR_MCP_ALIAS_RE.search(
            name
        ) is not None or _contains_linear_endpoint(server.get("transport"))
        if not is_linear:
            continue
        if CODEX_CONFIG_BARE_KEY_RE.fullmatch(name) is None:
            raise RuntimeError(
                f"cannot safely disable Linear MCP alias {name!r}: "
                "Codex config overrides require a bare key"
            )
        transport = server.get("transport")
        transport_type = transport.get("type") if isinstance(transport, dict) else None
        if transport_type == "stdio":
            replacement = 'command="tweed-linear-disabled"'
        elif transport_type in {"sse", "streamable_http"}:
            replacement = 'url="https://tweed-linear-disabled.invalid"'
        else:
            raise RuntimeError(
                f"cannot safely disable Linear MCP alias {name!r}: "
                "Codex returned an unsupported transport"
            )
        disabled.append(f"mcp_servers.{name}={{{replacement},enabled=false}}")
    return tuple(dict.fromkeys(disabled))


def incident_mcp_overrides(
    codex_bin: str, cwd: Path, allowed_tools: tuple[str, ...]
) -> tuple[str, ...]:
    """Expose only explicitly selected read-only tools from configured MCP servers."""
    selected: dict[str, list[str]] = {}
    for qualified in allowed_tools:
        match = MCP_TOOL_RE.fullmatch(qualified)
        if match is None:
            raise RuntimeError("incident MCP tools must use the exact server/tool form")
        selected.setdefault(match.group("server"), []).append(match.group("tool"))
    overrides: list[str] = []
    for server in _resolved_codex_mcp_servers(codex_bin, cwd):
        name = server.get("name")
        if (
            not isinstance(name, str)
            or CODEX_CONFIG_BARE_KEY_RE.fullmatch(name) is None
        ):
            raise RuntimeError("Codex returned an unsafe MCP server name")
        is_linear = LINEAR_MCP_ALIAS_RE.search(
            name
        ) is not None or _contains_linear_endpoint(server.get("transport"))
        tools = selected.get(name)
        if tools and is_linear:
            allowed_linear_reads = {
                "fetch",
                "get_issue",
                "list_comments",
                "list_issues",
                "search",
            }
            if not set(tools).issubset(allowed_linear_reads):
                raise RuntimeError(
                    "incident collection permits only explicitly allowlisted read-only Linear tools"
                )
        if tools:
            overrides.append(
                f"mcp_servers.{name}.enabled_tools="
                + json.dumps(sorted(set(tools)), separators=(",", ":"))
            )
            overrides.append(f"mcp_servers.{name}.supports_parallel_tool_calls=false")
            continue
        transport = server.get("transport")
        transport_type = transport.get("type") if isinstance(transport, dict) else None
        if transport_type == "stdio":
            replacement = 'command="tweed-mcp-disabled"'
        elif transport_type in {"sse", "streamable_http"}:
            replacement = 'url="https://tweed-mcp-disabled.invalid"'
        else:
            raise RuntimeError("Codex returned an unsupported MCP transport")
        overrides.append(f"mcp_servers.{name}={{{replacement},enabled=false}}")
    return tuple(overrides)


def incident_app_overrides(allowed_tools: tuple[str, ...]) -> tuple[str, ...]:
    """Disable all connectors, then expose only audited per-tool reads."""
    selected: dict[str, set[str]] = {}
    for qualified in allowed_tools:
        server, tool = qualified.split("/", 1)
        if tool not in INCIDENT_MCP_READ_ALLOWLIST.get(server, set()):
            raise RuntimeError(
                f"incident app tool is not in the audited read allowlist: {qualified}"
            )
        selected.setdefault(server, set()).add(tool)
    overrides = ["apps.default.enabled=false"]
    for server, tools in sorted(selected.items()):
        if CODEX_CONFIG_BARE_KEY_RE.fullmatch(server) is None:
            raise RuntimeError("incident app connector has an unsafe name")
        overrides.extend(
            (
                f"apps.{server}.enabled=true",
                f"apps.{server}.destructive_enabled=false",
                f"apps.{server}.open_world_enabled=false",
                f"apps.{server}.enabled_tools="
                + json.dumps(sorted(tools), separators=(",", ":")),
            )
        )
    return tuple(overrides)


