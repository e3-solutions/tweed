def repository_root(cwd: str | Path | None = None) -> Path:
    current = Path(cwd or os.getcwd()).expanduser().resolve()
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=current,
            capture_output=True,
            check=True,
            text=True,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Tweed requires a Git repository: {current}") from error
    return Path(result.stdout.strip()).resolve()


def git(root: Path, *args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", *args], cwd=root, capture_output=True, text=True, check=False
    )
    if check and result.returncode:
        raise RuntimeError(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result.stdout.strip()


def sha256_file(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as source:
        while chunk := source.read(1024 * 1024):
            value.update(chunk)
    return value.hexdigest()


def git_stdout_sha256(root: Path, *args: str) -> str:
    value = hashlib.sha256()
    with tempfile.TemporaryFile() as error_file:
        try:
            process = subprocess.Popen(
                ["git", *args],
                cwd=root,
                stdout=subprocess.PIPE,
                stderr=error_file,
            )
        except OSError as error:
            raise RuntimeError(f"git {' '.join(args)} could not start") from error
        assert process.stdout is not None
        with process.stdout:
            while chunk := process.stdout.read(1024 * 1024):
                value.update(chunk)
        returncode = process.wait()
        if returncode:
            error_file.seek(0)
            detail = error_file.read(4096).decode("utf-8", errors="replace").strip()
            raise RuntimeError(detail or f"git {' '.join(args)} failed")
    return value.hexdigest()


def cached_input_digest(root: Path, path: Path) -> str:
    canonical_root = root.resolve()
    canonical = path.resolve()
    if canonical.is_relative_to(canonical_root):
        relative = str(canonical.relative_to(canonical_root))
        tracked = bool(
            git(root, "ls-files", "--error-unmatch", "--", relative, check=False)
        )
        clean = (
            subprocess.run(
                ["git", "diff", "--quiet", "--", relative], cwd=root, check=False
            ).returncode
            == 0
        )
        if tracked and clean:
            blob = git(root, "rev-parse", f":{relative}")
            identity = digest(f"{canonical_root}\0{relative}")
            memo = state_root().parent / "cache/file-hashes" / f"{identity}.json"
            if memo.exists():
                try:
                    value = json.loads(memo.read_text(encoding="utf-8"))
                except (OSError, json.JSONDecodeError):
                    value = {}
                if value.get("blob") == blob and re.fullmatch(
                    r"[a-f0-9]{64}", str(value.get("sha256", ""))
                ):
                    return value["sha256"]
            value = sha256_file(canonical)
            atomic_json_write(memo, {"blob": blob, "sha256": value})
            return value
    return sha256_file(canonical)


def repository_cache_identity(root: Path) -> dict[str, Any]:
    status_bytes = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
        cwd=root,
        capture_output=True,
        check=True,
    ).stdout
    untracked: dict[str, str] = {}
    for raw in status_bytes.split(b"\0"):
        if raw.startswith(b"?? "):
            relative = raw[3:].decode("utf-8", errors="surrogateescape")
            path = (root / relative).resolve()
            if not path.is_relative_to(root.resolve()) or not path.is_file():
                raise RuntimeError(
                    "uncertain untracked repository state; evidence is not cacheable"
                )
            untracked[relative] = sha256_file(path)
    return {
        "head": git(root, "rev-parse", "HEAD"),
        "index_tree": git(root, "write-tree"),
        "status_sha256": hashlib.sha256(status_bytes).hexdigest(),
        "worktree_diff_sha256": git_stdout_sha256(root, "diff", "--binary", "HEAD"),
        "untracked": untracked,
    }


def evidence_cache_key(
    root: Path,
    argv: list[str],
    *,
    dependency_paths: list[Path],
    configuration_paths: list[Path],
    declared_environment: list[str],
    tool_versions: dict[str, str],
    artifact_hashes: list[str],
    execution_controls: dict[str, Any] | None = None,
) -> tuple[str, dict[str, Any]]:
    if not argv or not all(isinstance(part, str) for part in argv):
        raise RuntimeError("evidence cache requires exact command arguments")
    if not tool_versions or any(not value for value in tool_versions.values()):
        raise RuntimeError("evidence cache requires every tool/runtime version")

    def path_state(paths: list[Path]) -> dict[str, str]:
        values: dict[str, str] = {}
        for raw in paths:
            path = raw.expanduser().resolve()
            if not path.is_file():
                raise RuntimeError(f"evidence cache input is unavailable: {path}")
            values[str(path)] = cached_input_digest(root, path)
        return values

    environment = {
        name: digest(os.environ[name]) if name in os.environ else "ABSENT"
        for name in sorted(set(declared_environment))
    }
    document = {
        "schema_version": CACHE_SCHEMA_VERSION,
        "repository": repository_cache_identity(root),
        "argv": argv,
        "dependencies": path_state(dependency_paths),
        "configuration": path_state(configuration_paths),
        "declared_environment": environment,
        "tool_versions": dict(sorted(tool_versions.items())),
        "artifact_hashes": sorted(artifact_hashes),
        "execution_controls": execution_controls or {},
    }
    encoded = json.dumps(
        document, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest(), document


def evidence_cache_path(key: str) -> Path:
    if not re.fullmatch(r"[a-f0-9]{64}", key):
        raise RuntimeError("invalid evidence cache key")
    return state_root().parent / "cache/evidence" / f"{key}.json"


def load_cached_evidence(
    key: str, key_document: dict[str, Any]
) -> dict[str, Any] | None:
    path = evidence_cache_path(key)
    if not path.exists():
        return None
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if value.get("key") != key or value.get("key_document") != key_document:
        return None
    result = value.get("result")
    return result if isinstance(result, dict) else None


def save_cached_evidence(
    key: str, key_document: dict[str, Any], result: dict[str, Any]
) -> None:
    atomic_json_write(
        evidence_cache_path(key),
        {"key": key, "key_document": key_document, "result": result},
    )


def config_path() -> Path:
    explicit = os.environ.get("TWEED_CONFIG")
    if explicit:
        return Path(explicit).expanduser()
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return base.expanduser() / "tweed/config.json"


def load_config() -> dict[str, Any]:
    path = config_path()
    if not path.exists():
        return {"folders": {}}
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"could not read Tweed config at {path}: {error}") from error
    if not isinstance(data, dict) or not isinstance(data.get("folders", {}), dict):
        raise RuntimeError(f"invalid Tweed config at {path}")
    data.setdefault("folders", {})
    return data


def atomic_json_write(path: Path, data: dict[str, Any], mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as file:
            json.dump(data, file, indent=2, sort_keys=True)
            file.write("\n")
            file.flush()
            os.fsync(file.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def atomic_bytes_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as file:
            file.write(data)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(temporary, mode)
        try:
            os.link(temporary, path)
        except FileExistsError:
            if path.read_bytes() != data:
                raise RuntimeError(f"content-addressed artifact collision: {path.name}")
        finally:
            os.unlink(temporary)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def artifact_root(run_id: str) -> Path:
    return state_path(run_id).parent / "artifacts"


def artifact_manifest_path(run_id: str) -> Path:
    return artifact_root(run_id) / "manifest.json"


def empty_artifact_manifest(run_id: str) -> dict[str, Any]:
    return {
        "schema_version": ARTIFACT_MANIFEST_VERSION,
        "run_id": run_id,
        "artifacts": {},
    }


def load_artifact_manifest(run_id: str) -> dict[str, Any]:
    path = artifact_manifest_path(run_id)
    if not path.exists():
        return empty_artifact_manifest(run_id)
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(
            f"invalid artifact manifest for {run_id}: {error}"
        ) from error
    if (
        not isinstance(manifest, dict)
        or manifest.get("schema_version") != ARTIFACT_MANIFEST_VERSION
        or manifest.get("run_id") != run_id
        or not isinstance(manifest.get("artifacts"), dict)
    ):
        raise RuntimeError(f"invalid artifact manifest for {run_id}")
    return manifest


def put_artifact(
    run_id: str,
    logical_name: str,
    content: str | bytes,
    *,
    media_type: str = "text/markdown; charset=utf-8",
    manifest: dict[str, Any] | None = None,
) -> dict[str, Any]:
    if not re.fullmatch(r"[a-z][a-z0-9-]*", logical_name):
        raise RuntimeError(f"invalid artifact name: {logical_name}")
    data = content.encode("utf-8") if isinstance(content, str) else content
    sha256 = hashlib.sha256(data).hexdigest()
    relative = Path("sha256") / sha256
    target = artifact_root(run_id) / relative
    atomic_bytes_write(target, data)
    entry = {
        "sha256": sha256,
        "bytes": len(data),
        "media_type": media_type,
        "path": str(relative),
    }
    value = manifest if manifest is not None else load_artifact_manifest(run_id)
    value["artifacts"][logical_name] = entry
    atomic_json_write(artifact_manifest_path(run_id), value)
    return entry


def read_artifact(run_id: str, logical_name: str) -> bytes:
    manifest = load_artifact_manifest(run_id)
    try:
        entry = manifest["artifacts"][logical_name]
        relative = Path(entry["path"])
        expected_hash = entry["sha256"]
        expected_bytes = entry["bytes"]
    except (KeyError, TypeError) as error:
        raise RuntimeError(f"artifact is missing: {logical_name}") from error
    root = artifact_root(run_id).resolve()
    if relative.is_absolute() or ".." in relative.parts:
        raise RuntimeError(f"unsafe artifact path: {relative}")
    target = (root / relative).resolve()
    if not target.is_relative_to(root) or not target.is_file():
        raise RuntimeError(f"artifact is missing: {logical_name}")
    data = target.read_bytes()
    actual = hashlib.sha256(data).hexdigest()
    if actual != expected_hash or len(data) != expected_bytes:
        raise RuntimeError(f"artifact integrity check failed: {logical_name}")
    return data


def artifact_manifest_digest(manifest: dict[str, Any]) -> str:
    encoded = json.dumps(
        manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def incident_policy(window_start: str, window_end: str, impact: str) -> dict[str, Any]:
    def parse_utc(value: str, label: str) -> datetime:
        if not isinstance(value, str) or not value.endswith("Z"):
            raise RuntimeError(f"{label} must be an RFC3339 UTC timestamp ending in Z")
        try:
            parsed = datetime.fromisoformat(value[:-1] + "+00:00")
        except ValueError as error:
            raise RuntimeError(
                f"{label} must be a valid RFC3339 UTC timestamp"
            ) from error
        if parsed.tzinfo != timezone.utc:
            raise RuntimeError(f"{label} must be UTC")
        return parsed

    start = parse_utc(window_start, "incident window start")
    end = parse_utc(window_end, "incident window end")
    if start >= end:
        raise RuntimeError("incident window start must be before its end")
    if end - start > MAX_INCIDENT_WINDOW:
        raise RuntimeError("incident window cannot exceed seven days")
    normalized_impact = " ".join(str(impact).split())
    if not normalized_impact:
        raise RuntimeError("incident impact policy is required")
    if len(normalized_impact.encode("utf-8")) > 1000:
        raise RuntimeError("incident impact policy exceeds the byte limit")
    return {
        "schema": "dev.tweed.incident-policy.v1",
        "environment": "production",
        "window_start": window_start,
        "window_end": window_end,
        "impact_policy": normalized_impact,
    }


def incident_tool_allowlist(values: list[str]) -> tuple[str, ...]:
    normalized = tuple(dict.fromkeys(item.strip() for item in values if item.strip()))
    if not normalized:
        raise RuntimeError("incident requires at least one --mcp-tool server/tool")
    if len(normalized) > 32 or any(
        MCP_TOOL_RE.fullmatch(item) is None for item in normalized
    ):
        raise RuntimeError("incident MCP tools must be bounded server/tool names")
    for qualified in normalized:
        server, tool = qualified.split("/", 1)
        if tool not in INCIDENT_MCP_READ_ALLOWLIST.get(server, set()):
            raise RuntimeError(
                f"incident MCP tool is not in the audited read allowlist: {qualified}"
            )
    servers = {item.split("/", 1)[0].casefold() for item in normalized}
    missing_existing_work = {"github", "linear"} - servers
    if missing_existing_work:
        raise RuntimeError(
            "incident requires existing-work MCP reads from: "
            + ", ".join(sorted(missing_existing_work))
        )
    return normalized


def _stdio_mcp_transport(server: dict[str, Any], root: Path) -> dict[str, Any]:
    """Validate a resolved Codex stdio transport without accepting shell syntax."""
    transport = server.get("transport")
    if not isinstance(transport, dict) or transport.get("type") != "stdio":
        raise RuntimeError("incident direct MCP requires a configured stdio server")
    command = transport.get("command")
    args = transport.get("args") or []
    configured_env = transport.get("env") or {}
    forwarded_env_names = transport.get("env_vars") or []
    configured_cwd = transport.get("cwd")
    if not isinstance(command, str) or not command or "\x00" in command:
        raise RuntimeError("incident direct MCP has an invalid command")
    if not isinstance(args, list) or not all(
        isinstance(value, str) and "\x00" not in value for value in args
    ):
        raise RuntimeError("incident direct MCP has invalid arguments")
    if not isinstance(configured_env, dict) or not all(
        isinstance(key, str)
        and isinstance(value, str)
        and "\x00" not in key
        and "\x00" not in value
        for key, value in configured_env.items()
    ):
        raise RuntimeError("incident direct MCP has an invalid environment")
    if not isinstance(forwarded_env_names, list) or not all(
        isinstance(name, str) and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name)
        for name in forwarded_env_names
    ):
        raise RuntimeError(
            "incident direct MCP has invalid forwarded environment names"
        )
    requested_protected = set(LINEAR_CHILD_ENV_NAMES) & (
        set(forwarded_env_names) | set(configured_env)
    )
    if requested_protected:
        raise RuntimeError(
            "incident direct MCP requested protected environment names: "
            + ", ".join(sorted(requested_protected))
        )
    if configured_cwd is not None and not isinstance(configured_cwd, str):
        raise RuntimeError("incident direct MCP has an invalid working directory")
    child_env = {
        name: os.environ[name]
        for name in sorted(MCP_CHILD_ENV_ALLOWLIST | set(forwarded_env_names))
        if name in os.environ
    }
    child_env.update(configured_env)
    return {
        "command": [command, *args],
        "cwd": Path(configured_cwd).expanduser() if configured_cwd else root,
        "env": child_env,
        "startup_timeout": min(
            60.0, max(5.0, float(server.get("startup_timeout_sec") or 15))
        ),
        "tool_timeout": min(
            120.0, max(5.0, float(server.get("tool_timeout_sec") or 60))
        ),
    }


def _stdio_mcp_session(
    server: dict[str, Any],
    root: Path,
    calls: list[dict[str, Any]],
    *,
    expected_tools_digest: str | None = None,
    result_budget: int = MAX_INCIDENT_EVIDENCE_BYTES,
    deadline: float | None = None,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], str]:
    """Discover and call one configured MCP using bounded JSON-RPC over stdio."""
    now = time.monotonic()
    session_deadline = min(
        now + MAX_MCP_SESSION_WALL_SECONDS,
        deadline if deadline is not None else float("inf"),
    )
    if session_deadline <= now:
        raise RuntimeError("incident direct MCP exceeded its overall deadline")
    config = _stdio_mcp_transport(server, root)
    process = subprocess.Popen(
        config["command"],
        cwd=config["cwd"],
        env=config["env"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )

    def abort_setup() -> None:
        if process.poll() is None:
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(process.pid, signal.SIGKILL)
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=2)
        for stream in (process.stdin, process.stdout, process.stderr):
            if stream is not None:
                with contextlib.suppress(OSError):
                    stream.close()

    if process.stdin is None or process.stdout is None or process.stderr is None:
        abort_setup()
        raise RuntimeError("incident direct MCP did not expose stdio")
    stderr = bytearray()
    stderr_exceeded = threading.Event()
    stderr_stop = threading.Event()
    try:
        stderr_fd = process.stderr.fileno()
        os.set_blocking(stderr_fd, False)
        os.set_blocking(process.stdin.fileno(), False)
    except BaseException:
        abort_setup()
        raise

    def kill_group(sig: int = signal.SIGKILL) -> None:
        if process.poll() is not None:
            return
        try:
            os.killpg(process.pid, sig)
        except ProcessLookupError:
            pass

    def drain_stderr() -> None:
        stderr_selector = selectors.DefaultSelector()
        try:
            stderr_selector.register(stderr_fd, selectors.EVENT_READ)
            while not stderr_stop.is_set():
                if not stderr_selector.select(0.2):
                    if process.poll() is not None:
                        return
                    continue
                try:
                    chunk = os.read(stderr_fd, 65536)
                except (BlockingIOError, OSError):
                    if stderr_stop.is_set():
                        return
                    continue
                if not chunk:
                    return
                remaining = 65537 - len(stderr)
                if remaining > 0:
                    stderr.extend(chunk[:remaining])
                if len(stderr) > 65536:
                    stderr_exceeded.set()
                    kill_group()
                    return
        finally:
            stderr_selector.close()

    stderr_thread = threading.Thread(target=drain_stderr, daemon=True)
    selector = selectors.DefaultSelector()
    try:
        stderr_thread.start()
        selector.register(process.stdout, selectors.EVENT_READ)
    except BaseException:
        stderr_stop.set()
        abort_setup()
        stderr_thread.join(timeout=1)
        selector.close()
        raise
    stdout_buffer = bytearray()
    stdout_total = 0

    def send(message: dict[str, Any], timeout: float) -> None:
        encoded = (
            json.dumps(
                message,
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=False,
                allow_nan=False,
            ).encode("utf-8")
            + b"\n"
        )
        write_deadline = min(time.monotonic() + timeout, session_deadline)
        offset = 0
        write_selector = selectors.DefaultSelector()
        try:
            write_selector.register(process.stdin.fileno(), selectors.EVENT_WRITE)
            while offset < len(encoded):
                remaining = write_deadline - time.monotonic()
                if remaining <= 0:
                    raise RuntimeError("incident direct MCP input timed out")
                if process.poll() is not None:
                    raise RuntimeError("incident direct MCP closed its input")
                if not write_selector.select(min(remaining, 0.5)):
                    continue
                try:
                    written = os.write(process.stdin.fileno(), encoded[offset:])
                except BlockingIOError:
                    continue
                except (BrokenPipeError, OSError) as error:
                    raise RuntimeError(
                        "incident direct MCP closed its input"
                    ) from error
                if written <= 0:
                    raise RuntimeError("incident direct MCP closed its input")
                offset += written
        finally:
            write_selector.close()

    def receive(request_id: int, timeout: float) -> dict[str, Any]:
        nonlocal stdout_total
        response_deadline = min(time.monotonic() + timeout, session_deadline)
        while True:
            while b"\n" in stdout_buffer:
                line, _, remainder = stdout_buffer.partition(b"\n")
                stdout_buffer[:] = remainder
                if not line.strip():
                    continue
                try:
                    response = json.loads(line, parse_constant=reject_non_json_number)
                except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
                    raise RuntimeError(
                        "incident direct MCP returned invalid JSON"
                    ) from error
                if not isinstance(response, dict):
                    raise RuntimeError(
                        "incident direct MCP returned an invalid response"
                    )
                if response.get("jsonrpc") != "2.0":
                    raise RuntimeError("incident direct MCP returned invalid JSON-RPC")
                if "method" in response:
                    method = response.get("method")
                    inbound_id = response.get("id")
                    if not isinstance(method, str):
                        raise RuntimeError(
                            "incident direct MCP returned an invalid request"
                        )
                    if "id" not in response:
                        continue
                    if not isinstance(inbound_id, (str, int)) or isinstance(
                        inbound_id, bool
                    ):
                        raise RuntimeError(
                            "incident direct MCP returned an invalid request ID"
                        )
                    if method == "ping":
                        send(
                            {"jsonrpc": "2.0", "id": inbound_id, "result": {}},
                            min(timeout, 5.0),
                        )
                    else:
                        send(
                            {
                                "jsonrpc": "2.0",
                                "id": inbound_id,
                                "error": {
                                    "code": -32601,
                                    "message": "Method not supported by Tweed",
                                },
                            },
                            min(timeout, 5.0),
                        )
                    continue
                response_id = response.get("id")
                if response_id == request_id and type(response_id) is not int:
                    raise RuntimeError(
                        "incident direct MCP returned an invalid response ID"
                    )
                if type(response_id) is int and response_id == request_id:
                    has_result = "result" in response
                    has_error = "error" in response
                    if has_result == has_error:
                        raise RuntimeError(
                            "incident direct MCP returned an invalid response envelope"
                        )
                    if has_error:
                        error_value = response["error"]
                        if (
                            not isinstance(error_value, dict)
                            or type(error_value.get("code")) is not int
                            or not isinstance(error_value.get("message"), str)
                        ):
                            raise RuntimeError(
                                "incident direct MCP returned an invalid error envelope"
                            )
                        raise McpToolCallError(
                            "incident direct MCP call failed with JSON-RPC code "
                            + str(error_value["code"])
                        )
                    result = response.get("result")
                    if not isinstance(result, dict):
                        raise RuntimeError(
                            "incident direct MCP returned an invalid result"
                        )
                    return result
            remaining = response_deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError("incident direct MCP timed out")
            if stderr_exceeded.is_set():
                raise RuntimeError("incident direct MCP stderr exceeded its byte limit")
            if process.poll() is not None:
                raise RuntimeError("incident direct MCP exited before responding")
            ready = selector.select(min(remaining, 0.5))
            if not ready:
                continue
            chunk = os.read(process.stdout.fileno(), 65536)
            if not chunk:
                raise RuntimeError("incident direct MCP closed its output")
            stdout_total += len(chunk)
            if stdout_total > MAX_INCIDENT_EVIDENCE_BYTES:
                raise RuntimeError("incident direct MCP stdout exceeded its byte limit")
            stdout_buffer.extend(chunk)

    try:
        send(
            {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "protocolVersion": "2025-06-18",
                    "capabilities": {},
                    "clientInfo": {"name": "tweed", "version": "0.2.0"},
                },
            },
            config["startup_timeout"],
        )
        initialized = receive(1, config["startup_timeout"])
        protocol_version = initialized.get("protocolVersion")
        if protocol_version not in SUPPORTED_MCP_PROTOCOL_VERSIONS:
            raise RuntimeError("incident direct MCP negotiated an unsupported protocol")
        capabilities = initialized.get("capabilities")
        server_info = initialized.get("serverInfo")
        if (
            not isinstance(capabilities, dict)
            or not isinstance(capabilities.get("tools"), dict)
            or not isinstance(server_info, dict)
            or not isinstance(server_info.get("name"), str)
            or not server_info["name"]
            or not isinstance(server_info.get("version"), str)
            or not server_info["version"]
        ):
            raise RuntimeError(
                "incident direct MCP returned an invalid initialize result"
            )
        send(
            {
                "jsonrpc": "2.0",
                "method": "notifications/initialized",
                "params": {},
            },
            config["startup_timeout"],
        )
        tools: list[dict[str, Any]] = []
        cursor: str | None = None
        for page in range(8):
            request_id = 2 + page
            params = {"cursor": cursor} if cursor is not None else {}
            send(
                {
                    "jsonrpc": "2.0",
                    "id": request_id,
                    "method": "tools/list",
                    "params": params,
                },
                config["startup_timeout"],
            )
            listed = receive(request_id, config["startup_timeout"])
            page_tools = listed.get("tools")
            if not isinstance(page_tools, list) or not all(
                isinstance(tool, dict)
                and isinstance(tool.get("name"), str)
                and isinstance(tool.get("inputSchema"), dict)
                for tool in page_tools
            ):
                raise RuntimeError("incident direct MCP returned an invalid tool list")
            tools.extend(page_tools)
            if len(tools) > 256:
                raise RuntimeError("incident direct MCP returned too many tools")
            next_cursor = listed.get("nextCursor")
            if next_cursor is None:
                break
            if not isinstance(next_cursor, str) or not next_cursor:
                raise RuntimeError(
                    "incident direct MCP returned an invalid tool cursor"
                )
            cursor = next_cursor
        else:
            raise RuntimeError(
                "incident direct MCP tool listing exceeded its page limit"
            )
        tool_names = [tool["name"] for tool in tools]
        if len(set(tool_names)) != len(tool_names):
            raise RuntimeError("incident direct MCP returned invalid tool names")
        tools_encoded = json.dumps(
            tools,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
            allow_nan=False,
        ).encode("utf-8")
        tools_digest = hashlib.sha256(tools_encoded).hexdigest()
        if expected_tools_digest is not None and tools_digest != expected_tools_digest:
            raise RuntimeError(
                "incident direct MCP tool catalog changed during collection"
            )
        results: list[dict[str, Any]] = []
        for sequence, call in enumerate(calls, 100):
            if result_budget < MAX_INCIDENT_DIRECT_RECEIPT_BYTES:
                raise RuntimeError(
                    "incident MCP evidence has insufficient remaining byte budget"
                )
            started = time.monotonic()
            send(
                {
                    "jsonrpc": "2.0",
                    "id": sequence,
                    "method": "tools/call",
                    "params": {
                        "name": call["tool"],
                        "arguments": call["arguments"],
                    },
                },
                config["tool_timeout"],
            )
            try:
                result = receive(sequence, config["tool_timeout"])
            except McpToolCallError as error:
                receipt = {
                    "server": call["server"],
                    "tool": call["tool"],
                    "qualified_tool": call["qualified_tool"],
                    "arguments": call["arguments"],
                    "result": None,
                    "error": str(error),
                    "status": "failed",
                    "protocol_version": protocol_version,
                    "tools_sha256": tools_digest,
                    "duration_ms": round((time.monotonic() - started) * 1000),
                }
                receipt_bytes = json.dumps(
                    receipt,
                    sort_keys=True,
                    separators=(",", ":"),
                    ensure_ascii=False,
                    allow_nan=False,
                ).encode("utf-8")
                result_budget -= len(receipt_bytes)
                if result_budget < 0:
                    raise RuntimeError("incident MCP evidence exceeds the byte limit")
                results.append(receipt)
                continue
            result_bytes = json.dumps(
                result,
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=False,
                allow_nan=False,
            ).encode("utf-8")
            if len(result_bytes) > MAX_INCIDENT_DIRECT_CALL_BYTES:
                raise RuntimeError("incident direct MCP result exceeded its byte limit")
            receipt = {
                "server": call["server"],
                "tool": call["tool"],
                "qualified_tool": call["qualified_tool"],
                "arguments": call["arguments"],
                "result": result,
                "error": (
                    "incident direct MCP tool reported an error"
                    if result.get("isError") is True
                    else None
                ),
                "status": "failed" if result.get("isError") is True else "completed",
                "protocol_version": protocol_version,
                "tools_sha256": tools_digest,
                "duration_ms": round((time.monotonic() - started) * 1000),
            }
            receipt_bytes = json.dumps(
                receipt,
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=False,
                allow_nan=False,
            ).encode("utf-8")
            result_budget -= len(receipt_bytes)
            if result_budget < 0:
                raise RuntimeError("incident MCP evidence exceeds the byte limit")
            if result.get("isError") is True:
                results.append(receipt)
                continue
            results.append(receipt)
        return tools, results, protocol_version
    finally:
        selector.close()
        with contextlib.suppress(OSError):
            process.stdin.close()
        kill_group(signal.SIGTERM)
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            kill_group()
            process.wait(timeout=2)
        stderr_stop.set()
        stderr_thread.join(timeout=1)
        if stderr_thread.is_alive():
            raise RuntimeError("incident direct MCP stderr did not close")
        with contextlib.suppress(OSError):
            process.stdout.close()
        with contextlib.suppress(OSError):
            process.stderr.close()


def discover_direct_mcp_tools(
    root: Path,
    allowed_tools: tuple[str, ...],
    *,
    deadline: float | None = None,
) -> tuple[tuple[str, ...], dict[str, dict[str, Any]], dict[str, dict[str, Any]]]:
    """Discover selected stdio tools; other MCPs remain model-facing."""
    selected: dict[str, set[str]] = {}
    for qualified in allowed_tools:
        match = MCP_TOOL_RE.fullmatch(qualified)
        assert match is not None
        selected.setdefault(match.group("server"), set()).add(match.group("tool"))
    servers = {
        server["name"]: server
        for server in _resolved_codex_mcp_servers(find_codex(), root)
        if isinstance(server.get("name"), str)
    }
    model_tools: list[str] = []
    catalog: dict[str, dict[str, Any]] = {}
    direct_servers: dict[str, dict[str, Any]] = {}
    for qualified in allowed_tools:
        match = MCP_TOOL_RE.fullmatch(qualified)
        assert match is not None
        server_name = match.group("server")
        server = servers.get(server_name)
        transport = server.get("transport") if isinstance(server, dict) else None
        if not isinstance(transport, dict) or transport.get("type") != "stdio":
            model_tools.append(qualified)
            continue
        if match.group("tool") not in DIRECT_MCP_READ_ALLOWLIST.get(server_name, set()):
            raise RuntimeError(
                f"incident direct MCP tool is not in the audited read allowlist: {qualified}"
            )
        if server_name in direct_servers:
            continue
        tools, _, protocol_version = _stdio_mcp_session(
            server, root, [], deadline=deadline
        )
        tools_digest = hashlib.sha256(
            json.dumps(
                tools, sort_keys=True, separators=(",", ":"), ensure_ascii=False
            ).encode("utf-8")
        ).hexdigest()
        by_name = {tool["name"]: tool for tool in tools}
        for tool_name in sorted(selected[server_name]):
            tool = by_name.get(tool_name)
            qualified_tool = f"{server_name}/{tool_name}"
            if tool is None:
                raise RuntimeError(
                    f"configured incident MCP tool is unavailable: {server_name}/{tool_name}"
                )
            annotations = tool.get("annotations")
            if isinstance(annotations, dict) and (
                annotations.get("destructiveHint") is True
                or annotations.get("readOnlyHint") is False
            ):
                raise RuntimeError(
                    f"incident direct MCP tool conflicts with the read-only policy: {qualified_tool}"
                )
            input_schema = tool["inputSchema"]
            validate_json_schema_definition(input_schema, input_schema)
            catalog[qualified_tool] = {
                "description": tool.get("description", ""),
                "input_schema": input_schema,
                "protocol_version": protocol_version,
                "tools_sha256": tools_digest,
            }
        direct_servers[server_name] = server
    return tuple(model_tools), catalog, direct_servers


def _resolve_local_schema_ref(root: dict[str, Any], reference: str) -> dict[str, Any]:
    if not reference.startswith("#/"):
        raise RuntimeError("incident direct MCP schema uses a non-local reference")
    value: Any = root
    for raw_part in reference[2:].split("/"):
        part = raw_part.replace("~1", "/").replace("~0", "~")
        if not isinstance(value, dict) or part not in value:
            raise RuntimeError("incident direct MCP schema has an invalid reference")
        value = value[part]
    if not isinstance(value, dict):
        raise RuntimeError("incident direct MCP schema reference is not an object")
    return value


SUPPORTED_DIRECT_SCHEMA_KEYWORDS = {
    "$defs",
    "$ref",
    "$schema",
    "additionalProperties",
    "anyOf",
    "const",
    "default",
    "description",
    "enum",
    "format",
    "items",
    "maximum",
    "maxItems",
    "maxLength",
    "minimum",
    "minItems",
    "minLength",
    "nullable",
    "properties",
    "required",
    "title",
    "type",
}


def validate_json_schema_definition(
    schema: dict[str, Any], root_schema: dict[str, Any], depth: int = 0
) -> None:
    """Reject unsupported or malformed MCP schemas before exposing their tools."""
    if depth > 32:
        raise RuntimeError("incident direct MCP schema exceeds the nesting limit")
    if set(schema) - SUPPORTED_DIRECT_SCHEMA_KEYWORDS:
        raise RuntimeError("incident direct MCP schema uses unsupported constraints")
    if "$ref" in schema:
        reference = schema["$ref"]
        if not isinstance(reference, str):
            raise RuntimeError("incident direct MCP schema has an invalid reference")
        validate_json_schema_definition(
            _resolve_local_schema_ref(root_schema, reference), root_schema, depth + 1
        )
    definitions = schema.get("$defs", {})
    if not isinstance(definitions, dict) or not all(
        isinstance(key, str) and isinstance(child, dict)
        for key, child in definitions.items()
    ):
        raise RuntimeError("incident direct MCP schema has invalid definitions")
    for child in definitions.values():
        validate_json_schema_definition(child, root_schema, depth + 1)
    schema_type = schema.get("type")
    if schema_type is not None and not (
        isinstance(schema_type, str)
        or (
            isinstance(schema_type, list)
            and schema_type
            and all(isinstance(item, str) for item in schema_type)
        )
    ):
        raise RuntimeError("incident direct MCP schema has an invalid type")
    properties = schema.get("properties", {})
    if not isinstance(properties, dict) or not all(
        isinstance(key, str) and isinstance(child, dict)
        for key, child in properties.items()
    ):
        raise RuntimeError("incident direct MCP schema has invalid properties")
    for child in properties.values():
        validate_json_schema_definition(child, root_schema, depth + 1)
    required = schema.get("required", [])
    if not isinstance(required, list) or not all(
        isinstance(item, str) for item in required
    ):
        raise RuntimeError("incident direct MCP schema has invalid required keys")
    if not set(required).issubset(properties):
        raise RuntimeError("incident direct MCP schema requires unknown keys")
    any_of = schema.get("anyOf", [])
    if not isinstance(any_of, list) or not all(
        isinstance(child, dict) for child in any_of
    ):
        raise RuntimeError("incident direct MCP schema has invalid anyOf")
    for child in any_of:
        validate_json_schema_definition(child, root_schema, depth + 1)
    items = schema.get("items")
    if items is not None:
        if not isinstance(items, dict):
            raise RuntimeError("incident direct MCP schema has invalid items")
        validate_json_schema_definition(items, root_schema, depth + 1)
    additional = schema.get("additionalProperties", True)
    if not isinstance(additional, (bool, dict)):
        raise RuntimeError(
            "incident direct MCP schema has invalid additionalProperties"
        )
    if isinstance(additional, dict):
        validate_json_schema_definition(additional, root_schema, depth + 1)


def validate_json_schema_value(
    value: Any,
    schema: dict[str, Any],
    root_schema: dict[str, Any],
    path: str = "$",
    depth: int = 0,
) -> None:
    """Validate the bounded JSON Schema subset used by audited direct MCP tools."""
    if depth > 32:
        raise RuntimeError("incident direct MCP arguments exceed the nesting limit")
    if set(schema) - SUPPORTED_DIRECT_SCHEMA_KEYWORDS:
        raise RuntimeError("incident direct MCP schema uses unsupported constraints")
    if "$ref" in schema:
        reference = schema["$ref"]
        if not isinstance(reference, str):
            raise RuntimeError("incident direct MCP schema has an invalid reference")
        validate_json_schema_value(
            value,
            _resolve_local_schema_ref(root_schema, reference),
            root_schema,
            path,
            depth + 1,
        )
    if "anyOf" in schema:
        options = schema["anyOf"]
        if not isinstance(options, list) or not options:
            raise RuntimeError("incident direct MCP schema has invalid anyOf")
        matched = False
        for option in options:
            if not isinstance(option, dict):
                raise RuntimeError("incident direct MCP schema has invalid anyOf")
            try:
                validate_json_schema_value(value, option, root_schema, path, depth + 1)
            except RuntimeError:
                continue
            matched = True
            break
        if not matched:
            raise RuntimeError(
                f"incident direct MCP arguments violate schema at {path}"
            )
    if "const" in schema and value != schema["const"]:
        raise RuntimeError(f"incident direct MCP arguments violate const at {path}")
    if "enum" in schema:
        enum = schema["enum"]
        if not isinstance(enum, list) or value not in enum:
            raise RuntimeError(f"incident direct MCP arguments violate enum at {path}")
    expected_type = schema.get("type")
    if expected_type is not None:
        expected_types = (
            expected_type if isinstance(expected_type, list) else [expected_type]
        )
        if not all(isinstance(item, str) for item in expected_types):
            raise RuntimeError("incident direct MCP schema has an invalid type")
        if schema.get("nullable") is True:
            expected_types = [*expected_types, "null"]

        def matches_type(name: str) -> bool:
            return {
                "array": isinstance(value, list),
                "boolean": isinstance(value, bool),
                "integer": isinstance(value, int) and not isinstance(value, bool),
                "null": value is None,
                "number": isinstance(value, (int, float))
                and not isinstance(value, bool),
                "object": isinstance(value, dict),
                "string": isinstance(value, str),
            }.get(name, False)

        if not any(matches_type(name) for name in expected_types):
            raise RuntimeError(
                f"incident direct MCP arguments have wrong type at {path}"
            )
    if isinstance(value, dict):
        properties = schema.get("properties", {})
        required = schema.get("required", [])
        if not isinstance(properties, dict) or not isinstance(required, list):
            raise RuntimeError(
                "incident direct MCP schema has invalid object constraints"
            )
        if not all(isinstance(item, str) for item in required):
            raise RuntimeError("incident direct MCP schema has invalid required keys")
        missing = set(required) - set(value)
        if missing:
            raise RuntimeError(
                f"incident direct MCP arguments omit required keys at {path}"
            )
        additional = schema.get("additionalProperties", True)
        if additional is False and set(value) - set(properties):
            raise RuntimeError(f"incident direct MCP arguments add keys at {path}")
        if not isinstance(additional, (bool, dict)):
            raise RuntimeError(
                "incident direct MCP schema has invalid additionalProperties"
            )
        for key, child in value.items():
            child_schema = properties.get(key)
            if child_schema is None and isinstance(additional, dict):
                child_schema = additional
            if child_schema is None:
                continue
            if not isinstance(child_schema, dict):
                raise RuntimeError("incident direct MCP schema property is invalid")
            validate_json_schema_value(
                child, child_schema, root_schema, f"{path}.{key}", depth + 1
            )
    if isinstance(value, list):
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            raise RuntimeError(f"incident direct MCP array is too long at {path}")
        if "minItems" in schema and len(value) < schema["minItems"]:
            raise RuntimeError(f"incident direct MCP array is too short at {path}")
        item_schema = schema.get("items")
        if item_schema is not None:
            if not isinstance(item_schema, dict):
                raise RuntimeError("incident direct MCP schema items are invalid")
            for index, child in enumerate(value):
                validate_json_schema_value(
                    child, item_schema, root_schema, f"{path}[{index}]", depth + 1
                )
    if isinstance(value, str):
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            raise RuntimeError(f"incident direct MCP string is too long at {path}")
        if "minLength" in schema and len(value) < schema["minLength"]:
            raise RuntimeError(f"incident direct MCP string is too short at {path}")
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if "maximum" in schema and value > schema["maximum"]:
            raise RuntimeError(f"incident direct MCP number is too large at {path}")
        if "minimum" in schema and value < schema["minimum"]:
            raise RuntimeError(f"incident direct MCP number is too small at {path}")


def validate_direct_mcp_call(
    call: dict[str, Any],
    catalog: dict[str, dict[str, Any]],
    policy: dict[str, Any],
) -> dict[str, Any]:
    if not isinstance(call, dict) or set(call) != {
        "qualified_tool",
        "arguments_json",
    }:
        raise RuntimeError("incident collector returned an invalid direct MCP call")
    qualified = call.get("qualified_tool")
    arguments_json = call.get("arguments_json")
    if qualified not in catalog or not isinstance(arguments_json, str):
        raise RuntimeError(
            "incident collector returned a non-allowlisted direct MCP call"
        )
    encoded = arguments_json.encode("utf-8")
    if len(encoded) > MAX_INCIDENT_DIRECT_ARGUMENT_BYTES:
        raise RuntimeError("incident direct MCP arguments exceeded their byte limit")

    def reject_constant(_value: str) -> None:
        raise ValueError("non-finite number")

    try:
        arguments = json.loads(arguments_json, parse_constant=reject_constant)
    except (json.JSONDecodeError, ValueError) as error:
        raise RuntimeError("incident direct MCP arguments are invalid JSON") from error
    if not isinstance(arguments, dict):
        raise RuntimeError("incident direct MCP arguments must be a JSON object")
    schema = catalog[qualified].get("input_schema")
    properties = schema.get("properties", {}) if isinstance(schema, dict) else {}
    required = schema.get("required", []) if isinstance(schema, dict) else []
    if not isinstance(properties, dict) or not isinstance(required, list):
        raise RuntimeError("incident direct MCP exposed an invalid input schema")
    if set(arguments) - set(properties) or not set(required).issubset(arguments):
        raise RuntimeError("incident direct MCP arguments do not match its schema")
    if {"since", "until"}.issubset(properties):
        arguments = {
            **arguments,
            "since": policy["window_start"],
            "until": policy["window_end"],
        }
    validate_json_schema_value(arguments, schema, schema)
    lines = arguments.get("lines")
    if lines is not None and (
        not isinstance(lines, int) or isinstance(lines, bool) or not 1 <= lines <= 1000
    ):
        raise RuntimeError("incident direct MCP lines must be between 1 and 1000")
    server_name, tool = qualified.split("/", 1)
    return {
        "server": server_name,
        "tool": tool,
        "qualified_tool": qualified,
        "arguments": arguments,
    }


def execute_direct_mcp_calls(
    root: Path,
    calls: list[dict[str, Any]],
    catalog: dict[str, dict[str, Any]],
    servers: dict[str, dict[str, Any]],
    policy: dict[str, Any],
    result_budget: int = MAX_INCIDENT_EVIDENCE_BYTES,
    deadline: float | None = None,
) -> list[dict[str, Any]]:
    validated = [validate_direct_mcp_call(call, catalog, policy) for call in calls]
    grouped: dict[str, list[dict[str, Any]]] = {}
    for call in validated:
        grouped.setdefault(call["server"], []).append(call)
    results: list[dict[str, Any]] = []
    for server_name, server_calls in grouped.items():
        expected = catalog[server_calls[0]["qualified_tool"]]["tools_sha256"]
        _, server_results, _ = _stdio_mcp_session(
            servers[server_name],
            root,
            server_calls,
            expected_tools_digest=expected,
            result_budget=result_budget,
            deadline=deadline,
        )
        results.extend(server_results)
        result_budget -= len(
            json.dumps(
                server_results,
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=False,
                allow_nan=False,
            ).encode("utf-8")
        )
        if result_budget < 0:
            raise RuntimeError("incident MCP evidence exceeds the byte limit")
    return results


def validate_incident_dispatch_budget(
    items: list[Any],
    direct_results: list[dict[str, Any]],
    planned: list[dict[str, Any]],
) -> int:
    model_call_count = sum(
        1
        for wrapped in items
        if getattr(getattr(wrapped, "root", wrapped), "type", None) == "mcpToolCall"
    )
    if model_call_count + len(direct_results) + len(planned) > MAX_INCIDENT_MCP_CALLS:
        raise RuntimeError("incident collector exceeded the MCP call limit")
    direct_bytes = len(
        json.dumps(
            direct_results,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
            allow_nan=False,
        ).encode("utf-8")
    )
    if direct_bytes >= MAX_INCIDENT_EVIDENCE_BYTES:
        raise RuntimeError("incident MCP evidence exceeds the byte limit")
    return MAX_INCIDENT_EVIDENCE_BYTES - direct_bytes


def canonical_mcp_tool_name(server: object, tool: object) -> str:
    """Map Codex app-connector receipt names back to configured server/tool names."""
    server_name = str(server)
    tool_name = str(tool)
    if server_name == "codex_apps" and "." in tool_name:
        app_server, app_tool = tool_name.split(".", 1)
        if CODEX_CONFIG_BARE_KEY_RE.fullmatch(app_server) and re.fullmatch(
            r"[A-Za-z0-9_.:-]+", app_tool
        ):
            return f"{app_server}/{app_tool}"
    return f"{server_name}/{tool_name}"


def canonical_mcp_evidence(
    items: list[Any],
    policy: dict[str, Any],
    allowed_tools: tuple[str, ...],
    direct_calls: list[dict[str, Any]] | None = None,
    coverage: str | None = None,
) -> bytes:
    """Bind actual completed MCP thread items without trusting model-authored citations."""
    allowed = set(allowed_tools)
    calls: list[dict[str, Any]] = []
    successful_calls = 0
    call_ids: set[str] = set()
    for wrapped in items:
        item = getattr(wrapped, "root", wrapped)
        if getattr(item, "type", None) != "mcpToolCall":
            continue
        server = getattr(item, "server", None)
        tool = getattr(item, "tool", None)
        qualified = canonical_mcp_tool_name(server, tool)
        if qualified not in allowed:
            raise RuntimeError(
                f"incident collector used a non-allowlisted MCP tool: {qualified}"
            )
        call_id = str(getattr(item, "id", ""))
        if not call_id or call_id in call_ids:
            raise RuntimeError("incident MCP evidence has empty or duplicate call IDs")
        call_ids.add(call_id)

        def json_value(value: Any) -> Any:
            if hasattr(value, "model_dump"):
                return value.model_dump(mode="json", by_alias=True)
            return value

        status_value = getattr(
            getattr(item, "status", None), "value", getattr(item, "status", None)
        )
        result = json_value(getattr(item, "result", None))
        result_is_error = isinstance(result, dict) and result.get("isError") is True
        completed = (
            status_value == "completed"
            and getattr(item, "error", None) is None
            and result is not None
            and not result_is_error
        )
        calls.append(
            {
                "sequence": len(calls) + 1,
                "source": "codex-turn",
                "call_id": call_id,
                "server": server,
                "tool": tool,
                "qualified_tool": qualified,
                "arguments": json_value(getattr(item, "arguments", None)),
                "result": result if completed else None,
                "status": "completed" if completed else "failed",
                # Connector error text may contain remote payloads or credentials.
                # The receipt records the failure without persisting that text.
                "error": None if completed else "model-facing MCP call failed",
                "duration_ms": getattr(item, "duration_ms", None),
            }
        )
        if completed:
            successful_calls += 1
        if len(calls) > MAX_INCIDENT_MCP_CALLS:
            raise RuntimeError("incident collector exceeded the MCP call limit")
    for direct in direct_calls or []:
        qualified = direct.get("qualified_tool")
        if qualified not in allowed:
            raise RuntimeError(
                f"incident collector used a non-allowlisted MCP tool: {qualified}"
            )
        status = direct.get("status", "completed")
        if status not in {"completed", "failed"}:
            raise RuntimeError(f"incident MCP call has invalid status: {qualified}")
        if status == "completed" and not isinstance(direct.get("result"), dict):
            raise RuntimeError(f"incident MCP call returned no result: {qualified}")
        if status == "failed" and not isinstance(direct.get("error"), str):
            raise RuntimeError(f"incident MCP call omitted its error: {qualified}")
        direct_call_id = f"runner-stdio:{len(calls) + 1}"
        if direct_call_id in call_ids:
            raise RuntimeError("incident MCP evidence has duplicate call IDs")
        call_ids.add(direct_call_id)
        calls.append(
            {
                "sequence": len(calls) + 1,
                "source": "runner-stdio",
                "call_id": direct_call_id,
                "server": direct.get("server"),
                "tool": direct.get("tool"),
                "qualified_tool": qualified,
                "arguments": direct.get("arguments"),
                "result": direct.get("result"),
                "status": status,
                "error": direct.get("error"),
                "duration_ms": direct.get("duration_ms"),
                "protocol_version": direct.get("protocol_version"),
                "tools_sha256": direct.get("tools_sha256"),
            }
        )
        if status == "completed":
            successful_calls += 1
        if len(calls) > MAX_INCIDENT_MCP_CALLS:
            raise RuntimeError("incident collector exceeded the MCP call limit")
    if not successful_calls:
        raise RuntimeError(
            "incident collector produced no successful MCP evidence calls"
        )
    envelope = {
        "schema_version": INCIDENT_RECEIPT_SCHEMA_VERSION,
        "policy": policy,
        "policy_sha256": digest(
            json.dumps(
                policy, sort_keys=True, separators=(",", ":"), ensure_ascii=False
            )
        ),
        "allowlist": list(allowed_tools),
        "coverage": coverage,
        "calls": calls,
    }
    encoded = json.dumps(
        envelope,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        allow_nan=False,
    ).encode("utf-8")
    if len(encoded) > MAX_INCIDENT_EVIDENCE_BYTES:
        raise RuntimeError("incident MCP evidence exceeds the byte limit")
    return encoded


def manifest_digest(run_id: str) -> str:
    return artifact_manifest_digest(load_artifact_manifest(run_id))


def snapshot_artifact_manifest(run_id: str) -> tuple[Path, str]:
    manifest = load_artifact_manifest(run_id)
    encoded = json.dumps(
        manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")
    sha256 = hashlib.sha256(encoded).hexdigest()
    path = artifact_root(run_id) / "manifests" / f"{sha256}.json"
    if not path.exists():
        atomic_bytes_write(path, encoded)
    return path, sha256


def restore_manifest_snapshot(run_id: str, state: dict[str, Any]) -> None:
    expected = state.get("artifact_manifest_digest")
    reference = state.get("artifact_manifest")
    if not expected or not reference:
        raise RuntimeError(f"run {run_id} has no committed artifact manifest")
    path = Path(reference).resolve()
    root = (artifact_root(run_id) / "manifests").resolve()
    if not path.is_relative_to(root) or path.name != f"{expected}.json":
        raise RuntimeError(f"run {run_id} has an unsafe artifact manifest reference")
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(
            f"run {run_id} artifact manifest snapshot is invalid"
        ) from error
    if artifact_manifest_digest(manifest) != expected:
        raise RuntimeError(f"run {run_id} artifact manifest snapshot is corrupt")
    atomic_json_write(artifact_manifest_path(run_id), manifest)


def save_config(config: dict[str, Any]) -> None:
    atomic_json_write(config_path(), config)


def normalize_github_origin(remote: str) -> str:
    value = remote.strip()
    patterns = (
        r"https://github\.com/(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+?)(?:\.git)?",
        r"git@github\.com:(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+?)(?:\.git)?",
        r"ssh://git@github\.com(?::22)?/(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+?)(?:\.git)?",
    )
    for pattern in patterns:
        match = re.fullmatch(pattern, value, re.IGNORECASE)
        if match:
            return f"{match.group('owner')}/{match.group('repo')}"
    raise RuntimeError(
        "origin must be a standard HTTPS or SSH GitHub owner/repository remote"
    )


def linear_binding_repository(root: Path) -> dict[str, str]:
    names = subprocess.run(
        ["git", "remote"],
        cwd=root,
        capture_output=True,
        text=True,
        check=False,
    )
    if names.returncode:
        raise RuntimeError("Git remotes could not be read for Linear binding")
    if "origin" not in names.stdout.split():
        return {"identity": str(root.resolve()), "identity_source": "canonical-root"}
    result = subprocess.run(
        ["git", "remote", "get-url", "--all", "origin"],
        cwd=root,
        capture_output=True,
        text=True,
        check=False,
    )
    remotes = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if result.returncode or not remotes:
        raise RuntimeError("origin could not be read for Linear binding")
    normalized = {normalize_github_origin(remote) for remote in remotes}
    if len(normalized) != 1:
        raise RuntimeError("origin has ambiguous GitHub repository identities")
    return {"identity": normalized.pop(), "identity_source": "origin"}


def linear_sync_config_path() -> Path:
    override = os.environ.get(LINEAR_SYNC_CONFIG_DIR_ENV, "")
    directory = (
        Path(override).expanduser() if override else Path.home() / ".codex/linear-sync"
    )
    return directory.resolve() / "repos.json"


def _strict_json_object(raw: bytes, label: str) -> dict[str, Any]:
    def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ValueError(f"duplicate key: {key}")
            result[key] = value
        return result

    try:
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object)
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        raise RuntimeError(f"{label} is malformed") from error
    if not isinstance(value, dict):
        raise RuntimeError(f"{label} must contain a JSON object")
    return value


def _binding_name(value: object, label: str) -> str:
    if (
        not isinstance(value, str)
        or not value
        or value != value.strip()
        or len(value.encode("utf-8")) > 512
        or any(ord(character) < 0x20 for character in value)
    ):
        raise RuntimeError(f"Linear binding {label} must be an exact non-empty name")
    return value


def linear_binding_digest(binding: dict[str, Any]) -> str:
    protected = {
        key: binding.get(key)
        for key in (
            "repository",
            "identity_source",
            "team",
            "project",
            "source",
            "disabled",
            "reason",
        )
    }
    encoded = json.dumps(
        protected, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def _validate_shared_binding(repo: str, value: object) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise RuntimeError(f"Linear sync binding for {repo} must be an object")
    if value.get("disabled") is True:
        if set(value) - {"disabled", "reason"}:
            raise RuntimeError(f"disabled Linear sync binding for {repo} is malformed")
        reason = value.get("reason", "")
        if not isinstance(reason, str):
            raise RuntimeError(
                f"disabled Linear sync binding reason for {repo} is invalid"
            )
        return {"disabled": True, "reason": reason.strip()}
    if set(value) - {"team", "project", "disabled"} or value.get("disabled") not in {
        None,
        False,
    }:
        raise RuntimeError(f"Linear sync binding for {repo} is malformed")
    return {
        "disabled": False,
        "team": _binding_name(value.get("team"), "team"),
        "project": _binding_name(value.get("project"), "project"),
    }


def shared_linear_binding(root: Path) -> dict[str, Any] | None:
    path = linear_sync_config_path()
    try:
        raw = path.read_bytes()
    except FileNotFoundError:
        return None
    except OSError as error:
        raise RuntimeError(f"Linear sync bindings could not be read: {path}") from error
    if len(raw) > MAX_BINDING_CONFIG_BYTES:
        raise RuntimeError("Linear sync bindings exceed the byte limit")
    document = _strict_json_object(raw, "Linear sync bindings")
    repos = document.get("repos")
    if not isinstance(repos, dict):
        raise RuntimeError("Linear sync bindings must contain a repos object")
    folded_github_repos: set[str] = set()
    for repo, value in repos.items():
        if not isinstance(repo, str) or not repo or repo != repo.strip():
            raise RuntimeError("Linear sync bindings contain an invalid repository key")
        if re.fullmatch(r"[^/]+/[^/]+", repo):
            folded = repo.casefold()
            if folded in folded_github_repos:
                raise RuntimeError(
                    "Linear sync bindings contain ambiguous repository keys"
                )
            folded_github_repos.add(folded)
        _validate_shared_binding(repo, value)
    repository = linear_binding_repository(root)
    value = repos.get(repository["identity"])
    if value is None:
        return None
    binding = {
        **repository,
        **_validate_shared_binding(repository["identity"], value),
        "repository": repository["identity"],
        "source": "linear-progress-sync",
        "config_path": str(path),
        "config_digest": hashlib.sha256(raw).hexdigest(),
    }
    binding["binding_digest"] = linear_binding_digest(binding)
    return binding


def linear_project(root: Path) -> str | None:
    entry = load_config()["folders"].get(str(root), {})
    value = entry.get("linear_project") if isinstance(entry, dict) else None
    return value.strip() if isinstance(value, str) and value.strip() else None


def set_linear_project(root: Path, project: str | None) -> None:
    config = load_config()
    if project:
        config["folders"][str(root)] = {"linear_project": project.strip()}
    else:
        config["folders"].pop(str(root), None)
    save_config(config)


def legacy_linear_binding(root: Path) -> dict[str, Any] | None:
    entry = load_config()["folders"].get(str(root), {})
    if not isinstance(entry, dict):
        return None
    project = entry.get("linear_project")
    if not isinstance(project, str) or not project.strip():
        return None
    repository = linear_binding_repository(root)
    team = entry.get("linear_team")
    binding = {
        **repository,
        "repository": repository["identity"],
        "source": "legacy-tweed",
        "config_path": str(config_path()),
        "disabled": False,
        "team": team.strip() if isinstance(team, str) and team.strip() else None,
        "project": project.strip(),
    }
    binding["binding_digest"] = linear_binding_digest(binding)
    return binding


def set_legacy_linear_binding(
    root: Path, team: str | None, project: str | None
) -> None:
    config = load_config()
    if team is not None or project is not None:
        config["folders"][str(root)] = {
            "linear_team": _binding_name(team, "team"),
            "linear_project": _binding_name(project, "project"),
        }
    else:
        config["folders"].pop(str(root), None)
    save_config(config)


def resolve_linear_binding(
    root: Path,
    *,
    team_override: str | None = None,
    project_override: str | None = None,
    required: bool = True,
) -> dict[str, Any] | None:
    repository = linear_binding_repository(root)
    if team_override is not None or project_override is not None:
        if team_override is None or project_override is None:
            raise RuntimeError(
                "explicit Linear override requires both --team and --project"
            )
        binding = {
            **repository,
            "repository": repository["identity"],
            "source": "command",
            "config_path": None,
            "disabled": False,
            "team": _binding_name(team_override, "team"),
            "project": _binding_name(project_override, "project"),
        }
        binding["binding_digest"] = linear_binding_digest(binding)
        return binding
    shared = shared_linear_binding(root)
    if shared is not None:
        return shared
    legacy = legacy_linear_binding(root)
    if legacy is not None:
        if legacy.get("team"):
            return legacy
        legacy["invalid_reason"] = (
            "legacy Tweed binding lacks a Linear team; configure linear-progress-sync "
            "or use explicit --team and --project"
        )
        return legacy
    if required:
        raise RuntimeError(
            "no Linear team/project binding; configure linear-progress-sync for this "
            "repository or use explicit --team and --project"
        )
    return None


def state_root() -> Path:
    explicit = os.environ.get("TWEED_STATE_HOME")
    if explicit:
        return Path(explicit).expanduser()
    base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return base.expanduser() / "tweed/runs"


def state_path(run_id: str) -> Path:
    if not re.fullmatch(r"tw_[a-f0-9]{16}", run_id):
        raise RuntimeError("invalid Tweed run ID")
    return state_root() / run_id / "run.json"


def save_run(state: dict[str, Any]) -> None:
    state.setdefault("run_schema_version", RUN_SCHEMA_VERSION)
    if artifact_manifest_path(state["run_id"]).exists():
        manifest_path, manifest_sha256 = snapshot_artifact_manifest(state["run_id"])
        state["artifact_manifest"] = str(manifest_path)
        state["artifact_manifest_digest"] = manifest_sha256
    path = state_path(state["run_id"])
    atomic_json_write(path, state)


def load_run(run_id: str) -> dict[str, Any]:
    path = state_path(run_id)
    if not path.exists():
        raise RuntimeError(f"unknown Tweed run: {run_id}")
    state = json.loads(path.read_text())
    if state.get("run_schema_version") == RUN_SCHEMA_VERSION:
        expected = state.get("artifact_manifest_digest")
        if expected and (
            not artifact_manifest_path(run_id).exists()
            or manifest_digest(run_id) != expected
        ):
            restore_manifest_snapshot(run_id, state)
        return state
    previous_schema = state.get("run_schema_version")
    if previous_schema not in {None, 1, 2}:
        raise RuntimeError(f"run {run_id} uses an unsupported state schema")
    backup = path.parent / f"run.v{previous_schema or 1}.json"
    if not backup.exists():
        atomic_bytes_write(backup, path.read_bytes())
    manifest = load_artifact_manifest(run_id)
    issue = state.get("issue")
    if isinstance(issue, dict) and isinstance(issue.get("description"), str):
        put_artifact(
            run_id,
            "linear-description",
            issue["description"],
            manifest=manifest,
        )
    if isinstance(state.get("report_markdown"), str):
        put_artifact(
            run_id,
            str(state.get("phase") or "report"),
            state["report_markdown"],
            manifest=manifest,
        )
    if isinstance(state.get("workflow_text"), str):
        put_artifact(
            run_id,
            "workflow",
            state["workflow_text"],
            manifest=manifest,
        )
    if (
        previous_schema == 2
        and state.get("operation") == "phase"
        and state.get("state") in {"sync-pending", "sync-blocked"}
    ):
        state["legacy_description_sync"] = True
    state["run_schema_version"] = RUN_SCHEMA_VERSION
    save_run(state)
    return state


def new_run_id() -> str:
    global LAST_RUN_ID
    LAST_RUN_ID = "tw_" + uuid.uuid4().hex[:16]
    return LAST_RUN_ID


def record_active_turn(turn_id: str) -> None:
    if not LAST_RUN_ID:
        return
    path = state_path(LAST_RUN_ID)
    if not path.exists():
        return
    state = json.loads(path.read_text())
    if state.get("state") == "running":
        state["turn_id"] = turn_id
        atomic_json_write(path, state)


def mark_run_terminal(run_id: str | None, state_name: str, error: str) -> None:
    if not run_id:
        return
    path = state_path(run_id)
    if not path.exists():
        return
    state = json.loads(path.read_text())
    previous_state = state.get("state")
    if previous_state != "running":
        if state.get("operation") != "incident" or previous_state not in {
            "collecting",
            "evidence-frozen",
        }:
            return
        state["failed_from_state"] = previous_state
    state["state"] = state_name
    state["error"] = safe_error(error)
    if LAST_TURN_ID:
        state["turn_id"] = LAST_TURN_ID
    save_run(state)


def digest(text: str) -> str:
    return hashlib.sha256(text.encode()).hexdigest()


def metadata_block(metadata: dict[str, Any]) -> str:
    return (
        f"{META_START}\n## Tweed\n\n```json\n"
        f"{json.dumps(metadata, indent=2, sort_keys=True)}\n```\n{META_END}"
    )


def section_block(name: str, body: str) -> str:
    return f"<!-- tweed:{name}:start -->\n{body.strip()}\n<!-- tweed:{name}:end -->"


def parse_metadata(description: str) -> dict[str, Any]:
    start = description.find(META_START)
    end = description.find(META_END)
    if start < 0 or end < start:
        try:
            return journal.parse_genesis(description).metadata
        except journal.JournalError as error:
            raise RuntimeError(
                "Linear issue is not a Tweed issue: metadata is missing"
            ) from error
    block = description[start + len(META_START) : end]
    match = re.search(r"```json\s*(\{.*\})\s*```", block, re.DOTALL)
    if not match:
        raise RuntimeError("Linear issue has invalid Tweed metadata")
    metadata = json.loads(match.group(1))
    if metadata.get("schema_version") != SCHEMA_VERSION:
        raise RuntimeError("Linear issue uses an unsupported Tweed schema")
    return metadata


def section_body(description: str, name: str) -> str | None:
    pattern = re.compile(
        rf"^[ \t]*<!-- tweed:{re.escape(name)}:start -->\r?\n(?P<body>.*?)\r?\n"
        rf"^[ \t]*<!-- tweed:{re.escape(name)}:end -->",
        re.DOTALL | re.MULTILINE,
    )
    match = pattern.search(description)
    return match.group("body").strip() if match else None


def intake_description(
    kind: str,
    request: str,
    root: Path,
    project: str,
    run_id: str,
    *,
    team: str | None = None,
    binding_source: str | None = None,
    binding_digest: str | None = None,
    binding_repository: str | None = None,
    extra_metadata: dict[str, Any] | None = None,
) -> str:
    stage = "needs-rca" if kind == "problem" else "needs-scope"
    metadata = {
        "schema_version": SCHEMA_VERSION,
        "kind": kind,
        "stage": stage,
        "contract_revision": 0,
        "repository": str(root),
        "planning_base": git(root, "rev-parse", "HEAD"),
        "integration_branch": None,
        "integration_commit": None,
        "linear_project": project,
        "last_run": run_id,
    }
    if team is not None:
        metadata.update(
            {
                "linear_team": team,
                "linear_binding_source": binding_source,
                "linear_binding_digest": binding_digest,
                "linear_binding_repository": binding_repository,
            }
        )
    if extra_metadata:
        reserved = set(metadata) & set(extra_metadata)
        if reserved:
            raise RuntimeError(
                "incident metadata cannot replace genesis fields: "
                + ", ".join(sorted(reserved))
            )
        metadata.update(extra_metadata)
    return journal.build_genesis_description(
        metadata,
        f"# Request\n\n{request}",
    ) + (
        "\nTweed keeps this request stable. Complete RCA, scope, implementation, "
        "and review handoffs are appended below as human-readable Linear comments; "
        "the current stage is derived from their validated hash chain.\n"
    )


def evidence_from_scope(scope: str | None) -> str:
    if not scope:
        return ""
    match = re.search(
        r"^## Repository state\s*$\n(?P<body>.*?)(?=^## |\Z)",
        scope,
        re.MULTILINE | re.DOTALL,
    )
    return match.group(0).strip() if match else ""


def freeze_linear_snapshot(
    run_id: str, issue: dict[str, Any], workflow: str
) -> dict[str, Any]:
    manifest = load_artifact_manifest(run_id)
    put_artifact(run_id, "linear-description", issue["description"], manifest=manifest)
    snapshot_metadata = {
        key: issue[key]
        for key in (
            "identifier",
            "url",
            "title",
            "revision",
            "digest",
            "issue_id",
            "snapshot_digest",
            "content_digest",
            "genesis_digest",
        )
        if key in issue
    }
    put_artifact(
        run_id,
        "linear-snapshot",
        json.dumps(
            snapshot_metadata,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ),
        media_type="application/json; charset=utf-8",
        manifest=manifest,
    )
    if isinstance(issue.get("transport_snapshot"), dict):
        put_artifact(
            run_id,
            "linear-transport-snapshot",
            json.dumps(
                issue["transport_snapshot"],
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=False,
            ),
            media_type="application/json; charset=utf-8",
            manifest=manifest,
        )
    for name in ("request", "rca", "scope", "implementation", "review"):
        body = section_body(issue["description"], name)
        if body is not None:
            put_artifact(run_id, name, body, manifest=manifest)
    put_artifact(
        run_id,
        "evidence",
        evidence_from_scope(section_body(issue["description"], "scope")),
        manifest=manifest,
    )
    put_artifact(run_id, "workflow", workflow, manifest=manifest)
    return snapshot_metadata


def artifact_reference(run_id: str, logical_name: str) -> dict[str, Any]:
    manifest = load_artifact_manifest(run_id)
    try:
        entry = manifest["artifacts"][logical_name]
    except KeyError as error:
        raise RuntimeError(
            f"required phase artifact is missing: {logical_name}"
        ) from error
    read_artifact(run_id, logical_name)
    return {
        "name": logical_name,
        "sha256": entry["sha256"],
        "bytes": entry["bytes"],
        "media_type": entry["media_type"],
        "path": str((artifact_root(run_id) / entry["path"]).resolve()),
    }


def build_phase_packet(
    run_id: str, issue: dict[str, Any], phase: Phase
) -> dict[str, Any]:
    required = list(PHASE_ARTIFACTS[phase.command])
    if (
        phase.command == "scope"
        and parse_metadata(issue["description"])["kind"] == "feature"
    ):
        required.remove("rca")
    references = [artifact_reference(run_id, name) for name in required]
    manifest_path, manifest_sha256 = snapshot_artifact_manifest(run_id)
    packet = {
        "schema": "dev.tweed.phase-packet.v1",
        "run_id": run_id,
        "phase": phase.command,
        "issue": {
            "identifier": issue["identifier"],
            "url": issue["url"],
            "title": issue["title"],
            "revision": issue["revision"],
            "description_digest": issue["digest"],
            "metadata": parse_metadata(issue["description"]),
        },
        "artifacts": references,
        "artifact_manifest": {
            "path": str(manifest_path.resolve()),
            "sha256": manifest_sha256,
        },
        "instructions": (
            "Read only referenced artifacts needed for this phase. Verify each file's "
            "SHA-256 before use. Inspect the verified manifest and open another artifact "
            "by exact name only when genuinely required. Do not load transcripts or the "
            "complete Linear description."
        ),
    }
    if phase.command == "scope":
        packet["repository_evidence_contract"] = (
            "In ## Repository state, every path → SHA-256|ABSENT entry must use a "
            "repository-relative path (example: src/example.ts), never an absolute or "
            ".. path. artifacts[].path, artifact_manifest.path, run-state, and content-"
            "artifact paths are input provenance only and must not appear there."
        )
    encoded = json.dumps(packet, ensure_ascii=False, separators=(",", ":")).encode(
        "utf-8"
    )
    if len(encoded) > 8192:
        raise RuntimeError("phase packet exceeded the 8 KiB bound")
    return packet


def load_frozen_issue(state: dict[str, Any]) -> dict[str, Any]:
    issue = dict(state["issue"])
    if isinstance(issue.get("description"), str):
        description = issue["description"]
    else:
        description = read_artifact(state["run_id"], "linear-description").decode(
            "utf-8"
        )
        issue["description"] = description
    issue.setdefault("digest", digest(issue["description"]))
    if not isinstance(issue.get("revision"), str) or not issue["revision"]:
        raise RuntimeError(
            "legacy run lacks authoritative Linear revision provenance; "
            "reasoning and synchronization remain preserved but cannot resume automatically"
        )
    if issue["digest"] != digest(description):
        raise RuntimeError("frozen Linear snapshot digest is corrupt")
    return issue


def compact_issue(issue: dict[str, Any]) -> dict[str, Any]:
    return {
        key: issue[key]
        for key in (
            "identifier",
            "url",
            "title",
            "revision",
            "digest",
            "issue_id",
            "snapshot_digest",
            "content_digest",
            "genesis_digest",
        )
        if key in issue
    }


def record_phase_artifacts(run_id: str, phase: Phase, result: dict[str, Any]) -> None:
    manifest = load_artifact_manifest(run_id)
    put_artifact(run_id, phase.section, result["report_markdown"], manifest=manifest)
    evidence = re.findall(
        r"^## (?:Verification|Repository state)\s*$\n.*?(?=^## |\Z)",
        result["report_markdown"],
        re.MULTILINE | re.DOTALL,
    )
    put_artifact(
        run_id,
        "evidence",
        "\n\n".join(part.strip() for part in evidence),
        manifest=manifest,
    )


def completed_turn(
    thread: Any,
    prompt: str,
    schema: dict[str, Any],
    sandbox: Sandbox | None = None,
    timeout_seconds: int = 180,
) -> Any:
    global LAST_TURN_ID
    options: dict[str, Any] = {"output_schema": schema}
    if sandbox is not None:
        options["sandbox"] = sandbox
    if hasattr(thread, "turn"):
        handle = thread.turn(prompt, **options)
        LAST_TURN_ID = handle.id
        record_active_turn(handle.id)

        def timed_out(_signum: int, _frame: Any) -> None:
            raise TimeoutError(f"Codex turn exceeded {timeout_seconds} seconds")

        previous_handler = signal.signal(signal.SIGALRM, timed_out)
        signal.setitimer(signal.ITIMER_REAL, timeout_seconds)
        try:
            result = handle.run()
        except BaseException:
            with contextlib.suppress(Exception):
                handle.interrupt()
            raise
        finally:
            signal.setitimer(signal.ITIMER_REAL, 0)
            signal.signal(signal.SIGALRM, previous_handler)
    else:
        result = thread.run(prompt, **options)
    if result.status != TurnStatus.completed:
        detail = f": {result.error}" if result.error else ""
        raise RuntimeError(
            f"Codex turn ended with status {result.status.value}{detail}"
        )
    if not result.final_response:
        raise RuntimeError(f"Codex turn failed: {result.error or result.status}")
    return result


def completed_json_turn(
    thread: Any,
    prompt: str,
    schema: dict[str, Any],
    sandbox: Sandbox | None = None,
    timeout_seconds: int = 180,
) -> dict[str, Any]:
    result = completed_turn(
        thread,
        prompt,
        schema,
        sandbox=sandbox,
        timeout_seconds=timeout_seconds,
    )
    try:
        value = json.loads(result.final_response)
    except json.JSONDecodeError as error:
        raise RuntimeError("Codex returned invalid structured output") from error
    if not isinstance(value, dict):
        raise RuntimeError("Codex structured output was not an object")
    return value


def linear_turn_timeout() -> int:
    value = int(os.environ.get("TWEED_LINEAR_TIMEOUT", "300"))
    if value <= 0:
        raise RuntimeError("TWEED_LINEAR_TIMEOUT must be a positive integer")
    return value


def linear_adapter_command() -> list[str]:
    configured = os.environ.get("TWEED_LINEAR_ADAPTER", "").strip()
    if not configured:
        mode = os.environ.get("TWEED_LINEAR_AUTH", "oauth").strip().lower()
        if mode not in {"oauth", "api-key"}:
            raise RuntimeError("TWEED_LINEAR_AUTH must be oauth or api-key")
        if mode == "api-key" and not os.environ.get("LINEAR_API_KEY"):
            raise RuntimeError("explicit api-key mode requires LINEAR_API_KEY")
        command = [
            sys.executable,
            str(Path(__file__).resolve().with_name("tweed_linear_adapter.py")),
        ]
    else:
        command = shlex.split(configured)
    if not command:
        raise RuntimeError("TWEED_LINEAR_ADAPTER is empty")
    executable = shutil.which(command[0])
    if not executable:
        raise RuntimeError(f"Linear adapter executable not found: {command[0]}")
    command[0] = executable
    return command


def linear_adapter_environment(command: list[str]) -> dict[str, str]:
    """Do not forward Tweed authentication configuration to external adapters."""
    environment = os.environ.copy()
    bundled = not os.environ.get("TWEED_LINEAR_ADAPTER", "").strip() and (
        len(command) >= 2
        and Path(command[1]).resolve()
        == Path(__file__).resolve().with_name("tweed_linear_adapter.py")
    )
    if bundled:
        environment.setdefault("TWEED_LINEAR_AUTH", "oauth")
        return environment
    for name in (
        "LINEAR_API_KEY",
        "LINEAR_ACCESS_TOKEN",
        "LINEAR_OAUTH_TOKEN",
        "TWEED_LINEAR_AUTH",
        "TWEED_LINEAR_CLIENT_ID",
        "TWEED_LINEAR_OAUTH_FILE",
    ):
        environment.pop(name, None)
    return environment


def call_linear_adapter(request: dict[str, Any]) -> dict[str, Any]:
    envelope = {"protocol": LINEAR_PROTOCOL, **request}
    command = linear_adapter_command()
    try:
        completed = run_bounded_process(
            command,
            input_bytes=json.dumps(
                envelope, sort_keys=True, separators=(",", ":"), ensure_ascii=False
            ).encode("utf-8"),
            timeout=linear_turn_timeout(),
            stdout_limit=1024 * 1024,
            stderr_limit=512 * 1024,
            env=linear_adapter_environment(command),
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("Linear adapter timed out") from error
    except OutputLimitExceeded as error:
        raise RuntimeError("Linear adapter output exceeded its byte limit") from error
    if completed.returncode:
        raise RuntimeError(f"Linear adapter failed with exit {completed.returncode}")
    try:
        value = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("Linear adapter returned invalid UTF-8 JSON") from error
    if not isinstance(value, dict) or value.get("protocol") != LINEAR_PROTOCOL:
        raise RuntimeError("Linear adapter returned an invalid protocol envelope")
    return value


def transport_content_digest(
    issue: dict[str, Any], *, excluding_comment: str | None = None
) -> str:
    stable = {
        "id": issue.get("id"),
        "identifier": issue.get("identifier"),
        "title": issue.get("title"),
        "description": issue.get("description") or "",
        "comments": [
            {
                "id": item.get("id"),
                "body": item.get("body"),
                "archivedAt": item.get("archivedAt"),
            }
            for item in issue.get("comments", [])
            if item.get("id") != excluding_comment
        ],
    }
    return digest(
        json.dumps(stable, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    )


def transport_snapshot_digest(issue: dict[str, Any]) -> str:
    stable = {
        "id": issue.get("id"),
        "identifier": issue.get("identifier"),
        "title": issue.get("title"),
        "description": issue.get("description") or "",
        "updatedAt": issue.get("updatedAt"),
        "comments": [
            {
                key: comment.get(key)
                for key in (
                    "id",
                    "body",
                    "createdAt",
                    "updatedAt",
                    "editedAt",
                    "archivedAt",
                )
            }
            for comment in issue.get("comments", [])
        ],
    }
    return digest(
        json.dumps(stable, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    )


def validate_adapter_issue(
    root: Path, value: dict[str, Any], expected_identifier: str | None = None
) -> dict[str, Any]:
    required = {
        "id",
        "identifier",
        "url",
        "title",
        "description",
        "comments",
        "snapshot_digest",
        "content_digest",
    }
    if not required.issubset(value) or not all(
        isinstance(value[key], str) for key in required - {"comments"}
    ):
        raise RuntimeError("Linear adapter returned an incomplete issue snapshot")
    if not isinstance(value["comments"], list) or any(
        not isinstance(item, dict)
        or not isinstance(item.get("id"), str)
        or not isinstance(item.get("body"), str)
        for item in value["comments"]
    ):
        raise RuntimeError("Linear adapter returned invalid issue comments")
    if (
        expected_identifier
        and value["identifier"].upper() != expected_identifier.upper()
    ):
        raise RuntimeError(
            f"Linear returned {value['identifier']} while reading {expected_identifier}"
        )
    if value["snapshot_digest"] != transport_snapshot_digest(value):
        raise RuntimeError("Linear adapter returned a corrupt snapshot digest")
    if value["content_digest"] != transport_content_digest(value):
        raise RuntimeError("Linear adapter returned a corrupt content digest")
    try:
        snapshot = journal.validate_snapshot(
            description=value["description"],
            comments=[item["body"] for item in value["comments"]],
            issue_identifier=value["identifier"],
            expected_repository=str(root),
        )
        materialized = journal.materialize_snapshot(snapshot)
    except journal.JournalError as error:
        raise RuntimeError(f"Linear journal is invalid: {error}") from error
    description = materialized["description"]
    head = snapshot.records[-1].digest if snapshot.records else snapshot.genesis.digest
    issue = {
        "issue_id": value["id"],
        "identifier": value["identifier"],
        "url": value["url"],
        "title": value["title"],
        "description": description,
        "revision": head,
        "digest": digest(description),
        "snapshot_digest": value["snapshot_digest"],
        "content_digest": value["content_digest"],
        "genesis_digest": snapshot.genesis.digest,
        "transport_snapshot": value,
    }
    validate_linear_snapshot(root, issue)
    return issue


def read_linear_issue(root: Path, issue: str) -> dict[str, Any]:
    expected = sanitize_issue(issue).upper()
    response = call_linear_adapter({"operation": "fetch", "identifier": expected})
    if response.get("status") != "ok" or not isinstance(response.get("issue"), dict):
        raise RuntimeError(
            response.get("reason") or "Linear snapshot fetch was blocked"
        )
    return validate_adapter_issue(root, response["issue"], expected)


def verify_linear_issue(issue: dict[str, Any]) -> None:
    if not issue.get("snapshot_digest"):
        current = read_linear_issue(
            Path(parse_metadata(issue["description"])["repository"]),
            issue["identifier"],
        )
        if current["digest"] != issue["digest"]:
            raise RuntimeError("Linear issue changed during the phase")
        return
    response = call_linear_adapter(
        {
            "operation": "verify",
            "identifier": issue["identifier"],
            "expected_snapshot_digest": issue["snapshot_digest"],
        }
    )
    if response.get("status") != "unchanged":
        raise RuntimeError(
            response.get("reason") or "Linear issue changed during the phase"
        )


def create_linear_issue(
    root: Path,
    project: str,
    title: str,
    description: str,
    run_id: str,
    *,
    team: str | None = None,
) -> dict[str, Any]:
    request = {
        "operation": "create-or-recover",
        "issue_id": journal.deterministic_comment_id(
            f"{LINEAR_PROTOCOL}\0issue\0{run_id}"
        ),
        "project": project,
        "title": title,
        "description": description,
    }
    if team is not None:
        request["team"] = team
    response = call_linear_adapter(request)
    if response.get("status") not in {"created", "recovered"}:
        return {
            "status": "blocked",
            "identifier": None,
            "url": None,
            "reason": response.get("reason"),
        }
    issue = validate_adapter_issue(root, response.get("issue", {}))
    recovered_genesis = journal.parse_genesis(
        issue["transport_snapshot"]["description"]
    )
    if recovered_genesis.digest != journal.parse_genesis(description).digest:
        raise RuntimeError(
            "recovered Linear issue does not match the intake description"
        )
    return {
        "status": "synced",
        "identifier": issue["identifier"],
        "url": issue["url"],
        "reason": None,
        "issue": issue,
    }


def append_linear_record(
    root: Path,
    issue: dict[str, Any],
    record: journal.Record,
) -> dict[str, Any]:
    response = call_linear_adapter(
        {
            "operation": "append-or-recover",
            "identifier": issue["identifier"],
            "comment_id": record.metadata["comment_id"],
            "body": record.comment,
            "expected_snapshot_digest": issue["snapshot_digest"],
            "expected_content_digest": issue["content_digest"],
            "expected_head_digest": issue["revision"],
            "desired_head_digest": record.digest,
            "repository": str(root),
        }
    )
    if response.get("status") in {"appended", "recovered"}:
        updated = validate_adapter_issue(
            root, response.get("issue", {}), issue["identifier"]
        )
        if updated["revision"] != record.digest:
            raise RuntimeError("Linear adapter acknowledged the wrong journal head")
        return {
            "status": "synced",
            "identifier": updated["identifier"],
            "url": updated["url"],
            "reason": None,
            "issue": updated,
        }
    return {
        "status": "blocked",
        "identifier": None,
        "url": None,
        "reason": response.get("reason") or "Linear journal append was blocked",
    }


def phase_prompt(issue: dict[str, Any], phase: Phase, packet: dict[str, Any]) -> str:
    prompt = (
        f"Execute only the {phase.command} phase for Linear issue {issue['identifier']}. "
        "The runner fetched Linear exactly once and froze content-addressed artifacts. "
        "Do not use Linear write tools. Return the required structured result. If a material "
        "question is necessary, set status to needs-input, populate question, and put only a "
        "short clarification record in report_markdown. Otherwise question must be null.\n\n"
        "Bounded phase packet (artifact contents are intentionally not repeated):\n"
        + json.dumps(packet, indent=2, ensure_ascii=False)
    )
    if len(prompt.encode("utf-8")) > 12288:
        raise RuntimeError("phase prompt exceeded the 12 KiB bound")
    return prompt


def run_phase_turn(thread: Any, prompt: str, phase: Phase) -> dict[str, Any]:
    timeout = int(os.environ.get("TWEED_PHASE_TIMEOUT", "1200"))
    result = completed_json_turn(
        thread, prompt, phase_schema(phase.command), timeout_seconds=timeout
    )
    return validate_phase_result(result, phase)


def validate_phase_result(result: dict[str, Any], phase: Phase) -> dict[str, Any]:
    required = {"status", "summary", "question", "report_markdown"}
    if set(result) != required:
        raise RuntimeError("phase structured output has invalid fields")
    if result["status"] not in ALLOWED_STATUSES[phase.command]:
        raise RuntimeError("phase returned an unsupported status")
    if not isinstance(result["summary"], str) or not isinstance(
        result["report_markdown"], str
    ):
        raise RuntimeError("phase returned invalid text fields")
    if result["status"] == NEEDS_INPUT and not result.get("question"):
        raise RuntimeError("phase requested input without a structured question")
    if result["status"] != NEEDS_INPUT and result.get("question") is not None:
        raise RuntimeError("phase returned a question without needs-input status")
    first_line = next(
        (
            line.strip()
            for line in result["report_markdown"].splitlines()
            if line.strip()
        ),
        "",
    )
    if first_line != f"Status: {result['status']}":
        raise RuntimeError("phase report status does not match its structured status")
    return result


def validate_scope_evidence(root: Path, report: str) -> None:
    canonical_root = root.resolve()
    state_match = re.search(
        r"^## Repository state\s*$\n(?P<body>.*?)(?=^## |\Z)",
        report,
        re.MULTILINE | re.DOTALL,
    )
    if not state_match:
        raise RuntimeError("scoped report is missing its repository state")
    entries: list[tuple[str, str]] = []
    for line in state_match.group("body").splitlines():
        if "→" not in line:
            continue
        match = re.fullmatch(
            r"\s*[-*]\s+`?([^`]+?)`?\s+→\s+`?(ABSENT|[a-f0-9]+)`?\s*",
            line,
        )
        if not match:
            raise RuntimeError(f"invalid scope evidence entry: {line.strip()}")
        entries.append((match.group(1), match.group(2)))
    if not entries:
        raise RuntimeError("scoped report has no evidence snapshot entries")
    for relative, expected in entries:
        path = Path(relative)
        if path.is_absolute() or ".." in path.parts:
            raise RuntimeError(f"unsafe scope evidence path: {relative}")
        target = (canonical_root / path).resolve()
        if not target.is_relative_to(canonical_root):
            raise RuntimeError(f"scope evidence escapes the repository: {relative}")
        if expected == "ABSENT":
            if target.exists():
                raise RuntimeError(
                    f"scope evidence expected an absent path: {relative}"
                )
            continue
        if not re.fullmatch(r"[a-f0-9]{64}", expected):
            raise RuntimeError(f"scope evidence has an invalid SHA-256: {relative}")
        if not target.is_file():
            raise RuntimeError(f"scope evidence file is missing: {relative}")
        actual = hashlib.sha256(target.read_bytes()).hexdigest()
        if actual != expected:
            raise RuntimeError(f"scope evidence hash does not match: {relative}")


def validate_linear_snapshot(root: Path, issue: dict[str, Any]) -> None:
    parse_metadata(issue["description"])
    scope = section_body(issue["description"], "scope")
    if scope is not None:
        validate_scope_evidence(root, scope)


def phase_result_from_response(response: str, phase: Phase) -> dict[str, Any]:
    try:
        result = json.loads(response)
    except json.JSONDecodeError as error:
        raise RuntimeError(
            "completed Codex turn has invalid structured output"
        ) from error
    if not isinstance(result, dict):
        raise RuntimeError("completed Codex turn output was not an object")
    return validate_phase_result(result, phase)


def final_response_from_turn(turn: Any) -> str:
    fallback: str | None = None
    for raw_item in reversed(turn.items):
        item = getattr(raw_item, "root", raw_item)
        if getattr(item, "type", None) != "agentMessage":
            continue
        phase = getattr(item, "phase", None)
        phase_value = getattr(phase, "value", phase)
        if phase_value == "final_answer":
            return item.text
        if phase is None and fallback is None:
            fallback = item.text
    if fallback is None:
        raise RuntimeError("completed Codex turn has no final response")
    return fallback


def recover_recorded_result(
    thread: Any, state: dict[str, Any], phase: Phase
) -> dict[str, Any] | None:
    turn_id = state.get("turn_id")
    if not turn_id:
        raise RuntimeError("interrupted run has no recorded Codex turn")
    turns = thread.read(include_turns=True).thread.turns
    recorded = next((turn for turn in turns if turn.id == turn_id), None)
    if recorded is None:
        raise RuntimeError("recorded Codex turn is missing from its thread")
    if recorded.status == TurnStatus.in_progress:
        raise RuntimeError("recorded Codex turn is still active; retry resume later")
    if recorded.status == TurnStatus.completed:
        return phase_result_from_response(final_response_from_turn(recorded), phase)
    if recorded.status in {TurnStatus.interrupted, TurnStatus.failed}:
        return None
    raise RuntimeError(f"recorded Codex turn has unsupported status {recorded.status}")


def start_phase_thread(
    codex: Codex,
    root: Path,
    issue: dict[str, Any],
    phase: Phase,
    run_id: str,
) -> tuple[Any, str, str]:
    workflow = load_workflow(phase.workflow)
    freeze_linear_snapshot(run_id, issue, workflow)
    packet = build_phase_packet(run_id, issue, phase)
    thread = codex.thread_start(
        cwd=str(root),
        developer_instructions=workflow,
        **phase_thread_permissions(phase),
    )
    thread.set_name(f"Tweed {phase.command}: {issue['identifier']}")
    return thread, workflow, phase_prompt(issue, phase, packet)


def continuation_prompt(answer: str) -> str:
    return (
        "Clarification answer:\n"
        f"{answer}\n\nContinue the same phase from the frozen issue snapshot. Normalize the "
        "answer into a decision, reconcile it with repository evidence, and complete the phase. "
        "Ask one further material question only if still necessary."
    )


def interrupted_continuation_prompt() -> str:
    return (
        "The runner process was interrupted before this phase returned its final structured "
        "result. Continue the same phase from the frozen issue snapshot and preserved "
        "workspace. Reuse completed investigation and partial implementation where valid, "
        "revalidate the current repository state, and return the complete phase result. Do "
        "not repeat external writes or ask for input unless a material decision is still "
        "required."
    )


def resume_prompt(state_name: str, answer: str) -> str:
    if state_name == "awaiting-input":
        if not answer:
            raise RuntimeError("resume requires an answer for an awaiting-input run")
        return continuation_prompt(answer)
    if state_name in {"running", "failed", "canceled"}:
        if answer:
            raise RuntimeError(
                "an interrupted run resumes without a clarification answer"
            )
        return interrupted_continuation_prompt()
    raise RuntimeError(f"run is not resumable from state {state_name!r}")


def sanitize_issue(issue: str) -> str:
    value = issue.strip().lower()
    if not re.fullmatch(r"[a-z][a-z0-9]*-\d+", value):
        raise RuntimeError(f"invalid Linear issue identifier: {issue}")
    return value


def worktree_parent(root: Path) -> Path:
    return root.parent / ".tweed-worktrees"


def branch_worktree(root: Path, branch: str) -> Path | None:
    records = git(root, "worktree", "list", "--porcelain").splitlines()
    current: Path | None = None
    for line in records:
        if line.startswith("worktree "):
            current = Path(line.removeprefix("worktree ")).resolve()
        elif line == f"branch refs/heads/{branch}" and current:
            return current
    return None


def validate_resume_worktree(
    root: Path,
    worktree: Path,
    branch: str | None,
    phase: Phase,
    metadata: dict[str, Any],
) -> None:
    if not worktree.is_dir():
        raise RuntimeError(f"saved Tweed worktree is missing: {worktree}")
    if phase.writes_repository:
        if not branch or branch_worktree(root, branch) != worktree:
            raise RuntimeError(
                "saved Tweed worktree no longer owns its recorded branch"
            )
        expected_head = (
            metadata.get("planning_base")
            if phase.command == "implement"
            else metadata.get("integration_commit")
        )
    else:
        if worktree != root:
            raise RuntimeError("saved read-only Tweed run has the wrong worktree")
        expected_head = metadata.get("planning_base")
    if not expected_head or git(worktree, "rev-parse", "HEAD") != expected_head:
        raise RuntimeError(
            "saved Tweed worktree HEAD changed while the phase was paused"
        )


def prepare_implementation_worktree(
    root: Path, issue: str, base: str
) -> tuple[Path, str]:
    if git(root, "status", "--porcelain"):
        raise RuntimeError("implementation requires the source checkout to be clean")
    slug = sanitize_issue(issue)
    branch = f"tweed/{slug}"
    existing = branch_worktree(root, branch)
    if existing:
        if git(existing, "status", "--porcelain"):
            raise RuntimeError(f"existing Tweed worktree is dirty: {existing}")
        return existing, branch
    parent = worktree_parent(root)
    parent.mkdir(parents=True, exist_ok=True)
    path = parent / f"{root.name}-{slug}"
    if path.exists():
        raise RuntimeError(f"Tweed worktree path already exists: {path}")
    branch_exists = bool(
        git(root, "show-ref", "--verify", f"refs/heads/{branch}", check=False)
    )
    if branch_exists:
        git(root, "worktree", "add", str(path), branch)
    else:
        git(root, "worktree", "add", "-b", branch, str(path), base)
    return path.resolve(), branch


def review_worktree(root: Path, metadata: dict[str, Any]) -> tuple[Path, str]:
    branch = metadata.get("integration_branch")
    commit = metadata.get("integration_commit")
    if not isinstance(branch, str) or not isinstance(commit, str):
        raise RuntimeError("issue has no completed implementation branch and commit")
    path = branch_worktree(root, branch)
    if not path:
        raise RuntimeError(f"integration worktree is not available for {branch}")
    if git(path, "status", "--porcelain"):
        raise RuntimeError(f"integration worktree is dirty before review: {path}")
    if git(path, "rev-parse", "HEAD") != commit:
        raise RuntimeError("integration worktree does not match the issue commit")
    return path, branch


def commit_phase(worktree: Path, issue: str, phase: Phase) -> str:
    changes = git(worktree, "status", "--porcelain")
    if not changes:
        if phase.command == "implement":
            raise RuntimeError("implementation completed without repository changes")
        return git(worktree, "rev-parse", "HEAD")
    git(worktree, "add", "-A")
    message = f"{phase.command.capitalize()} {issue}"
    git(worktree, "commit", "-m", message)
    if git(worktree, "status", "--porcelain"):
        raise RuntimeError("phase commit did not leave a clean worktree")
    return git(worktree, "rev-parse", "HEAD")


@contextlib.contextmanager
def repository_write_lock(root: Path, enabled: bool) -> Iterator[None]:
    if not enabled:
        yield
        return
    common = git(root, "rev-parse", "--git-common-dir")
    common_path = (
        (root / common).resolve() if not Path(common).is_absolute() else Path(common)
    )
    lock_path = common_path / "tweed-write.lock"
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(
                "another Tweed writer is active for this repository"
            ) from error
        yield


@contextlib.contextmanager
def issue_execution_lock(root: Path, issue: str) -> Iterator[None]:
    common = git(root, "rev-parse", "--git-common-dir")
    common_path = (
        (root / common).resolve() if not Path(common).is_absolute() else Path(common)
    )
    lock_name = digest(f"{root.resolve()}\0{issue.upper()}")[:24]
    lock_path = common_path / f"tweed-issue-{lock_name}.lock"
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(
                f"another Tweed run is active for {issue.upper()}"
            ) from error
        yield


@contextlib.contextmanager
def run_execution_lock(run_id: str) -> Iterator[None]:
    lock_path = state_path(run_id).parent / "execution.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path.touch(mode=0o600, exist_ok=True)
    lock_path.chmod(0o600)
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(f"run {run_id} is already active") from error
        yield


@contextlib.contextmanager
def active_run(run_id: str) -> Iterator[None]:
    previous = os.environ.get("TWEED_ACTIVE_RUN")
    os.environ["TWEED_ACTIVE_RUN"] = run_id
    try:
        yield
    finally:
        if previous is None:
            os.environ.pop("TWEED_ACTIVE_RUN", None)
        else:
            os.environ["TWEED_ACTIVE_RUN"] = previous


def validate_issue_for_phase(
    issue: dict[str, Any], phase: Phase, caller_root: Path
) -> tuple[dict[str, Any], Path]:
    metadata = parse_metadata(issue["description"])
    if metadata.get("stage") != phase.expected_stage:
        raise RuntimeError(
            f"{issue['identifier']} is {metadata.get('stage')!r}; {phase.command} requires "
            f"{phase.expected_stage!r}"
        )
    if phase.command == "root-cause" and metadata.get("kind") != "problem":
        raise RuntimeError("root-cause is only valid for problem issues")
    stored_root = Path(str(metadata.get("repository", ""))).expanduser().resolve()
    if stored_root != caller_root:
        raise RuntimeError(
            f"issue repository is {stored_root}, but Tweed was invoked from {caller_root}"
        )
    return metadata, stored_root


def safe_error(value: object, maximum: int = 400) -> str:
    text = str(value).replace("\r", " ").replace("\n", " ")
    secret = os.environ.get("LINEAR_API_KEY")
    if secret:
        text = text.replace(secret, "[REDACTED]")
    text = re.sub(r"(?i)\bBearer\s+[^\s,;]+", "Bearer [REDACTED]", text)
    text = re.sub(r"\blin_api_[A-Za-z0-9_-]+", "[REDACTED]", text)
    return " ".join(text.split())[:maximum]


def bounded_question(value: dict[str, Any] | None) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None
    options = value.get("options") if isinstance(value.get("options"), list) else []
    return {
        "prompt": str(value.get("prompt", ""))[:400],
        "why": str(value.get("why", ""))[:300],
        "options": [str(item)[:200] for item in options[:3]],
        "recommendation": (
            str(value["recommendation"])[:200]
            if value.get("recommendation") is not None
            else None
        ),
    }


