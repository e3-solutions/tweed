def find_codex() -> str:
    explicit = os.environ.get("CODEX_BIN")
    if explicit:
        resolved = shutil.which(explicit)
        if resolved:
            return resolved
        raise RuntimeError(f"Codex CLI not found: {explicit}")
    candidates = [
        shutil.which("codex"),
        str(Path.home() / ".vite-plus/bin/codex"),
        "/Applications/ChatGPT.app/Contents/Resources/codex",
    ]
    for candidate in filter(None, candidates):
        try:
            subprocess.run(
                [candidate, "--version"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
                timeout=5,
            )
            return candidate
        except (OSError, subprocess.SubprocessError):
            continue
    raise RuntimeError("no working Codex CLI found")


def linear_mcp_disable_overrides() -> tuple[str, ...]:
    """Disable configured Linear MCP aliases without synthesizing invalid entries."""
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    config_path = codex_home / "config.toml"
    if not config_path.exists():
        return ()
    try:
        value = tomllib.loads(config_path.read_text())
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise RuntimeError("cannot safely inspect Codex MCP configuration") from error
    servers = value.get("mcp_servers", {}) if isinstance(value, dict) else {}
    if not isinstance(servers, dict):
        raise RuntimeError("Codex MCP configuration is invalid")
    disabled: list[str] = []
    for name, server in servers.items():
        if not isinstance(name, str) or not isinstance(server, dict):
            continue
        url = server.get("url")
        args = server.get("args")
        is_linear = isinstance(url, str) and urlsplit(url).hostname == "mcp.linear.app"
        if isinstance(args, list):
            is_linear = is_linear or any(
                isinstance(item, str) and "https://mcp.linear.app/" in item
                for item in args
            )
        if is_linear:
            disabled.append(f"mcp_servers.{json.dumps(name)}.enabled=false")
    return tuple(disabled)


