class OutputLimitExceeded(RuntimeError):
    pass


def run_bounded_process(
    command: list[str],
    *,
    input_bytes: bytes | None = None,
    cwd: Path | None = None,
    timeout: float,
    stdout_limit: int,
    stderr_limit: int,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[bytes]:
    """Run a child while retaining at most each declared stream limit."""
    stdin_file = tempfile.TemporaryFile()
    if input_bytes is not None:
        stdin_file.write(input_bytes)
    stdin_file.seek(0)
    process = subprocess.Popen(
        command,
        cwd=cwd,
        stdin=stdin_file,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
        env=env,
    )
    captured: dict[str, bytearray] = {
        "stdout": bytearray(),
        "stderr": bytearray(),
    }
    exceeded: list[str] = []
    guard = threading.Lock()

    def kill_group() -> None:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    def drain(name: str, stream: Any, limit: int) -> None:
        while True:
            chunk = stream.read(min(65536, limit + 1))
            if not chunk:
                return
            with guard:
                remaining = max(0, limit + 1 - len(captured[name]))
                captured[name].extend(chunk[:remaining])
                too_large = len(captured[name]) > limit
                if too_large and name not in exceeded:
                    exceeded.append(name)
            if too_large:
                kill_group()
                return

    threads = [
        threading.Thread(
            target=drain,
            args=("stdout", process.stdout, stdout_limit),
            daemon=True,
        ),
        threading.Thread(
            target=drain,
            args=("stderr", process.stderr, stderr_limit),
            daemon=True,
        ),
    ]
    for thread in threads:
        thread.start()
    timed_out = False
    deadline = time.monotonic() + timeout
    try:
        process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        kill_group()
        process.wait()
    finally:
        for thread in threads:
            thread.join(timeout=max(0.0, min(0.1, deadline - time.monotonic())))
        if any(thread.is_alive() for thread in threads):
            # The immediate child exited while descendants retained its pipes.
            kill_group()
            for thread in threads:
                thread.join(timeout=1)
        if process.stdout is not None:
            process.stdout.close()
        if process.stderr is not None:
            process.stderr.close()
        for thread in threads:
            thread.join(timeout=0.1)
        stdin_file.close()
        if any(thread.is_alive() for thread in threads):
            raise RuntimeError("child output streams did not close after termination")
    stdout = bytes(captured["stdout"][:stdout_limit])
    stderr = bytes(captured["stderr"][:stderr_limit])
    if exceeded:
        raise OutputLimitExceeded(
            f"child {', '.join(sorted(exceeded))} exceeded its byte limit"
        )
    if timed_out:
        raise subprocess.TimeoutExpired(command, timeout, output=stdout, stderr=stderr)
    return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)


