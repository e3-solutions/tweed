        }
    )


def finish_phase(
    codex: Codex,
    root: Path,
    worktree: Path,
    branch: str | None,
    issue: dict[str, Any],
    metadata: dict[str, Any],
    phase: Phase,
    run_id: str,
    thread_id: str,
    result: dict[str, Any],
    agent: bool,
) -> int:
    status = result["status"]
    if status != phase.completed_status:
        save_run(
            {
                "schema_version": SCHEMA_VERSION,
                "run_id": run_id,
                "state": status,
                "operation": "phase",
                "phase": phase.command,
                "issue": issue,
                "repository": str(root),
                "worktree": str(worktree),
                "branch": branch,
                "thread_id": thread_id,
                "summary": result["summary"],
                "report_markdown": result["report_markdown"],
            }
        )
        emit(
            receipt(
                run_id=run_id,
                state=status,
                issue=issue["identifier"],
                url=issue["url"],
                phase=phase.command,
                status=status,
                previous_stage=metadata["stage"],
                next_stage=metadata["stage"],
                summary=result["summary"],
                thread_id=thread_id,
                branch=branch,
            ),
            agent,
            result["report_markdown"],
        )
        return {"not-established": 3, "blocked": 4, "partial": 6}.get(status, 1)

    if phase.command == "scope":
        validate_scope_evidence(worktree, result["report_markdown"])

    commit = (
        commit_phase(worktree, issue["identifier"], phase)
        if phase.writes_repository
        else None
    )
    new_description = advanced_description(
        issue, metadata, phase, result, run_id, root, branch, commit
    )
    pending = {
        "schema_version": SCHEMA_VERSION,
        "run_id": run_id,
        "state": "sync-pending",
        "operation": "phase",
        "phase": phase.command,
        "issue": issue,
        "metadata": metadata,
        "repository": str(root),
        "worktree": str(worktree),
        "branch": branch,
        "commit": commit,
        "thread_id": thread_id,
        "summary": result["summary"],
        "status": status,
        "report_markdown": result["report_markdown"],
        "expected_digest": digest(issue["description"]),
        "new_description": new_description,
    }
    save_run(pending)
    synced = update_linear_issue(
        codex, root, issue["identifier"], digest(issue["description"]), new_description
    )
    if synced["status"] != "synced":
        pending["state"] = "sync-blocked"
        pending["sync_error"] = (
            synced.get("reason") or "Linear synchronization was blocked"
        )
        save_run(pending)
        emit(
            receipt(
                run_id=run_id,
                state="sync-blocked",
                issue=issue["identifier"],
                url=issue["url"],
                phase=phase.command,
                status=status,
                previous_stage=metadata["stage"],
                next_stage=metadata["stage"],
                summary=result["summary"],
                thread_id=thread_id,
                branch=branch,
                commit=commit,
                error=pending["sync_error"],
            ),
            agent,
        )
        return 8
    if not synced.get("identifier") or not synced.get("url"):
        raise RuntimeError("Linear update returned an incomplete receipt")
    pending["state"] = "completed"
    pending["issue_identifier"] = synced["identifier"]
    pending["issue_url"] = synced["url"]
    save_run(pending)
    emit(
        receipt(
            run_id=run_id,
            state="completed",
            issue=issue["identifier"],
            url=synced["url"],
            phase=phase.command,
            status=status,
            previous_stage=metadata["stage"],
            next_stage=phase.next_stage,
            summary=result["summary"],
            thread_id=thread_id,
            branch=branch,
            commit=commit,
        ),
        agent,
        result["report_markdown"],
    )
    return 0


def phase_command(args: argparse.Namespace) -> int:
    if os.environ.get("TWEED_ACTIVE_RUN"):
        raise RuntimeError("nested Tweed invocation is not allowed")
    phase = PHASES[args.command]
    args.issue = sanitize_issue(args.issue).upper()
    caller_root = repository_root(args.repo)
    run_id = new_run_id()
    with active_run(run_id), run_execution_lock(run_id):
        with repository_write_lock(caller_root, phase.writes_repository):
            with Codex(codex_config(caller_root)) as codex:
                issue = read_linear_issue(codex, caller_root, args.issue)
                metadata, root = validate_issue_for_phase(issue, phase, caller_root)
                branch: str | None = None
                worktree = root
                if phase.command == "implement":
                    worktree, branch = prepare_implementation_worktree(
                        root, issue["identifier"], metadata["planning_base"]
                    )
                elif phase.command == "review":
                    worktree, branch = review_worktree(root, metadata)
                thread, workflow, prompt = start_phase_thread(
                    codex, worktree, issue, phase
                )
                save_run(
                    {
                        "schema_version": SCHEMA_VERSION,
                        "run_id": run_id,
                        "state": "running",
                        "operation": "phase",
                        "phase": phase.command,
                        "issue": issue,
                        "issue_digest": digest(issue["description"]),
                        "metadata": metadata,
                        "repository": str(root),
                        "worktree": str(worktree),
                        "branch": branch,
                        "thread_id": thread.id,
                        "workflow_text": workflow,
                    }
                )
                result = run_phase_turn(thread, prompt, phase)
                while result["status"] == NEEDS_INPUT and sys.stdin.isatty():
                    question = result["question"]
                    print(f"\n{question['prompt']}\n", file=sys.stderr)
                    answer = input("Your answer\n> ").strip()
                    if not answer:
                        continue
                    result = run_phase_turn(thread, continuation_prompt(answer), phase)
                if result["status"] == NEEDS_INPUT:
                    save_awaiting_run(
                        run_id,
                        phase,
                        issue,
                        metadata,
                        root,
                        worktree,
                        branch,
                        thread,
                        result,
                        workflow,
                    )
                    emit(
                        receipt(
                            run_id=run_id,
                            state="awaiting-input",
                            issue=issue["identifier"],
                            url=issue["url"],
                            phase=phase.command,
                            status=NEEDS_INPUT,
                            previous_stage=metadata["stage"],
                            next_stage=metadata["stage"],
                            summary=result["summary"],
                            thread_id=thread.id,
                            question=result["question"],
                            branch=branch,
                        ),
                        args.agent,
                    )
                    return 7
                return finish_phase(
                    codex,
                    root,
                    worktree,
                    branch,
                    issue,
                    metadata,
                    phase,
                    run_id,
                    thread.id,
                    result,
                    args.agent,
                )


def resume_command(args: argparse.Namespace) -> int:
    global LAST_RUN_ID
    state = load_run(args.run_id)
    state_name = str(state.get("state"))
    answer = (
        read_request(args.answer, "Answer the Tweed clarification")
        if state_name == "awaiting-input"
        else " ".join(args.answer).strip()
    )
    prompt = resume_prompt(state_name, answer)
    phase = PHASES[state["phase"]]
    root = Path(state["repository"]).resolve()
    worktree = Path(state["worktree"]).resolve()
    branch = state.get("branch")
    with run_execution_lock(args.run_id):
        with repository_write_lock(root, phase.writes_repository):
            with active_run(args.run_id):
                validate_resume_worktree(
                    root, worktree, branch, phase, state["metadata"]
                )
                with Codex(codex_config(worktree)) as codex:
                    current_issue = read_linear_issue(
                        codex, root, state["issue"]["identifier"]
                    )
                    if digest(current_issue["description"]) != state["issue_digest"]:
                        raise RuntimeError(
                            "Linear issue changed while the phase was paused"
                        )
                    thread = codex.thread_resume(
                        state["thread_id"],
                        cwd=str(worktree),
                        developer_instructions=state["workflow_text"],
                        sandbox=phase.sandbox,
                    )
                    recovered = (
                        recover_recorded_result(thread, state, phase)
                        if state_name in {"running", "failed", "canceled"}
                        else None
                    )
                    LAST_RUN_ID = args.run_id
                    state["state"] = "running"
                    state.pop("error", None)
                    save_run(state)
                    result = recovered or run_phase_turn(thread, prompt, phase)
                    if result["status"] == NEEDS_INPUT:
                        save_awaiting_run(
                            args.run_id,
                            phase,
                            current_issue,
                            state["metadata"],
                            root,
                            worktree,
                            branch,
                            thread,
                            result,
                            state["workflow_text"],
                        )
                        emit(
                            receipt(
                                run_id=args.run_id,
                                state="awaiting-input",
                                issue=current_issue["identifier"],
                                url=current_issue["url"],
                                phase=phase.command,
                                status=NEEDS_INPUT,
                                previous_stage=state["metadata"]["stage"],
                                next_stage=state["metadata"]["stage"],
                                summary=result["summary"],
                                thread_id=thread.id,
                                question=result["question"],
                                branch=branch,
                            ),
                            args.agent,
                        )
                        return 7
                    return finish_phase(
                        codex,
                        root,
                        worktree,
                        branch,
                        current_issue,
                        state["metadata"],
                        phase,
                        args.run_id,
                        thread.id,
                        result,
                        args.agent,
                    )


def retry_sync_command(args: argparse.Namespace) -> int:
    state = load_run(args.run_id)
    if state.get("state") not in {"sync-pending", "sync-blocked"}:
        raise RuntimeError(f"run {args.run_id} has no pending Linear synchronization")
    root = Path(state["repository"]).resolve()
    with active_run(args.run_id), Codex(codex_config(root)) as codex:
        if state.get("operation") == "create":
            synced = create_linear_issue(
                codex,
                root,
                state["project"],
                state["title"],
                state["description"],
                args.run_id,
            )
            stage = "needs-rca" if state["kind"] == "problem" else "needs-scope"
            phase = None
            status = "created"
            previous_stage = None
            next_stage = stage
        elif state.get("operation") == "phase":
            synced = update_linear_issue(
                codex,
                root,
                state["issue"]["identifier"],
                state["expected_digest"],
                state["new_description"],
            )
            phase = state["phase"]
            status = state["status"]
            previous_stage = state["metadata"]["stage"]
            next_stage = PHASES[phase].next_stage
        else:
            raise RuntimeError("run has an unsupported synchronization operation")
    if synced["status"] != "synced" and state.get("operation") == "phase":
        with Codex(codex_config(root)) as reader:
            current_issue = read_linear_issue(
                reader, root, state["issue"]["identifier"]
            )
        if phase_sync_already_landed(state, current_issue):
            synced = {
                "status": "synced",
                "identifier": current_issue["identifier"],
                "url": current_issue["url"],
                "reason": None,
            }
    if synced["status"] != "synced":
        state["state"] = "sync-blocked"
        state["sync_error"] = (
            synced.get("reason") or "Linear synchronization was blocked"
        )
        save_run(state)
        emit(
            receipt(
                run_id=args.run_id,
                state="sync-blocked",
                issue=state.get("issue", {}).get("identifier"),
                phase=phase,
                status=status,
                previous_stage=previous_stage,
                next_stage=previous_stage,
                summary=state.get("summary", ""),
                branch=state.get("branch"),
                commit=state.get("commit"),
                error=state["sync_error"],
            ),
            args.agent,
        )
        return 8
    if not synced.get("identifier") or not synced.get("url"):
        raise RuntimeError("Linear synchronization returned an incomplete receipt")
    state.update(
        {
            "state": "completed",
            "issue_identifier": synced["identifier"],
            "issue_url": synced["url"],
        }
    )
    save_run(state)
    emit(
        receipt(
            run_id=args.run_id,
            state="completed",
            issue=synced["identifier"],
            url=synced["url"],
            phase=phase,
            status=status,
            previous_stage=previous_stage,
            next_stage=next_stage,
            summary=state.get("summary", "Synchronization completed."),
            thread_id=state.get("thread_id"),
            branch=state.get("branch"),
            commit=state.get("commit"),
        ),
        args.agent,
    )
    return 0


def project_command(args: argparse.Namespace) -> int:
    root = repository_root(args.repo)
    if args.action == "set":
        project = " ".join(args.value).strip()
        if not project:
            raise RuntimeError("project set requires a Linear project name or ID")
        set_linear_project(root, project)
        print(f"Linear project for {root}: {project}")
        return 0
    if args.action == "clear":
        set_linear_project(root, None)
        print(f"Cleared Linear project for {root}")
        return 0
    project = linear_project(root)
    if not project:
        raise RuntimeError(f"no Linear project configured for {root}")
    print(project)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="tweed")
    parser.add_argument(
        "--agent", action="store_true", help="emit one bounded JSON receipt"
    )
    parser.add_argument("--repo", help="explicit target repository")
    subparsers = parser.add_subparsers(dest="command", required=True)

    create = subparsers.add_parser("create")
    create.add_argument("kind", choices=["problem", "feature"])
    create.add_argument("request", nargs="*")

    for command in PHASES:
        phase = subparsers.add_parser(command)
        phase.add_argument("issue")

    resume = subparsers.add_parser("resume")
    resume.add_argument("run_id")
    resume.add_argument("answer", nargs="*")

    retry = subparsers.add_parser("retry-sync")
    retry.add_argument("run_id")

    project = subparsers.add_parser("project")
    project.add_argument("action", nargs="?", choices=["set", "clear"])
    project.add_argument("value", nargs="*")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if os.environ.get("TWEED_ACTIVE_RUN"):
        raise RuntimeError("nested Tweed invocation is not allowed")
    if args.command == "create":
        return create_command(args)
    if args.command in PHASES:
        return phase_command(args)
    if args.command == "resume":
        return resume_command(args)
    if args.command == "retry-sync":
        return retry_sync_command(args)
    if args.command == "project":
        return project_command(args)
    raise RuntimeError(f"unknown command: {args.command}")


if __name__ == "__main__":
    agent_mode = "--agent" in sys.argv
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        mark_run_terminal(LAST_RUN_ID, "canceled", "interrupted")
        if agent_mode:
            emit(
                receipt(
                    run_id=LAST_RUN_ID or new_run_id(),
                    state="canceled",
                    error="interrupted",
                ),
                True,
            )
        else:
            print(
                "tweed: interrupted; inspect the preserved workspace", file=sys.stderr
            )
        raise SystemExit(130) from None
    except Exception as error:
        mark_run_terminal(LAST_RUN_ID, "failed", str(error))
        if agent_mode:
            emit(
                receipt(
                    run_id=LAST_RUN_ID or new_run_id(), state="failed", error=str(error)
                ),
                True,
            )
        else:
            print(f"tweed: {error}", file=sys.stderr)
        raise SystemExit(1) from None
