#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["openai-codex==0.144.4"]
# ///

from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

from openai_codex import Codex, CodexConfig, Sandbox
from openai_codex.types import TurnStatus


NEEDS_INPUT = "needs-input"
MAX_CLARIFICATION_ROUNDS = 10
EXPECTED_STATUSES = {
    "root-cause": {"established", "not-established", NEEDS_INPUT},
    "scope": {"scoped", "blocked", NEEDS_INPUT},
    "feature": {"scoped", "blocked", NEEDS_INPUT},
    "implement": {"implemented", "blocked", "partial"},
    "review": {"reviewed", "blocked", "partial"},
}
COMPLETED_STATUSES = {
    "root-cause": "established",
    "scope": "scoped",
    "feature": "scoped",
    "implement": "implemented",
    "review": "reviewed",
}


def find_codex() -> str:
    explicit = os.environ.get("CODEX_BIN")
    if explicit:
        resolved = shutil.which(explicit)
        if resolved:
            return resolved
        raise RuntimeError(f"Codex CLI not found: {explicit}")

    candidates = [
        shutil.which("codex"),
        str(Path.home() / ".vite-plus/bin/codex"),
        "/Applications/ChatGPT.app/Contents/Resources/codex",
    ]
    for candidate in filter(None, candidates):
        try:
            subprocess.run(
                [candidate, "--version"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
                timeout=5,
            )
            return candidate
        except (OSError, subprocess.SubprocessError):
            continue
    raise RuntimeError("no working Codex CLI found")


def load_workflow(name: str) -> str:
    path = Path(__file__).resolve().parent / f"workflows/{name}.md"
    return path.read_text()


def repository_root(cwd: str | Path | None = None) -> Path:
    current = Path(cwd or os.getcwd()).resolve()
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=current,
            capture_output=True,
            check=True,
            text=True,
        )
    except (OSError, subprocess.SubprocessError):
        return current
    return Path(result.stdout.strip()).resolve()


def config_path() -> Path:
    explicit = os.environ.get("TWEED_CONFIG")
    if explicit:
        return Path(explicit).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME")
    if base:
        return Path(base).expanduser() / "tweed/config.json"
    return Path.home() / ".config/tweed/config.json"


def load_config() -> dict:
    path = config_path()
    if not path.exists():
        return {"folders": {}}
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"could not read Tweed config at {path}: {error}") from error
    if not isinstance(data, dict) or not isinstance(data.get("folders", {}), dict):
        raise RuntimeError(f"invalid Tweed config at {path}")
    data.setdefault("folders", {})
    return data


def save_config(config: dict) -> None:
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")


def linear_project(root: Path | None = None) -> str | None:
    key = str((root or repository_root()).resolve())
    entry = load_config()["folders"].get(key, {})
    project = entry.get("linear_project") if isinstance(entry, dict) else None
    return project.strip() if isinstance(project, str) and project.strip() else None


def set_linear_project(project: str | None, root: Path | None = None) -> None:
    key = str((root or repository_root()).resolve())
    config = load_config()
    if project:
        config["folders"][key] = {"linear_project": project.strip()}
    else:
        config["folders"].pop(key, None)
    save_config(config)


def project_command(args: list[str]) -> int:
    root = repository_root()
    if not args:
        project = linear_project(root)
        if project:
            print(project)
            return 0
        print(f"tweed: no Linear project configured for {root}", file=sys.stderr)
        return 4
    action = args.pop(0)
    if action == "set":
        project = " ".join(args).strip()
        if not project:
            raise RuntimeError("project set requires a Linear project name or ID")
        set_linear_project(project, root)
        print(f"Linear project for {root}: {project}")
        return 0
    if action == "clear" and not args:
        set_linear_project(None, root)
        print(f"Cleared Linear project for {root}")
        return 0
    raise RuntimeError("project accepts no arguments, 'set <project>', or 'clear'")


def completed_turn(
    thread,
    prompt: str,
    sandbox: Sandbox | None = None,
) -> str:
    options = {"sandbox": sandbox} if sandbox is not None else {}
    result = thread.run(prompt, **options)
    if result.status != TurnStatus.completed:
        detail = f": {result.error}" if result.error else ""
        raise RuntimeError(f"Codex turn ended with status {result.status.value}{detail}")
    if not result.final_response:
        raise RuntimeError(f"Codex turn failed: {result.error or result.status}")
    return result.final_response


def run_with_clarifications(thread, prompt: str) -> str:
    report = completed_turn(thread, prompt)
    rounds = 0
    while report_status(report) == NEEDS_INPUT:
        if not sys.stdin.isatty():
            return report
        if rounds >= MAX_CLARIFICATION_ROUNDS:
            raise RuntimeError("clarification limit reached")
        print("\n" + report + "\n", file=sys.stderr)
        answer = input("Your answer\n> ").strip()
        if not answer:
            print("tweed: an answer is required", file=sys.stderr)
            continue
        rounds += 1
        report = completed_turn(
            thread,
            "Clarification answer:\n"
            f"{answer}\n\n"
            "Continue the same investigation. Resolve the answer against repository "
            "evidence, ask another material question only if still necessary, and "
            "otherwise complete the phase and run its final adversarial pass.",
        )
    return report


def run_phase(
    codex: Codex,
    workflow: str,
    title: str,
    prompt: str,
    sandbox: Sandbox = Sandbox.read_only,
) -> tuple[object, str]:
    thread = codex.thread_start(
        cwd=os.getcwd(),
        developer_instructions=load_workflow(workflow),
        sandbox=sandbox,
    )
    thread.set_name(title)
    print(f"{title} in Codex thread {thread.id}…", file=sys.stderr)
    return thread, run_with_clarifications(thread, prompt)


def report_status(report: str) -> str | None:
    first_line = next((line.strip() for line in report.splitlines() if line.strip()), "")
    prefix = "Status: "
    return first_line[len(prefix) :].strip() if first_line.startswith(prefix) else None


def should_sync_linear(command: str, status: str | None) -> bool:
    return COMPLETED_STATUSES.get(command) == status


def workspace_fingerprint() -> str | None:
    try:
        root = Path(
            subprocess.run(
                ["git", "rev-parse", "--show-toplevel"],
                capture_output=True,
                check=True,
                text=True,
            ).stdout.strip()
        )
        head = subprocess.run(
            ["git", "rev-parse", "HEAD"], cwd=root, capture_output=True
        ).stdout or b"<unborn>"
        ref = subprocess.run(
            ["git", "symbolic-ref", "-q", "HEAD"], cwd=root, capture_output=True
        ).stdout or b"<detached>"
        paths = subprocess.run(
            ["git", "ls-files", "-co", "--exclude-standard", "-z"],
            cwd=root,
            capture_output=True,
            check=True,
        ).stdout.split(b"\0")
        status = subprocess.run(
            ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
            cwd=root,
            capture_output=True,
            check=True,
        ).stdout
        index = subprocess.run(
            ["git", "diff", "--cached", "--binary"],
            cwd=root,
            capture_output=True,
            check=True,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None

    digest = hashlib.sha256(os.fsencode(root) + b"\0" + head + ref + status + index)
    for raw_path in sorted(path for path in paths if path):
        path = root / os.fsdecode(raw_path)
        digest.update(raw_path + b"\0")
        try:
            if path.is_symlink():
                digest.update(os.fsencode(os.readlink(path)))
            else:
                with path.open("rb") as file:
                    for chunk in iter(lambda: file.read(1024 * 1024), b""):
                        digest.update(chunk)
        except OSError:
            digest.update(b"<missing>")
    return digest.hexdigest()


def read_request(args: list[str], question: str) -> str:
    if args:
        return " ".join(args).strip()
    if sys.stdin.isatty():
        return input(f"{question}\n> ").strip()
    return sys.stdin.read().strip()


def read_issue(args: list[str], command: str) -> str:
    if len(args) != 1:
        raise RuntimeError(f"{command} requires one Linear issue identifier")
    issue = args[0].strip()
    if not issue:
        raise RuntimeError(f"{command} requires a Linear issue identifier")
    return issue


def issue_phase_prompt(issue: str, phase: str) -> str:
    return (
        f"Linear issue: {issue}\n\n"
        "Use the configured Linear MCP read tools to retrieve this issue. Treat its "
        f"description as the completed handoff that is the input to the {phase} "
        "phase. Do not create, update, or comment on any Linear issue during this "
        "phase. Complete the workflow and return its report; the runner will request "
        "a separate Linear sync only after the phase completion gate passes."
    )


def linear_sync_prompt(
    command: str,
    report: str,
    issue: str | None = None,
    project: str | None = None,
) -> str:
    if issue:
        action = (
            f"Update exactly the existing Linear issue {issue}. Read it first. Preserve "
            "all previously completed Tweed phase content and replace any older copy of "
            f"the {command} phase with the completed report below. Do not create a new "
            "issue and do not add a comment."
        )
    else:
        action = (
            "Create exactly one Linear issue in the configured project "
            f"{project!r}. Resolve the project with Linear MCP, infer its team, choose a "
            "concise title from the completed report, and use the complete report as the "
            "issue description. Do not add a comment or create any other object."
        )
    return (
        "TWEED_LINEAR_SYNC\n\n"
        "The workflow phase has passed its completion gate. You may now use only the "
        "configured Linear MCP tools for this one synchronization. "
        f"{action}\n\n"
        "Completed report:\n"
        f"{report}\n\n"
        "After the MCP write succeeds, return exactly this small receipt:\n"
        "Status: synced\n"
        "Linear issue: [identifier]\n"
        "Linear URL: [URL]\n\n"
        "If the project or issue cannot be resolved unambiguously, or the MCP write "
        "fails, make no other write and return Status: blocked with the reason."
    )


def sync_linear(
    thread,
    command: str,
    report: str,
    issue: str | None = None,
    project: str | None = None,
) -> str:
    receipt = completed_turn(
        thread,
        linear_sync_prompt(command, report, issue=issue, project=project),
        sandbox=Sandbox.read_only,
    )
    if report_status(receipt) not in {"synced", "blocked"}:
        raise RuntimeError("Linear sync returned an invalid status")
    return receipt


def main() -> int:
    if any(arg in {"-h", "--help"} for arg in sys.argv[1:]):
        print(
            "Usage: tweed root-cause [problem]\n"
            "       tweed scope <linear-issue>\n"
            "       tweed feature [request]\n"
            "       tweed implement <linear-issue>\n"
            "       tweed review <linear-issue>\n"
            "       tweed project\n"
            "       tweed project set <linear-project>\n"
            "       tweed project clear"
        )
        return 0

    args = sys.argv[1:]
    commands = {"root-cause", "scope", "feature", "implement", "review", "project"}
    write_commands = {"implement", "review"}
    if args and args[0] not in commands:
        print(f"tweed: unknown command: {args[0]}", file=sys.stderr)
        return 2
    command = args.pop(0) if args else "root-cause"
    if command == "project":
        return project_command(args)

    sandbox = Sandbox.read_only
    issue = None
    project = None
    if command == "scope":
        issue = read_issue(args, "scope")
        prompt = issue_phase_prompt(issue, "solution-scoping")
        workflow = "scope-solution"
        title = "Tweed solution scope"
    elif command == "implement":
        issue = read_issue(args, "implement")
        prompt = issue_phase_prompt(issue, "implementation")
        workflow = "implementation"
        title = "Tweed implementation"
        sandbox = Sandbox.workspace_write
    elif command == "review":
        issue = read_issue(args, "review")
        prompt = issue_phase_prompt(issue, "implementation-review")
        workflow = "review"
        title = "Tweed implementation review"
        sandbox = Sandbox.workspace_write
    elif command == "feature":
        prompt = read_request(args, "What feature should Tweed scope?")
        if not prompt:
            print("tweed: a feature request is required", file=sys.stderr)
            return 2
        project = linear_project()
        if not project:
            print(
                "tweed: no Linear project configured; run "
                "'tweed project set <linear-project>'",
                file=sys.stderr,
            )
            return 4
        workflow = "feature"
        title = f"Tweed feature: {' '.join(prompt.split())[:76]}"
    else:
        prompt = read_request(args, "What problem should Tweed investigate?")
        if not prompt:
            print("tweed: a problem is required", file=sys.stderr)
            return 2
        project = linear_project()
        if not project:
            print(
                "tweed: no Linear project configured; run "
                "'tweed project set <linear-project>'",
                file=sys.stderr,
            )
            return 4
        workflow = "root-cause"
        title = f"Tweed RCA: {' '.join(prompt.split())[:80]}"

    baseline = workspace_fingerprint() if command in write_commands else None
    if command in write_commands and baseline is None:
        print(f"tweed: {command} requires a Git repository for workspace safety", file=sys.stderr)
        return 2

    config = CodexConfig(
        codex_bin=find_codex(),
        cwd=os.getcwd(),
        client_name="tweed",
        client_title="Tweed",
        client_version="0.1.0",
        experimental_api=False,
    )

    try:
        with Codex(config) as codex:
            thread, report = run_phase(codex, workflow, title, prompt, sandbox)
            status = report_status(report)
            if status not in EXPECTED_STATUSES[command]:
                raise RuntimeError(f"{command} returned an invalid status")

            receipt = None
            if should_sync_linear(command, status):
                receipt = sync_linear(
                    thread,
                    command,
                    report,
                    issue=issue,
                    project=project,
                )
    except Exception:
        if command in write_commands:
            print(f"tweed: {command} failed; workspace changes may remain", file=sys.stderr)
        raise

    if command in write_commands and status == "blocked":
        final = workspace_fingerprint()
        if baseline is not None and final != baseline:
            status = "partial"
            report = report.replace("Status: blocked", "Status: partial", 1)
            report += f"\n\nRunner note: workspace changes were detected after the blocked {command} report."
    print(report)
    if receipt:
        print("\n" + receipt)
        if report_status(receipt) == "blocked":
            return 8
    if status == NEEDS_INPUT:
        return 7
    if status == "not-established":
        return 3
    if status == "blocked":
        return 5 if command in write_commands else 4
    if status == "partial":
        return 6

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print(
            "tweed: interrupted; workspace changes, if any, were preserved—inspect git status and git diff",
            file=sys.stderr,
        )
        raise SystemExit(130) from None
    except Exception as error:
        print(f"tweed: {error}", file=sys.stderr)
        raise SystemExit(1) from None
