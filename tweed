        "summary": summary[:400],
        "thread_id": thread_id,
        "question": question,
        "branch": branch,
        "commit": commit,
        "error": error,
    }


def emit(value: dict[str, Any], agent: bool, report: str | None = None) -> None:
    if agent:
        output = json.dumps(value, separators=(",", ":"))
        if len(output.encode()) > 4096:
            raise RuntimeError("agent receipt exceeded the 4 KiB protocol limit")
        print(output)
        return
    if report:
        print(report.rstrip() + "\n")
    print(json.dumps(value, indent=2))


def read_request(parts: list[str], prompt: str) -> str:
    if parts:
        return " ".join(parts).strip()
    if sys.stdin.isatty():
        return input(f"{prompt}\n> ").strip()
    return sys.stdin.read().strip()


def evidence_command(args: argparse.Namespace) -> int:
    root = repository_root(args.repo)
    command = list(args.evidence_command)
    if command and command[0] == "--":
        command.pop(0)
    if not command:
        raise RuntimeError("evidence requires a command after --")
    versions: dict[str, str] = {"python": sys.version.split()[0]}
    for value in args.tool_version:
        name, separator, version = value.partition("=")
        if not separator or not name or not version:
            raise RuntimeError("--tool-version must be NAME=VERSION")
        versions[name] = version
    if len(versions) == 1:
        raise RuntimeError("evidence requires the command's declared --tool-version")
    declarations = (
        (args.dependency, args.no_dependencies, "dependency/lockfile"),
        (args.configuration, args.no_configuration, "configuration"),
        (args.declared_env, args.no_declared_env, "environment"),
    )
    for values, explicitly_empty, label in declarations:
        if values and explicitly_empty:
            raise RuntimeError(
                f"evidence cannot combine declared {label} inputs with an empty assertion"
            )
        if not values and not explicitly_empty:
            raise RuntimeError(
                f"evidence requires declared {label} inputs or an explicit empty assertion"
            )
    artifact_hashes: list[str] = []
    if args.run_id:
        if args.no_artifacts:
            raise RuntimeError(
                "evidence cannot combine --run-id with --no-artifacts"
            )
        manifest = load_artifact_manifest(args.run_id)
        artifact_hashes = [
            entry["sha256"] for entry in manifest["artifacts"].values()
        ]
    elif not args.no_artifacts:
        raise RuntimeError(
            "evidence requires --run-id artifact inputs or --no-artifacts"
        )
    key, document = evidence_cache_key(
        root,
        command,
        dependency_paths=[Path(value) for value in args.dependency],
        configuration_paths=[Path(value) for value in args.configuration],
        declared_environment=args.declared_env,
        tool_versions=versions,
        artifact_hashes=artifact_hashes,
    )
    cached = load_cached_evidence(key, document)
    if cached is not None:
        print(json.dumps({**cached, "cache_hit": True}, ensure_ascii=False))
        return int(cached["exit_code"])
    try:
        completed = subprocess.run(
            command,
            cwd=root,
            capture_output=True,
            timeout=args.timeout,
            check=False,
        )
        cacheable = (
            completed.returncode == 0
            and len(completed.stdout) <= 524288
            and len(completed.stderr) <= 524288
        )
        result = {
            "schema": "dev.tweed.evidence.v1",
            "cache_key": key,
            "cache_hit": False,
            "exit_code": completed.returncode,
            "stdout": completed.stdout.decode("utf-8", errors="replace")[-524288:],
            "stderr": completed.stderr.decode("utf-8", errors="replace")[-524288:],
            "cacheable": cacheable,
        }
    except subprocess.TimeoutExpired as error:
        result = {
            "schema": "dev.tweed.evidence.v1",
            "cache_key": key,
            "cache_hit": False,
            "exit_code": 124,
            "stdout": (error.stdout or b"").decode("utf-8", errors="replace")[-524288:],
            "stderr": (error.stderr or b"").decode("utf-8", errors="replace")[-524288:],
            "cacheable": False,
        }
    if result["cacheable"]:
        save_cached_evidence(key, document, result)
    print(json.dumps(result, ensure_ascii=False))
    return int(result["exit_code"])


def create_command(args: argparse.Namespace) -> int:
    root = repository_root(args.repo)
    project = linear_project(root)
    if not project:
        raise RuntimeError(
            f"no Linear project configured for {root}; run tweed project set <project>"
        )
    request = read_request(
        args.request, "What should the issue deliver or investigate?"
    )
    if not request:
        raise RuntimeError("create requires a request")
    run_id = new_run_id()
    title = " ".join(request.split())[:80]
    description = intake_description(args.kind, request, root, project, run_id)
    manifest = load_artifact_manifest(run_id)
    put_artifact(run_id, "request", request, manifest=manifest)
    put_artifact(run_id, "linear-desired-description", description, manifest=manifest)
    state = {
        "schema_version": SCHEMA_VERSION,
        "run_id": run_id,
        "state": "sync-pending",
        "operation": "create",
        "repository": str(root),
        "project": project,
        "title": title,
        "desired_digest": digest(description),
        "kind": args.kind,
    }
    save_run(state)
    try:
        with active_run(run_id):
            synced = create_linear_issue(root, project, title, description, run_id)
    except Exception as error:
        synced = {
            "status": "blocked",
            "identifier": None,
            "url": None,
            "reason": str(error),
        }
    if synced["status"] != "synced":
        state["state"] = "sync-blocked"
        state["sync_error"] = (
            synced.get("reason") or "Linear issue creation was blocked"
        )
        save_run(state)
        emit(
            receipt(
                run_id=run_id,
                state="sync-blocked",
                status="created",
                next_stage=("needs-rca" if args.kind == "problem" else "needs-scope"),
                summary="Intake is preserved and awaiting Linear synchronization.",
                error=state["sync_error"],
            ),
            args.agent,
        )
        return 8
    if not synced.get("identifier") or not synced.get("url"):
        raise RuntimeError("Linear create returned an incomplete receipt")
    state.update(
        {
            "state": "completed",
            "issue_identifier": synced["identifier"],
            "issue_url": synced["url"],
        }
    )
    save_run(state)
    stage = "needs-rca" if args.kind == "problem" else "needs-scope"
    emit(
        receipt(
            run_id=run_id,
            state="created",
            issue=synced["identifier"],
            url=synced["url"],
            status="created",
            next_stage=stage,
            summary=f"Created {args.kind} intake issue ready for {stage}.",
        ),
        args.agent,
    )
    return 0


