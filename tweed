def finish_phase(
    root: Path,
    worktree: Path,
    branch: str | None,
    issue: dict[str, Any],
    metadata: dict[str, Any],
    phase: Phase,
    run_id: str,
    thread_id: str,
    result: dict[str, Any],
    agent: bool,
) -> int:
    status = result["status"]
    record_phase_artifacts(run_id, phase, result)
    if status != phase.completed_status:
        save_run(
            {
                "schema_version": SCHEMA_VERSION,
                "run_id": run_id,
                "state": status,
                "operation": "phase",
                "phase": phase.command,
                "issue": compact_issue(issue),
                "repository": str(root),
                "worktree": str(worktree),
                "branch": branch,
                "thread_id": thread_id,
                "summary": result["summary"],
            }
        )
        emit(
            receipt(
                run_id=run_id,
                state=status,
                issue=issue["identifier"],
                url=issue["url"],
                phase=phase.command,
                status=status,
                previous_stage=metadata["stage"],
                next_stage=metadata["stage"],
                summary=result["summary"],
                thread_id=thread_id,
                branch=branch,
            ),
            agent,
            result["report_markdown"],
        )
        return {"not-established": 3, "blocked": 4, "partial": 6}.get(status, 1)

    if phase.command == "scope":
        validate_scope_evidence(worktree, result["report_markdown"])

    commit = (
        commit_phase(worktree, issue["identifier"], phase)
        if phase.writes_repository
        else None
    )
    persisted_result = {
        **result,
        "report_markdown": read_artifact(run_id, phase.section).decode("utf-8"),
    }
    new_description = advanced_description(
        issue, metadata, phase, persisted_result, run_id, root, branch, commit
    )
    put_artifact(run_id, "linear-desired-description", new_description)
    pending = {
        "schema_version": SCHEMA_VERSION,
        "run_id": run_id,
        "state": "sync-pending",
        "operation": "phase",
        "phase": phase.command,
        "issue": compact_issue(issue),
        "metadata": metadata,
        "repository": str(root),
        "worktree": str(worktree),
        "branch": branch,
        "commit": commit,
        "thread_id": thread_id,
        "summary": result["summary"],
        "status": status,
        "expected_revision": issue["revision"],
        "expected_digest": issue["digest"],
        "desired_digest": digest(new_description),
    }
    save_run(pending)
    try:
        synced = update_linear_issue(
            root,
            issue["identifier"],
            issue["revision"],
            issue["digest"],
            issue["description"],
            new_description,
        )
    except Exception as error:
        synced = {
            "status": "blocked",
            "identifier": None,
            "url": None,
            "reason": str(error),
        }
    current = synced.get("current_issue")
    if synced["status"] != "synced" and isinstance(current, dict):
        try:
            current = validate_adapter_issue(root, current, issue["identifier"])
        except RuntimeError:
            current = None
        if current and phase_sync_already_landed(pending, current):
            synced = {
                "status": "synced",
                "identifier": current["identifier"],
                "url": current["url"],
                "reason": None,
            }
    if synced["status"] != "synced":
        pending["state"] = "sync-blocked"
        pending["sync_error"] = (
            synced.get("reason") or "Linear synchronization was blocked"
        )
        save_run(pending)
        emit(
            receipt(
                run_id=run_id,
                state="sync-blocked",
                issue=issue["identifier"],
                url=issue["url"],
                phase=phase.command,
                status=status,
                previous_stage=metadata["stage"],
                next_stage=metadata["stage"],
                summary=result["summary"],
                thread_id=thread_id,
                branch=branch,
                commit=commit,
                error=pending["sync_error"],
            ),
            agent,
        )
        return 8
    if not synced.get("identifier") or not synced.get("url"):
        raise RuntimeError("Linear update returned an incomplete receipt")
    pending["state"] = "completed"
    pending["issue_identifier"] = synced["identifier"]
    pending["issue_url"] = synced["url"]
    save_run(pending)
    emit(
        receipt(
            run_id=run_id,
            state="completed",
            issue=issue["identifier"],
            url=synced["url"],
            phase=phase.command,
            status=status,
            previous_stage=metadata["stage"],
            next_stage=phase.next_stage,
            summary=result["summary"],
            thread_id=thread_id,
            branch=branch,
            commit=commit,
        ),
        agent,
        result["report_markdown"],
    )
    return 0


def phase_command(args: argparse.Namespace) -> int:
    if os.environ.get("TWEED_ACTIVE_RUN"):
        raise RuntimeError("nested Tweed invocation is not allowed")
    phase = PHASES[args.command]
    args.issue = sanitize_issue(args.issue).upper()
    caller_root = repository_root(args.repo)
    run_id = new_run_id()
    with active_run(run_id), run_execution_lock(run_id):
        with repository_write_lock(caller_root, phase.writes_repository):
            issue = read_linear_issue(caller_root, args.issue)
            metadata, root = validate_issue_for_phase(issue, phase, caller_root)
            branch: str | None = None
            worktree = root
            if phase.command == "implement":
                worktree, branch = prepare_implementation_worktree(
                    root, issue["identifier"], metadata["planning_base"]
                )
            elif phase.command == "review":
                worktree, branch = review_worktree(root, metadata)
            with Codex(codex_config(caller_root)) as codex:
                thread, workflow, prompt = start_phase_thread(
                    codex, worktree, issue, phase, run_id
                )
                save_run(
                    {
                        "schema_version": SCHEMA_VERSION,
                        "run_id": run_id,
                        "state": "running",
                        "operation": "phase",
                        "phase": phase.command,
                        "issue": compact_issue(issue),
                        "issue_digest": issue["digest"],
                        "metadata": metadata,
                        "repository": str(root),
                        "worktree": str(worktree),
                        "branch": branch,
                        "thread_id": thread.id,
                    }
                )
                result = run_phase_turn(thread, prompt, phase)
                while result["status"] == NEEDS_INPUT and sys.stdin.isatty():
                    question = result["question"]
                    print(f"\n{question['prompt']}\n", file=sys.stderr)
                    answer = input("Your answer\n> ").strip()
                    if not answer:
                        continue
                    result = run_phase_turn(thread, continuation_prompt(answer), phase)
                if result["status"] == NEEDS_INPUT:
                    save_awaiting_run(
                        run_id,
                        phase,
                        issue,
                        metadata,
                        root,
                        worktree,
                        branch,
                        thread,
                        result,
                        workflow,
                    )
                    emit(
                        receipt(
                            run_id=run_id,
                            state="awaiting-input",
                            issue=issue["identifier"],
                            url=issue["url"],
                            phase=phase.command,
                            status=NEEDS_INPUT,
                            previous_stage=metadata["stage"],
                            next_stage=metadata["stage"],
                            summary=result["summary"],
                            thread_id=thread.id,
                            question=result["question"],
                            branch=branch,
                        ),
                        args.agent,
                    )
                    return 7
                return finish_phase(
                    root,
                    worktree,
                    branch,
                    issue,
                    metadata,
                    phase,
                    run_id,
                    thread.id,
                    result,
                    args.agent,
                )


def resume_command(args: argparse.Namespace) -> int:
    global LAST_RUN_ID
    state = load_run(args.run_id)
    state_name = str(state.get("state"))
    answer = (
        read_request(args.answer, "Answer the Tweed clarification")
        if state_name == "awaiting-input"
        else " ".join(args.answer).strip()
    )
    prompt = resume_prompt(state_name, answer)
    phase = PHASES[state["phase"]]
    root = Path(state["repository"]).resolve()
    worktree = Path(state["worktree"]).resolve()
    branch = state.get("branch")
    with run_execution_lock(args.run_id):
        with repository_write_lock(root, phase.writes_repository):
            with active_run(args.run_id):
                validate_resume_worktree(
                    root, worktree, branch, phase, state["metadata"]
                )
                current_issue = load_frozen_issue(state)
                verify_linear_issue(current_issue)
                with Codex(codex_config(worktree)) as codex:
                    workflow_text = state.get("workflow_text") or read_artifact(
                        args.run_id, "workflow"
                    ).decode("utf-8")
                    thread = codex.thread_resume(
                        state["thread_id"],
                        cwd=str(worktree),
                        developer_instructions=workflow_text,
                        sandbox=phase.sandbox,
                    )
                    recovered = (
                        recover_recorded_result(thread, state, phase)
                        if state_name in {"running", "failed", "canceled"}
                        else None
                    )
                    LAST_RUN_ID = args.run_id
                    state["state"] = "running"
                    state.pop("error", None)
                    save_run(state)
                    result = recovered or run_phase_turn(thread, prompt, phase)
                    if result["status"] == NEEDS_INPUT:
                        save_awaiting_run(
                            args.run_id,
                            phase,
                            current_issue,
                            state["metadata"],
                            root,
                            worktree,
                            branch,
                            thread,
                            result,
                            workflow_text,
                        )
                        emit(
                            receipt(
                                run_id=args.run_id,
                                state="awaiting-input",
                                issue=current_issue["identifier"],
                                url=current_issue["url"],
                                phase=phase.command,
                                status=NEEDS_INPUT,
                                previous_stage=state["metadata"]["stage"],
                                next_stage=state["metadata"]["stage"],
                                summary=result["summary"],
                                thread_id=thread.id,
                                question=result["question"],
                                branch=branch,
                            ),
                            args.agent,
                        )
                        return 7
                    return finish_phase(
                        root,
                        worktree,
                        branch,
                        current_issue,
                        state["metadata"],
                        phase,
                        args.run_id,
                        thread.id,
                        result,
                        args.agent,
                    )


def retry_sync_command(args: argparse.Namespace) -> int:
    state = load_run(args.run_id)
    if state.get("state") not in {"sync-pending", "sync-blocked"}:
        raise RuntimeError(f"run {args.run_id} has no pending Linear synchronization")
    root = Path(state["repository"]).resolve()
    phase = state.get("phase")
    status = state.get("status") or (
        "created" if state.get("operation") == "create" else None
    )
    previous_stage = (
        state.get("metadata", {}).get("stage")
        if state.get("operation") == "phase"
        else None
    )
    next_stage = (
        ("needs-rca" if state.get("kind") == "problem" else "needs-scope")
        if state.get("operation") == "create"
        else PHASES[phase].next_stage if phase in PHASES else None
    )
    try:
        with active_run(args.run_id):
            if state.get("operation") == "create":
                intake = state.get("description") or read_artifact(
                    args.run_id, "linear-desired-description"
                ).decode("utf-8")
                synced = create_linear_issue(
                    root,
                    state["project"],
                    state["title"],
                    intake,
                    args.run_id,
                )
            elif state.get("operation") == "phase":
                frozen_issue = load_frozen_issue(state)
                desired_description = desired_description_from_state(state)
                synced = update_linear_issue(
                    root,
                    state["issue"]["identifier"],
                    state.get("expected_revision") or frozen_issue["revision"],
                    state["expected_digest"],
                    frozen_issue["description"],
                    desired_description,
                )
            else:
                raise RuntimeError("run has an unsupported synchronization operation")
    except Exception as error:
        synced = {
            "status": "blocked",
            "identifier": None,
            "url": None,
            "reason": str(error),
        }
    if synced["status"] != "synced" and state.get("operation") == "phase":
        current_issue = synced.get("current_issue")
        if isinstance(current_issue, dict):
            try:
                current_issue = validate_adapter_issue(
                    root, current_issue, state["issue"]["identifier"]
                )
            except RuntimeError:
                current_issue = None
        if current_issue and phase_sync_already_landed(state, current_issue):
            synced = {
                "status": "synced",
                "identifier": current_issue["identifier"],
                "url": current_issue["url"],
                "reason": None,
            }
    if synced["status"] != "synced":
        state["state"] = "sync-blocked"
        state["sync_error"] = (
            synced.get("reason") or "Linear synchronization was blocked"
        )
        save_run(state)
        emit(
            receipt(
                run_id=args.run_id,
                state="sync-blocked",
                issue=state.get("issue", {}).get("identifier"),
                phase=phase,
                status=status,
                previous_stage=previous_stage,
                next_stage=previous_stage,
                summary=state.get("summary", ""),
                branch=state.get("branch"),
                commit=state.get("commit"),
                error=state["sync_error"],
            ),
            args.agent,
        )
        return 8
    if not synced.get("identifier") or not synced.get("url"):
        raise RuntimeError("Linear synchronization returned an incomplete receipt")
    state.update(
        {
            "state": "completed",
            "issue_identifier": synced["identifier"],
            "issue_url": synced["url"],
        }
    )
    save_run(state)
    emit(
        receipt(
            run_id=args.run_id,
            state="completed",
            issue=synced["identifier"],
            url=synced["url"],
            phase=phase,
            status=status,
            previous_stage=previous_stage,
            next_stage=next_stage,
            summary=state.get("summary", "Synchronization completed."),
            thread_id=state.get("thread_id"),
            branch=state.get("branch"),
            commit=state.get("commit"),
        ),
        args.agent,
    )
    return 0


def project_command(args: argparse.Namespace) -> int:
    root = repository_root(args.repo)
    if args.action == "set":
        project = " ".join(args.value).strip()
        if not project:
            raise RuntimeError("project set requires a Linear project name or ID")
        set_linear_project(root, project)
        print(f"Linear project for {root}: {project}")
        return 0
    if args.action == "clear":
        set_linear_project(root, None)
        print(f"Cleared Linear project for {root}")
        return 0
    project = linear_project(root)
    if not project:
        raise RuntimeError(f"no Linear project configured for {root}")
    print(project)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="tweed")
    parser.add_argument(
        "--agent", action="store_true", help="emit one bounded JSON receipt"
    )
    parser.add_argument("--repo", help="explicit target repository")
    subparsers = parser.add_subparsers(dest="command", required=True)

    create = subparsers.add_parser("create")
    create.add_argument("kind", choices=["problem", "feature"])
    create.add_argument("request", nargs="*")

    for command in PHASES:
        phase = subparsers.add_parser(command)
        phase.add_argument("issue")

    resume = subparsers.add_parser("resume")
    resume.add_argument("run_id")
    resume.add_argument("answer", nargs="*")

    retry = subparsers.add_parser("retry-sync")
    retry.add_argument("run_id")

    evidence = subparsers.add_parser("evidence")
    evidence.add_argument("--run-id")
    evidence.add_argument("--dependency", action="append", default=[])
    evidence.add_argument("--no-dependencies", action="store_true")
    evidence.add_argument("--configuration", action="append", default=[])
    evidence.add_argument("--no-configuration", action="store_true")
    evidence.add_argument("--declared-env", action="append", default=[])
    evidence.add_argument("--no-declared-env", action="store_true")
    evidence.add_argument("--no-artifacts", action="store_true")
    evidence.add_argument("--tool-version", action="append", default=[])
    evidence.add_argument("--timeout", type=int, default=1200)
    evidence.add_argument("evidence_command", nargs=argparse.REMAINDER)

    project = subparsers.add_parser("project")
    project.add_argument("action", nargs="?", choices=["set", "clear"])
    project.add_argument("value", nargs="*")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if os.environ.get("TWEED_ACTIVE_RUN") and args.command != "evidence":
        raise RuntimeError("nested Tweed invocation is not allowed")
    if args.command == "create":
        return create_command(args)
    if args.command in PHASES:
        return phase_command(args)
    if args.command == "resume":
        return resume_command(args)
    if args.command == "retry-sync":
        return retry_sync_command(args)
    if args.command == "evidence":
        return evidence_command(args)
    if args.command == "project":
        return project_command(args)
    raise RuntimeError(f"unknown command: {args.command}")


if __name__ == "__main__":
    agent_mode = "--agent" in sys.argv
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        mark_run_terminal(LAST_RUN_ID, "canceled", "interrupted")
        if agent_mode:
            emit(
                receipt(
                    run_id=LAST_RUN_ID or new_run_id(),
                    state="canceled",
                    error="interrupted",
                ),
                True,
            )
        else:
            print(
                "tweed: interrupted; inspect the preserved workspace", file=sys.stderr
            )
        raise SystemExit(130) from None
    except Exception as error:
        mark_run_terminal(LAST_RUN_ID, "failed", str(error))
        if agent_mode:
            emit(
                receipt(
                    run_id=LAST_RUN_ID or new_run_id(), state="failed", error=str(error)
                ),
                True,
            )
        else:
            print(f"tweed: {error}", file=sys.stderr)
        raise SystemExit(1) from None
