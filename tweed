def emit(value: dict[str, Any], agent: bool, report: str | None = None) -> None:
    if agent:
        output = json.dumps(value, separators=(",", ":"), ensure_ascii=False)
        if len(output.encode()) > 4096:
            raise RuntimeError("agent receipt exceeded the 4 KiB protocol limit")
        print(output)
        return
    if report:
        print(report.rstrip() + "\n")
    print(json.dumps(value, indent=2))


def read_request(parts: list[str], prompt: str) -> str:
    if parts:
        return " ".join(parts).strip()
    if sys.stdin.isatty():
        return input(f"{prompt}\n> ").strip()
    return sys.stdin.read().strip()


def evidence_command(args: argparse.Namespace) -> int:
    root = repository_root(args.repo)
    command = list(args.evidence_command)
    if command and command[0] == "--":
        command.pop(0)
    if not command:
        raise RuntimeError("evidence requires a command after --")
    versions: dict[str, str] = {"python": sys.version.split()[0]}
    for value in args.tool_version:
        name, separator, version = value.partition("=")
        if not separator or not name or not version:
            raise RuntimeError("--tool-version must be NAME=VERSION")
        versions[name] = version
    if len(versions) == 1:
        raise RuntimeError("evidence requires the command's declared --tool-version")
    declarations = (
        (args.dependency, args.no_dependencies, "dependency/lockfile"),
        (args.configuration, args.no_configuration, "configuration"),
        (args.declared_env, args.no_declared_env, "environment"),
    )
    for values, explicitly_empty, label in declarations:
        if values and explicitly_empty:
            raise RuntimeError(
                f"evidence cannot combine declared {label} inputs with an empty assertion"
            )
        if not values and not explicitly_empty:
            raise RuntimeError(
                f"evidence requires declared {label} inputs or an explicit empty assertion"
            )
    artifact_hashes: list[str] = []
    if args.run_id:
        if args.no_artifacts:
            raise RuntimeError("evidence cannot combine --run-id with --no-artifacts")
        manifest = load_artifact_manifest(args.run_id)
        artifact_hashes = [entry["sha256"] for entry in manifest["artifacts"].values()]
    elif not args.no_artifacts:
        raise RuntimeError(
            "evidence requires --run-id artifact inputs or --no-artifacts"
        )
    key, document = evidence_cache_key(
        root,
        command,
        dependency_paths=[Path(value) for value in args.dependency],
        configuration_paths=[Path(value) for value in args.configuration],
        declared_environment=args.declared_env,
        tool_versions=versions,
        artifact_hashes=artifact_hashes,
        execution_controls={"timeout_seconds": args.timeout},
    )
    cached = load_cached_evidence(key, document)
    if cached is not None:
        print(json.dumps({**cached, "cache_hit": True}, ensure_ascii=False))
        return int(cached["exit_code"])
    try:
        completed = run_bounded_process(
            command,
            cwd=root,
            timeout=args.timeout,
            stdout_limit=524288,
            stderr_limit=524288,
        )
        cacheable = completed.returncode == 0
        result = {
            "schema": "dev.tweed.evidence.v1",
            "cache_key": key,
            "cache_hit": False,
            "exit_code": completed.returncode,
            "stdout": completed.stdout.decode("utf-8", errors="replace")[-524288:],
            "stderr": completed.stderr.decode("utf-8", errors="replace")[-524288:],
            "cacheable": cacheable,
        }
    except subprocess.TimeoutExpired as error:
        result = {
            "schema": "dev.tweed.evidence.v1",
            "cache_key": key,
            "cache_hit": False,
            "exit_code": 124,
            "stdout": (error.stdout or b"").decode("utf-8", errors="replace")[-524288:],
            "stderr": (error.stderr or b"").decode("utf-8", errors="replace")[-524288:],
            "cacheable": False,
        }
    except OutputLimitExceeded as error:
        result = {
            "schema": "dev.tweed.evidence.v1",
            "cache_key": key,
            "cache_hit": False,
            "exit_code": 125,
            "stdout": "",
            "stderr": safe_error(error),
            "cacheable": False,
        }
    if result["cacheable"]:
        save_cached_evidence(key, document, result)
    print(json.dumps(result, ensure_ascii=False))
    return int(result["exit_code"])


def incident_collector_schema(
    direct_tools: tuple[str, ...] = (),
) -> dict[str, Any]:
    direct_items: dict[str, Any]
    if direct_tools:
        direct_items = {
            "type": "object",
            "additionalProperties": False,
            "required": ["qualified_tool", "arguments_json"],
            "properties": {
                "qualified_tool": {
                    "type": "string",
                    "enum": list(direct_tools),
                },
                "arguments_json": {
                    "type": "string",
                    "maxLength": MAX_INCIDENT_DIRECT_ARGUMENT_BYTES,
                },
            },
        }
    else:
        direct_items = {
            "type": "object",
            "additionalProperties": False,
            "required": [],
            "properties": {},
        }
    properties: dict[str, Any] = {
        "status": {"type": "string", "enum": ["collected", "blocked"]},
        "summary": {"type": "string", "maxLength": 500},
        "coverage": {"type": "string", "maxLength": 2000},
        "direct_calls": {
            "type": "array",
            "maxItems": 16 if direct_tools else 0,
            "items": direct_items,
        },
    }
    return {
        "type": "object",
        "additionalProperties": False,
        "required": ["status", "summary", "coverage", "direct_calls"],
        "properties": properties,
    }


def incident_rca_schema() -> dict[str, Any]:
    schema = phase_schema("root-cause")
    schema["required"] = [
        *schema["required"],
        "issue_title",
        "duplicate_reference",
        "supporting_call_ids",
        "existing_work_call_ids",
    ]
    schema["properties"] = {
        **schema["properties"],
        "issue_title": {"type": ["string", "null"], "maxLength": 120},
        "duplicate_reference": {"type": ["string", "null"], "maxLength": 512},
        "supporting_call_ids": {
            "type": "array",
            "maxItems": 16,
            "items": {"type": "string", "maxLength": 200},
        },
        "existing_work_call_ids": {
            "type": "array",
            "maxItems": 16,
            "items": {"type": "string", "maxLength": 200},
        },
    }
    return schema


def validate_incident_rca_result(value: dict[str, Any]) -> dict[str, Any]:
    extras = {
        "issue_title",
        "duplicate_reference",
        "supporting_call_ids",
        "existing_work_call_ids",
    }
    if set(value) != {
        "status",
        "summary",
        "question",
        "report_markdown",
        *extras,
    }:
        raise RuntimeError("incident RCA returned invalid fields")
    result = validate_phase_result(
        {key: value[key] for key in value if key not in extras},
        PHASES["root-cause"],
    )
    title = value["issue_title"]
    duplicate = value["duplicate_reference"]
    for field in ("supporting_call_ids", "existing_work_call_ids"):
        call_ids = value[field]
        if (
            not isinstance(call_ids, list)
            or len(call_ids) > 16
            or not all(isinstance(call_id, str) and call_id for call_id in call_ids)
            or len(set(call_ids)) != len(call_ids)
        ):
            raise RuntimeError(f"incident RCA returned invalid {field}")
        result[field] = call_ids
    normalized_duplicate = None
    if duplicate is not None:
        normalized_duplicate = " ".join(str(duplicate).split())
        if value["status"] != "established" or not normalized_duplicate:
            raise RuntimeError(
                "incident duplicate reference is inconsistent with RCA status"
            )
    if value["status"] == "established":
        normalized = " ".join(str(title or "").split())
        if not normalized and normalized_duplicate is None:
            raise RuntimeError(
                "established incident RCA requires a specific issue title"
            )
        result["issue_title"] = normalized or None
    elif title is not None:
        raise RuntimeError("non-established incident RCA cannot provide an issue title")
    else:
        result["issue_title"] = None
    result["duplicate_reference"] = normalized_duplicate
    return result


def incident_evidence_envelope(encoded: bytes) -> dict[str, Any]:
    try:
        envelope = json.loads(encoded, parse_constant=reject_non_json_number)
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        raise RuntimeError("incident evidence artifact is invalid") from error
    if not isinstance(envelope, dict) or not isinstance(envelope.get("calls"), list):
        raise RuntimeError("incident evidence artifact is invalid")
    call_ids = [
        call.get("call_id") if isinstance(call, dict) else None
        for call in envelope["calls"]
    ]
    if not all(isinstance(call_id, str) and call_id for call_id in call_ids) or len(
        set(call_ids)
    ) != len(call_ids):
        raise RuntimeError("incident evidence has empty or duplicate call IDs")
    if (
        not isinstance(envelope.get("coverage"), str)
        or not envelope["coverage"].strip()
    ):
        raise RuntimeError("incident evidence has no frozen coverage summary")
    return envelope


def frozen_incident_policy(run_id: str) -> dict[str, Any]:
    try:
        policy = json.loads(
            read_artifact(run_id, "incident-policy"),
            parse_constant=reject_non_json_number,
        )
    except (json.JSONDecodeError, ValueError) as error:
        raise RuntimeError("incident policy artifact is invalid") from error
    if not isinstance(policy, dict):
        raise RuntimeError("incident policy artifact is invalid")
    return policy


def successful_incident_calls(envelope: dict[str, Any]) -> list[dict[str, Any]]:
    return [
        call
        for call in envelope["calls"]
        if isinstance(call, dict) and call.get("status", "completed") == "completed"
    ]


def is_bounded_production_call(call: dict[str, Any], policy: dict[str, Any]) -> bool:
    arguments = call.get("arguments")
    return (
        call.get("qualified_tool") in INCIDENT_PRODUCTION_EVIDENCE_TOOLS
        and isinstance(arguments, dict)
        and arguments.get("since") == policy.get("window_start")
        and arguments.get("until") == policy.get("window_end")
    )


def canonical_external_references(value: Any) -> set[str]:
    references: set[str] = set()

    def visit(item: Any) -> None:
        if isinstance(item, dict):
            for child in item.values():
                visit(child)
            return
        if isinstance(item, list):
            for child in item:
                visit(child)
            return
        if not isinstance(item, str):
            return
        for identifier in re.findall(
            r"(?<![A-Za-z0-9])([A-Za-z][A-Za-z0-9]*-[0-9]+)(?![A-Za-z0-9])",
            item,
        ):
            references.add(identifier.casefold())
        for url in re.findall(r"https?://[^\s<>\"'`\])}]+", item):
            normalized = url.rstrip(".,;:")
            if urlsplit(normalized).hostname:
                references.add(normalized)

    visit(value)
    return references


def validate_incident_collection_coverage(
    encoded: bytes, expected_policy: dict[str, Any] | None = None
) -> None:
    envelope = incident_evidence_envelope(encoded)
    policy = envelope.get("policy")
    if not isinstance(policy, dict):
        raise RuntimeError("incident evidence has no embedded policy")
    policy_digest = digest(
        json.dumps(
            policy,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
            allow_nan=False,
        )
    )
    if envelope.get("policy_sha256") != policy_digest:
        raise RuntimeError("incident evidence policy digest is invalid")
    if expected_policy is not None and policy != expected_policy:
        raise RuntimeError("incident evidence policy does not match the frozen policy")
    calls = successful_incident_calls(envelope)
    covered_servers: set[str] = set()
    for call in calls:
        qualified = str(call.get("qualified_tool", ""))
        if "/" not in qualified:
            continue
        server, tool = qualified.split("/", 1)
        server = server.casefold()
        if tool.casefold() in INCIDENT_EXISTING_WORK_SEARCH_TOOLS.get(server, set()):
            covered_servers.add(server)
    missing = {"github", "linear"} - covered_servers
    if missing:
        raise RuntimeError(
            "incident collection requires successful existing-work reads from: "
            + ", ".join(sorted(missing))
        )
    bounded_production_calls = [
        call for call in calls if is_bounded_production_call(call, policy)
    ]
    if not bounded_production_calls:
        raise RuntimeError(
            "incident collection requires successful production-observability evidence "
            "bounded to the frozen window"
        )


def validate_incident_rca_evidence(run_id: str, result: dict[str, Any]) -> None:
    policy = frozen_incident_policy(run_id)
    encoded = read_artifact(run_id, "incident-evidence")
    validate_incident_collection_coverage(encoded, policy)
    envelope = incident_evidence_envelope(encoded)
    calls = successful_incident_calls(envelope)
    by_id = {str(call.get("call_id")): call for call in calls if call.get("call_id")}
    supporting = result["supporting_call_ids"]
    existing = result["existing_work_call_ids"]
    if result["status"] == "established" and not supporting:
        raise RuntimeError(
            "established incident RCA has no successful evidence bindings"
        )
    for field, call_ids in (
        ("supporting_call_ids", supporting),
        ("existing_work_call_ids", existing),
    ):
        missing = [call_id for call_id in call_ids if call_id not in by_id]
        if missing:
            raise RuntimeError(f"incident RCA {field} contains an unsuccessful call")
    if result["status"] == "established" and not any(
        is_bounded_production_call(by_id[call_id], policy) for call_id in supporting
    ):
        raise RuntimeError(
            "established incident RCA has no bound production-observability receipt"
        )
    if result["status"] == "established":
        existing_servers: set[str] = set()
        for call_id in existing:
            qualified = str(by_id[call_id].get("qualified_tool", ""))
            if "/" not in qualified:
                continue
            server, tool = qualified.split("/", 1)
            server = server.casefold()
            if tool.casefold() in INCIDENT_EXISTING_WORK_BINDING_TOOLS.get(
                server, set()
            ):
                existing_servers.add(server)
        if not {"github", "linear"}.issubset(existing_servers):
            raise RuntimeError(
                "incident RCA must bind successful Linear and GitHub existing-work checks"
            )
    duplicate = result.get("duplicate_reference")
    if duplicate:
        duplicate_text = str(duplicate)
        is_identifier = re.fullmatch(r"[A-Za-z][A-Za-z0-9]*-[0-9]+", duplicate_text)
        is_url = urlsplit(duplicate_text).scheme in {"http", "https"} and bool(
            urlsplit(duplicate_text).hostname
        )
        if not is_identifier and not is_url:
            raise RuntimeError(
                "incident duplicate reference must be an exact identifier or URL"
            )
        needle = duplicate_text.casefold() if is_identifier else duplicate_text
        matched = False
        for call_id in existing:
            call = by_id[call_id]
            server = str(call.get("qualified_tool", "")).split("/", 1)[0].casefold()
            references = canonical_external_references(call.get("result"))
            if server in {"github", "linear"} and needle in references:
                matched = True
                break
        if not matched:
            raise RuntimeError(
                "incident duplicate reference is not present in bound existing-work evidence"
            )


def verify_incident_publication_inputs(
    run_id: str,
    policy: dict[str, Any],
    result: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Revalidate every frozen safety boundary before a Linear create attempt."""
    evidence_bytes = read_artifact(run_id, "incident-evidence")
    frozen_policy = frozen_incident_policy(run_id)
    if frozen_policy != policy:
        raise RuntimeError("incident policy state does not match its frozen artifact")
    validate_incident_collection_coverage(evidence_bytes, frozen_policy)
    if result is not None:
        validate_incident_rca_evidence(run_id, result)
    try:
        return load_artifact_manifest(run_id)["artifacts"]["incident-evidence"]
    except (KeyError, TypeError) as error:
        raise RuntimeError("incident evidence artifact is missing") from error


def build_incident_packet(
    run_id: str, root: Path, policy: dict[str, Any]
) -> dict[str, Any]:
    validate_incident_collection_coverage(
        read_artifact(run_id, "incident-evidence"), policy
    )
    references = [
        artifact_reference(run_id, name)
        for name in ("request", "incident-policy", "incident-evidence")
    ]
    manifest_path, manifest_sha256 = snapshot_artifact_manifest(run_id)
    packet = {
        "schema": "dev.tweed.incident-packet.v1",
        "run_id": run_id,
        "repository": str(root),
        "policy": policy,
        "artifacts": references,
        "artifact_manifest": {
            "path": str(manifest_path.resolve()),
            "sha256": manifest_sha256,
        },
        "instructions": (
            "Verify the three artifact hashes. Treat incident-evidence as the complete "
            "external evidence boundary. Every production and existing-work claim must "
            "map to a successful recorded MCP call. Do not make external calls."
        ),
    }
    encoded = json.dumps(packet, separators=(",", ":"), ensure_ascii=False).encode()
    if len(encoded) > 8192:
        raise RuntimeError("incident packet exceeded the 8 KiB bound")
    return packet


def collect_incident_evidence(
    root: Path,
    run_id: str,
    request: str,
    policy: dict[str, Any],
    allowed_tools: tuple[str, ...],
) -> tuple[str, str]:
    workflow = load_workflow("incident-evidence")
    collection_deadline = time.monotonic() + MAX_INCIDENT_COLLECTION_WALL_SECONDS
    direct_remaining = float(MAX_INCIDENT_DIRECT_WALL_SECONDS)
    direct_started = time.monotonic()
    model_tools, direct_catalog, direct_servers = discover_direct_mcp_tools(
        root,
        allowed_tools,
        deadline=min(collection_deadline, direct_started + direct_remaining),
    )
    direct_remaining -= time.monotonic() - direct_started
    direct_tool_names = tuple(sorted(direct_catalog))
    direct_prompt_catalog = {
        qualified: {
            "description": entry["description"],
            "input_schema": entry["input_schema"],
        }
        for qualified, entry in direct_catalog.items()
    }
    prompt = (
        "Collect the read-only production evidence requested below. Use every allowed "
        "model-facing tool that is material to coverage. For tools in the direct-call "
        "catalog, return exact planned calls in direct_calls; Tweed—not you—will execute "
        "them and return genuine MCP results in this same session. Do not repeat any "
        "successful call. If more direct results are needed, return the next dependency "
        "layer only. Return an empty direct_calls list only when collection is complete "
        "or blocked.\n\n"
        f"Request: {request}\n"
        f"Policy: {json.dumps(policy, ensure_ascii=False, sort_keys=True)}\n"
        f"Model-facing MCP tools: {json.dumps(list(model_tools))}\n"
        "Direct-call MCP catalog: "
        + json.dumps(direct_prompt_catalog, ensure_ascii=False, sort_keys=True)
    )
    timeout = int(os.environ.get("TWEED_PHASE_TIMEOUT", "1200"))
    all_items: list[Any] = []
    direct_results: list[dict[str, Any]] = []
    seen_direct_calls: set[str] = set()
    with Codex(incident_collector_codex_config(root, model_tools)) as codex:
        thread = codex.thread_start(
            cwd=str(root),
            developer_instructions=workflow,
            approval_mode=ApprovalMode.deny_all,
            sandbox=Sandbox.read_only,
        )
        thread.set_name(f"Tweed incident evidence: {run_id}")
        next_prompt = prompt
        response: dict[str, Any] | None = None
        for direct_round in range(MAX_INCIDENT_DIRECT_ROUNDS + 1):
            collection_remaining = collection_deadline - time.monotonic()
            if collection_remaining <= 0:
                raise RuntimeError("incident evidence collection exceeded its deadline")
            turn = completed_turn(
                thread,
                next_prompt,
                incident_collector_schema(direct_tool_names),
                sandbox=Sandbox.read_only,
                timeout_seconds=max(1, min(timeout, int(collection_remaining))),
            )
            all_items.extend(turn.items)
            try:
                parsed = json.loads(turn.final_response)
            except (TypeError, json.JSONDecodeError) as error:
                raise RuntimeError(
                    "incident collector returned invalid structured output"
                ) from error
            if not isinstance(parsed, dict) or set(parsed) != {
                "status",
                "summary",
                "coverage",
                "direct_calls",
            }:
                raise RuntimeError("incident collector returned invalid fields")
            planned = parsed.get("direct_calls")
            if not isinstance(planned, list):
                raise RuntimeError(
                    "incident collector returned invalid direct MCP calls"
                )
            if not planned:
                response = parsed
                break
            if parsed.get("status") == "blocked":
                raise RuntimeError(
                    "blocked incident collection cannot request MCP calls"
                )
            if direct_round >= MAX_INCIDENT_DIRECT_ROUNDS:
                raise RuntimeError(
                    "incident collector exceeded its direct MCP round limit"
                )
            for call in planned:
                call_key = json.dumps(
                    call, sort_keys=True, separators=(",", ":"), ensure_ascii=False
                )
                if call_key in seen_direct_calls:
                    raise RuntimeError("incident collector repeated a direct MCP call")
                seen_direct_calls.add(call_key)
            remaining_result_budget = validate_incident_dispatch_budget(
                all_items, direct_results, planned
            )
            if direct_remaining <= 0:
                raise RuntimeError("incident direct MCP exceeded its overall deadline")
            direct_started = time.monotonic()
            try:
                executed = execute_direct_mcp_calls(
                    root,
                    planned,
                    direct_catalog,
                    direct_servers,
                    policy,
                    result_budget=remaining_result_budget,
                    deadline=min(
                        collection_deadline, direct_started + direct_remaining
                    ),
                )
            finally:
                direct_remaining -= time.monotonic() - direct_started
            direct_results.extend(executed)
            if (
                len(
                    json.dumps(
                        direct_results,
                        sort_keys=True,
                        separators=(",", ":"),
                        ensure_ascii=False,
                    ).encode("utf-8")
                )
                > MAX_INCIDENT_EVIDENCE_BYTES
            ):
                raise RuntimeError("incident MCP evidence exceeds the byte limit")
            remaining_rounds = MAX_INCIDENT_DIRECT_ROUNDS - direct_round - 1
            next_prompt = (
                "Tweed executed the requested calls through the configured MCP transport. "
                "Use these exact results to plan only the next missing dependency layer, "
                "or return an empty direct_calls list and finalize coverage. "
                f"You have {remaining_rounds} direct-call rounds remaining; when that "
                "number is zero you must finalize without requesting more calls.\n\n"
                + json.dumps(executed, ensure_ascii=False, sort_keys=True)
            )
    if response is None:
        raise RuntimeError("incident collector did not finalize evidence collection")
    if response.get("status") != "collected":
        raise RuntimeError(
            response.get("summary") or "incident evidence collection was blocked"
        )
    evidence = canonical_mcp_evidence(
        all_items,
        policy,
        allowed_tools,
        direct_calls=direct_results,
        coverage=str(response.get("coverage") or ""),
    )
    validate_incident_collection_coverage(evidence, policy)
    manifest = load_artifact_manifest(run_id)
    put_artifact(
        run_id,
        "incident-evidence",
        evidence,
        media_type="application/json; charset=utf-8",
        manifest=manifest,
    )
    put_artifact(run_id, "incident-collector-workflow", workflow, manifest=manifest)
    return thread.id, str(response.get("summary") or "Evidence collected")


def run_incident_rca(
    root: Path, run_id: str, policy: dict[str, Any]
) -> tuple[str, dict[str, Any], str]:
    workflow = load_workflow("root-cause")
    base_state = load_run(run_id)
    put_artifact(run_id, "workflow", workflow)
    packet = build_incident_packet(run_id, root, policy)
    prompt = (
        "Establish the root cause for this pre-Linear production incident packet. "
        "Use independent investigators for repository tracing and falsification, but give "
        "them only relevant slices of the frozen artifacts. Do not call external tools. "
        "If an existing Linear issue or GitHub PR in the evidence already covers the same "
        "causal mechanism and scope, set duplicate_reference to its exact identifier or URL; "
        "otherwise set it to null. For an established new incident, provide a specific, "
        "non-truncated issue_title. Bind every established conclusion to successful receipt "
        "call IDs in supporting_call_ids. Put the successful Linear and GitHub receipt call "
        "IDs actually used for dedupe in existing_work_call_ids. A duplicate reference must "
        "appear in one of those bound results.\n\nBounded incident packet:\n"
        + json.dumps(packet, indent=2, ensure_ascii=False)
    )
    timeout = int(os.environ.get("TWEED_PHASE_TIMEOUT", "1200"))
    with Codex(incident_rca_codex_config(root)) as codex:
        thread = codex.thread_start(
            cwd=str(root),
            developer_instructions=workflow,
            approval_mode=ApprovalMode.deny_all,
            sandbox=Sandbox.read_only,
        )
        thread.set_name(f"Tweed incident RCA: {run_id}")
        save_run(
            {
                **base_state,
                "state": "running",
                "operation": "incident",
                "phase": "root-cause",
                "thread_id": thread.id,
            }
        )
        value = completed_json_turn(
            thread,
            prompt,
            incident_rca_schema(),
            timeout_seconds=timeout,
        )
    return thread.id, validate_incident_rca_result(value), workflow


def publish_incident(
    *,
    root: Path,
    run_id: str,
    request: str,
    policy: dict[str, Any],
    result: dict[str, Any],
    thread_id: str,
    binding: dict[str, Any],
    agent: bool,
) -> int:
    base_state = load_run(run_id)
    evidence_entry = verify_incident_publication_inputs(run_id, policy, result)
    description = intake_description(
        "problem",
        request,
        root,
        binding["project"],
        run_id,
        team=binding["team"],
        binding_source=binding["source"],
        binding_digest=binding["binding_digest"],
        binding_repository=binding["repository"],
        extra_metadata={
            "incident_policy_digest": digest(
                json.dumps(
                    policy, sort_keys=True, separators=(",", ":"), ensure_ascii=False
                )
            ),
            "incident_evidence_digest": evidence_entry["sha256"],
            "incident_rca_run": run_id,
        },
    )
    put_artifact(run_id, "linear-intake-description", description)
    record_phase_artifacts(run_id, PHASES["root-cause"], result)
    publication_evidence = {
        key: result[key]
        for key in (
            "status",
            "supporting_call_ids",
            "existing_work_call_ids",
            "duplicate_reference",
        )
    }
    put_artifact(
        run_id,
        "incident-publication-evidence",
        json.dumps(
            publication_evidence,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
            allow_nan=False,
        ),
        media_type="application/json; charset=utf-8",
    )
    pending = {
        **base_state,
        "state": "sync-pending",
        "operation": "incident-publish",
        "publish_step": "create",
        "title": result["issue_title"],
        "desired_digest": digest(description),
        "thread_id": thread_id,
        "summary": result["summary"],
    }
    save_run(pending)
    try:
        synced = create_linear_issue(
            root,
            binding["project"],
            result["issue_title"],
            description,
            run_id,
            team=binding["team"],
        )
    except Exception as error:
        synced = {"status": "blocked", "reason": str(error)}
    if synced.get("status") != "synced":
        pending["state"] = "sync-blocked"
        pending["sync_error"] = safe_error(
            synced.get("reason") or "incident Linear issue creation was blocked"
        )
        save_run(pending)
        emit(
            receipt(
                run_id=run_id,
                state="sync-blocked",
                phase="root-cause",
                status="established",
                next_stage="needs-scope",
                summary=result["summary"],
                thread_id=thread_id,
                error=pending["sync_error"],
                team=binding["team"],
                project=binding["project"],
                binding_source=binding["source"],
                binding_digest=binding["binding_digest"],
            ),
            agent,
        )
        return 8
    issue = synced.get("issue")
    if not isinstance(issue, dict):
        raise RuntimeError("incident Linear create returned no frozen issue")
    freeze_linear_snapshot(run_id, issue, read_incident_workflow(run_id))
    metadata = parse_metadata(issue["description"])
    phase_result = {
        key: result[key] for key in ("status", "summary", "question", "report_markdown")
    }
    return finish_phase(
        root,
        root,
        None,
        issue,
        metadata,
        PHASES["root-cause"],
        run_id,
        thread_id,
        phase_result,
        agent,
    )


def finalize_incident_rca(
    run_id: str,
    state: dict[str, Any],
    result: dict[str, Any],
    thread_id: str,
    agent: bool,
) -> int:
    root = Path(state["repository"]).resolve()
    validate_incident_rca_evidence(run_id, result)
    record_phase_artifacts(run_id, PHASES["root-cause"], result)
    if result["status"] == NEEDS_INPUT:
        save_run(
            {
                **state,
                "state": "awaiting-input",
                "operation": "incident",
                "thread_id": thread_id,
                "phase": "root-cause",
                "question": result["question"],
                "summary": result["summary"],
            }
        )
        emit(
            receipt(
                run_id=run_id,
                state="awaiting-input",
                phase="root-cause",
                status=NEEDS_INPUT,
                summary=result["summary"],
                thread_id=thread_id,
                question=result["question"],
            ),
            agent,
        )
        return 7
    if result["status"] != "established":
        save_run({**state, "state": result["status"], "summary": result["summary"]})
        emit(
            receipt(
                run_id=run_id,
                state=result["status"],
                phase="root-cause",
                status=result["status"],
                summary=result["summary"],
                thread_id=thread_id,
            ),
            agent,
            result["report_markdown"],
        )
        return 3 if result["status"] == "not-established" else 4
    if result["duplicate_reference"]:
        save_run(
            {
                **state,
                "state": "duplicate",
                "summary": result["summary"],
                "duplicate_reference": result["duplicate_reference"],
            }
        )
        emit(
            receipt(
                run_id=run_id,
                state="duplicate",
                phase="root-cause",
                status="established",
                summary=(
                    f"RCA matches existing work: {result['duplicate_reference']}. "
                    "No Linear issue was created."
                ),
                thread_id=thread_id,
            ),
            agent,
            result["report_markdown"],
        )
        return 9
    request = read_artifact(run_id, "request").decode("utf-8")
    binding = {
        "team": state["team"],
        "project": state["project"],
        "source": state["binding_source"],
        "binding_digest": state["binding_digest"],
        "repository": state["binding_repository"],
    }
    return publish_incident(
        root=root,
        run_id=run_id,
        request=request,
        policy=state["policy"],
        result=result,
        thread_id=thread_id,
        binding=binding,
        agent=agent,
    )


def incident_command(args: argparse.Namespace) -> int:
    if os.environ.get("TWEED_ACTIVE_RUN"):
        raise RuntimeError("nested Tweed invocation is not allowed")
    root = repository_root(args.repo)
    binding = resolve_linear_binding(
        root,
        team_override=getattr(args, "team", None),
        project_override=getattr(args, "project", None),
    )
    assert binding is not None
    if binding.get("disabled") or binding.get("invalid_reason"):
        raise RuntimeError(
            binding.get("invalid_reason")
            or binding.get("reason")
            or "Linear sync is disabled"
        )
    request = read_request(
        args.request, "What production problem should Tweed investigate?"
    )
    if not request:
        raise RuntimeError("incident requires a request")
    policy = incident_policy(args.window_start, args.window_end, args.impact)
    allowed_tools = incident_tool_allowlist(args.mcp_tool)
    run_id = new_run_id()
    manifest = load_artifact_manifest(run_id)
    put_artifact(run_id, "request", request, manifest=manifest)
    put_artifact(
        run_id,
        "incident-policy",
        json.dumps(policy, sort_keys=True, separators=(",", ":"), ensure_ascii=False),
        media_type="application/json; charset=utf-8",
        manifest=manifest,
    )
    state = {
        "schema_version": SCHEMA_VERSION,
        "run_id": run_id,
        "state": "collecting",
        "operation": "incident",
        "repository": str(root),
        "team": binding["team"],
        "project": binding["project"],
        "binding_source": binding["source"],
        "binding_digest": binding["binding_digest"],
        "binding_repository": binding["repository"],
        "policy": policy,
        "allowed_tools": list(allowed_tools),
    }
    save_run(state)
    with active_run(run_id), run_execution_lock(run_id):
        _collector_thread, collection_summary = collect_incident_evidence(
            root, run_id, request, policy, allowed_tools
        )
        state.update(
            {"state": "evidence-frozen", "collection_summary": collection_summary}
        )
        save_run(state)
        thread_id, result, _workflow = run_incident_rca(root, run_id, policy)
        return finalize_incident_rca(run_id, state, result, thread_id, args.agent)


def create_command(args: argparse.Namespace) -> int:
    root = repository_root(args.repo)
    binding = resolve_linear_binding(
        root,
        team_override=getattr(args, "team", None),
        project_override=getattr(args, "project", None),
    )
    assert binding is not None
    if binding.get("disabled"):
        reason = binding.get("reason") or "no reason recorded"
        raise RuntimeError(
            f"Linear sync is explicitly disabled for {binding['repository']}: {reason}"
        )
    if binding.get("invalid_reason"):
        raise RuntimeError(binding["invalid_reason"])
    team = binding["team"]
    project = binding["project"]
    request = read_request(
        args.request, "What should the issue deliver or investigate?"
    )
    if not request:
        raise RuntimeError("create requires a request")
    run_id = new_run_id()
    title = " ".join(request.split())[:80]
    description = intake_description(
        args.kind,
        request,
        root,
        project,
        run_id,
        team=team,
        binding_source=binding["source"],
        binding_digest=binding["binding_digest"],
        binding_repository=binding["repository"],
    )
    manifest = load_artifact_manifest(run_id)
    put_artifact(run_id, "request", request, manifest=manifest)
    put_artifact(run_id, "linear-intake-description", description, manifest=manifest)
    state = {
        "schema_version": SCHEMA_VERSION,
        "run_id": run_id,
        "state": "sync-pending",
        "operation": "create",
        "repository": str(root),
        "team": team,
        "project": project,
        "binding_source": binding["source"],
        "binding_digest": binding["binding_digest"],
        "binding_repository": binding["repository"],
        "title": title,
        "desired_digest": digest(description),
        "kind": args.kind,
    }
    save_run(state)
    try:
        with active_run(run_id):
            synced = create_linear_issue(
                root, project, title, description, run_id, team=team
            )
    except Exception as error:
        synced = {
            "status": "blocked",
            "identifier": None,
            "url": None,
            "reason": str(error),
        }
    if synced["status"] != "synced":
        state["state"] = "sync-blocked"
        state["sync_error"] = safe_error(
            synced.get("reason") or "Linear issue creation was blocked"
        )
        save_run(state)
        emit(
            receipt(
                run_id=run_id,
                state="sync-blocked",
                status="created",
                next_stage=("needs-rca" if args.kind == "problem" else "needs-scope"),
                summary="Intake is preserved and awaiting Linear synchronization.",
                error=state["sync_error"],
                team=team,
                project=project,
                binding_source=binding["source"],
                binding_digest=binding["binding_digest"],
            ),
            args.agent,
        )
        return 8
    if not synced.get("identifier") or not synced.get("url"):
        raise RuntimeError("Linear create returned an incomplete receipt")
    state.update(
        {
            "state": "completed",
            "issue_identifier": synced["identifier"],
            "issue_url": synced["url"],
        }
    )
    save_run(state)
    stage = "needs-rca" if args.kind == "problem" else "needs-scope"
    emit(
        receipt(
            run_id=run_id,
            state="created",
            issue=synced["identifier"],
            url=synced["url"],
            status="created",
            next_stage=stage,
            summary=(
                f"Created {args.kind} intake issue in {team} / {project} "
                f"from {binding['source']}, ready for {stage}."
            ),
            team=team,
            project=project,
            binding_source=binding["source"],
            binding_digest=binding["binding_digest"],
        ),
        args.agent,
    )
    return 0


