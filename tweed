def repository_root(cwd: str | Path | None = None) -> Path:
    current = Path(cwd or os.getcwd()).expanduser().resolve()
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=current,
            capture_output=True,
            check=True,
            text=True,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Tweed requires a Git repository: {current}") from error
    return Path(result.stdout.strip()).resolve()


def git(root: Path, *args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", *args], cwd=root, capture_output=True, text=True, check=False
    )
    if check and result.returncode:
        raise RuntimeError(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result.stdout.strip()


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def cached_input_digest(root: Path, path: Path) -> str:
    canonical_root = root.resolve()
    canonical = path.resolve()
    if canonical.is_relative_to(canonical_root):
        relative = str(canonical.relative_to(canonical_root))
        tracked = bool(
            git(root, "ls-files", "--error-unmatch", "--", relative, check=False)
        )
        clean = (
            subprocess.run(
                ["git", "diff", "--quiet", "--", relative], cwd=root, check=False
            ).returncode
            == 0
        )
        if tracked and clean:
            blob = git(root, "rev-parse", f":{relative}")
            identity = digest(f"{canonical_root}\0{relative}")
            memo = state_root().parent / "cache/file-hashes" / f"{identity}.json"
            if memo.exists():
                try:
                    value = json.loads(memo.read_text(encoding="utf-8"))
                except (OSError, json.JSONDecodeError):
                    value = {}
                if value.get("blob") == blob and re.fullmatch(
                    r"[a-f0-9]{64}", str(value.get("sha256", ""))
                ):
                    return value["sha256"]
            value = sha256_file(canonical)
            atomic_json_write(memo, {"blob": blob, "sha256": value})
            return value
    return sha256_file(canonical)


def repository_cache_identity(root: Path) -> dict[str, Any]:
    status_bytes = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
        cwd=root,
        capture_output=True,
        check=True,
    ).stdout
    untracked: dict[str, str] = {}
    for raw in status_bytes.split(b"\0"):
        if raw.startswith(b"?? "):
            relative = raw[3:].decode("utf-8", errors="surrogateescape")
            path = (root / relative).resolve()
            if not path.is_relative_to(root.resolve()) or not path.is_file():
                raise RuntimeError("uncertain untracked repository state; evidence is not cacheable")
            untracked[relative] = sha256_file(path)
    diff = subprocess.run(
        ["git", "diff", "--binary", "HEAD"],
        cwd=root,
        capture_output=True,
        check=True,
    ).stdout
    return {
        "head": git(root, "rev-parse", "HEAD"),
        "index_tree": git(root, "write-tree"),
        "status_sha256": hashlib.sha256(status_bytes).hexdigest(),
        "worktree_diff_sha256": hashlib.sha256(diff).hexdigest(),
        "untracked": untracked,
    }


def evidence_cache_key(
    root: Path,
    argv: list[str],
    *,
    dependency_paths: list[Path],
    configuration_paths: list[Path],
    declared_environment: list[str],
    tool_versions: dict[str, str],
    artifact_hashes: list[str],
) -> tuple[str, dict[str, Any]]:
    if not argv or not all(isinstance(part, str) for part in argv):
        raise RuntimeError("evidence cache requires exact command arguments")
    if not tool_versions or any(not value for value in tool_versions.values()):
        raise RuntimeError("evidence cache requires every tool/runtime version")

    def path_state(paths: list[Path]) -> dict[str, str]:
        values: dict[str, str] = {}
        for raw in paths:
            path = raw.expanduser().resolve()
            if not path.is_file():
                raise RuntimeError(f"evidence cache input is unavailable: {path}")
            values[str(path)] = cached_input_digest(root, path)
        return values

    environment = {
        name: digest(os.environ[name]) if name in os.environ else "ABSENT"
        for name in sorted(set(declared_environment))
    }
    document = {
        "schema_version": CACHE_SCHEMA_VERSION,
        "repository": repository_cache_identity(root),
        "argv": argv,
        "dependencies": path_state(dependency_paths),
        "configuration": path_state(configuration_paths),
        "declared_environment": environment,
        "tool_versions": dict(sorted(tool_versions.items())),
        "artifact_hashes": sorted(artifact_hashes),
    }
    encoded = json.dumps(
        document, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest(), document


def evidence_cache_path(key: str) -> Path:
    if not re.fullmatch(r"[a-f0-9]{64}", key):
        raise RuntimeError("invalid evidence cache key")
    return state_root().parent / "cache/evidence" / f"{key}.json"


def load_cached_evidence(
    key: str, key_document: dict[str, Any]
) -> dict[str, Any] | None:
    path = evidence_cache_path(key)
    if not path.exists():
        return None
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if value.get("key") != key or value.get("key_document") != key_document:
        return None
    result = value.get("result")
    return result if isinstance(result, dict) else None


def save_cached_evidence(
    key: str, key_document: dict[str, Any], result: dict[str, Any]
) -> None:
    atomic_json_write(
        evidence_cache_path(key),
        {"key": key, "key_document": key_document, "result": result},
    )


def config_path() -> Path:
    explicit = os.environ.get("TWEED_CONFIG")
    if explicit:
        return Path(explicit).expanduser()
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return base.expanduser() / "tweed/config.json"


def load_config() -> dict[str, Any]:
    path = config_path()
    if not path.exists():
        return {"folders": {}}
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"could not read Tweed config at {path}: {error}") from error
    if not isinstance(data, dict) or not isinstance(data.get("folders", {}), dict):
        raise RuntimeError(f"invalid Tweed config at {path}")
    data.setdefault("folders", {})
    return data


def atomic_json_write(path: Path, data: dict[str, Any], mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as file:
            json.dump(data, file, indent=2, sort_keys=True)
            file.write("\n")
            file.flush()
            os.fsync(file.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def atomic_bytes_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as file:
            file.write(data)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(temporary, mode)
        try:
            os.link(temporary, path)
        except FileExistsError:
            if path.read_bytes() != data:
                raise RuntimeError(f"content-addressed artifact collision: {path.name}")
        finally:
            os.unlink(temporary)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def artifact_root(run_id: str) -> Path:
    return state_path(run_id).parent / "artifacts"


def artifact_manifest_path(run_id: str) -> Path:
    return artifact_root(run_id) / "manifest.json"


def empty_artifact_manifest(run_id: str) -> dict[str, Any]:
    return {
        "schema_version": ARTIFACT_MANIFEST_VERSION,
        "run_id": run_id,
        "artifacts": {},
    }


def load_artifact_manifest(run_id: str) -> dict[str, Any]:
    path = artifact_manifest_path(run_id)
    if not path.exists():
        return empty_artifact_manifest(run_id)
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"invalid artifact manifest for {run_id}: {error}") from error
    if (
        not isinstance(manifest, dict)
        or manifest.get("schema_version") != ARTIFACT_MANIFEST_VERSION
        or manifest.get("run_id") != run_id
        or not isinstance(manifest.get("artifacts"), dict)
    ):
        raise RuntimeError(f"invalid artifact manifest for {run_id}")
    return manifest


def put_artifact(
    run_id: str,
    logical_name: str,
    content: str | bytes,
    *,
    media_type: str = "text/markdown; charset=utf-8",
    manifest: dict[str, Any] | None = None,
) -> dict[str, Any]:
    if not re.fullmatch(r"[a-z][a-z0-9-]*", logical_name):
        raise RuntimeError(f"invalid artifact name: {logical_name}")
    data = content.encode("utf-8") if isinstance(content, str) else content
    sha256 = hashlib.sha256(data).hexdigest()
    relative = Path("sha256") / sha256
    target = artifact_root(run_id) / relative
    atomic_bytes_write(target, data)
    entry = {
        "sha256": sha256,
        "bytes": len(data),
        "media_type": media_type,
        "path": str(relative),
    }
    value = manifest if manifest is not None else load_artifact_manifest(run_id)
    value["artifacts"][logical_name] = entry
    atomic_json_write(artifact_manifest_path(run_id), value)
    return entry


def read_artifact(run_id: str, logical_name: str) -> bytes:
    manifest = load_artifact_manifest(run_id)
    try:
        entry = manifest["artifacts"][logical_name]
        relative = Path(entry["path"])
        expected_hash = entry["sha256"]
        expected_bytes = entry["bytes"]
    except (KeyError, TypeError) as error:
        raise RuntimeError(f"artifact is missing: {logical_name}") from error
    root = artifact_root(run_id).resolve()
    if relative.is_absolute() or ".." in relative.parts:
        raise RuntimeError(f"unsafe artifact path: {relative}")
    target = (root / relative).resolve()
    if not target.is_relative_to(root) or not target.is_file():
        raise RuntimeError(f"artifact is missing: {logical_name}")
    data = target.read_bytes()
    actual = hashlib.sha256(data).hexdigest()
    if actual != expected_hash or len(data) != expected_bytes:
        raise RuntimeError(f"artifact integrity check failed: {logical_name}")
    return data


def artifact_manifest_digest(manifest: dict[str, Any]) -> str:
    encoded = json.dumps(
        manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def manifest_digest(run_id: str) -> str:
    return artifact_manifest_digest(load_artifact_manifest(run_id))


def snapshot_artifact_manifest(run_id: str) -> tuple[Path, str]:
    manifest = load_artifact_manifest(run_id)
    encoded = json.dumps(
        manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")
    sha256 = hashlib.sha256(encoded).hexdigest()
    path = artifact_root(run_id) / "manifests" / f"{sha256}.json"
    if not path.exists():
        atomic_bytes_write(path, encoded)
    return path, sha256


def restore_manifest_snapshot(run_id: str, state: dict[str, Any]) -> None:
    expected = state.get("artifact_manifest_digest")
    reference = state.get("artifact_manifest")
    if not expected or not reference:
        raise RuntimeError(f"run {run_id} has no committed artifact manifest")
    path = Path(reference).resolve()
    root = (artifact_root(run_id) / "manifests").resolve()
    if not path.is_relative_to(root) or path.name != f"{expected}.json":
        raise RuntimeError(f"run {run_id} has an unsafe artifact manifest reference")
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"run {run_id} artifact manifest snapshot is invalid") from error
    if artifact_manifest_digest(manifest) != expected:
        raise RuntimeError(f"run {run_id} artifact manifest snapshot is corrupt")
    atomic_json_write(artifact_manifest_path(run_id), manifest)


def save_config(config: dict[str, Any]) -> None:
    atomic_json_write(config_path(), config)


def linear_project(root: Path) -> str | None:
    entry = load_config()["folders"].get(str(root), {})
    value = entry.get("linear_project") if isinstance(entry, dict) else None
    return value.strip() if isinstance(value, str) and value.strip() else None


def set_linear_project(root: Path, project: str | None) -> None:
    config = load_config()
    if project:
        config["folders"][str(root)] = {"linear_project": project.strip()}
    else:
        config["folders"].pop(str(root), None)
    save_config(config)


def state_root() -> Path:
    explicit = os.environ.get("TWEED_STATE_HOME")
    if explicit:
        return Path(explicit).expanduser()
    base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return base.expanduser() / "tweed/runs"


def state_path(run_id: str) -> Path:
    if not re.fullmatch(r"tw_[a-f0-9]{16}", run_id):
        raise RuntimeError("invalid Tweed run ID")
    return state_root() / run_id / "run.json"


def save_run(state: dict[str, Any]) -> None:
    state.setdefault("run_schema_version", RUN_SCHEMA_VERSION)
    if artifact_manifest_path(state["run_id"]).exists():
        manifest_path, manifest_sha256 = snapshot_artifact_manifest(state["run_id"])
        state["artifact_manifest"] = str(manifest_path)
        state["artifact_manifest_digest"] = manifest_sha256
    path = state_path(state["run_id"])
    atomic_json_write(path, state)


def load_run(run_id: str) -> dict[str, Any]:
    path = state_path(run_id)
    if not path.exists():
        raise RuntimeError(f"unknown Tweed run: {run_id}")
    state = json.loads(path.read_text())
    if state.get("run_schema_version") == RUN_SCHEMA_VERSION:
        expected = state.get("artifact_manifest_digest")
        if expected and (
            not artifact_manifest_path(run_id).exists()
            or manifest_digest(run_id) != expected
        ):
            restore_manifest_snapshot(run_id, state)
        return state
    if state.get("run_schema_version") not in {None, 1}:
        raise RuntimeError(f"run {run_id} uses an unsupported state schema")
    backup = path.parent / "run.v1.json"
    if not backup.exists():
        atomic_bytes_write(backup, path.read_bytes())
    manifest = load_artifact_manifest(run_id)
    issue = state.get("issue")
    if isinstance(issue, dict) and isinstance(issue.get("description"), str):
        put_artifact(
            run_id,
            "linear-description",
            issue["description"],
            manifest=manifest,
        )
    if isinstance(state.get("report_markdown"), str):
        put_artifact(
            run_id,
            str(state.get("phase") or "report"),
            state["report_markdown"],
            manifest=manifest,
        )
    if isinstance(state.get("workflow_text"), str):
        put_artifact(
            run_id,
            "workflow",
            state["workflow_text"],
            manifest=manifest,
        )
    state["run_schema_version"] = RUN_SCHEMA_VERSION
    save_run(state)
    return state


def new_run_id() -> str:
    global LAST_RUN_ID
    LAST_RUN_ID = "tw_" + uuid.uuid4().hex[:16]
    return LAST_RUN_ID


def record_active_turn(turn_id: str) -> None:
    if not LAST_RUN_ID:
        return
    path = state_path(LAST_RUN_ID)
    if not path.exists():
        return
    state = json.loads(path.read_text())
    if state.get("state") == "running":
        state["turn_id"] = turn_id
        atomic_json_write(path, state)


def mark_run_terminal(run_id: str | None, state_name: str, error: str) -> None:
    if not run_id:
        return
    path = state_path(run_id)
    if not path.exists():
        return
    state = json.loads(path.read_text())
    if state.get("state") != "running":
        return
    state["state"] = state_name
    state["error"] = error
    if LAST_TURN_ID:
        state["turn_id"] = LAST_TURN_ID
    save_run(state)


def digest(text: str) -> str:
    return hashlib.sha256(text.encode()).hexdigest()


def metadata_block(metadata: dict[str, Any]) -> str:
    return (
        f"{META_START}\n## Tweed\n\n```json\n"
        f"{json.dumps(metadata, indent=2, sort_keys=True)}\n```\n{META_END}"
    )


def section_block(name: str, body: str) -> str:
    return f"<!-- tweed:{name}:start -->\n{body.strip()}\n<!-- tweed:{name}:end -->"


def parse_metadata(description: str) -> dict[str, Any]:
    start = description.find(META_START)
    end = description.find(META_END)
    if start < 0 or end < start:
        raise RuntimeError("Linear issue is not a Tweed issue: metadata is missing")
    block = description[start + len(META_START) : end]
    match = re.search(r"```json\s*(\{.*\})\s*```", block, re.DOTALL)
    if not match:
        raise RuntimeError("Linear issue has invalid Tweed metadata")
    metadata = json.loads(match.group(1))
    if metadata.get("schema_version") != SCHEMA_VERSION:
        raise RuntimeError("Linear issue uses an unsupported Tweed schema")
    return metadata


def replace_metadata(description: str, metadata: dict[str, Any]) -> str:
    start = description.find(META_START)
    end = description.find(META_END)
    if start < 0 or end < start:
        raise RuntimeError("cannot update issue without Tweed metadata")
    end += len(META_END)
    return description[:start] + metadata_block(metadata) + description[end:]


def replace_section(description: str, name: str, body: str) -> str:
    replacement = section_block(name, body)
    marker = f"<!-- tweed:{name}:start -->"
    if marker not in description:
        return description.rstrip() + "\n\n" + replacement + "\n"
    for match in SECTION_RE.finditer(description):
        if match.group("name") == name:
            return (
                description[: match.start()] + replacement + description[match.end() :]
            )
    raise RuntimeError(f"Linear issue has malformed Tweed {name} section")


def section_body(description: str, name: str) -> str | None:
    pattern = re.compile(
        rf"^[ \t]*<!-- tweed:{re.escape(name)}:start -->\r?\n(?P<body>.*?)\r?\n"
        rf"^[ \t]*<!-- tweed:{re.escape(name)}:end -->",
        re.DOTALL | re.MULTILINE,
    )
    match = pattern.search(description)
    return match.group("body").strip() if match else None


def phase_sync_already_landed(state: dict[str, Any], issue: dict[str, Any]) -> bool:
    try:
        desired_description = desired_description_from_state(state)
    except (KeyError, RuntimeError, json.JSONDecodeError):
        return False
    return (
        issue.get("digest") == digest(desired_description)
        and issue.get("description") == desired_description
    )


def desired_description_from_state(state: dict[str, Any]) -> str:
    if isinstance(state.get("new_description"), str):
        return state["new_description"]
    return read_artifact(state["run_id"], "linear-desired-description").decode(
        "utf-8"
    )


def intake_description(
    kind: str, request: str, root: Path, project: str, run_id: str
) -> str:
    stage = "needs-rca" if kind == "problem" else "needs-scope"
    metadata = {
        "schema_version": SCHEMA_VERSION,
        "kind": kind,
        "stage": stage,
        "contract_revision": 0,
        "repository": str(root),
        "planning_base": git(root, "rev-parse", "HEAD"),
        "integration_branch": None,
        "integration_commit": None,
        "linear_project": project,
        "last_run": run_id,
    }
    return (
        metadata_block(metadata)
        + "\n\n"
        + section_block("request", f"# Request\n\n{request}")
        + "\n"
    )


def evidence_from_scope(scope: str | None) -> str:
    if not scope:
        return ""
    match = re.search(
        r"^## Repository state\s*$\n(?P<body>.*?)(?=^## |\Z)",
        scope,
        re.MULTILINE | re.DOTALL,
    )
    return match.group(0).strip() if match else ""


def freeze_linear_snapshot(
    run_id: str, issue: dict[str, Any], workflow: str
) -> dict[str, Any]:
    manifest = load_artifact_manifest(run_id)
    put_artifact(run_id, "linear-description", issue["description"], manifest=manifest)
    snapshot_metadata = {
        key: issue[key]
        for key in ("identifier", "url", "title", "revision", "digest")
    }
    put_artifact(
        run_id,
        "linear-snapshot",
        json.dumps(
            snapshot_metadata,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ),
        media_type="application/json; charset=utf-8",
        manifest=manifest,
    )
    for name in ("request", "rca", "scope", "implementation", "review"):
        body = section_body(issue["description"], name)
        if body is not None:
            put_artifact(run_id, name, body, manifest=manifest)
    put_artifact(
        run_id,
        "evidence",
        evidence_from_scope(section_body(issue["description"], "scope")),
        manifest=manifest,
    )
    put_artifact(run_id, "workflow", workflow, manifest=manifest)
    return snapshot_metadata


def artifact_reference(run_id: str, logical_name: str) -> dict[str, Any]:
    manifest = load_artifact_manifest(run_id)
    try:
        entry = manifest["artifacts"][logical_name]
    except KeyError as error:
        raise RuntimeError(f"required phase artifact is missing: {logical_name}") from error
    read_artifact(run_id, logical_name)
    return {
        "name": logical_name,
        "sha256": entry["sha256"],
        "bytes": entry["bytes"],
        "media_type": entry["media_type"],
        "path": str((artifact_root(run_id) / entry["path"]).resolve()),
    }


def build_phase_packet(
    run_id: str, issue: dict[str, Any], phase: Phase
) -> dict[str, Any]:
    required = list(PHASE_ARTIFACTS[phase.command])
    if phase.command == "scope" and parse_metadata(issue["description"])["kind"] == "feature":
        required.remove("rca")
    references = [
        artifact_reference(run_id, name)
        for name in required
    ]
    manifest_path, manifest_sha256 = snapshot_artifact_manifest(run_id)
    packet = {
        "schema": "dev.tweed.phase-packet.v1",
        "run_id": run_id,
        "phase": phase.command,
        "issue": {
            "identifier": issue["identifier"],
            "url": issue["url"],
            "title": issue["title"],
            "revision": issue["revision"],
            "description_digest": issue["digest"],
            "metadata": parse_metadata(issue["description"]),
        },
        "artifacts": references,
        "artifact_manifest": {
            "path": str(manifest_path.resolve()),
            "sha256": manifest_sha256,
        },
        "instructions": (
            "Read only referenced artifacts needed for this phase. Verify each file's "
            "SHA-256 before use. Inspect the verified manifest and open another artifact "
            "by exact name only when genuinely required. Do not load transcripts or the "
            "complete Linear description."
        ),
    }
    encoded = json.dumps(packet, ensure_ascii=False, separators=(",", ":")).encode(
        "utf-8"
    )
    if len(encoded) > 8192:
        raise RuntimeError("phase packet exceeded the 8 KiB bound")
    return packet


def load_frozen_issue(state: dict[str, Any]) -> dict[str, Any]:
    issue = dict(state["issue"])
    if isinstance(issue.get("description"), str):
        description = issue["description"]
    else:
        description = read_artifact(
            state["run_id"], "linear-description"
        ).decode("utf-8")
        issue["description"] = description
    issue.setdefault("digest", digest(issue["description"]))
    if not isinstance(issue.get("revision"), str) or not issue["revision"]:
        raise RuntimeError(
            "legacy run lacks authoritative Linear revision provenance; "
            "reasoning and synchronization remain preserved but cannot resume automatically"
        )
    if issue["digest"] != digest(description):
        raise RuntimeError("frozen Linear snapshot digest is corrupt")
    return issue


def compact_issue(issue: dict[str, Any]) -> dict[str, Any]:
    return {
        key: issue[key]
        for key in ("identifier", "url", "title", "revision", "digest")
    }


def record_phase_artifacts(
    run_id: str, phase: Phase, result: dict[str, Any]
) -> None:
    manifest = load_artifact_manifest(run_id)
    put_artifact(
        run_id, phase.section, result["report_markdown"], manifest=manifest
    )
    evidence = re.findall(
        r"^## (?:Verification|Repository state)\s*$\n.*?(?=^## |\Z)",
        result["report_markdown"],
        re.MULTILINE | re.DOTALL,
    )
    put_artifact(
        run_id,
        "evidence",
        "\n\n".join(part.strip() for part in evidence),
        manifest=manifest,
    )


def completed_json_turn(
    thread: Any,
    prompt: str,
    schema: dict[str, Any],
    sandbox: Sandbox | None = None,
    timeout_seconds: int = 180,
) -> dict[str, Any]:
    global LAST_TURN_ID
    options: dict[str, Any] = {"output_schema": schema}
    if sandbox is not None:
        options["sandbox"] = sandbox
    if hasattr(thread, "turn"):
        handle = thread.turn(prompt, **options)
        LAST_TURN_ID = handle.id
        record_active_turn(handle.id)

        def timed_out(_signum: int, _frame: Any) -> None:
            raise TimeoutError(f"Codex turn exceeded {timeout_seconds} seconds")

        previous_handler = signal.signal(signal.SIGALRM, timed_out)
        signal.setitimer(signal.ITIMER_REAL, timeout_seconds)
        try:
            result = handle.run()
        except BaseException:
            with contextlib.suppress(Exception):
                handle.interrupt()
            raise
        finally:
            signal.setitimer(signal.ITIMER_REAL, 0)
            signal.signal(signal.SIGALRM, previous_handler)
    else:
        result = thread.run(prompt, **options)
    if result.status != TurnStatus.completed:
        detail = f": {result.error}" if result.error else ""
        raise RuntimeError(
            f"Codex turn ended with status {result.status.value}{detail}"
        )
    if not result.final_response:
        raise RuntimeError(f"Codex turn failed: {result.error or result.status}")
    try:
        value = json.loads(result.final_response)
    except json.JSONDecodeError as error:
        raise RuntimeError("Codex returned invalid structured output") from error
    if not isinstance(value, dict):
        raise RuntimeError("Codex structured output was not an object")
    return value


def linear_turn_timeout() -> int:
    value = int(os.environ.get("TWEED_LINEAR_TIMEOUT", "300"))
    if value <= 0:
        raise RuntimeError("TWEED_LINEAR_TIMEOUT must be a positive integer")
    return value


def linear_adapter_command() -> list[str]:
    configured = os.environ.get("TWEED_LINEAR_ADAPTER", "").strip()
    if not configured:
        raise RuntimeError(
            "model-free Linear transport is not configured; set TWEED_LINEAR_ADAPTER "
            "to an officially authenticated adapter that implements atomic Tweed CAS v1"
        )
    command = shlex.split(configured)
    if not command:
        raise RuntimeError("TWEED_LINEAR_ADAPTER is empty")
    executable = shutil.which(command[0])
    if not executable:
        raise RuntimeError(f"Linear adapter executable not found: {command[0]}")
    command[0] = executable
    return command


def call_linear_adapter(request: dict[str, Any]) -> dict[str, Any]:
    envelope = {"protocol": "dev.tweed.linear.v1", **request}
    try:
        completed = subprocess.run(
            linear_adapter_command(),
            input=json.dumps(
                envelope, sort_keys=True, separators=(",", ":"), ensure_ascii=False
            ).encode("utf-8"),
            capture_output=True,
            timeout=linear_turn_timeout(),
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("Linear adapter timed out") from error
    if completed.returncode:
        detail = completed.stderr.decode("utf-8", errors="replace").strip()
        raise RuntimeError(
            f"Linear adapter failed with exit {completed.returncode}"
            + (f": {detail[:500]}" if detail else "")
        )
    if len(completed.stdout) > 1024 * 1024:
        raise RuntimeError("Linear adapter response exceeded 1 MiB")
    try:
        value = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("Linear adapter returned invalid UTF-8 JSON") from error
    if not isinstance(value, dict) or value.get("protocol") != "dev.tweed.linear.v1":
        raise RuntimeError("Linear adapter returned an invalid protocol envelope")
    return value


def validate_adapter_issue(
    root: Path, value: dict[str, Any], expected_identifier: str | None = None
) -> dict[str, Any]:
    required = {"identifier", "url", "title", "description", "revision", "digest"}
    if not required.issubset(value) or not all(
        isinstance(value[key], str) for key in required
    ):
        raise RuntimeError("Linear adapter returned an incomplete issue snapshot")
    if expected_identifier and value["identifier"].upper() != expected_identifier.upper():
        raise RuntimeError(
            f"Linear returned {value['identifier']} while reading {expected_identifier}"
        )
    if not value["revision"]:
        raise RuntimeError("Linear adapter returned an empty issue revision")
    actual = digest(value["description"])
    if value["digest"] != actual:
        raise RuntimeError("Linear adapter returned a corrupt description digest")
    validate_linear_snapshot(root, value)
    return value


def read_linear_issue(root: Path, issue: str) -> dict[str, Any]:
    expected = sanitize_issue(issue).upper()
    response = call_linear_adapter({"operation": "fetch", "identifier": expected})
    if response.get("status") != "ok" or not isinstance(response.get("issue"), dict):
        raise RuntimeError(response.get("reason") or "Linear snapshot fetch was blocked")
    return validate_adapter_issue(root, response["issue"], expected)


def verify_linear_issue(issue: dict[str, Any]) -> None:
    response = call_linear_adapter(
        {
            "operation": "verify",
            "identifier": issue["identifier"],
            "expected_revision": issue["revision"],
            "expected_digest": issue["digest"],
        }
    )
    if response.get("status") != "unchanged":
        raise RuntimeError(response.get("reason") or "Linear issue changed during the phase")


def create_linear_issue(
    root: Path, project: str, title: str, description: str, run_id: str
) -> dict[str, Any]:
    response = call_linear_adapter(
        {
            "operation": "create-or-recover",
            "project": project,
            "run_id": run_id,
            "title": title,
            "description": description,
            "description_digest": digest(description),
        }
    )
    if response.get("status") not in {"created", "recovered"}:
        return {"status": "blocked", "identifier": None, "url": None, "reason": response.get("reason")}
    issue = validate_adapter_issue(root, response.get("issue", {}))
    if issue["digest"] != digest(description):
        raise RuntimeError("recovered Linear issue does not match the intake description")
    return {"status": "synced", "identifier": issue["identifier"], "url": issue["url"], "reason": None}


def update_linear_issue(
    root: Path,
    issue: str,
    expected_revision: str,
    expected_digest: str,
    expected_description: str,
    description: str,
) -> dict[str, Any]:
    if digest(expected_description) != expected_digest:
        raise RuntimeError("persisted Linear CAS preimage is corrupt")
    response = call_linear_adapter(
        {
            "operation": "compare-and-swap",
            "identifier": issue,
            "expected_revision": expected_revision,
            "expected_digest": expected_digest,
            "expected_description": expected_description,
            "desired_description": description,
            "desired_digest": digest(description),
        }
    )
    if response.get("status") in {"applied", "already-applied"}:
        updated = validate_adapter_issue(root, response.get("issue", {}), issue)
        if updated["digest"] != digest(description):
            raise RuntimeError("Linear adapter acknowledged the wrong desired bytes")
        return {"status": "synced", "identifier": updated["identifier"], "url": updated["url"], "reason": None}
    return {
        "status": "blocked",
        "identifier": None,
        "url": None,
        "reason": response.get("reason") or "Linear CAS precondition was stale",
        "current_issue": response.get("issue"),
    }


def phase_prompt(issue: dict[str, Any], phase: Phase, packet: dict[str, Any]) -> str:
    prompt = (
        f"Execute only the {phase.command} phase for Linear issue {issue['identifier']}. "
        "The runner fetched Linear exactly once and froze content-addressed artifacts. "
        "Do not use Linear write tools. Return the required structured result. If a material "
        "question is necessary, set status to needs-input, populate question, and put only a "
        "short clarification record in report_markdown. Otherwise question must be null.\n\n"
        "Bounded phase packet (artifact contents are intentionally not repeated):\n"
        + json.dumps(packet, indent=2, ensure_ascii=False)
    )
    if len(prompt.encode("utf-8")) > 12288:
        raise RuntimeError("phase prompt exceeded the 12 KiB bound")
    return prompt


def run_phase_turn(thread: Any, prompt: str, phase: Phase) -> dict[str, Any]:
    timeout = int(os.environ.get("TWEED_PHASE_TIMEOUT", "1200"))
    result = completed_json_turn(
        thread, prompt, phase_schema(phase.command), phase.sandbox, timeout
    )
    return validate_phase_result(result, phase)


def validate_phase_result(result: dict[str, Any], phase: Phase) -> dict[str, Any]:
    required = {"status", "summary", "question", "report_markdown"}
    if set(result) != required:
        raise RuntimeError("phase structured output has invalid fields")
    if result["status"] not in ALLOWED_STATUSES[phase.command]:
        raise RuntimeError("phase returned an unsupported status")
    if not isinstance(result["summary"], str) or not isinstance(
        result["report_markdown"], str
    ):
        raise RuntimeError("phase returned invalid text fields")
    if result["status"] == NEEDS_INPUT and not result.get("question"):
        raise RuntimeError("phase requested input without a structured question")
    if result["status"] != NEEDS_INPUT and result.get("question") is not None:
        raise RuntimeError("phase returned a question without needs-input status")
    first_line = next(
        (
            line.strip()
            for line in result["report_markdown"].splitlines()
            if line.strip()
        ),
        "",
    )
    if first_line != f"Status: {result['status']}":
        raise RuntimeError("phase report status does not match its structured status")
    return result


def validate_scope_evidence(root: Path, report: str) -> None:
    canonical_root = root.resolve()
    state_match = re.search(
        r"^## Repository state\s*$\n(?P<body>.*?)(?=^## |\Z)",
        report,
        re.MULTILINE | re.DOTALL,
    )
    if not state_match:
        raise RuntimeError("scoped report is missing its repository state")
    entries: list[tuple[str, str]] = []
    for line in state_match.group("body").splitlines():
        if "→" not in line:
            continue
        match = re.fullmatch(
            r"\s*[-*]\s+`?([^`]+?)`?\s+→\s+`?(ABSENT|[a-f0-9]+)`?\s*",
            line,
        )
        if not match:
            raise RuntimeError(f"invalid scope evidence entry: {line.strip()}")
        entries.append((match.group(1), match.group(2)))
    if not entries:
        raise RuntimeError("scoped report has no evidence snapshot entries")
    for relative, expected in entries:
        path = Path(relative)
        if path.is_absolute() or ".." in path.parts:
            raise RuntimeError(f"unsafe scope evidence path: {relative}")
        target = (canonical_root / path).resolve()
        if not target.is_relative_to(canonical_root):
            raise RuntimeError(f"scope evidence escapes the repository: {relative}")
        if expected == "ABSENT":
            if target.exists():
                raise RuntimeError(
                    f"scope evidence expected an absent path: {relative}"
                )
            continue
        if not re.fullmatch(r"[a-f0-9]{64}", expected):
            raise RuntimeError(f"scope evidence has an invalid SHA-256: {relative}")
        if not target.is_file():
            raise RuntimeError(f"scope evidence file is missing: {relative}")
        actual = hashlib.sha256(target.read_bytes()).hexdigest()
        if actual != expected:
            raise RuntimeError(f"scope evidence hash does not match: {relative}")


def validate_linear_snapshot(root: Path, issue: dict[str, Any]) -> None:
    parse_metadata(issue["description"])
    scope = section_body(issue["description"], "scope")
    if scope is not None:
        validate_scope_evidence(root, scope)


def phase_result_from_response(response: str, phase: Phase) -> dict[str, Any]:
    try:
        result = json.loads(response)
    except json.JSONDecodeError as error:
        raise RuntimeError(
            "completed Codex turn has invalid structured output"
        ) from error
    if not isinstance(result, dict):
        raise RuntimeError("completed Codex turn output was not an object")
    return validate_phase_result(result, phase)


def final_response_from_turn(turn: Any) -> str:
    fallback: str | None = None
    for raw_item in reversed(turn.items):
        item = getattr(raw_item, "root", raw_item)
        if getattr(item, "type", None) != "agentMessage":
            continue
        phase = getattr(item, "phase", None)
        phase_value = getattr(phase, "value", phase)
        if phase_value == "final_answer":
            return item.text
        if phase is None and fallback is None:
            fallback = item.text
    if fallback is None:
        raise RuntimeError("completed Codex turn has no final response")
    return fallback


def recover_recorded_result(
    thread: Any, state: dict[str, Any], phase: Phase
) -> dict[str, Any] | None:
    turn_id = state.get("turn_id")
    if not turn_id:
        raise RuntimeError("interrupted run has no recorded Codex turn")
    turns = thread.read(include_turns=True).thread.turns
    recorded = next((turn for turn in turns if turn.id == turn_id), None)
    if recorded is None:
        raise RuntimeError("recorded Codex turn is missing from its thread")
    if recorded.status == TurnStatus.in_progress:
        raise RuntimeError("recorded Codex turn is still active; retry resume later")
    if recorded.status == TurnStatus.completed:
        return phase_result_from_response(final_response_from_turn(recorded), phase)
    if recorded.status in {TurnStatus.interrupted, TurnStatus.failed}:
        return None
    raise RuntimeError(f"recorded Codex turn has unsupported status {recorded.status}")


def start_phase_thread(
    codex: Codex,
    root: Path,
    issue: dict[str, Any],
    phase: Phase,
    run_id: str,
) -> tuple[Any, str, str]:
    workflow = load_workflow(phase.workflow)
    freeze_linear_snapshot(run_id, issue, workflow)
    packet = build_phase_packet(run_id, issue, phase)
    thread = codex.thread_start(
        cwd=str(root), developer_instructions=workflow, sandbox=phase.sandbox
    )
    thread.set_name(f"Tweed {phase.command}: {issue['identifier']}")
    return thread, workflow, phase_prompt(issue, phase, packet)


def continuation_prompt(answer: str) -> str:
    return (
        "Clarification answer:\n"
        f"{answer}\n\nContinue the same phase from the frozen issue snapshot. Normalize the "
        "answer into a decision, reconcile it with repository evidence, and complete the phase. "
        "Ask one further material question only if still necessary."
    )


def interrupted_continuation_prompt() -> str:
    return (
        "The runner process was interrupted before this phase returned its final structured "
        "result. Continue the same phase from the frozen issue snapshot and preserved "
        "workspace. Reuse completed investigation and partial implementation where valid, "
        "revalidate the current repository state, and return the complete phase result. Do "
        "not repeat external writes or ask for input unless a material decision is still "
        "required."
    )


def resume_prompt(state_name: str, answer: str) -> str:
    if state_name == "awaiting-input":
        if not answer:
            raise RuntimeError("resume requires an answer for an awaiting-input run")
        return continuation_prompt(answer)
    if state_name in {"running", "failed", "canceled"}:
        if answer:
            raise RuntimeError(
                "an interrupted run resumes without a clarification answer"
            )
        return interrupted_continuation_prompt()
    raise RuntimeError(f"run is not resumable from state {state_name!r}")


def sanitize_issue(issue: str) -> str:
    value = issue.strip().lower()
    if not re.fullmatch(r"[a-z][a-z0-9]*-\d+", value):
        raise RuntimeError(f"invalid Linear issue identifier: {issue}")
    return value


def worktree_parent(root: Path) -> Path:
    return root.parent / ".tweed-worktrees"


def branch_worktree(root: Path, branch: str) -> Path | None:
    records = git(root, "worktree", "list", "--porcelain").splitlines()
    current: Path | None = None
    for line in records:
        if line.startswith("worktree "):
            current = Path(line.removeprefix("worktree ")).resolve()
        elif line == f"branch refs/heads/{branch}" and current:
            return current
    return None


def validate_resume_worktree(
    root: Path,
    worktree: Path,
    branch: str | None,
    phase: Phase,
    metadata: dict[str, Any],
) -> None:
    if not worktree.is_dir():
        raise RuntimeError(f"saved Tweed worktree is missing: {worktree}")
    if phase.writes_repository:
        if not branch or branch_worktree(root, branch) != worktree:
            raise RuntimeError(
                "saved Tweed worktree no longer owns its recorded branch"
            )
        expected_head = (
            metadata.get("planning_base")
            if phase.command == "implement"
            else metadata.get("integration_commit")
        )
    else:
        if worktree != root:
            raise RuntimeError("saved read-only Tweed run has the wrong worktree")
        expected_head = metadata.get("planning_base")
    if not expected_head or git(worktree, "rev-parse", "HEAD") != expected_head:
        raise RuntimeError(
            "saved Tweed worktree HEAD changed while the phase was paused"
        )


def prepare_implementation_worktree(
    root: Path, issue: str, base: str
) -> tuple[Path, str]:
    if git(root, "status", "--porcelain"):
        raise RuntimeError("implementation requires the source checkout to be clean")
    slug = sanitize_issue(issue)
    branch = f"tweed/{slug}"
    existing = branch_worktree(root, branch)
    if existing:
        if git(existing, "status", "--porcelain"):
            raise RuntimeError(f"existing Tweed worktree is dirty: {existing}")
        return existing, branch
    parent = worktree_parent(root)
    parent.mkdir(parents=True, exist_ok=True)
    path = parent / f"{root.name}-{slug}"
    if path.exists():
        raise RuntimeError(f"Tweed worktree path already exists: {path}")
    branch_exists = bool(
        git(root, "show-ref", "--verify", f"refs/heads/{branch}", check=False)
    )
    if branch_exists:
        git(root, "worktree", "add", str(path), branch)
    else:
        git(root, "worktree", "add", "-b", branch, str(path), base)
    return path.resolve(), branch


def review_worktree(root: Path, metadata: dict[str, Any]) -> tuple[Path, str]:
    branch = metadata.get("integration_branch")
    commit = metadata.get("integration_commit")
    if not isinstance(branch, str) or not isinstance(commit, str):
        raise RuntimeError("issue has no completed implementation branch and commit")
    path = branch_worktree(root, branch)
    if not path:
        raise RuntimeError(f"integration worktree is not available for {branch}")
    if git(path, "status", "--porcelain"):
        raise RuntimeError(f"integration worktree is dirty before review: {path}")
    if git(path, "rev-parse", "HEAD") != commit:
        raise RuntimeError("integration worktree does not match the issue commit")
    return path, branch


def commit_phase(worktree: Path, issue: str, phase: Phase) -> str:
    changes = git(worktree, "status", "--porcelain")
    if not changes:
        if phase.command == "implement":
            raise RuntimeError("implementation completed without repository changes")
        return git(worktree, "rev-parse", "HEAD")
    git(worktree, "add", "-A")
    message = f"{phase.command.capitalize()} {issue}"
    git(worktree, "commit", "-m", message)
    if git(worktree, "status", "--porcelain"):
        raise RuntimeError("phase commit did not leave a clean worktree")
    return git(worktree, "rev-parse", "HEAD")


@contextlib.contextmanager
def repository_write_lock(root: Path, enabled: bool) -> Iterator[None]:
    if not enabled:
        yield
        return
    common = git(root, "rev-parse", "--git-common-dir")
    common_path = (
        (root / common).resolve() if not Path(common).is_absolute() else Path(common)
    )
    lock_path = common_path / "tweed-write.lock"
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(
                "another Tweed writer is active for this repository"
            ) from error
        yield


@contextlib.contextmanager
def run_execution_lock(run_id: str) -> Iterator[None]:
    lock_path = state_path(run_id).parent / "execution.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path.touch(mode=0o600, exist_ok=True)
    lock_path.chmod(0o600)
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(f"run {run_id} is already active") from error
        yield


@contextlib.contextmanager
def active_run(run_id: str) -> Iterator[None]:
    previous = os.environ.get("TWEED_ACTIVE_RUN")
    os.environ["TWEED_ACTIVE_RUN"] = run_id
    try:
        yield
    finally:
        if previous is None:
            os.environ.pop("TWEED_ACTIVE_RUN", None)
        else:
            os.environ["TWEED_ACTIVE_RUN"] = previous


def validate_issue_for_phase(
    issue: dict[str, Any], phase: Phase, caller_root: Path
) -> tuple[dict[str, Any], Path]:
    metadata = parse_metadata(issue["description"])
    if metadata.get("stage") != phase.expected_stage:
        raise RuntimeError(
            f"{issue['identifier']} is {metadata.get('stage')!r}; {phase.command} requires "
            f"{phase.expected_stage!r}"
        )
    if phase.command == "root-cause" and metadata.get("kind") != "problem":
        raise RuntimeError("root-cause is only valid for problem issues")
    stored_root = Path(str(metadata.get("repository", ""))).expanduser().resolve()
    if stored_root != caller_root:
        raise RuntimeError(
            f"issue repository is {stored_root}, but Tweed was invoked from {caller_root}"
        )
    return metadata, stored_root


def advanced_description(
    issue: dict[str, Any],
    metadata: dict[str, Any],
    phase: Phase,
    result: dict[str, Any],
    run_id: str,
    root: Path,
    branch: str | None,
    commit: str | None,
) -> str:
    updated = dict(metadata)
    updated["stage"] = phase.next_stage
    updated["contract_revision"] = int(metadata.get("contract_revision", 0)) + 1
    updated["last_run"] = run_id
    if phase.command == "scope":
        updated["planning_base"] = git(root, "rev-parse", "HEAD")
    if branch:
        updated["integration_branch"] = branch
    if commit:
        updated["integration_commit"] = commit
    description = replace_section(
        issue["description"], phase.section, result["report_markdown"]
    )
    return replace_metadata(description, updated)


def receipt(
    *,
    run_id: str,
    state: str,
    issue: str | None = None,
    url: str | None = None,
    phase: str | None = None,
    status: str | None = None,
    previous_stage: str | None = None,
