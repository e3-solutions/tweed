#!/usr/bin/env python3
"""Run one isolated Tweed phase and emit one bounded receipt."""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path

MODEL = "gpt-5.6-sol"
COORDINATOR_EFFORT = "medium"
SUBAGENT_EFFORT = "medium"
PHASE_CHILD_ENV = "TWEED_PHASE_CHILD"
RECEIPT_FIELDS = (
    "phase",
    "state",
    "issue",
    "linear_url",
    "result",
    "summary",
    "question",
    "next_action",
    "branch",
    "commit",
    "pull_request_url",
    "resume_session_id",
)

RECEIPT_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": list(RECEIPT_FIELDS),
    "properties": {
        "phase": {
            "type": "string",
            "enum": ["create", "rca", "scope", "implement", "review", "publish"],
        },
        "state": {"type": "string", "enum": ["completed", "needs-input", "blocked"]},
        "issue": {"type": ["string", "null"], "maxLength": 100},
        "linear_url": {"type": ["string", "null"], "maxLength": 512},
        "result": {"type": ["string", "null"], "maxLength": 50},
        "summary": {"type": "string", "maxLength": 800},
        "question": {"type": ["string", "null"], "maxLength": 500},
        "next_action": {"type": ["string", "null"], "maxLength": 400},
        "branch": {"type": ["string", "null"], "maxLength": 300},
        "commit": {"type": ["string", "null"], "maxLength": 100},
        "pull_request_url": {"type": ["string", "null"], "maxLength": 512},
        "resume_session_id": {"type": ["string", "null"], "maxLength": 100},
    },
}

WORKFLOWS = {
    "create": (
        "create.md",
        "Create or recover the standardized Linear request. Do not investigate. ",
    ),
    "rca": (
        "bug-rca.md",
        "Read the Linear issue, run the RCA, and publish its first Tweed comment. ",
    ),
    "scope": (
        "scope.md",
        "Read the issue and required handoff, then publish the solution scope. ",
    ),
    "implement": (
        "implement.md",
        "Implement the approved scope, commit it locally, and publish the handoff. ",
    ),
    "review": (
        "review.md",
        "Review the implementation, make bounded fixes, and publish the verdict. ",
    ),
    "publish": (
        "publish.md",
        "Push the reviewed commit, open or recover its PR, and record it in Linear. ",
    ),
}

COMPLETED_RESULTS = {
    "create": "created",
    "rca": "established",
    "scope": "scoped",
    "implement": "implemented",
    "review": "reviewed",
    "publish": "published",
}


def find_codex() -> str:
    requested = os.environ.get("CODEX_BIN")
    candidates = (
        [shutil.which(requested)]
        if requested
        else [
            str(Path(part or ".") / "codex")
            for part in os.environ.get("PATH", "").split(os.pathsep)
        ]
    )
    for candidate in filter(None, candidates):
        try:
            subprocess.run(
                [candidate, "--version"],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
            return candidate
        except (OSError, subprocess.SubprocessError):
            pass
    raise RuntimeError("no working local Codex CLI found")


def emit(receipt: dict) -> None:
    output = json.dumps(receipt, ensure_ascii=False, separators=(",", ":"))
    if len(output.encode()) > 4096:
        raise RuntimeError("receipt exceeded 4 KiB")
    print(output)


def extract_session_id(events) -> str | None:
    events.seek(0)
    for line in events:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") == "thread.started":
            session_id = event.get("thread_id")
            if isinstance(session_id, str):
                return session_id
    return None


def child_environment() -> dict[str, str]:
    return {**os.environ, PHASE_CHILD_ENV: "1"}


def codex_command(
    repository: Path,
    schema_path: Path,
    receipt_path: Path,
    resume_session_id: str | None,
) -> list[str]:
    child_configs = {
        "default": "General-purpose Tweed subagent",
        "worker": "Tweed implementation and correction worker",
        "explorer": "Read-only Tweed repository investigator",
    }
    child_configs = {
        role: (
            f'{{description="{description}",model="{MODEL}",'
            f'model_reasoning_effort="{SUBAGENT_EFFORT}"}}'
        )
        for role, description in child_configs.items()
    }
    command = [find_codex(), "exec"]
    if resume_session_id:
        command.append("resume")
    else:
        command.extend(("-C", str(repository)))
    command.extend(
        (
            "-m",
            MODEL,
            "-c",
            f'model_reasoning_effort="{COORDINATOR_EFFORT}"',
            "-c",
            f"agents.default={child_configs['default']}",
            "-c",
            f"agents.worker={child_configs['worker']}",
            "-c",
            f"agents.explorer={child_configs['explorer']}",
            "--dangerously-bypass-approvals-and-sandbox",
            "--output-schema",
            str(schema_path),
            "--output-last-message",
            str(receipt_path),
            "--json",
        )
    )
    if resume_session_id:
        command.extend((resume_session_id, "-"))
    else:
        command.extend(("--color", "never", "-"))
    return command


def run_phase(
    repository: Path,
    phase: str,
    phase_input: str,
    resume_session_id: str | None = None,
) -> dict:
    workflow_name, assignment = WORKFLOWS[phase]
    workflow = (Path(__file__).resolve().parent / "workflows" / workflow_name).read_text()
    if resume_session_id:
        prompt = (
            f"Clarification answer for the pending {phase} phase:\n\n{phase_input}\n\n"
            "Continue the same phase from the existing investigation. Do not restart "
            "or invoke Tweed. Return only the requested JSON receipt, populate every "
            "schema field, and set resume_session_id to null; the runner owns that field."
        )
    else:
        prompt = (
            f"{workflow}\n\n# Assignment\n\n{assignment}"
            "Return only the requested JSON receipt. Populate every schema field, use "
            "null when a field does not apply, and always set resume_session_id to null; "
            "the runner owns that field.\n\n"
            "# Phase-child guard\n\n"
            "You are already the Tweed phase coordinator. TWEED_PHASE_CHILD=1 is set. "
            "Execute this supplied workflow directly. Do not invoke the tweed executable "
            "or delegate back to the use-tweed skill.\n\n"
            "# Model policy\n\n"
            f"This coordinator is pinned to {MODEL} at {COORDINATOR_EFFORT} "
            f"reasoning. Spawn every child on {MODEL} at {SUBAGENT_EFFORT} "
            "reasoning using only the built-in default, worker, or explorer roles. "
            "Do not select or request a different child model, role, or reasoning "
            "effort.\n\n"
            f"Repository: {repository}\n\nInput:\n{phase_input}"
        )
    with tempfile.TemporaryDirectory(prefix=f"tweed-{phase}-") as temporary:
        temporary_path = Path(temporary)
        schema_path = temporary_path / "schema.json"
        receipt_path = temporary_path / "receipt.json"
        schema_path.write_text(json.dumps(RECEIPT_SCHEMA))
        with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as events:
            result = subprocess.run(
                codex_command(
                    repository, schema_path, receipt_path, resume_session_id
                ),
                cwd=repository,
                env=child_environment(),
                input=prompt,
                text=True,
                stdout=events,
                stderr=subprocess.PIPE,
                check=False,
            )
            session_id = extract_session_id(events) or resume_session_id
        if result.returncode:
            detail = result.stderr.strip().splitlines()
            raise RuntimeError(detail[-1][:800] if detail else f"{phase} failed")
        raw_receipt: object = json.loads(receipt_path.read_text())

    if not isinstance(raw_receipt, dict):
        raise RuntimeError("Codex returned an invalid receipt")
    receipt = raw_receipt
    if set(receipt) != set(RECEIPT_FIELDS):
        raise RuntimeError("Codex returned an invalid receipt")
    if receipt["phase"] != phase:
        raise RuntimeError("Codex returned the wrong phase")
    if receipt["state"] == "completed" and (
        not receipt["issue"] or not receipt["linear_url"]
    ):
        raise RuntimeError("completed phase is missing its Linear issue")
    if receipt["state"] == "completed" and (
        receipt["result"] != COMPLETED_RESULTS[phase]
    ):
        raise RuntimeError(f"completed {phase} returned the wrong result")
    if receipt["state"] == "needs-input" and not receipt["question"]:
        raise RuntimeError("phase requested input without a question")
    if receipt["state"] == "needs-input":
        if not session_id:
            raise RuntimeError("phase requested input without a resumable session")
        receipt["resume_session_id"] = session_id
    elif receipt["resume_session_id"] is not None:
        raise RuntimeError("terminal phase returned a resume session")
    if phase in {"implement", "review", "publish"} and receipt["state"] == "completed":
        if not receipt["branch"] or not receipt["commit"]:
            raise RuntimeError(f"completed {phase} is missing Git provenance")
    if phase == "publish" and receipt["state"] == "completed" and not receipt[
        "pull_request_url"
    ]:
        raise RuntimeError("completed publish is missing its pull request")
    return receipt


def parse() -> tuple[Path, str, str, str | None]:
    parser = argparse.ArgumentParser(
        prog="tweed",
        description="Run one isolated Linear-backed software delivery phase.",
        epilog=(
            "phases: create bug|feature, RCA, scope, implement, review, publish; "
            "resume: resume <phase> <session-id> <answer>"
        ),
    )
    parser.add_argument("--repo", default=".")
    parser.add_argument("command")
    parser.add_argument("input", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command.casefold()
    values = args.input
    request_kind = None
    resume_session_id = None
    if command == "create":
        if not values or (request_kind := values.pop(0).casefold()) not in {
            "bug",
            "feature",
        }:
            raise RuntimeError("use: tweed create bug|feature <request>")
        phase = "create"
    elif command == "resume":
        if len(values) < 3 or values[0].casefold() not in WORKFLOWS:
            raise RuntimeError("use: tweed resume <phase> <session-id> <answer>")
        phase = values.pop(0).casefold()
        resume_session_id = values.pop(0).casefold()
        try:
            parsed_session_id = uuid.UUID(resume_session_id)
        except ValueError as error:
            raise RuntimeError("resume requires a valid session ID") from error
        if str(parsed_session_id) != resume_session_id:
            raise RuntimeError("resume requires a canonical session ID")
    elif command in WORKFLOWS and command != "create":
        phase = command
    else:
        raise RuntimeError(
            "use: tweed create bug|feature <request> | "
            "RCA|scope|implement|review|publish <issue>"
        )
    phase_input = " ".join(values).strip() or (
        sys.stdin.read().strip() if not sys.stdin.isatty() else ""
    )
    if request_kind and phase_input:
        phase_input = f"Kind: {request_kind}\n\nRequest:\n{phase_input}"
    repository = Path(args.repo).resolve()
    if not repository.is_dir() or not phase_input:
        raise RuntimeError("phase requires a repository and input")
    return repository, phase, phase_input, resume_session_id


def fail(summary: str) -> dict:
    return {
        "phase": None,
        "state": "failed",
        "issue": None,
        "linear_url": None,
        "result": None,
        "summary": summary,
        "question": None,
        "next_action": "Fix the reported problem and rerun the same phase.",
        "branch": None,
        "commit": None,
        "pull_request_url": None,
        "resume_session_id": None,
    }


if __name__ == "__main__":
    try:
        if os.environ.get(PHASE_CHILD_ENV) == "1":
            raise RuntimeError(
                "nested Tweed invocation blocked; execute the supplied phase workflow directly"
            )
        repo, selected_phase, supplied_input, session_id = parse()
        emit(run_phase(repo, selected_phase, supplied_input, session_id))
    except KeyboardInterrupt:
        emit(fail("Tweed was interrupted."))
        raise SystemExit(130) from None
    except Exception as error:  # noqa: BLE001
        emit(fail(str(error).replace("\n", " ")[:800]))
        raise SystemExit(1) from None
