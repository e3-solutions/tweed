.gitattributes export-ignore
.gitignore export-ignore
.confidence export-ignore
.github export-ignore
docs/research export-ignore
skills/confidence-protocol/tests export-ignore
# Stored unified diffs are byte-exact evidence: blank context markers are spaces.
# Preserve their bytes and keep normal source/document whitespace checks enabled.
docs/research/2026-10-confidence/pr-benchmark/results/*/patches/*.patch -text -whitespace
docs/research/2026-10-confidence/claude-first-evaluation/results/patches/*.patch -text -whitespace
docs/research/2026-10-confidence/v08-spotcheck/patches/*.patch -text -whitespace
docs/research/2026-10-confidence/lean-repair/patches/*/*.patch -text -whitespace
docs/research/2026-10-confidence/lean-repair/repair-only-v2/patches/*.patch -text -whitespace
# Frozen trial patches and captured command output retain their original bytes.
docs/research/2026-10-confidence/fork-flush/evidence/*/*/*.patch -text -whitespace
docs/research/2026-10-confidence/fork-flush/evidence/*/*/*.diff -text -whitespace
docs/research/2026-10-confidence/fork-flush/evidence/*/*/*.stdout -text -whitespace
# Fair-loop captured patches and command output are byte-exact evidence.
docs/research/2026-10-confidence/fair-loop/evidence/**/*.patch -text -whitespace
docs/research/2026-10-confidence/fair-loop/evidence/**/*.diff -text -whitespace
docs/research/2026-10-confidence/fair-loop/evidence/**/*.stdout -text -whitespace
