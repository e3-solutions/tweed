) -> dict:
    """Commit run identity before any native coordinator work starts."""
    git = capture_git_state(repository)
    if not git["git_dir"]:
        raise RuntimeError("phase ledger repository identity is unavailable")
    ledger = {
        "version": CHECKPOINT_VERSION,
        "token": token,
        "phase_token": token,
        "status": "starting",
        "phase": phase,
        "native_thread_id": None,
        "native_turn_id": None,
        "protocol": {
            "receipt_protocol": RECEIPT_PROTOCOL,
            "progress_abi": PROGRESS_ABI,
            "initial_remote": {"status": "pending"},
        },
        "runtime": {"version": _runtime_version()},
        "capabilities": {},
        "soft_phase_budget_seconds": resolve_soft_phase_budget(soft_phase_budget_seconds),
        "worktree": str(repository.resolve()),
        "git_dir": git["git_dir"],
        "base_head": git["head"],
        "identity_head": git["head"],
        "model": model,
        "reasoning": reasoning,
        "question": None,
        "pending_answer": None,
        "pending_answer_state": "none",
        "receipt": {"issue": issue_identifier} if issue_identifier else {},
        "final_receipt": None,
        "branch": git["branch"],
        "files_changed": git["files_changed"],
        "files_changed_total_count": git["files_changed_total_count"],
        "files_changed_truncated": git["files_changed_truncated"],
        "checks_completed": [],
        "checks_completed_total_count": 0,
        "checks_completed_truncated": False,
        "activity": "starting",
        "blocker": None,
        "remote_state_changed": False,
        "updated_at": utc_now(),
        "semantic": None,
        "semantic_milestones": [],
        "semantic_milestones_total_count": 0,
        "semantic_milestones_truncated": False,
    }
    write_checkpoint(ledger)
    return ledger


def remote_snapshot(
    repository: Path,
    phase: str,
    branch: str | None,
    issue_identifier: str | None,
    phase_token: str | None = None,
) -> dict:
    """Capture bounded read-only observations used to detect remote effects."""
    snapshot: dict = {}
    if phase == "create":
        try:
            if issue_identifier:
                issue, _comments = call_linear(repository, issue_identifier)
            elif phase_token:
                issue = find_linear_issue_by_correlation(repository, phase_token)
            else:
                issue = None
            snapshot["create_issue"] = {
                "status": "observed",
                "identifier": (
                    (issue.get("identifier") or issue.get("id")) if issue else None
                ),
                "url": issue.get("url") if issue else None,
            }
        except Exception:  # noqa: BLE001 - exact readback is fail-closed
            snapshot["create_issue"] = {"status": "unknown"}
    if branch:
        remote_head = git_output(
            repository, "ls-remote", "--heads", "origin", f"refs/heads/{branch}"
        )
        snapshot["git_head"] = (
            {"status": "unknown"}
            if remote_head is None
            else {
                "status": "observed",
                "oid": remote_head.split(maxsplit=1)[0] if remote_head else None,
            }
        )
        try:
            selector = canonical_github_repository(repository)
            completed = subprocess.run(
                [
                    "gh", "pr", "list", "--repo", selector, "--state", "all",
                    "--head", branch, "--json",
                    "number,state,isDraft,headRefName,headRefOid,baseRefName",
                ],
                check=True, capture_output=True, text=True, timeout=10,
            )
            values = json.loads(completed.stdout)
            if not isinstance(values, list):
                raise ValueError
            snapshot["pull_requests"] = {
                "status": "observed",
                "values": sorted(
                    [
                        {
                            key: item.get(key)
                            for key in (
                                "number", "state", "isDraft", "headRefName",
                                "headRefOid", "baseRefName",
                            )
                        }
                        for item in values
                        if isinstance(item, dict)
                    ],
                    key=lambda item: item.get("number") or 0,
                ),
            }
        except (OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError):
            snapshot["pull_requests"] = {"status": "unknown"}
    if issue_identifier and (header := PHASE_HEADERS.get(phase)):
        try:
            artifact = read_linear_phase_artifact(
                repository, issue_identifier, header
            )
            snapshot["linear_artifact"] = {
                "status": "observed",
                "id": artifact.get("id") if artifact else None,
            }
        except Exception:  # noqa: BLE001 - uncertainty is represented structurally
            snapshot["linear_artifact"] = {"status": "unknown"}
    snapshot["status"] = (
        "unknown"
        if any(
            isinstance(value, dict) and value.get("status") == "unknown"
            for value in snapshot.values()
        )
        else "observed"
    )
    return snapshot


def _serialized_size(receipt: dict) -> int:
    return len(
        (
            json.dumps(receipt, ensure_ascii=False, separators=(",", ":")) + "\n"
        ).encode("utf-8")
    )


def checkpoint_receipt(
    checkpoint: dict,
    *,
    state: str | None = None,
    summary: str | None = None,
) -> dict:
    stored = checkpoint["receipt"]
    receipt = {
        "phase": checkpoint["phase"],
        "state": "blocked" if state == "failed" else (state or "needs-input"),
        "issue": stored.get("issue"),
        "linear_url": stored.get("linear_url"),
        "result": None,
        "summary": (summary or stored.get("summary") or "Checkpoint saved.")[:800],
        "question": checkpoint.get("question"),
        "next_action": "Resume this token to continue the same Codex session.",
        "branch": checkpoint.get("branch") or stored.get("branch"),
        "commit": stored.get("commit"),
        "pull_request_url": stored.get("pull_request_url"),
        "remote_state_changed": checkpoint.get("remote_state_changed"),
        "resume_session_id": checkpoint["token"],
        "resume_token": checkpoint["token"],
        "worktree": checkpoint.get("worktree"),
        "files_changed": list((checkpoint.get("files_changed") or [])[:3]),
        "files_changed_total_count": checkpoint.get(
            "files_changed_total_count", 0
        ),
        "files_changed_truncated": bool(
            checkpoint.get("files_changed_truncated")
            or len(checkpoint.get("files_changed") or []) > 3
        ),
        "checks_completed": list((checkpoint.get("checks_completed") or [])[:3]),
        "checks_completed_total_count": checkpoint.get(
            "checks_completed_total_count", 0
        ),
        "checks_completed_truncated": bool(
            checkpoint.get("checks_completed_truncated")
            or len(checkpoint.get("checks_completed") or []) > 3
        ),
        "activity": checkpoint.get("activity"),
        "blocker": (checkpoint.get("blocker") or "")[:300] or None,
    }
    receipt_v2(
        receipt,
        checkpoint["phase_token"],
        observation={"runtime_version": (checkpoint.get("runtime") or {}).get("version")},
        soft_budget=checkpoint.get("question") == SOFT_BUDGET_CONTINUE_QUESTION,
        failed_resumable=state == "failed" or checkpoint.get("status") == "failed-resumable",
        reconciliation_required=bool(
            checkpoint.get("remote_state_changed") is None
            or checkpoint.get("status") == "failed-resumable"
        ),
    )
    if _serialized_size(receipt) <= RECEIPT_MAX_BYTES:
        return receipt

    receipt.update(
        files_changed=[],
        files_changed_truncated=bool(receipt["files_changed_total_count"]),
        checks_completed=[],
        checks_completed_truncated=bool(receipt["checks_completed_total_count"]),
    )
    if _serialized_size(receipt) <= RECEIPT_MAX_BYTES:
        return receipt
    receipt.update(
        issue=None,
        linear_url=None,
        summary="Checkpoint saved.",
        branch=None,
        commit=None,
        pull_request_url=None,
        worktree=None,
        activity=None,
        blocker=None,
    )
    if _serialized_size(receipt) > RECEIPT_MAX_BYTES:
        receipt["question"] = (
            "The saved question is too large to display; resume this token after "
            "reviewing its durable checkpoint."
        )
    return receipt


def _checkpoint_failure(checkpoint: dict, summary: str, *, remote_uncertain=False) -> dict:
    checkpoint.update(
        status="failed-resumable",
        activity="waiting-user",
        blocker=summary.replace("\n", " ")[:800],
        updated_at=utc_now(),
    )
    if remote_uncertain:
        checkpoint["remote_state_changed"] = _combine_remote(
            checkpoint.get("remote_state_changed"), None
        )
    checkpoint["final_receipt"] = None
    _refresh_checkpoint_git(checkpoint)
    write_checkpoint(checkpoint)
    return checkpoint_receipt(checkpoint, state="failed", summary=summary)


def _validate_checkpoint_worktree(checkpoint: dict) -> Path:
    repository = Path(checkpoint["worktree"])
    if not repository.is_dir():
        raise RuntimeError("checkpoint worktree is unavailable")
    current = capture_git_state(repository)
    if checkpoint.get("git_dir") and current.get("git_dir") != checkpoint["git_dir"]:
        raise RuntimeError("checkpoint worktree no longer identifies the same repository")
    if current.get("branch") != checkpoint.get("branch"):
        raise RuntimeError("checkpoint worktree is on a different branch")
    if (
        checkpoint.get("branch") is None
        and checkpoint.get("identity_head")
        and current.get("head") != checkpoint["identity_head"]
    ):
        raise RuntimeError("checkpoint worktree is at a different detached commit")
    return repository.resolve()


def resume_checkpoint(
    checkpoint: dict,
    answer: str,
    model_override: str | None,
    reasoning_override: str | None,
    soft_phase_budget_override: float | None = None,
) -> tuple[dict, int]:
    pending = checkpoint.get("pending_answer")
    replayed_answer = bool(pending)
    if pending:
        if answer and answer != pending:
            return (
                _checkpoint_failure(
                    checkpoint,
                    "A different clarification answer is already pending for this token.",
                ),
                1,
            )
        prompt = pending
    elif answer:
        checkpoint["pending_answer"] = answer
        checkpoint["pending_answer_state"] = "pending"
        prompt = answer
    else:
        return (
            _checkpoint_failure(
                checkpoint, "This checkpoint is waiting for a clarification answer."
            ),
            1,
        )

    if model_override is not None:
        checkpoint["model"] = resolve_model(model_override)
    if reasoning_override is not None:
        checkpoint["reasoning"] = resolve_reasoning(reasoning_override)
    if soft_phase_budget_override is not None:
        checkpoint["soft_phase_budget_seconds"] = resolve_soft_phase_budget(
            soft_phase_budget_override
        )
    checkpoint.update(
        status="running",
        pending_answer_state="delivering",
        activity="coordinating",
        blocker=None,
        updated_at=utc_now(),
    )
    write_checkpoint(checkpoint)

    try:
        repository = _validate_checkpoint_worktree(checkpoint)
    except Exception as error:  # noqa: BLE001 - retain the accepted answer durably
        return _checkpoint_failure(checkpoint, str(error)), 1

    observation: dict = {}
    observation["phase_token"] = checkpoint["phase_token"]
    observation["_durable_event"] = lambda event, payload: _persist_run_event(
        checkpoint, event, payload, resumed=True
    )
    try:
        receipt = run_phase(
            repository,
            checkpoint["phase"],
            prompt,
            checkpoint.get("native_thread_id") or checkpoint["token"],
            checkpoint.get("model"),
            checkpoint["reasoning"],
            observation,
            replayed_answer,
            checkpoint["soft_phase_budget_seconds"],
        )
    except KeyboardInterrupt:
        committed = authoritative_receipt(checkpoint)
        if committed is not None:
            return committed, 0
        _update_checkpoint_observation(checkpoint, observation)
        return (
            _checkpoint_failure(
                checkpoint, "Bonaparte was interrupted.", remote_uncertain=True
            ),
            130,
        )
    except Exception as error:  # noqa: BLE001 - preserve a resumable answer
        committed = authoritative_receipt(checkpoint)
        if committed is not None:
            return committed, 0
        _update_checkpoint_observation(checkpoint, observation)
        return _checkpoint_failure(
            checkpoint,
            str(error).replace("\n", " ")[:800],
            remote_uncertain=True,
        ), 1

    _update_checkpoint_observation(checkpoint, observation)
    checkpoint.update(
        receipt=_coordinator_receipt(receipt),
        pending_answer=None,
        pending_answer_state="delivered",
        remote_state_changed=_combine_remote(
            checkpoint.get("remote_state_changed"),
            receipt.get("remote_state_changed"),
        ),
        updated_at=utc_now(),
    )
    if receipt["state"] == "needs-input":
        checkpoint.update(
            status="waiting-input",
            question=receipt["question"],
            activity="waiting-user",
            blocker=receipt["question"],
            pending_answer_state="none",
        )
        try:
            _refresh_checkpoint_git(
                checkpoint, update_identity=True, require_identity=True
            )
        except RuntimeError as error:
            return _checkpoint_failure(checkpoint, str(error)), 1
        write_checkpoint(checkpoint)
        return checkpoint_receipt(checkpoint), 0

    receipt["remote_state_changed"] = checkpoint["remote_state_changed"]
    receipt_v2(
        receipt,
        checkpoint["phase_token"],
        observation={
            "runtime_version": receipt.get("runtime_version")
            or (checkpoint.get("runtime") or {}).get("version")
        },
    )
    checkpoint.update(
        status="completed" if receipt["state"] == "completed" else "blocked",
        question=None,
        activity=receipt["state"],
        blocker=receipt["summary"] if receipt["state"] == "blocked" else None,
        final_receipt=dict(receipt),
    )
    _refresh_checkpoint_git(checkpoint, update_identity=True)
    write_checkpoint(checkpoint)
    return receipt, 0


def run_and_checkpoint(
    repository: Path,
    phase: str,
    phase_input: str,
    session_id: str | None,
    model: str | None,
    reasoning: str,
    soft_phase_budget_seconds: float = DEFAULT_SOFT_PHASE_BUDGET_SECONDS,
) -> tuple[dict, int]:
    token = session_id or str(uuid.uuid4())
    base_git = capture_git_state(repository)
    phase_values = phase_input.split(maxsplit=1)
    issue_identifier = phase_values[0] if phase != "create" and phase_values else None
    ledger = new_phase_ledger(
        repository,
        phase,
        token,
        model,
        reasoning,
        soft_phase_budget_seconds,
        issue_identifier,
    )
    ledger["protocol"]["initial_remote"] = remote_snapshot(
        repository, phase, ledger.get("branch"), issue_identifier, token
    )
    write_checkpoint(ledger)
    observation: dict = {
        "phase_token": token,
        "_durable_event": lambda event, payload: _persist_run_event(
            ledger, event, payload, resumed=False
        ),
    }
    ledger.update(status="running", activity="coordinating", updated_at=utc_now())
    write_checkpoint(ledger)
    try:
        receipt = run_phase(
            repository,
            phase,
            phase_input,
            session_id,
            model,
            reasoning,
            observation=observation,
            soft_phase_budget_seconds=soft_phase_budget_seconds,
        )
    except (Exception, KeyboardInterrupt) as error:
        committed = authoritative_receipt(ledger)
        if committed is not None:
            return committed, 0
        _update_checkpoint_observation(ledger, observation)
        coordinator_session = observation.get("session_id") or observation.get(
            "native_thread_id"
        )
        ledger.update(
            native_thread_id=coordinator_session,
            native_turn_id=observation.get("native_turn_id"),
            capabilities=dict((observation.get("native") or {}).get("capabilities") or {}),
            runtime={"version": _runtime_version(observation)},
            question=(
                SOFT_BUDGET_CONTINUE_QUESTION
                if observation.get("soft_budget_steered")
                else "Reconcile this token with inspect before resuming."
            ),
            receipt={},
            remote_state_changed=(None if coordinator_session else False),
        )
        summary = (
            "Bonaparte was interrupted."
            if isinstance(error, KeyboardInterrupt)
            else str(error).replace("\n", " ")[:800]
        )
        return (
            _checkpoint_failure(
                ledger,
                summary,
                remote_uncertain=bool(coordinator_session),
            ),
            130 if isinstance(error, KeyboardInterrupt) else 1,
        )
    _update_checkpoint_observation(ledger, observation)
    coordinator_session = observation.get("session_id") or observation.get(
        "native_thread_id"
    )
    ledger.update(
        native_thread_id=coordinator_session,
        native_turn_id=observation.get("native_turn_id"),
        capabilities=dict((observation.get("native") or {}).get("capabilities") or {}),
        runtime={"version": _runtime_version(observation)},
        receipt=_coordinator_receipt(receipt),
        remote_state_changed=receipt.get("remote_state_changed"),
        updated_at=utc_now(),
    )
    _refresh_checkpoint_git(ledger, update_identity=True)
    if receipt["state"] == "needs-input":
        if not coordinator_session:
            return _checkpoint_failure(
                ledger, "Codex requested input without a resumable native thread."
            ), 1
        ledger.update(
            status="waiting-input",
            question=receipt["question"],
            pending_answer_state="none",
            activity="waiting-user",
            blocker=receipt["question"],
        )
        write_checkpoint(ledger)
        return checkpoint_receipt(ledger), 0
    ledger.update(
        status="completed" if receipt["state"] == "completed" else "blocked",
        question=None,
        activity=receipt["state"],
        blocker=receipt["summary"] if receipt["state"] == "blocked" else None,
        final_receipt=dict(receipt),
    )
    write_checkpoint(ledger)
    return receipt, 0


def canonical_github_repository(repository: Path) -> str:
    remote = git_output(repository, "remote", "get-url", "origin")
    if not remote:
        raise RuntimeError("origin is unavailable")
    value = remote.removesuffix(".git")
    if value.startswith("git@github.com:"):
        selector = value.removeprefix("git@github.com:")
    elif value.startswith("https://github.com/"):
        selector = value.removeprefix("https://github.com/")
    else:
        raise RuntimeError("origin is not a canonical GitHub repository")
    if len(selector.split("/")) != 2 or any(not part for part in selector.split("/")):
        raise RuntimeError("origin is not a canonical GitHub repository")
    return selector


def inspect_checkpoint(checkpoint: dict) -> dict:
    """Reconcile local and provider observations without persisting or writing."""
    repository = Path(checkpoint["worktree"])
    unknown = False
    changed = False
    details = []
    current = capture_git_state(repository)
    if not current.get("git_dir"):
        unknown = True
        details.append("Git unavailable")
    elif current.get("git_dir") != checkpoint.get("git_dir") or current.get(
        "branch"
    ) != checkpoint.get("branch"):
        changed = True
        details.append("Git identity changed")
    elif checkpoint.get("identity_head") and current.get("head") != checkpoint.get(
        "identity_head"
    ):
        changed = True
        details.append("Git head changed")
    else:
        details.append("Git unchanged")

    stored = checkpoint.get("final_receipt") or checkpoint.get("receipt") or {}
    initial_remote = (checkpoint.get("protocol") or {}).get("initial_remote")
    current_remote = remote_snapshot(
        repository,
        checkpoint["phase"],
        checkpoint.get("branch"),
        stored.get("issue"),
        checkpoint.get("phase_token"),
    )
    if (
        not isinstance(initial_remote, dict)
        or initial_remote.get("status") != "observed"
        or current_remote.get("status") != "observed"
    ):
        unknown = True
        details.append("remote baseline unknown")
    elif current_remote != initial_remote:
        changed = True
        details.append("remote effects changed")
    else:
        details.append("remote effects unchanged")
    pr_url = stored.get("pull_request_url")
    if pr_url:
        try:
            selector = canonical_github_repository(repository)
            completed = subprocess.run(
                [
                    "gh",
                    "pr",
                    "view",
                    pr_url,
                    "--repo",
                    selector,
                    "--json",
                    "state,isDraft,headRefName,headRefOid,baseRefName,url",
                ],
                check=True,
                capture_output=True,
                text=True,
                timeout=10,
            )
            pr = json.loads(completed.stdout)
            expected_commit = stored.get("commit")
            expected_branch = stored.get("branch") or checkpoint.get("branch")
            if pr.get("headRefName") != expected_branch or (
                expected_commit and pr.get("headRefOid") != expected_commit
            ):
                changed = True
                details.append("PR changed")
            else:
                details.append("PR unchanged")
        except (OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError):
            unknown = True
            details.append("PR unknown")

    issue = stored.get("issue")
    header = PHASE_HEADERS.get(checkpoint["phase"])
    if issue and header:
        try:
            artifact = read_linear_phase_artifact(repository, issue, header)
            if stored.get("linear_comment_id") and (
                artifact is None or artifact.get("id") != stored["linear_comment_id"]
            ):
                changed = True
                details.append("Linear changed")
            else:
                details.append("Linear observed" if artifact else "Linear absent")
        except Exception:  # noqa: BLE001 - provider uncertainty is fail-closed
            unknown = True
            details.append("Linear unknown")

    remote_state = "unknown" if unknown else "changed" if changed else "unchanged"
    safe = not unknown and not changed and checkpoint["status"] in {
        "waiting-input",
        "failed-resumable",
    }
    final = authoritative_receipt(checkpoint)
    if final is not None:
        return final
    if checkpoint["phase"] == "create":
        correlated = current_remote.get("create_issue")
        if (
            isinstance(correlated, dict)
            and correlated.get("status") == "observed"
            and isinstance(correlated.get("identifier"), str)
            and correlated.get("identifier")
            and isinstance(correlated.get("url"), str)
            and correlated.get("url")
        ):
            recovered = {
                "phase": "create",
                "state": "completed",
                "issue": correlated["identifier"],
                "linear_url": correlated["url"],
                "result": "created",
                "summary": (
                    "Recovered the exact Linear issue from the durable phase-token "
                    "correlation marker after receipt loss."
                ),
                "question": None,
                "next_action": None,
                "branch": None,
                "commit": None,
                "pull_request_url": None,
                "remote_state_changed": True,
            }
            receipt_v2(
                recovered,
                checkpoint["phase_token"],
                observation={
                    "runtime_version": (checkpoint.get("runtime") or {}).get("version")
                },
            )
            return recovered
    receipt = {
        "phase": checkpoint["phase"],
        "state": "needs-input" if safe else "blocked",
        "issue": stored.get("issue"),
        "linear_url": stored.get("linear_url"),
        "result": None,
        "summary": "; ".join(details)[:800],
        "question": checkpoint.get("question") if safe else None,
        "next_action": (
            "Resume this token to continue the bound native thread."
            if safe
            else "Resolve the changed or unknown observation, then inspect again."
        ),
        "branch": checkpoint.get("branch"),
        "commit": stored.get("commit"),
        "pull_request_url": pr_url,
        "remote_state_changed": (
            None if unknown else True if changed else checkpoint.get("remote_state_changed")
        ),
    }
    receipt_v2(
        receipt,
        checkpoint["phase_token"],
        observation={"runtime_version": (checkpoint.get("runtime") or {}).get("version")},
        failed_resumable=checkpoint["status"] == "failed-resumable",
        reconciliation_required=not safe,
    )
    receipt["remote_state"] = remote_state
    receipt["safe_to_resume"] = safe
    receipt["user_action_required"] = True
    receipt["input_kind"] = "continuation" if safe else "reconciliation"
    receipt["reason_code"] = (
        "failed-resumable" if safe else "reconciliation-required"
    )
    return receipt


def parse() -> tuple[
    Path, str | None, str, str | None, str | None, str | None, float | None
]:
    parser = argparse.ArgumentParser(
        prog="bonaparte",
        description="Run one isolated Linear-backed software delivery phase.",
        epilog="phases: create bug|feature, RCA, scope, implement, review, publish; resume; inspect",
    )
    parser.add_argument("--repo", default=".")
    parser.add_argument(
        "--model",
        help=(
            "model for this phase or resume; overrides BONAPARTE_MODEL and "
            "Codex configuration"
        ),
    )
    parser.add_argument(
        "--reasoning",
        help=(
            "reasoning effort for this phase or resume; defaults to medium"
        ),
    )
    parser.add_argument(
        "--soft-phase-budget-seconds",
        help="positive finite soft target for each coordinator turn (default: 300)",
    )
    parser.add_argument(
        "--finalization-window-seconds",
        help="positive finite bounded soft-budget finalization window (default: 30)",
    )
    parser.add_argument("command")
    parser.add_argument("input", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    global _SELECTED_FINALIZATION_WINDOW_SECONDS
    _SELECTED_FINALIZATION_WINDOW_SECONDS = (
        resolve_finalization_window(args.finalization_window_seconds)
        if args.finalization_window_seconds is not None
        else DEFAULT_FINALIZATION_WINDOW_SECONDS
    )
    command = args.command.casefold()
    values = args.input
    request_kind = None
    resume_session_id = None
    if command == "create":
        if not values or (request_kind := values.pop(0).casefold()) not in {
            "bug",
            "feature",
        }:
            raise RuntimeError("use: bonaparte create bug|feature <request>")
        phase = "create"
    elif command == "inspect":
        if len(values) != 1:
            raise RuntimeError("use: bonaparte inspect <token>")
        resume_session_id = values.pop(0)
        try:
            if str(uuid.UUID(resume_session_id)) != resume_session_id:
                raise ValueError
        except ValueError as error:
            raise RuntimeError("inspect requires a canonical token") from error
        phase = "inspect"
    elif command == "resume":
        if values and values[0].casefold() not in WORKFLOWS:
            resume_session_id = values.pop(0)
            try:
                if str(uuid.UUID(resume_session_id)) != resume_session_id:
                    raise ValueError
            except ValueError as error:
                raise RuntimeError("resume requires a canonical token") from error
            phase = None
        else:
            if len(values) < 3 or values[0].casefold() not in WORKFLOWS:
                raise RuntimeError(
                    "use: bonaparte resume <token> <answer> | "
                    "resume <phase> <session-id> <answer>"
                )
            phase = values.pop(0).casefold()
            resume_session_id = values.pop(0).casefold()
            try:
                if str(uuid.UUID(resume_session_id)) != resume_session_id:
                    raise ValueError
            except ValueError as error:
                raise RuntimeError("resume requires a canonical session ID") from error
    elif command in WORKFLOWS and command != "create":
        phase = command
    else:
        raise RuntimeError(
            "use: bonaparte create bug|feature <request> | "
            "RCA|scope|implement|review|publish <issue>"
        )
    phase_input = " ".join(values).strip() or (
        sys.stdin.read().strip() if not sys.stdin.isatty() else ""
    )
    if request_kind and phase_input:
        phase_input = f"Kind: {request_kind}\n\nRequest:\n{phase_input}"
    repository = Path(args.repo).resolve()
    if not repository.is_dir() or (
        phase is not None and phase != "inspect" and not phase_input
    ):
        raise RuntimeError("phase requires a repository and input")
    return (
        repository,
        phase,
        phase_input,
        resume_session_id,
        args.model if command == "resume" else resolve_model(args.model),
        args.reasoning if command == "resume" else resolve_reasoning(args.reasoning),
        (
            resolve_soft_phase_budget(args.soft_phase_budget_seconds)
            if args.soft_phase_budget_seconds is not None
            else (None if command == "resume" else DEFAULT_SOFT_PHASE_BUDGET_SECONDS)
        ),
    )


def fail(
    summary: str,
    phase: str | None = None,
    phase_token: str | None = None,
) -> dict:
    return {
        "phase": phase if phase in WORKFLOWS else None,
        "state": "failed",
        "issue": None,
        "linear_url": None,
        "result": None,
        "summary": summary,
        "question": None,
        "next_action": "Fix the reported problem and rerun the same phase.",
        "branch": None,
        "commit": None,
        "pull_request_url": None,
        "remote_state_changed": None,
        "resume_session_id": None,
        "phase_token": phase_token or str(uuid.uuid4()),
        "reason_code": "failed-terminal",
        "user_action_required": False,
        "input_kind": "none",
        "safe_to_resume": False,
        "reconciliation_required": False,
        "remote_state": "unknown",
        "runtime_version": _runtime_version(),
        "receipt_protocol": RECEIPT_PROTOCOL,
        "progress_abi": PROGRESS_ABI,
    }


def main() -> int:
    global _ACTIVE_PROGRESS
    progress = ProgressReporter(None)
    exit_code = 0
    selected_phase = None
    phase_token = str(uuid.uuid4())
    try:
        try:
            if os.environ.get(PHASE_CHILD_ENV) == "1":
                raise RuntimeError("nested Bonaparte invocation blocked")
            (
                repo,
                selected_phase,
                supplied_input,
                session_id,
                selected_model,
                selected_reasoning,
                selected_soft_phase_budget,
            ) = parse()
            if session_id is not None:
                phase_token = session_id
            if selected_phase == "inspect":
                checkpoint = read_checkpoint(session_id)
                selected_phase = checkpoint["phase"]
                progress = acquire_progress_reporter(True, selected_phase)
                _ACTIVE_PROGRESS = progress
                progress.start()
                result_receipt = inspect_checkpoint(checkpoint)
                exit_code = (
                    0
                    if result_receipt.get("state") == "completed"
                    or result_receipt.get("safe_to_resume")
                    or authoritative_receipt(checkpoint)
                    else 1
                )
            elif session_id is not None:
                with checkpoint_lease(session_id):
                    if os.path.lexists(checkpoint_path(session_id, ensure_directory=False)):
                        checkpoint = read_checkpoint(session_id)
                        if selected_phase is not None and selected_phase != checkpoint["phase"]:
                            raise RuntimeError("legacy resume phase does not match its checkpoint")
                        selected_phase = checkpoint["phase"]
                        progress = acquire_progress_reporter(True, selected_phase)
                        progress.restore_semantic(checkpoint)
                        _ACTIVE_PROGRESS = progress
                        progress.start()
                        committed = authoritative_receipt(checkpoint)
                        if committed is not None:
                            result_receipt, exit_code = committed, 0
                        else:
                            legacy = isinstance(
                                (checkpoint.get("protocol") or {}).get(
                                    "legacy_checkpoint_version"
                                ),
                                int,
                            )
                            reconciliation = (
                                {"safe_to_resume": True}
                                if legacy
                                else inspect_checkpoint(checkpoint)
                            )
                            if reconciliation.get("state") == "completed":
                                result_receipt, exit_code = reconciliation, 0
                            elif reconciliation.get("safe_to_resume"):
                                result_receipt, exit_code = resume_checkpoint(
                                    checkpoint,
                                    supplied_input,
                                    selected_model,
                                    selected_reasoning,
                                    selected_soft_phase_budget,
                                )
                            else:
                                result_receipt, exit_code = reconciliation, 1
                    else:
                        raise RuntimeError("resume checkpoint is unavailable")
            else:
                progress = acquire_progress_reporter(True, selected_phase)
                _ACTIVE_PROGRESS = progress
                progress.start()
                result_receipt, exit_code = run_and_checkpoint(
                    repo,
                    selected_phase,
                    supplied_input,
                    None,
                    selected_model,
                    selected_reasoning,
                    selected_soft_phase_budget
                    or DEFAULT_SOFT_PHASE_BUDGET_SECONDS,
                )
            progress.stop_heartbeat()
            progress.report("finalizing")
            terminal_state = result_receipt["state"]
            if terminal_state not in PROGRESS_TERMINAL_STATES:
                raise ValueError("invalid progress state")
            serialized_receipt = serialize_receipt(result_receipt)
        except KeyboardInterrupt:
            progress.stop_heartbeat()
            progress.report("finalizing")
            serialized_receipt = serialize_receipt(
                fail("Bonaparte was interrupted.", selected_phase, phase_token)
            )
            terminal_state = "failed"
            exit_code = 130
        except Exception as error:  # noqa: BLE001
            progress.stop_heartbeat()
            progress.report("finalizing")
            serialized_receipt = serialize_receipt(
                fail(
                    str(error).replace("\n", " ")[:800],
                    selected_phase,
                    phase_token,
                )
            )
            terminal_state = "failed"
            exit_code = 1

        emit_serialized(serialized_receipt)
        progress.report(terminal_state)
        return exit_code
    finally:
        _ACTIVE_PROGRESS = None
        progress.close()


if __name__ == "__main__":
    raise SystemExit(main())
