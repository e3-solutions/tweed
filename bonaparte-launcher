#!/usr/bin/env python3
"""Launch the installed Bonaparte runtime and update it from stable Git tags."""

from __future__ import annotations

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

REPOSITORY = os.environ.get(
    "BONAPARTE_REPOSITORY", "https://github.com/e3-solutions/tweed.git"
)
TAG_PATTERN = re.compile(r"v(\d+)\.(\d+)\.(\d+)")
CHECK_INTERVAL = 24 * 60 * 60
ACTIVITY_VERSION = 1
ACTIVITY_RETENTION = 50
PHASES = {"create", "rca", "scope", "implement", "review", "publish"}
REQUIRED = """bonaparte bonaparte-launcher skills/use-bonaparte/SKILL.md
skills/use-bonaparte/agents/openai.yaml workflows/create.md workflows/bug-rca.md
workflows/scope.md workflows/implement.md workflows/review.md workflows/publish.md""".split()


def bonaparte_home() -> Path:
    runtime = Path(__file__).resolve().parent
    if runtime.parent.name == "releases":
        return runtime.parent.parent
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    return Path(os.environ.get("BONAPARTE_HOME", data_home / "bonaparte"))


def atomic_link(target: str, link: Path) -> None:
    temporary = link.with_name(f".{link.name}.{os.getpid()}")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    os.replace(temporary, link)


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace(
        "+00:00", "Z"
    )


def phase_from_arguments(arguments: list[str]) -> str | None:
    index = 0
    while index < len(arguments) and arguments[index].startswith("-"):
        index += 2 if arguments[index] in {"--repo", "--model"} else 1
    if index >= len(arguments):
        return None
    command = arguments[index].casefold()
    if command == "resume" and index + 1 < len(arguments):
        command = arguments[index + 1].casefold()
    return command if command in PHASES else None


def activity_directory(home: Path) -> Path:
    directory = home / "activity"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    return directory


def write_activity(path: Path, activity: dict) -> None:
    directory = path.parent
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix=".activity-",
        dir=directory,
        delete=False,
    ) as temporary:
        temporary_path = Path(temporary.name)
        os.chmod(temporary_path, 0o600)
        json.dump(activity, temporary, ensure_ascii=False, separators=(",", ":"))
        temporary.write("\n")
        temporary.flush()
        os.fsync(temporary.fileno())
    try:
        os.replace(temporary_path, path)
    finally:
        temporary_path.unlink(missing_ok=True)


def lock_is_held(path: Path) -> bool:
    try:
        with path.open("a+") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(lock, fcntl.LOCK_UN)
    except OSError:
        return False
    return False


def prune_activity(directory: Path) -> None:
    paths = sorted(
        directory.glob("*.json"), key=lambda path: path.stat().st_mtime, reverse=True
    )
    for path in paths[ACTIVITY_RETENTION:]:
        lock_path = path.with_suffix(".lock")
        if not lock_is_held(lock_path):
            path.unlink(missing_ok=True)
            lock_path.unlink(missing_ok=True)


def elapsed_seconds(activity: dict) -> float:
    started = datetime.fromisoformat(activity["started_at"].replace("Z", "+00:00"))
    finished_at = activity.get("finished_at")
    finished = (
        datetime.fromisoformat(finished_at.replace("Z", "+00:00"))
        if finished_at
        else datetime.now(timezone.utc)
    )
    return round(max(0.0, (finished - started).total_seconds()), 3)


def read_activity(home: Path, run_id: str | None = None) -> dict:
    directory = activity_directory(home)
    if run_id is not None and str(uuid.UUID(run_id)) != run_id:
        raise RuntimeError("status requires a canonical run ID")
    paths = (
        [directory / f"{run_id}.json"]
        if run_id
        else list(directory.glob("*.json"))
    )
    activities = []
    for path in paths:
        try:
            activity = json.loads(path.read_text())
            if activity.get("version") != ACTIVITY_VERSION:
                continue
            if activity.get("state") == "running" and not lock_is_held(
                path.with_suffix(".lock")
            ):
                activity["state"] = "unknown"
            activity["elapsed_seconds"] = elapsed_seconds(activity)
            activities.append(activity)
        except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError):
            continue
    if not activities:
        return {"version": ACTIVITY_VERSION, "state": "idle"}
    running = [activity for activity in activities if activity["state"] == "running"]
    return max(running or activities, key=lambda activity: activity["started_at"])


def terminal_state(stdout: str, returncode: int) -> str:
    if returncode:
        return "interrupted" if returncode == 130 else "failed"
    try:
        receipt = json.loads(stdout)
    except json.JSONDecodeError:
        receipt = None
    if isinstance(receipt, dict) and receipt.get("state") in {
        "completed",
        "needs-input",
        "blocked",
        "failed",
    }:
        return receipt["state"]
    return "failed"


def run_child(command: list[str]) -> tuple[str, int]:
    process = subprocess.Popen(command, stdout=subprocess.PIPE, text=True)
    interrupted = False
    try:
        stdout, _ = process.communicate()
    except KeyboardInterrupt:
        interrupted = True
        try:
            stdout, _ = process.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            process.terminate()
            try:
                stdout, _ = process.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                stdout, _ = process.communicate()
    return stdout, 130 if interrupted else process.returncode


def run_tracked(home: Path, runner: Path, arguments: list[str], phase: str) -> int:
    command = [sys.executable, str(runner), *arguments]
    try:
        directory = activity_directory(home)
        prune_activity(directory)
    except OSError:
        os.execv(sys.executable, command)
    run_id = str(uuid.uuid4())
    activity_path = directory / f"{run_id}.json"
    lock_path = activity_path.with_suffix(".lock")
    started_at = utc_now()
    activity = {
        "version": ACTIVITY_VERSION,
        "run_id": run_id,
        "phase": phase,
        "state": "running",
        "started_at": started_at,
        "finished_at": None,
        "exit_code": None,
    }
    lock = None
    try:
        lock = lock_path.open("x+")
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        write_activity(activity_path, activity)
    except OSError:
        if lock is not None:
            lock.close()
        os.execv(sys.executable, command)
    with lock:
        try:
            stdout, returncode = run_child(command)
        except Exception:
            activity.update(state="failed", finished_at=utc_now(), exit_code=1)
            try:
                write_activity(activity_path, activity)
            except OSError:
                pass
            raise
        activity.update(
            state=terminal_state(stdout, returncode),
            finished_at=utc_now(),
            exit_code=returncode,
        )
        try:
            write_activity(activity_path, activity)
        except OSError:
            pass
        sys.stdout.write(stdout)
        sys.stdout.flush()
        return returncode


def current_release(home: Path) -> Path:
    current = home / "current"
    if not current.is_symlink():
        raise RuntimeError("Bonaparte has no active release; rerun ./install")
    release = current.resolve()
    if not release.is_dir():
        raise RuntimeError("Bonaparte's active release is missing; rerun ./install")
    return release


def tag_version(tag: str) -> tuple[int, int, int] | None:
    match = TAG_PATTERN.search(tag)
    return tuple(map(int, match.groups())) if match else None


def latest_tag() -> tuple[str, str]:
    output = subprocess.check_output(
        ["git", "ls-remote", "--tags", "--refs", REPOSITORY],
        text=True,
        timeout=15,
    )
    refs = [line.split() for line in output.splitlines()]
    tags = [(oid, ref.removeprefix("refs/tags/")) for oid, ref in refs]
    stable = [
        (tag_version(tag), tag, oid) for oid, tag in tags if TAG_PATTERN.fullmatch(tag)
    ]
    if not stable:
        raise RuntimeError("no stable vX.Y.Z tag is published")
    _, tag, oid = max(stable)
    return tag, oid


def validate_release(release: Path) -> None:
    missing = [name for name in REQUIRED if not (release / name).exists()]
    if missing:
        raise RuntimeError(f"release is missing {', '.join(missing)}")
    for name in ("bonaparte", "bonaparte-launcher"):
        source = release / name
        compile(source.read_text(), str(source), "exec")
    environment = os.environ.copy()
    environment["BONAPARTE_AUTO_UPDATE"] = "0"
    subprocess.run(
        [sys.executable, str(release / "bonaparte"), "--help"],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        env=environment,
        timeout=10,
    )


def git(directory: Path, *arguments: str, output: bool = False):
    return subprocess.run(
        ["git", "-C", directory, *arguments],
        check=True,
        capture_output=output,
        text=output,
        timeout=30,
    )


def fetch_release(home: Path, tag: str, expected_oid: str) -> Path:
    destination = home / "releases" / tag
    if destination.exists():
        validate_release(destination)
        return destination
    staging = Path(tempfile.mkdtemp(prefix=".update-", dir=home))
    try:
        git(staging, "init", "-q")
        git(staging, "fetch", "-q", "--depth=1", REPOSITORY, f"refs/tags/{tag}")
        actual_oid = git(staging, "rev-parse", "FETCH_HEAD", output=True).stdout.strip()
        if actual_oid != expected_oid:
            raise RuntimeError(f"tag {tag} moved while updating")
        git(staging, "checkout", "-q", "--detach", "FETCH_HEAD")
        validate_release(staging)
        shutil.rmtree(staging / ".git")
        staging.rename(destination)
        return destination
    finally:
        if staging.exists():
            shutil.rmtree(staging)


def update(home: Path) -> str | None:
    tag, oid = latest_tag()
    current = current_release(home)
    current_version = tag_version(current.name)
    if current_version and current_version >= tag_version(tag):
        return None
    release = fetch_release(home, tag, oid)
    current_version = tag_version(current_release(home).name)
    if current_version and current_version >= tag_version(tag):
        return None
    atomic_link(f"releases/{release.name}", home / "current")
    return tag


def automatic_update(home: Path) -> None:
    if os.environ.get("BONAPARTE_AUTO_UPDATE") == "0":
        return
    checked = home / "last-check"
    if checked.exists() and time.time() - checked.stat().st_mtime < CHECK_INTERVAL:
        return
    try:
        checked.touch()
        update(home)
    except Exception as error:
        print(f"bonaparte: automatic update failed: {error}", file=sys.stderr)


def main() -> int:
    home = bonaparte_home()
    try:
        if sys.argv[1:] == ["update"]:
            tag = update(home)
            print(
                f"Updated Bonaparte to {tag}."
                if tag
                else "Bonaparte is already current."
            )
            return 0
        if sys.argv[1:2] == ["status"]:
            run_id = sys.argv[2] if len(sys.argv) == 3 else None
            if len(sys.argv) > 3:
                raise RuntimeError("use: bonaparte status [run-id]")
            print(json.dumps(read_activity(home, run_id), separators=(",", ":")))
            return 0
        automatic_update(home)
        runner = current_release(home) / "bonaparte"
        arguments = sys.argv[1:]
        phase = phase_from_arguments(arguments)
        if phase is None:
            os.execv(sys.executable, [sys.executable, str(runner), *arguments])
        return run_tracked(home, runner, arguments, phase)
    except Exception as error:
        print(f"bonaparte: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
