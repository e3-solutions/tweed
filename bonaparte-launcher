#!/usr/bin/env python3
"""Launch the installed Bonaparte runtime and update it from stable Git tags."""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPOSITORY = os.environ.get(
    "BONAPARTE_REPOSITORY", "https://github.com/e3-solutions/tweed.git"
)
TAG_PATTERN = re.compile(r"v(\d+)\.(\d+)\.(\d+)")
CHECK_INTERVAL = 24 * 60 * 60
REQUIRED = """bonaparte bonaparte-launcher autoresearch bonaparte_checkpoint.py
bonaparte_native.py bonaparte_progress.py
bonaparte_linear.py
skills/use-bonaparte/SKILL.md
skills/use-bonaparte/agents/openai.yaml workflows/create.md workflows/bug-rca.md
workflows/scope.md workflows/implement.md workflows/review.md workflows/publish.md
workflows/autoresearch-setup.md workflows/autoresearch-worker.md
workflows/autoresearch-critic.md""".split()


def updater_environment() -> dict[str, str]:
    """Keep the host progress channel private to the final runner exec."""

    environment = os.environ.copy()
    environment.pop("BONAPARTE_PROGRESS_FD", None)
    return environment


def bonaparte_home() -> Path:
    runtime = Path(__file__).resolve().parent
    if runtime.parent.name == "releases":
        return runtime.parent.parent
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    return Path(os.environ.get("BONAPARTE_HOME", data_home / "bonaparte"))


def atomic_link(target: str, link: Path) -> None:
    temporary = link.with_name(f".{link.name}.{os.getpid()}")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    os.replace(temporary, link)


def migrate_autoresearch_link(home: Path) -> None:
    bin_dir = Path(os.environ.get("BONAPARTE_BIN_DIR", Path.home() / ".local/bin"))
    link = bin_dir / "autoresearch"
    if link.exists() and not link.is_symlink():
        raise RuntimeError(f"refusing to replace non-symlink: {link}")
    if not (current_release(home) / "autoresearch").is_file():
        return
    atomic_link(str(home / "current" / "autoresearch"), link)


def managed_targets(home: Path) -> tuple[Path, ...]:
    bin_dir = Path(os.environ.get("BONAPARTE_BIN_DIR", Path.home() / ".local/bin"))
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    return (
        bin_dir / "bonaparte",
        bin_dir / "autoresearch",
        codex_home / "skills/use-bonaparte",
    )


def preflight_managed_targets(home: Path) -> None:
    for target in managed_targets(home):
        if target.exists() and not target.is_symlink():
            raise RuntimeError(f"refusing to replace non-symlink: {target}")


def current_release(home: Path) -> Path:
    current = home / "current"
    if not current.is_symlink():
        raise RuntimeError("Bonaparte has no active release; rerun ./install")
    release = current.resolve()
    if not release.is_dir():
        raise RuntimeError("Bonaparte's active release is missing; rerun ./install")
    return release


def tag_version(tag: str) -> tuple[int, int, int] | None:
    match = TAG_PATTERN.search(tag)
    return tuple(map(int, match.groups())) if match else None


def latest_tag() -> tuple[str, str]:
    output = subprocess.check_output(
        ["git", "ls-remote", "--tags", "--refs", REPOSITORY],
        env=updater_environment(),
        text=True,
        timeout=15,
    )
    refs = [line.split() for line in output.splitlines()]
    tags = [(oid, ref.removeprefix("refs/tags/")) for oid, ref in refs]
    stable = [
        (tag_version(tag), tag, oid) for oid, tag in tags if TAG_PATTERN.fullmatch(tag)
    ]
    if not stable:
        raise RuntimeError("no stable vX.Y.Z tag is published")
    _, tag, oid = max(stable)
    return tag, oid


def validate_release(release: Path) -> None:
    missing = [name for name in REQUIRED if not (release / name).exists()]
    if missing:
        raise RuntimeError(f"release is missing {', '.join(missing)}")
    for name in (
        "bonaparte",
        "bonaparte-launcher",
        "bonaparte_checkpoint.py",
        "bonaparte_linear.py",
        "bonaparte_native.py",
        "bonaparte_progress.py",
    ):
        source = release / name
        compile(source.read_text(), str(source), "exec")
    environment = updater_environment()
    environment["BONAPARTE_AUTO_UPDATE"] = "0"
    subprocess.run(
        [sys.executable, str(release / "bonaparte"), "--help"],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        env=environment,
        timeout=10,
    )
    subprocess.run(
        [sys.executable, str(release / "autoresearch"), "--help"],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        env=environment,
        timeout=10,
    )


def git(directory: Path, *arguments: str, output: bool = False):
    return subprocess.run(
        ["git", "-C", directory, *arguments],
        check=True,
        capture_output=output,
        env=updater_environment(),
        text=output,
        timeout=30,
    )


def fetch_release(home: Path, tag: str, expected_oid: str) -> Path:
    destination = home / "releases" / tag
    if destination.exists():
        validate_release(destination)
        return destination
    staging = Path(tempfile.mkdtemp(prefix=".update-", dir=home))
    try:
        git(staging, "init", "-q")
        git(staging, "fetch", "-q", "--depth=1", REPOSITORY, f"refs/tags/{tag}")
        actual_oid = git(staging, "rev-parse", "FETCH_HEAD", output=True).stdout.strip()
        if actual_oid != expected_oid:
            raise RuntimeError(f"tag {tag} moved while updating")
        git(staging, "checkout", "-q", "--detach", "FETCH_HEAD")
        validate_release(staging)
        shutil.rmtree(staging / ".git")
        try:
            staging.rename(destination)
        except OSError:
            # Another updater may have completed the same immutable snapshot.
            if not destination.exists():
                raise
            validate_release(destination)
        return destination
    finally:
        if staging.exists():
            shutil.rmtree(staging)


def update(home: Path) -> str | None:
    tag, oid = latest_tag()
    current = current_release(home)
    current_version = tag_version(current.name)
    if current_version and current_version >= tag_version(tag):
        return None
    preflight_managed_targets(home)
    release = fetch_release(home, tag, oid)
    current_version = tag_version(current_release(home).name)
    if current_version and current_version >= tag_version(tag):
        return None
    atomic_link(f"releases/{release.name}", home / "current")
    migrate_autoresearch_link(home)
    return tag


def status(home: Path) -> int:
    installed = current_release(home).name
    print(f"installed: {installed}")
    try:
        tag, _ = latest_tag()
    except Exception:
        print("latest: unavailable")
        print("current: unknown")
        return 1
    print(f"latest: {tag}")
    installed_version = tag_version(installed)
    print(
        "current: "
        + (
            "unknown"
            if installed_version is None
            else "yes" if installed_version >= tag_version(tag) else "no"
        )
    )
    return 0


def automatic_update(home: Path) -> None:
    if os.environ.get("BONAPARTE_AUTO_UPDATE") == "0":
        return
    checked = home / "last-check"
    if checked.exists() and time.time() - checked.stat().st_mtime < CHECK_INTERVAL:
        return
    try:
        checked.touch()
        tag, _ = latest_tag()
        installed = current_release(home).name
        installed_version = tag_version(installed)
        if installed_version is not None and installed_version < tag_version(tag):
            print(
                f"bonaparte: update available: {tag} (installed: {installed}); "
                "run 'bonaparte update'",
                file=sys.stderr,
            )
    except Exception:
        # Ordinary commands remain quiet and runnable when the check is offline.
        return


def main() -> int:
    home = bonaparte_home()
    try:
        if sys.argv[1:] == ["status"]:
            return status(home)
        if sys.argv[1:] == ["update"]:
            tag = update(home)
            print(
                f"Updated Bonaparte to {tag}."
                if tag
                else "Bonaparte is already current."
            )
            return 0
        migrate_autoresearch_link(home)
        automatic_update(home)
        runner = current_release(home) / "bonaparte"
        os.execv(sys.executable, [sys.executable, str(runner), *sys.argv[1:]])
    except Exception as error:
        print(f"bonaparte: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
